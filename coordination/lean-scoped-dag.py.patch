+    def hold_unchanged_failures(self, prior):
+        """Explicitly retain exact prior source failures while independent work runs."""
+        held = {}
+        for module in self.order:
+            path = prior / 'modules' / module / 'status.json'
+            if self.states[module] != 'PENDING' or not path.is_file():
+                continue
+            result = json.loads(path.read_text())
+            if (result.get('state') == 'FAIL' and (result.get('producerExit') or 0) > 0
+                    and result.get('inputFingerprint') == self.fingerprints[module]
+                    and result.get('sourceSha256') == self.source_pins[module]
+                    and result.get('dependencyArtifacts') == self.dependency_artifacts(module)):
+                self.states[module] = 'FAIL'
+                held[module] = str(path)
+        save(self.run / 'held-unchanged-failures.json', held)
+        print('LEAN DAG RETAINED SOURCE FAILURES ' + str(len(held)), flush=True)
+
+    def recover(self, prior):
+        """Adopt only known successful compiles whose publication failed with EXDEV."""
+        recovered = []
+        for module in self.order:
+            leaf = prior / 'modules' / module
+            status_path = leaf / 'status.json'
+            if self.states[module] != 'PENDING' or not status_path.is_file():
+                continue
+            status = json.loads(status_path.read_text())
+            if (status.get('producerExit') != 0 or status.get('state') != 'ENVFAULT'
+                    or 'Invalid cross-device link' not in status.get('reason', '')
+                    or status.get('inputFingerprint') != self.fingerprints[module]
+                    or status.get('sourceSha256') != self.source_pins[module]
+                    or status.get('dependencyArtifacts') != self.dependency_artifacts(module)):
+                continue
+            if any(self.states[d] not in ('PASS', 'REUSED') for d in self.imports[module] if d in self.affected):
+                continue
+            stage = leaf / 'staging'
+            olean = stage / module_path(module, '.olean')
+            c_file = stage / module_path(module, '.c')
+            if not olean.is_file() or not c_file.is_file():
+                continue
+            frozen = {str(p): sha(p) for p in artifact_set(olean) + [c_file]}
+            save(self.run / ('recover-' + module + '.json'), {'priorStatus': status, 'stagedArtifacts': frozen})
+            artifacts = self.publish(module, stage, olean, c_file, leaf)
+            if any(sha(p) != digest for p, digest in frozen.items()):
+                raise ValueError('Recovered staging changed: ' + module)
+            result = dict(status, state='PASS', artifacts=artifacts,
+                          recoveredFrom=str(status_path), recoveredBy=str(self.run))
+            result.pop('reason', None)
+            self.entries[module] = result
+            self.states[module] = 'REUSED'
+            recovered.append(module)
+            self.checkpoint()
+        print('LEAN DAG RECOVERED ' + str(len(recovered)), flush=True)
+
+    def recover_namespace_equivalent(self, prior):
+        """Preserve producerExit0 across an exact immutable root relocation.
+
+        Dependency module identities and every companion content digest must
+        match. Only filesystem root names may differ, and the immutable overlay
+        has already verified the completed catalogue before this runs.
+        """
+        if getattr(self.args, 'immutable_cohort', None) is None:
+            raise ValueError('Namespace salvage requires pinned complete overlay')
+        prior_preflight = json.loads((prior / 'preflight.json').read_text())
+        if (prior_preflight['toolchainSha256'] != self.tool_pin or
+                prior_preflight['manifestSha256'] != sha(self.args.manifest)):
+            raise ValueError('Namespace salvage source/toolchain manifest mismatch')
+        def normalized(bundles):
+            return {module: {Path(path).name: digest for path, digest in bundle.items()}
+                    for module, bundle in bundles.items()}
+        adopted = []
+        for module in self.order:
+            leaf = prior / 'modules' / module
+            status_path = leaf / 'status.json'
+            if self.states[module] != 'PENDING' or not status_path.is_file():
+                continue
+            status = json.loads(status_path.read_text())
+            if (status.get('producerExit') != 0 or status.get('state') not in ('PASS', 'ENVFAULT') or
+                    (status.get('state') == 'ENVFAULT' and
+                     status.get('reason') != 'Imported artifact changed during compilation') or
+                    status.get('sourceSha256') != self.source_pins[module]):
+                continue
+            actual = self.dependency_artifacts(module)
+            if normalized(status.get('dependencyArtifacts', {})) != normalized(actual):
+                continue
+            if any(self.states[d] not in ('PASS', 'REUSED') for d in self.imports[module] if d in self.affected):
+                continue
+            stage = leaf / 'staging'
+            olean = stage / module_path(module, '.olean')
+            c_file = stage / module_path(module, '.c')
+            if not olean.is_file() or not c_file.is_file():
+                continue
+            frozen = {str(p): sha(p) for p in artifact_set(olean) + [c_file]}
+            evidence = {'priorStatus': status, 'stagedArtifacts': frozen,
+                        'actualDependencyArtifacts': actual,
+                        'exactModuleCompanionContentEquality': normalized(actual),
+                        'manifestSha256': sha(self.args.manifest), 'toolchainSha256': self.tool_pin}
+            save(self.run / ('namespace-recover-' + module + '.json'), evidence)
+            artifacts = self.publish(module, stage, olean, c_file, leaf)
+            if any(sha(p) != digest for p, digest in frozen.items()):
+                raise ValueError('Namespace recovered staging changed: ' + module)
+            result = dict(status, state='PASS', inputFingerprint=self.fingerprints[module],
+                          dependencyArtifacts=actual, artifacts=artifacts,
+                          recoveredFrom=str(status_path), recoveredBy=str(self.run),
+                          namespaceEquivalenceEvidence=str(self.run / ('namespace-recover-' + module + '.json')))
+            result.pop('reason', None)
+            self.entries[module] = result
+            self.states[module] = 'REUSED'
+            self.checkpoint()
+            adopted.append(module)
+        print('LEAN DAG NAMESPACE RECOVERED ' + str(len(adopted)), flush=True)
 
