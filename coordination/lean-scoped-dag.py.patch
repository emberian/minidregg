+def project_immutable_namespace(args):
+    """Project individually pinned warm files before writable namespaces exist.
+
+    Lean chooses the first namespace directory, so an empty-root preflight is
+    not evidence that imports will survive the first node publication. Only a
+    completed, independently hash-pinned immutable cohort is eligible here.
+    """
+    cohort = getattr(args, 'immutable_cohort', None)
+    if cohort is None:
+        return
+    catalogue = cohort / 'COHORT.json'
+    if not args.immutable_cohort_sha256 or sha(catalogue) != args.immutable_cohort_sha256:
+        raise ValueError('Immutable namespace catalogue pin mismatch')
+    data = json.loads(catalogue.read_text())
+    if data.get('state') != 'COMPLETE' or data.get('toolchainSha256') != sha(args.lean):
+        raise ValueError('Namespace projection requires complete matching-toolchain cohort')
+    selected = set(json.loads(args.manifest.read_text())['affected_topological'])
+    projected = []
+    for entry in data['artifacts']:
+        relative = Path(entry['path'])
+        if relative.is_absolute() or '..' in relative.parts:
+            raise ValueError('Unsafe immutable artifact name')
+        original = cohort / relative
+        if sha(original) != entry['sha256']:
+            raise ValueError('Immutable artifact drift: ' + str(relative))
+        if relative.parts[0] != 'olean':
+            continue
+        leaf = relative.name
+        ending = next((x for x in ('.olean.private', '.olean.server', '.olean', '.ilean', '.ir') if leaf.endswith(x)), None)
+        if ending is None:
+            raise ValueError('Unknown immutable companion: ' + str(relative))
+        module = '.'.join(relative.parts[1:-1] + (leaf[:-len(ending)],))
+        if module in selected:
+            continue
+        dest = args.output / Path(*relative.parts[1:])
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        if dest.exists() or dest.is_symlink():
+            if not dest.is_symlink() or dest.resolve() != original.resolve():
+                raise ValueError('Refusing namespace projection overwrite: ' + str(dest))
+        else:
+            dest.symlink_to(original)
+        if sha(dest) != entry['sha256']:
+            raise ValueError('Projected artifact pin mismatch')
+        projected.append({'module': module, 'path': str(dest), 'source': str(original), 'sha256': entry['sha256']})
+    save(args.output / '.immutable-namespace.json', {'catalogueSha256': args.immutable_cohort_sha256, 'artifacts': projected})
 
 
