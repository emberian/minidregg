[Unit]
Description=Mini agent grain controller %i
After=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=exec
Environment=MINI_GRAIN_CONTROLLER_UNIT=%n
ExecStart=/opt/mini/bin/grain-runtime serve /opt/mini/grains/%i.json
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
TasksMax=64
MemoryMax=1G

[Install]
WantedBy=default.target
