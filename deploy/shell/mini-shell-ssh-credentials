#!/usr/bin/env bash
# Opt-in six-argument shell launcher with the signed credential service.
# Installed beside mini-shell-ssh in FRAME/usr/local/lib/mini. The credential
# protocol is a byte relay to the box's key broker (mini-keys relay, beside
# the pinned mini); the broker named by FRAME/etc/mini/keys-client.json holds
# every key. A member cannot select a host path, a broker or a command.
set -euo pipefail
[[ $# == 6 ]] || { echo 'mini-shell-ssh-credentials requires six absolute participant paths' >&2; exit 64; }
for path in "$@"; do
  [[ $path == /* ]] || { echo 'participant path must be absolute' >&2; exit 64; }
done
mini=$1
[[ -x $mini ]] || { echo 'mini client is not executable' >&2; exit 66; }
[[ $0 == /*/usr/local/lib/mini/mini-shell-ssh-credentials ]] || { echo 'credential launcher must be installed in its root frame' >&2; exit 64; }
lib=${0%/mini-shell-ssh-credentials}
frame=${lib%/usr/local/lib/mini}
umask 077
if [[ ${SSH_ORIGINAL_COMMAND-} == mini-provider-credentials-v1 ]]; then
  # The broker checks this account's role, the member's signature and the
  # Store's current-key answer; this process only carries bytes.
  exec "${mini%/*}/mini-keys" relay --client-config "$frame/etc/mini/keys-client.json"
fi
exec "$lib/mini-shell-ssh" "$@"
