#!/usr/bin/env bash
# Opt-in six-argument shell launcher with the existing signed credential service.
# Installed beside mini-shell-ssh in FRAME/usr/local/lib/mini. The fixed config
# is FRAME/etc/mini/provider-service.json; a member cannot select a host path.
set -euo pipefail
[[ $# == 6 ]] || { echo 'mini-shell-ssh-credentials requires six absolute participant paths' >&2; exit 64; }
for path in "$@"; do
  [[ $path == /* ]] || { echo 'participant path must be absolute' >&2; exit 64; }
done
mini=$1
[[ -x $mini ]] || { echo 'mini client is not executable' >&2; exit 66; }
[[ $0 == /*/usr/local/lib/mini/mini-shell-ssh-credentials ]] || { echo 'credential launcher must be installed in its root frame' >&2; exit 64; }
lib=${0%/mini-shell-ssh-credentials}
frame=${lib%/usr/local/lib/mini}
umask 077
if [[ ${SSH_ORIGINAL_COMMAND-} == mini-provider-credentials-v1 ]]; then
  # Native key-service verifies canonical root custody and current signed owner.
  exec "$mini" key-service --config "$frame/etc/mini/provider-service.json"
fi
exec "$lib/mini-shell-ssh" "$@"
