-- generated by scripts/gen-storylaw.py from `mini story-law --table table`: the law on each
-- player's cell, one clause per line, each as the Host renders it in a refusal; {S} is the player.
-- clause 0: management
any [ verb == read, verb == write ];
-- clause 1: mover
any [ subject == {S}, not (verb == write) ];
-- clause 2: turn
any [ field 1 delta == 1, not (verb == write) ];
-- clause 3: exits
any [ field 0 delta == 0, all [ field 0 before == 0, field 0 == 1 ], all [ field 0 before == 1, field 0 == 2 ], all [ field 0 before == 1, field 0 == 3 ], all [ field 0 before == 3, field 0 == 4 ], not (verb == write) ];
-- clause 4: needs key (exit 1 -> 3)
any [ not (all [ field 0 before == 1, field 0 == 3 ]), field 2 before == 1, not (verb == write) ];
-- clause 5: here key (scene 1)
any [ field 2 delta == 0, all [ field 0 before == 1, field 0 delta == 0 ], not (verb == write) ];
-- clause 6: once key
any [ field 2 delta == 0, all [ field 2 before == 0, field 2 == 1 ], not (verb == write) ];
-- clause 7: progress
any [ not (field 0 delta == 0), not (field 2 delta == 0), not (verb == write) ]
