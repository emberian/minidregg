# story: a map (index), chapters (a text that only grows), scenes (a stream the story is told in) and a cast the room writes
#
# The same shape as every room template: the lines you would type, run in
# order as you with $ROOM and $ME bound (room template show workroom says
# more). For a story with rules (scenes a player moves through, a GM), see
# `story new NAME --from story/tale` (deploy/shell/templates/story/).

room new $ROOM --law open

# The map: everyone reads it, only you write it, and it only grows.
doc new $ROOM/index 'any [ not (verb == write), all [ subject == $ME, slot "content/atom-edits" == 0, slot "content/tombstones" == 0 ] ]' --in $ROOM

# The chapters, as written: no line edited, none struck.
doc new $ROOM/chapters note --in $ROOM

# Where the story is told, one entry at a time.
create $ROOM/scenes stream open --in $ROOM

# Who is in it: a draft anyone holding write in the room edits.
doc new $ROOM/cast draft --in $ROOM

doc append $ROOM-map $ROOM/index 'story $ROOM: chapters only grow, scenes is where it is told, cast is who is in it'
submit $ROOM-map
doc link $ROOM-map-chapters $ROOM/index $ROOM/chapters
submit $ROOM-map-chapters
doc link $ROOM-map-scenes $ROOM/index $ROOM/scenes
submit $ROOM-map-scenes
doc link $ROOM-map-cast $ROOM/index $ROOM/cast
submit $ROOM-map-cast
doc link $ROOM-chapters-cast $ROOM/chapters $ROOM/cast
submit $ROOM-chapters-cast
