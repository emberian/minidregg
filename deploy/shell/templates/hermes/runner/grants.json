{
  "type": "mini-hermes-role-grants-v2",
  "role": "runner",
  "placeholders": {
    "{ROOM}": "the room given to summon",
    "{FOUNDER}": "the summoner, the room's founder",
    "{H}": "Hermes's subject"
  },
  "room": ["observe", "append"],
  "docs": [],
  "each": {
    "outputs": {"verbs": ["observe", "mutate"], "from": "the program's `- **Outputs**` line"},
    "inputs": {"verbs": ["observe"], "from": "the program's `- **Inputs**` line"}
  },
  "program": {"name": "{ROOM}-hermes-runner", "law": "any [ not (verb == write), subject == {FOUNDER} ]"}
}
