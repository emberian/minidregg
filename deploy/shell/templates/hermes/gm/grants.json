{
  "type": "mini-hermes-role-grants-v2",
  "role": "gm",
  "for": "MUD-GM: `summon STORY as gm` refuses on this branch; the story verbs (P-STORY) own the state and scene cells this role writes",
  "placeholders": {
    "{STORY}": "the story room name given to summon",
    "{FOUNDER}": "the story's founder",
    "{H}": "Hermes's subject",
    "{N}": "each scene number in story.json",
    "{S}": "each invited player's subject"
  },
  "room": ["observe", "append"],
  "docs": [
    {"name": "{STORY}-state", "verbs": ["observe", "mutate"]}
  ],
  "each": {
    "scenes": {"name": "{STORY}-scene-{N}", "verbs": ["observe", "mutate"], "from": "story.json scenes"},
    "players": {"name": "{STORY}-player-{S}", "verbs": ["observe"], "from": "the invited players"}
  },
  "relaw": ["state", "scene"],
  "program": {"name": "{STORY}-hermes-gm", "law": "any [ not (verb == write), subject == {FOUNDER} ]"}
}
