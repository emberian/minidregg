#!/bin/bash
# SSH forced command: one authorized key = one participant session.
# The connecting key is bound to exactly one workspace and one session home by
# the authorized_keys line that names this wrapper; the friend cannot choose
# either. SSH_ORIGINAL_COMMAND, when present, is handed to `mini shell` as one
# line in the shell's own word syntax. It never reaches a system shell.
#
#   ssh -t friend@host              interactive (prompt, Tab completion)
#   ssh friend@host 'read shared'   one verb; exit code is the verb's
#   ssh -T friend@host < script     script mode; stops at the first failure
#
# This is the deployed wrapper (the box installs it from the candidate, so it and `mini` come
# from one tree). A one-verb session runs two processes, this shell and `mini`: everything below
# reads files with the shell's own `read`, never a helper process.
set -euo pipefail
if [[ $# -ne 6 ]]; then
  echo 'usage: mini-shell-ssh ABS_MINI ABS_HOST ABS_CONFIG ABS_SOCKET ABS_WORKSPACE ABS_HOME' >&2
  exit 64
fi
for path in "$@"; do
  [[ $path == /* ]] || { echo 'mini-shell-ssh paths must be absolute' >&2; exit 64; }
done
mini=$1 host=$2 config=$3 socket=$4 workspace=$5 home=$6
[[ -x $mini ]] || { echo 'mini client is not executable' >&2; exit 66; }
umask 077
# The box's consent mode for hosted sessions: /etc/mini/session-consent (root 0644, one word).
# `thin` sets MINI_THIN_CONSENT=1, the client's thin consent path (no Store replay); used where
# the operator runs both the Host and the hosted shell. Absent or `full`: full-peer consent.
# Remote and bring-your-own clients never read this file.
consent_mode=
if [[ -r /etc/mini/session-consent ]]; then read -r consent_mode </etc/mini/session-consent || true; fi
case ${consent_mode-} in
  thin) export MINI_THIN_CONSENT=1 ;;
  ''|full) unset MINI_THIN_CONSENT ;;
  *) echo "mini-shell-ssh: /etc/mini/session-consent must be thin or full" >&2; exit 78 ;;
esac
# Single tenancy (every hosted session runs as one account against the box's one pinned config):
# /etc/mini/session-residents (root 0644, one absolute path to a directory that account owns, 0700)
# gives every session the same resident directory, so the box runs ONE consent provider and ONE
# codec Host for all of them instead of one each (`mini_sdk::consent::serve_resident_kind`). Absent:
# each session's residents live under its own HOME. Never set it under split tenancy: there each
# member is its own account and its residents are its own.
if [[ -r /etc/mini/session-residents ]]; then
  read -r residents </etc/mini/session-residents || true
  [[ ${residents-} == /* ]] || { echo 'mini-shell-ssh: /etc/mini/session-residents must name an absolute directory' >&2; exit 78; }
  export MINI_CONSENT_ANCHOR_DIR=$residents
fi
# The client retains consent anchors under $HOME/.mini or MINI_CONSENT_ANCHOR_DIR. sshd sets HOME;
# a root-side caller that starts this through `env -i` (the door processor's sponsor credit read,
# runuser -u mini-core) sets neither, and the client then refuses. Without either, the anchors live
# in the session home this script was given, which its caller already owns.
if [[ -z ${HOME-} && -z ${MINI_CONSENT_ANCHOR_DIR-} ]]; then
  export MINI_CONSENT_ANCHOR_DIR="$home/.mini/consent-anchors"
fi
# Delegated full consent (split tenancy; mini-consent@NAME.socket, rendered per hosted member): a
# member's client cannot read the operator's Store to replay it, so it asks the operator's worker
# over HOME/consent/peer.sock. The client pins the listener (systemd's, uid 0), the consent
# executable and the pinned config by sha256; the worker computes the same pins from the same
# files. The ship renders both digests once into HOME/consent/peer.pins (root 0644, one line:
# `CONSENT_SHA256 CONFIG_SHA256`, 64 lowercase hex each), so no command hashes the 190 MB
# provider. A box without that file (shipped before it existed) hashes here, as it always did.
if [[ -S $home/consent/peer.sock ]]; then
  export MINI_CONSENT_SOCKET="$home/consent/peer.sock" MINI_CONSENT_PEER_UID=0
  # The client takes a durable consent selection only with all three of these beside the socket.
  MINI_CONSENT_HOST="${mini%/*}/minidregg-client-consent"
  export MINI_LOCAL_HOST="$host" MINI_CONSENT_HOST MINI_CONSENT_CONFIG="$config"
  pins=$home/consent/peer.pins
  if [[ -r $pins ]]; then
    read -r MINI_CONSENT_SHA256 MINI_CONSENT_CONFIG_SHA256 _ <"$pins" || true
    hex='^[0-9a-f]{64}$'
    [[ ${MINI_CONSENT_SHA256-} =~ $hex && ${MINI_CONSENT_CONFIG_SHA256-} =~ $hex ]] \
      || { echo "mini-shell-ssh: $pins must hold two sha256 digests" >&2; exit 78; }
  else
    read -r MINI_CONSENT_SHA256 _ < <(sha256sum "$MINI_CONSENT_HOST")
    read -r MINI_CONSENT_CONFIG_SHA256 _ < <(sha256sum "$config")
  fi
  export MINI_CONSENT_SHA256 MINI_CONSENT_CONFIG_SHA256
fi
# At most two calls per member at once; `mini shell --call-slots` holds one of two locks in the
# member's home for the call's life and refuses the third by name (exit 75). The client reads the
# candidate it runs from off its own path (`chat.rs` `running_candidate`).
args=(shell --socket "$socket" --host "$host" --config "$config"
  --workspace "$workspace" --home "$home" --call-slots "$home/.call-slots")
if [[ -n ${SSH_ORIGINAL_COMMAND-} ]]; then
  exec "$mini" "${args[@]}" --line "$SSH_ORIGINAL_COMMAND"
fi
# Interactive login only: the motd, then the re-genesis notice ship.sh --regenesis writes (and
# ember deletes when it is old news), go to stderr before the prompt. Both live beside this script.
lib=${BASH_SOURCE[0]%/*}
for note in "$lib/motd.txt" "$lib/notice.txt"; do
  [[ -r $note ]] && printf '%s\n' "$(<"$note")" >&2
done
exec "$mini" "${args[@]}"
