# /etc/mini/discord.env — root:root 0600. Read by systemd for mini-discord.service.
# Neither value below is a secret (Discord publishes the public key), but they
# stay off argv and out of the unit so the unit is the same on every box.
MINI_DISCORD_APPLICATION_ID=<the application id, from the Developer Portal>
MINI_DISCORD_PUBLIC_KEY=<the application public key, 64 hex characters>
# The workhorse's private address; the anchor's Caddy proxies to it. Never 0.0.0.0.
MINI_DISCORD_LISTEN=10.10.1.10:8793
MINI_DISCORD_ROSTER=/etc/mini/discord-roster.json
MINI_DISCORD_SPOOL=/run/mini-discord
# The ssh entrance's forced command and the first four arguments
# render-authorized-keys.sh gives it.
MINI_SHELL_WRAPPER=/usr/local/lib/mini/mini-shell-ssh
MINI_CLIENT=/var/lib/mini/candidate/current/bin/mini
MINI_HOST=/var/lib/mini/candidate/current/bin/minidregg-host
MINI_CONFIG=/var/lib/mini/store/node/deployment/pinned-config.json
MINI_SOCKET=/var/lib/mini/store/node/public/mini.sock
# render-authorized-keys.sh's session layout.
MINI_SESSIONS=/var/lib/mini/sessions
MINI_SPONSOR=ember
MINI_SPONSOR_WORKSPACE=/var/lib/mini/store/node/sponsor
