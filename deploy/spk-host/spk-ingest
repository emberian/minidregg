#!/bin/bash
# Operator materialization in a bounded user unit; no host-root package parser.
set -euo pipefail
umask 077
[[ $# -ge 2 && $1 == --root ]] || { echo 'usage: spk-ingest --root SPK_ROOT [--import-profile PROFILE] [--scratch DIR] HOST HOST_SHA256 INBOX_SPK APP_UID' >&2; exit 2; }
base=$2
shift 2
profile=standard-v1
if [[ ${1:-} == --import-profile ]]; then
  [[ $# -ge 2 ]] || exit 2
  profile=$2
  shift 2
fi
# The operator's spool directory (broker config ingestScratch): a disk with room for the profile's
# decoded bound, so the intake does not depend on the free space of the SPK store's filesystem.
scratch=
if [[ ${1:-} == --scratch ]]; then
  [[ $# -ge 2 && $2 == /* && $2 != */ && $2 != *//* && $2 != */../* && $2 != */./* ]] || exit 2
  scratch=$2
  shift 2
fi
[[ $# == 4 ]] || { echo 'SPK ingest expects HOST HOST_SHA256 INBOX_SPK APP_UID' >&2; exit 2; }
# Only the operator broker config selects this profile. Package metadata and
# app Ingest requests cannot alter the intake budget. Parsing remains unprivileged.
case $profile in
  standard-v1|market-large-v1|operator-appliance-v1) ;;
  *) echo 'unknown SPK import profile' >&2; exit 2 ;;
esac
host_binary=$1 expected=$2 package=$3 app_uid=$4
[[ $base == /* && $base != */ && $base != */../* && $base != */./* && $base != *//* && $base == */spk ]] || {
  echo 'SPK root must be a canonical per-store spk path' >&2; exit 2;
}
store_id=$(basename "$(dirname "$base")")
[[ $store_id =~ ^[0-9a-f]{16}$ && $expected =~ ^[0-9a-f]{64}$ && $app_uid =~ ^[1-9][0-9]*$ ]] || {
  echo 'SPK store namespace or ingest arguments invalid' >&2; exit 2;
}
[[ $(realpath -m -- "$base") == "$base" ]] || {
  echo 'SPK store namespace must be canonical and not symlinked' >&2; exit 1;
}
[[ $EUID != 0 ]] || { echo 'SPK ingest requires the store operator, not root' >&2; exit 2; }
[[ $package == "$base/inbox/"* && $(dirname "$package") == "$base/inbox" && ! -L $package ]] || exit 2
[[ $(sha256sum "$host_binary" | cut -d ' ' -f1) == "$expected" ]] || { echo 'SPK ingest binary pin differs' >&2; exit 1; }
# The profile's bounds come from the pinned Host (spk-host import-limits): the raw and decoded
# limits, and a wall clock that scales with this package's size up to the profile's cap.
read -r raw_limit file_limit seconds < <("$host_binary" import-limits "$profile" "$(stat -c '%s' "$package")") || exit 2
[[ $raw_limit =~ ^[0-9]+$ && $file_limit =~ ^[0-9]+$ && $seconds =~ ^[0-9]+$ ]] || { echo 'SPK import limits unavailable' >&2; exit 2; }
[[ $(stat -c '%u:%a' "$package") == "$EUID:600" && $(stat -c '%s' "$package") -le $raw_limit ]] || exit 2
if [[ -n $scratch ]]; then
  [[ $(realpath -m -- "$scratch") == "$scratch" && -d $scratch && ! -L $scratch && $(stat -c '%u:%a' "$scratch") == "$EUID:700" ]] || {
    echo 'SPK ingest scratch must be a canonical operator-owned 0700 directory' >&2; exit 1; }
fi
for dir in "$base" "$base/inbox" "$base/packages"; do
  [[ -d $dir && ! -L $dir && $(stat -c '%u' "$dir") == "$EUID" ]] || { echo 'SPK namespace custody differs' >&2; exit 1; }
  (( (8#$(stat -c '%a' "$dir") & 8#022) == 0 )) || exit 2
done
exec 9>>"$base/.ingest.lock"
flock -n 9 || { echo 'another SPK ingest is active' >&2; exit 1; }
# The lock above is held, so no other ingest of this store is running: a `.spk-stage-*` directory
# here was left by an ingest that was killed mid-materialization (its RuntimeMaxSec expired, the
# box ran out of memory, the box lost power). Staging is mode 0555 once sealed, so it is made
# writable before it is removed. Without this sweep one timed-out install leaves a stage behind,
# and every later install of the world "succeeds" and then fails the check at the end of this
# script with `SPK staging remains after unit success`. (e89fe7b8b tables, 2026-10-28: OrgTodo
# timed out, then SandCal, HackerCMS and HakyllCMS failed that way in the same worlds.)
while IFS= read -r -d '' stale; do
  chmod -R u+rwX -- "$stale" && rm -rf -- "$stale"
  echo "removed stale SPK staging left by a killed ingest: $(basename "$stale")" >&2
done < <(find "$base/packages" -mindepth 1 -maxdepth 1 -type d -name '.spk-stage-*' -print0)
input_sha=$(sha256sum "$package" | cut -d ' ' -f1)
unit=mini-spk-ingest-s$store_id-$$
systemd-run --user --unit="$unit" --wait --pipe --collect -p Type=exec \
  -p NoNewPrivileges=yes -p MemoryMax=2G -p MemorySwapMax=0 -p CPUQuota=100% \
  -p TasksMax=16 -p RuntimeMaxSec="$seconds" -p LimitFSIZE="$file_limit" -p KillMode=control-group \
  -- "$host_binary" materialize --import-profile "$profile" ${scratch:+--scratch "$scratch"} "$package" "$base/packages" "$app_uid"
installed=$base/packages/sha256-$input_sha
[[ $(sha256sum "$package" | cut -d ' ' -f1) == "$input_sha" && -d $installed/root && ! -L $installed/root ]] || { echo 'ingest exact image differs' >&2; exit 1; }
[[ $(sha256sum "$installed/package.spk" | cut -d ' ' -f1) == "$input_sha" ]] || exit 1
if find "$installed/root" \( -type f -o -type d \) -perm /022 -print -quit | grep -q . ||
   find "$installed/root" -type f -perm /6000 -print -quit | grep -q . ||
   find "$installed/root" \( -type b -o -type c -o -type p -o -type s \) -print -quit | grep -q .; then
  echo 'published image has writable, privileged, or special-node content' >&2; exit 1
fi
if find "$base/packages" -mindepth 1 -maxdepth 1 -name '.spk-stage-*' -print -quit | grep -q .; then
  echo 'SPK staging remains after unit success' >&2; exit 1
fi
printf 'ingest_verified unit=%s spkSha256=%s image=%s\n' "$unit" "$input_sha" "$installed"
