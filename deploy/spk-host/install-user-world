#!/bin/bash
# The same explicit ROOT SETUP/ROOT CLEANUP entrypoint is used by deployment
# and scratch acceptance. Runtime privilege is confined to the compiled helper.
set -euo pipefail
usage() { echo "usage: $0 install SOURCE_HELPER HELPER_PATH STORE DEPLOYMENT_HEX HOST_HEX OPERATOR_UID SUBUID_START COUNT [CUSTODIAN_SOCKET] | remove STORE HELPER_PATH" >&2; exit 2; }
[[ $EUID == 0 ]] || { echo 'world install requires explicit root setup' >&2; exit 1; }
[[ $# -ge 3 ]] || usage
if [[ $1 == controller-* ]]; then
  # This source installer is the deployment's explicit trusted root entrypoint.
  # Bind its companion to reviewed bytes, not an ambient writable sibling. Read
  # once through a no-follow descriptor and execute the verified byte snapshot.
  exec /usr/bin/python3 -I - "$(dirname -- "$0")/controller-world.py" "$@" <<'PY_CONTROLLER'
import hashlib, os, stat, sys
path = sys.argv.pop(1)
try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(fd, 'rb') as source:
        m = os.fstat(source.fileno())
        if not (stat.S_ISREG(m.st_mode) and m.st_nlink == 1 and
                m.st_uid in (0, int(os.environ.get('SUDO_UID', '0'))) and
                m.st_mode & 0o7022 == 0 and 0 < m.st_size <= 262144):
            raise ValueError('controller setup companion custody refused')
        code = source.read(262145)
    if hashlib.sha256(code).hexdigest() != '11be548f03ce75c56187375cd189a0942c8389a85b088e7b0ddd05e0b6cf3046':
        raise ValueError('controller setup companion code pin differs')
except (OSError, ValueError) as error:
    sys.exit(str(error))
exec(compile(code, path, 'exec'), {'__name__': '__main__', '__file__': path})
PY_CONTROLLER
fi
for mapper in /usr/bin/newuidmap /usr/bin/newgidmap; do
  [[ -f $mapper && ! -L $mapper && -x $mapper && $(stat -c '%u' "$mapper") == 0 ]] || {
    echo 'deployment prerequisite uidmap (newuidmap/newgidmap) missing or not root-owned' >&2; exit 1;
  }
done
action=$1
if [[ $action == install ]]; then
  [[ $# == 9 || $# == 10 ]] || usage
  source_helper=$2 helper=$3 store=$4 deployment=$5 host=$6 op_uid=$7 start=$8 count=$9 custodian_socket=${10:-}
elif [[ $action == remove ]]; then
  [[ $# == 3 ]] || usage
  store=$2 helper=$3
else usage; fi
[[ $store =~ ^[0-9a-f]{16}$ && $helper =~ ^/usr/local/libexec/mini-spk-volume-helper(-[0-9a-f]{16})?$ ]] || usage
registry_dir=/etc/mini-spk-volumes
registry=$registry_dir/$store.json
# A host restricting unprivileged user namespaces ships the profiled bwrap root:hbox 0750
# (docs/evidence/2026-09-27-hermes-upstream-hbox); its execute grants are named ACL entries.
# The operator creates each resident namespace with it and every app identity sandboxes with
# it. Only entries this installer added are ever revoked: per world in $root/bwrap-acl-grants,
# operators in $operator_grants (revoked with the operator's last world).
profiled_bwrap=/usr/local/libexec/mini-grain-bwrap
operator_grants=$registry_dir/bwrap-operator-acl
has_acl_entry() { getfacl -n --omit-header -p -- "$profiled_bwrap" | grep -qx "user:$1:[r-][w-][x-]"; }
rule=/etc/sudoers.d/mini-spk-$store
root=/var/lib/mini-spk-worlds/$store
# Serialize registry/subuid allocation and helper install/removal across worlds.
install -d -o root -g root -m 755 "$registry_dir" /var/lib/mini-spk-worlds /usr/local/libexec
exec 8>/run/mini-spk-world-install.lock
flock -x 8
safe_root_dir() {
  local path=$1 mode
  while :; do
    [[ -d $path && ! -L $path && $(stat -c '%u' "$path") == 0 ]] || { echo "root setup ancestor refused: $path" >&2; exit 1; }
    mode=$(stat -c '%a' "$path")
    (( (8#$mode & 8#022) == 0 )) || { echo "root setup ancestor writable: $path" >&2; exit 1; }
    [[ $path == / ]] && break
    path=$(dirname "$path")
  done
}
safe_root_dir "$registry_dir"
safe_root_dir /var/lib/mini-spk-worlds
safe_root_dir /usr/local/libexec
# A host whose /var/lib/mini-spk-worlds is not on a project-quota filesystem (a plain ext4 root, a
# container's overlay) names a dedicated prjquota-mounted directory in the root-owned one-line file
# $registry_dir/vars-backing. Each world's `vars` is then a bind mount of $backing/<store>, so the
# helper's volumes (deploy/spk-host/VOLUMES.md) live on that filesystem while every other path of the
# world stays where it is. Absent the file, `vars` is a plain directory of the grains root.
vars_backing=
if [[ -e $registry_dir/vars-backing ]]; then
  [[ -f $registry_dir/vars-backing && ! -L $registry_dir/vars-backing && $(stat -c '%u:%a' "$registry_dir/vars-backing") == 0:644 ]] \
    || { echo 'vars-backing custody refused' >&2; exit 1; }
  vars_backing=$(<"$registry_dir/vars-backing")
  [[ $vars_backing == /* && $vars_backing != *$'\n'* ]] && safe_root_dir "$vars_backing" \
    && /usr/bin/mountpoint -q -- "$vars_backing" || { echo "vars-backing $vars_backing is not an absolute mountpoint under root custody" >&2; exit 1; }
fi
# A host whose SPK store sits on a small disk names a scratch root for the intake spools in the root-owned
# one-line file $registry_dir/ingest-scratch (the operator-appliance profile's decoded bound is 20 GiB).
# Each world gets <root>/<store>, owned by its operator, 0700; the broker config's ingestScratch names it.
ingest_scratch_root=
if [[ -e $registry_dir/ingest-scratch ]]; then
  [[ -f $registry_dir/ingest-scratch && ! -L $registry_dir/ingest-scratch && $(stat -c '%u:%a' "$registry_dir/ingest-scratch") == 0:644 ]] \
    || { echo 'ingest-scratch custody refused' >&2; exit 1; }
  ingest_scratch_root=$(<"$registry_dir/ingest-scratch")
  [[ $ingest_scratch_root == /* && $ingest_scratch_root != *$'\n'* ]] && safe_root_dir "$ingest_scratch_root" \
    || { echo "ingest-scratch $ingest_scratch_root is not an absolute directory under root custody" >&2; exit 1; }
fi
release_vars() { # STORE: unmount the world's bind mount and drop its backing directory (empty by then)
  if /usr/bin/mountpoint -q -- "$root/vars"; then umount -- "$root/vars"; fi
  if [[ -n $vars_backing && -d $vars_backing/$1 ]]; then rmdir -- "$vars_backing/$1"; fi
  if [[ -n $ingest_scratch_root && -d $ingest_scratch_root/$1 && ! -L $ingest_scratch_root/$1 ]]; then rm -rf --one-file-system -- "$ingest_scratch_root/$1"; fi
}
if [[ $action == remove ]]; then
  [[ ! -e $root/controller && ! -L $root/controller ]] || {
    echo 'root cleanup refuses allocated controller; use controller-remove first' >&2; exit 1;
  }
  [[ -f $registry && ! -L $registry && $(stat -c '%u:%a' "$registry") == 0:644 ]] || { echo 'root cleanup registry custody refused' >&2; exit 1; }
  [[ $(jq -er .store "$registry") == "$store" && $(jq -er .helper "$registry") == "$helper" ]] || exit 1
  op_uid=$(jq -er .operatorUid "$registry")
  # A volume is a project-quota directory with kernel limits: removing the tree alone would leave
  # the limits behind, so every volume is destroyed through the helper first (world-down does).
  if compgen -G "$root/volumes/*.conf" >/dev/null; then
    echo 'root cleanup refuses a world with registered volumes; destroy them through the helper first' >&2; exit 1
  fi
  revoked=
  if [[ -f $root/bwrap-acl-grants ]]; then
    while read -r uid; do
      [[ $uid =~ ^[0-9]+$ ]] || continue
      setfacl -x "u:$uid" -- "$profiled_bwrap"; revoked+="$uid,"
    done <"$root/bwrap-acl-grants"
  fi
  rm -f "$rule" "$registry"
  release_vars "$store"
  rm -rf -- "$root"
  operator_kept=0
  for registered in "$registry_dir"/*.json; do
    [[ -e $registered ]] || continue
    [[ $(jq -er .operatorUid "$registered") != "$op_uid" ]] || operator_kept=1
  done
  if [[ $operator_kept == 0 && -f $operator_grants ]] && grep -qx "$op_uid" "$operator_grants"; then
    setfacl -x "u:$op_uid" -- "$profiled_bwrap"; revoked+="$op_uid,"
    grep -vx "$op_uid" "$operator_grants" >"$operator_grants.new" || true
    mv -f "$operator_grants.new" "$operator_grants"
  fi
  # A shared one-shot helper is removed only after its last registry is gone.
  used=0
  for registered in "$registry_dir"/*.json; do
    [[ -e $registered ]] || continue
    [[ $(jq -er .helper "$registered") != "$helper" ]] || used=1
  done
  if [[ $used == 0 ]]; then rm -f "$helper"; fi
  [[ ! -e $rule && ! -e $registry && ! -e $root ]] || { echo 'root cleanup removal assertion failed' >&2; exit 1; }
  printf 'ROOT CLEANUP store=%s removed_registry=yes removed_sudoers=yes helper_remaining=%s bwrap_acl_revoked=%s\n' "$store" "$used" "${revoked:-none}"
  exit 0
fi
[[ $deployment =~ ^[0-9a-f]{64}$ && $host =~ ^[0-9a-f]{64}$ && $op_uid =~ ^[1-9][0-9]*$ && $start =~ ^[1-9][0-9]*$ && $count =~ ^[1-9][0-9]*$ ]] || usage
# A world behind a volume custodian (a user-namespaced container, uids 0..65535) registers app uids
# from inside that namespace and names the custodian's socket; any other world keeps the subordinate floor.
if [[ -n $custodian_socket ]]; then
  [[ $custodian_socket =~ ^/[A-Za-z0-9._/-]+$ && $custodian_socket != *..* && $custodian_socket != *//* ]] || usage
  (( start >= 1 && count >= 2 && count <= 64 )) || usage
else
  (( start >= 65536 && count >= 2 && count <= 64 )) || usage
fi
[[ ! -e $registry && ! -L $registry && ! -e $rule && ! -e $root && ! -L $root ]] || { echo 'root setup refuses existing world' >&2; exit 1; }
entry=$(getent passwd "$op_uid")
op_user=${entry%%:*}
op_gid=$(printf '%s\n' "$entry" | cut -d: -f4)

# One fail-closed allocator checks every root registry and permanent controller
# reservation while inheriting this exact held global lock (fd8).
# A START already taken by another world or a controller account moves to the next free
# range of the delegation; the registry and the ROOT SETUP line carry the allocated one.
allocation=$("$0" controller-check-app-allocation "$store" "$helper" "$op_uid" "$start" "$count" ${custodian_socket:+custodian})
printf '%s\n' "$allocation"
[[ $allocation =~ \"appRangeChecked\":\ \[([0-9]+),\ ([0-9]+)\] ]] || { echo 'app allocation reply malformed' >&2; exit 1; }
(( BASH_REMATCH[2] - BASH_REMATCH[1] == count )) || { echo 'app allocation count differs' >&2; exit 1; }
start=${BASH_REMATCH[1]}

[[ -f $source_helper && ! -L $source_helper && -x $source_helper ]] || usage
created_helper=0
granted=() granted_operator=0
rule_tmp=
rollback() {
  local result=$?
  trap - EXIT
  [[ -z $rule_tmp ]] || rm -f "$rule_tmp"
  local uid
  for uid in "${granted[@]}"; do setfacl -x "u:$uid" -- "$profiled_bwrap" || true; done
  if [[ $granted_operator == 1 ]]; then
    setfacl -x "u:$op_uid" -- "$profiled_bwrap" || true
    grep -vx "$op_uid" "$operator_grants" >"$operator_grants.new" || true; mv -f "$operator_grants.new" "$operator_grants"
  fi
  rm -f "$rule" "$registry"
  release_vars "$store" || true
  rm -rf -- "$root"
  [[ $created_helper == 0 ]] || rm -f "$helper"
  exit "$result"
}
trap rollback EXIT
sha=$(sha256sum "$source_helper" | cut -d ' ' -f1)
if [[ -e $helper || -L $helper ]]; then
  [[ -f $helper && ! -L $helper && $(stat -c '%u:%a' "$helper") == 0:755 && $(sha256sum "$helper" | cut -d ' ' -f1) == "$sha" ]] || { echo 'root setup refuses helper replacement' >&2; exit 1; }
else
  created_helper=1
  install -o root -g root -m 755 -- "$source_helper" "$helper"
fi
[[ $(sha256sum "$helper" | cut -d ' ' -f1) == "$sha" ]] || { echo 'installed helper pin differs' >&2; exit 1; }
install -d -o root -g root -m 755 "$root" "$root/attest"
install -d -o root -g root -m 700 "$root/volumes" "$root/volume-custody"
install -o root -g root -m 600 /dev/null "$root/volume-custody/verbs.lock"
install -d -o root -g root -m 711 "$root/vars"
if [[ -n $vars_backing ]]; then
  install -d -o root -g root -m 711 "$vars_backing/$store"
  mount --bind -- "$vars_backing/$store" "$root/vars"
  # The bind shows the backing filesystem's type: refuse here, by name, rather than at the first volume.
  case $(stat -f -c '%T' "$root/vars") in ext2/ext3|ext4|xfs) ;; *) echo "vars-backing $vars_backing is not ext4 or xfs" >&2; exit 1;; esac
fi
install -d -o "$op_uid" -g "$op_gid" -m 700 "$root/broker" "$root/$store" "$root/runtime-$store"
install -d -o "$op_uid" -g "$op_gid" -m 755 "$root/spk" "$root/spk/packages"
install -d -o "$op_uid" -g "$op_gid" -m 700 "$root/spk/inbox"
[[ -z $ingest_scratch_root ]] || install -d -o "$op_uid" -g "$op_gid" -m 700 "$ingest_scratch_root/$store"
if [[ -e $profiled_bwrap ]]; then
  [[ -f $profiled_bwrap && ! -L $profiled_bwrap && $(stat -c '%u' "$profiled_bwrap") == 0 ]] || { echo "root setup refuses $profiled_bwrap custody" >&2; exit 1; }
  install -o root -g root -m 600 /dev/null "$root/bwrap-acl-grants"
  if ! has_acl_entry "$op_uid"; then
    setfacl -m "u:$op_uid:r-x" -- "$profiled_bwrap"; granted_operator=1
    printf '%s\n' "$op_uid" >>"$operator_grants"; chmod 600 "$operator_grants"
  fi
  for ((uid=start; uid<start+count; uid++)); do
    has_acl_entry "$uid" && continue
    setfacl -m "u:$uid:r-x" -- "$profiled_bwrap"; granted+=("$uid")
    printf '%s\n' "$uid" >>"$root/bwrap-acl-grants"
  done
fi
printf 'deployment_id=%s\nhost_id=%s\n' "$deployment" "$host" >"$root/host-identity"
chmod 600 "$root/host-identity"
jq -n --arg store "$store" --arg deployment "$deployment" --arg host "$host" --arg root "$root" --arg helper "$helper" --arg sha "$sha" \
  --argjson uid "$op_uid" --argjson gid "$op_gid" --argjson start "$start" --argjson count "$count" --arg custodian "$custodian_socket" \
  '{protocol:"mini-spk-volume-registry-v1",store:$store,deploymentId:$deployment,hostId:$host,grainsRoot:$root,operatorUid:$uid,operatorGid:$gid,appUids:[range($start;$start+$count)],helper:$helper,helperSha256:$sha} + (if $custodian == "" then {} else {custodianSocket:$custodian} end)' >"$registry"
chmod 644 "$registry"
# Numeric uid, precisely one binary. JSON decode and the registry enforce args.
rule_tmp=$(mktemp /etc/sudoers.d/.mini-spk.XXXXXXXX)
printf '#%s ALL=(root) NOPASSWD: %s\n' "$op_uid" "$helper" >"$rule_tmp"
chmod 440 "$rule_tmp"
visudo -cf "$rule_tmp"
install -o root -g root -m 440 "$rule_tmp" "$rule"
rm "$rule_tmp"
trap - EXIT
bwrap_acl=${granted[*]:-none}; [[ $granted_operator == 0 ]] || bwrap_acl="$op_uid $bwrap_acl"
printf 'ROOT SETUP store=%s caller_uid=%s helper=%s subuid_start=%s count=%s bwrap_acl_granted=%s\n' "$store" "$op_uid" "$helper" "$start" "$count" "${bwrap_acl// /,}"
