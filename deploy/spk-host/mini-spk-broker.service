[Unit]
Description=Mini SPK root broker (typed grain verbs for the Store operator)
Documentation=file:///usr/local/share/doc/minidregg/spk-host/README.md
After=local-fs.target
Before=mini-store.service

[Service]
Type=simple
# Root by design: it renders unit files, loop-mounts volumes and publishes
# package images. Its surface is the typed verb set, answered only for the
# operator UID. No mount namespace options: its mounts must be the host's.
ExecStart=/usr/local/libexec/minidregg/mini-spk-broker serve /etc/mini/spk-broker.json
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
