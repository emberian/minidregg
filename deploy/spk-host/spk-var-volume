#!/usr/bin/env bash
# Provision a bounded, persistent ext4 /var for one SPK application resource.
# This is a privileged operator command; it never starts an application.
set -euo pipefail

usage() {
  echo 'usage: spk-var-volume --root GRAINS_ROOT create STORE RESOURCE_ID APP_UID SIZE_MIB SOURCE_VOLUME_HEX
       spk-var-volume --root GRAINS_ROOT create-from STORE RESOURCE_ID APP_UID SIZE_MIB SOURCE_VOLUME_HEX IMAGE
       spk-var-volume --root GRAINS_ROOT verify STORE RESOURCE_ID APP_UID SIZE_MIB
       spk-var-volume --root GRAINS_ROOT attest STORE RESOURCE_ID' >&2
  exit 2
}

# Invoked by mini-spk-broker (root) with its configured grains root. Every
# name is <store>-<resource>: two Stores on one host never share a volume.
(( $# >= 5 )) && [[ $1 == --root ]] || usage
root=$2
shift 2
action=$1 store=$2 resource=$3
case $action in
  create) (( $# == 6 )) || usage ;;
  create-from) (( $# == 7 )) || usage ;;
  verify) (( $# == 5 )) || usage ;;
  attest) (( $# == 3 )) || usage ;;
  *) usage ;;
esac
[[ $root =~ ^/[A-Za-z0-9_./-]+$ && $root != */ && $root != *//* && $root != */./* && $root != */../* ]] || usage
[[ $store =~ ^[0-9a-f]{16}$ ]] || usage
[[ $resource =~ ^[1-9][0-9]{0,17}$ ]] || usage
if [[ $action == create || $action == create-from ]]; then
  volume_id=$6
  [[ $volume_id =~ ^[0-9a-f]{64}$ ]] || usage
fi
if [[ $action == create-from ]]; then
  source_image=$7
  [[ $source_image == "$root/volumes/.import-$store-$resource" ]] || usage
fi

# An imported image is operator-supplied bytes: nothing signs it, and its
# SHA-256 is the one the requester named. It is never mounted. e2fsprogs
# parses it in userspace, as the application's own uid with no privileges
# (untrusted_reader), and copies its file tree into a filesystem this script
# made itself (mkfs.ext4) and mounted; that copy is bounded by the class size
# because it is written into the mounted fresh filesystem. Device nodes,
# sockets and FIFOs are not copied (debugfs rdump skips them); symlinks are
# recreated, never followed. $1 holds untrusted.ext4 (reader-readable), $2 is
# the destination directory (reader-writable). Errors of single entries are
# logged to $3; an image that is not a clean ext4 is refused before any copy.
import_untrusted_tree() {
  local stage=$1 dest=$2 log=$3 type
  type=$(cd -- "$stage" && "${untrusted_reader[@]}" /usr/sbin/blkid -p -s TYPE -o value -- untrusted.ext4) || type=
  [[ $type == ext4 ]] || { echo 'import image is not ext4' >&2; return 1; }
  (cd -- "$stage" && "${untrusted_reader[@]}" /usr/sbin/e2fsck -fn -- untrusted.ext4) >/dev/null 2>&1 || {
    echo 'import image fails e2fsck' >&2; return 1;
  }
  (cd -- "$stage" && "${untrusted_reader[@]}" /usr/sbin/debugfs -R "rdump / $dest" untrusted.ext4) \
    >> "$log" 2>&1 || { echo 'import tree copy failed' >&2; return 1; }
}

(( EUID == 0 )) || { echo 'spk-var-volume requires root' >&2; exit 1; }

name=$store-$resource
config_dir=$root/volumes
config=$config_dir/$name.conf
if [[ $action == attest ]]; then
  app_uid=0 size_mib=0
else
  app_uid=$4 size_mib=$5
fi

image_dir=$root/volumes
mount_dir=$root/vars
image=$image_dir/$name.ext4
target=$mount_dir/$name

safe_dir() {
  local path=$1 mode=$2 actual allow_create=${3:-false}
  if [[ ! -e $path && ! -L $path ]]; then
    [[ $action == create || $action == create-from || $allow_create == true ]] || {
      echo "missing $path" >&2; exit 1;
    }
    install -d -o root -g root -m "$mode" -- "$path"
  fi
  [[ -d $path && ! -L $path ]] || { echo "unsafe directory $path" >&2; exit 1; }
  [[ $(stat -c '%u' -- "$path") == 0 ]] || { echo "non-root owner $path" >&2; exit 1; }
  actual=$(stat -c '%a' -- "$path")
  [[ $actual == "$mode" ]] || { echo "unexpected mode $path: $actual" >&2; exit 1; }
}

# Every ancestor of the grains root is root-owned and not group/world
# writable; below it, the private images and the task-traversable mounts.
ancestor=
IFS=/ read -r -a parts <<< "${root#/}"
for part in "${parts[@]}"; do
  ancestor=$ancestor/$part
  [[ -d $ancestor && ! -L $ancestor ]] || { echo "unsafe ancestor $ancestor" >&2; exit 1; }
  [[ $(stat -c '%u' -- "$ancestor") == 0 ]] || { echo "non-root ancestor $ancestor" >&2; exit 1; }
  (( ($(stat -c '0%a' -- "$ancestor") & 022) == 0 )) || { echo "writable ancestor $ancestor" >&2; exit 1; }
done
safe_dir "$root" 755
safe_dir "$image_dir" 700
safe_dir "$mount_dir" 711
safe_dir "$root/attest" 755 true
handoff_dir=$root/attest
lock=$handoff_dir/$name.lock
exec 9> "$lock"
chmod 600 -- "$lock"
/usr/bin/flock -x 9
if [[ $action == create || $action == create-from || $action == attest ]]; then
  identity=$root/host-identity
  [[ -f $identity && ! -L $identity ]] || { echo 'protected host identity absent' >&2; exit 1; }
  [[ $(stat -c '%u:%a:%h' -- "$identity") == '0:600:1' ]] || {
    echo 'protected host identity drift' >&2; exit 1;
  }
  identity_before=$(stat -c '%d:%i:%s:%Y:%Z' -- "$identity")
  mapfile -t identity_lines < "$identity"
  [[ $(stat -c '%d:%i:%s:%Y:%Z' -- "$identity") == "$identity_before" ]] || {
    echo 'protected host identity changed while read' >&2; exit 1;
  }
  (( ${#identity_lines[@]} == 2 )) || { echo 'protected host identity malformed' >&2; exit 1; }
  [[ ${identity_lines[0]} =~ ^deployment_id=([0-9a-f]{64})$ ]] || { echo 'deployment identity malformed' >&2; exit 1; }
  deployment_id=${BASH_REMATCH[1]}
  [[ ${identity_lines[1]} =~ ^host_id=([0-9a-f]{64})$ ]] || { echo 'host identity malformed' >&2; exit 1; }
  host_id=${BASH_REMATCH[1]}
fi

if [[ $action == attest ]]; then
  [[ -f $config && ! -L $config ]] || { echo 'registered volume config absent' >&2; exit 1; }
  [[ $(stat -c '%u:%a:%h' -- "$config") == '0:600:1' ]] || {
    echo 'registered volume config identity drift' >&2; exit 1;
  }
  config_identity_before=$(stat -c '%d:%i:%s:%Y:%Z' -- "$config")
  mapfile -t config_lines < "$config"
  [[ $(stat -c '%d:%i:%s:%Y:%Z' -- "$config") == "$config_identity_before" ]] || {
    echo 'registered volume config changed while read' >&2; exit 1;
  }
  (( ${#config_lines[@]} == 5 )) || { echo 'registered volume config malformed' >&2; exit 1; }
  [[ ${config_lines[0]} =~ ^app_uid=([1-9][0-9]{0,9})$ ]] || { echo 'registered app UID malformed' >&2; exit 1; }
  app_uid=${BASH_REMATCH[1]}
  [[ ${config_lines[1]} =~ ^size_mib=([1-9][0-9]{0,5})$ ]] || { echo 'registered quota malformed' >&2; exit 1; }
  size_mib=${BASH_REMATCH[1]}
  [[ ${config_lines[2]} == "deployment_id=$deployment_id" &&
     ${config_lines[3]} == "host_id=$host_id" ]] || {
    echo 'volume registration belongs to another deployment or host' >&2; exit 1;
  }
  [[ ${config_lines[4]} =~ ^volume_id=([0-9a-f]{64})$ ]] || {
    echo 'registered source volume ID malformed' >&2; exit 1;
  }
  volume_id=${BASH_REMATCH[1]}
fi
[[ $app_uid =~ ^[1-9][0-9]{0,9}$ ]] || usage
[[ $size_mib =~ ^[1-9][0-9]{0,5}$ ]] || usage
(( size_mib >= 64 && size_mib <= 16384 )) || usage
# The compiled helper has validated this uid against the root-owned registry.
bytes=$(( size_mib * 1024 * 1024 ))

if [[ $action == create || $action == create-from ]]; then
  [[ ! -e $config && ! -L $config ]] || { echo 'volume registration already exists' >&2; exit 1; }
  [[ ! -e $image && ! -L $image && ! -e $target && ! -L $target ]] || {
    echo 'resource image or mountpoint already exists; refusing overwrite' >&2; exit 1;
  }
  umask 077
  app_gid=$app_uid
  [[ $app_gid =~ ^[1-9][0-9]{0,9}$ ]] || { echo 'app primary group refused' >&2; exit 1; }
  stage=
  untrusted=
  image_tmp=$(mktemp "$image_dir/.image.XXXXXXXX")
  fresh=0
  cleanup_create() {
    local code=$?
    rm -f -- "$image_tmp"
    [[ -z $untrusted ]] || rm -f -- "$untrusted"
    [[ -z $stage ]] || rm -rf -- "$stage"
    # A failed create leaves no unregistered image or mount behind.
    if (( code != 0 && fresh == 1 )); then
      if /usr/bin/findmnt -n -M "$target" >/dev/null; then /usr/bin/umount -- "$target"; fi
      if [[ -d $target ]]; then rmdir -- "$target"; fi
      rm -f -- "$image"
    fi
  }
  trap cleanup_create EXIT
  if [[ $action == create-from ]]; then
    untrusted=$source_image
    [[ -f $untrusted && ! -L $untrusted ]] || { echo 'import image missing' >&2; exit 1; }
    [[ $(stat -c '%u:%a:%s:%h' -- "$untrusted") == "0:600:$bytes:1" ]] || {
      echo 'import image identity or size refused' >&2; exit 1;
    }
  fi
  # Every mounted filesystem is one this script made.
  chmod 600 -- "$image_tmp"
  chown root:root -- "$image_tmp"
  fallocate -l "$bytes" -- "$image_tmp"
  /usr/sbin/mkfs.ext4 -q -F -- "$image_tmp"
  ln -- "$image_tmp" "$image"
  fresh=1
  /usr/bin/sync -f "$image_dir"
  rm -- "$image_tmp"
  /usr/bin/sync -f "$image_dir"
  install -d -o root -g root -m 700 -- "$target"
  /usr/bin/mount -t ext4 -o loop,nosuid,nodev,noatime -- "$image" "$target"
  chown "$app_uid:$app_gid" -- "$target"
  chmod 700 -- "$target"
  if [[ $action == create-from ]]; then
    # The reader gets a private copy it can open by a cwd-relative name; it
    # never needs to traverse the root-only image directory.
    stage=$mount_dir/.import-$name
    [[ ! -e $stage && ! -L $stage ]] || { echo 'import stage already exists' >&2; exit 1; }
    install -d -o "$app_uid" -g "$app_gid" -m 700 -- "$stage"
    cp --reflink=auto -- "$untrusted" "$stage/untrusted.ext4"
    chown "$app_uid:$app_gid" -- "$stage/untrusted.ext4"
    chmod 400 -- "$stage/untrusted.ext4"
    rm -f -- "$untrusted"
    untrusted=
    untrusted_reader=(/usr/bin/setpriv --reuid="$app_uid" --regid="$app_gid" --clear-groups
      --no-new-privs --inh-caps=-all --bounding-set=-all --)
    import_untrusted_tree "$stage" "$target" "$handoff_dir/$name.import.log" || exit 1
    rm -rf -- "$stage"
    stage=
    # Entries the reader made are the app's already; re-own anything else
    # (never following a symlink) except root's own lost+found.
    /usr/bin/find "$target" -xdev ! -uid 0 ! -uid "$app_uid" -exec /usr/bin/chown -h "$app_uid:$app_gid" -- {} +
    chown "$app_uid:$app_gid" -- "$target"
    chmod 700 -- "$target"
  fi
  trap - EXIT
fi

[[ -f $image && ! -L $image ]] || { echo 'image missing or symlinked' >&2; exit 1; }
[[ $(stat -c '%u:%a:%s' -- "$image") == "0:600:$bytes" ]] || {
  echo 'image owner, mode or size drift' >&2; exit 1;
}
[[ -d $target && ! -L $target ]] || { echo 'mountpoint missing or symlinked' >&2; exit 1; }
[[ $(stat -c '%u:%a' -- "$target") == "$app_uid:700" ]] || {
  echo 'mounted /var owner or mode drift' >&2; exit 1;
}
mount_options=$(/usr/bin/findmnt -n -M "$target" -o OPTIONS)
for required in nosuid nodev noatime; do
  [[ ,$mount_options, == *,$required,* ]] || { echo "mounted /var lacks $required" >&2; exit 1; }
done
source_dev=$(/usr/bin/findmnt -n -M "$target" -o SOURCE)
[[ $source_dev == /dev/loop* ]] || { echo 'mounted /var is not a loop device' >&2; exit 1; }
backing=$(/usr/sbin/losetup -n -O BACK-FILE -- "$source_dev")
[[ $backing == "$image" ]] || { echo 'loop backing file mismatch' >&2; exit 1; }
[[ $(/usr/bin/findmnt -n -M "$target" -o FSTYPE) == ext4 ]] || {
  echo 'mounted /var is not ext4' >&2; exit 1;
}

if [[ $action == create || $action == create-from ]]; then
  [[ ! -e $config && ! -L $config ]] || { echo 'volume registration already exists' >&2; exit 1; }
  config_tmp=$(mktemp "$config_dir/.volume.XXXXXXXX")
  trap 'rm -f -- "$config_tmp"' EXIT
  printf 'app_uid=%s\nsize_mib=%s\ndeployment_id=%s\nhost_id=%s\nvolume_id=%s\n' \
    "$app_uid" "$size_mib" "$deployment_id" "$host_id" "$volume_id" > "$config_tmp"
  chmod 600 -- "$config_tmp"
  chown root:root -- "$config_tmp"
  /usr/bin/sync -f "$config_tmp"
  ln -- "$config_tmp" "$config"
  /usr/bin/sync -f "$config_dir"
  rm -- "$config_tmp"
  /usr/bin/sync -f "$config_dir"
  trap - EXIT
fi

if [[ $action == attest ]]; then
  handoff=$handoff_dir/$name.witness

  collect_witness() {
    local observed_loop observed_backing observed_inode observed_size backing_fs image_uuid
    local backing_type backing_source backing_uuid backing_guid
    [[ $(stat -c '%u:%a:%s:%h' -- "$image") == "0:600:$bytes:1" ]] || return 1
    [[ $(stat -c '%u:%a' -- "$target") == "$app_uid:700" ]] || return 1
    observed_loop=$(/usr/bin/findmnt -n -M "$target" -o SOURCE) || return 1
    [[ $observed_loop == /dev/loop* ]] || return 1
    observed_backing=$(/usr/sbin/losetup -n -O BACK-FILE -- "$observed_loop") || return 1
    [[ $observed_backing == "$image" ]] || return 1
    [[ $(/usr/bin/findmnt -n -M "$target" -o FSTYPE) == ext4 ]] || return 1
    observed_inode=$(stat -c '%i' -- "$image") || return 1
    observed_size=$(stat -c '%s' -- "$image") || return 1
    backing_type=$(/usr/bin/findmnt -n -T "$image" -o FSTYPE) || return 1
    case $backing_type in
      ext4|btrfs)
        backing_uuid=$(/usr/bin/findmnt -n -T "$image" -o UUID) || return 1
        [[ $backing_uuid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
        backing_fs=$backing_type:$backing_uuid
        ;;
      zfs)
        backing_source=$(/usr/bin/findmnt -n -T "$image" -o SOURCE) || return 1
        [[ $backing_source =~ ^[A-Za-z0-9_.:/-]+(\[/[A-Za-z0-9_.:/-]+\])?$ ]] || return 1
        backing_source=${backing_source%%[*}
        backing_guid=$(/usr/sbin/zfs get -H -o value guid "$backing_source") || return 1
        [[ $backing_guid =~ ^[1-9][0-9]{0,19}$ ]] || return 1
        backing_fs=zfs:$backing_guid
        ;;
      *) return 1 ;;
    esac
    image_uuid=$(/usr/sbin/blkid -p -s UUID -o value -- "$image") || return 1
    [[ $image_uuid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
    printf 'DREGG/SPK-VAR-CUSTODY/v1\ndeployment_id=%s\nhost_id=%s\nresource=%s\nvolume_id=%s\napp_uid=%s\nquota_bytes=%s\nbacking=%s\nbacking_fs=%s\nbacking_inode=%s\nbacking_size=%s\nimage_ext4_uuid=%s\nmount=%s\n' \
      "$deployment_id" "$host_id" "$resource" "$volume_id" "$app_uid" "$bytes" "$image" \
      "$backing_fs" "$observed_inode" "$observed_size" "$image_uuid" "$target"
  }

  witness=$(collect_witness) || { echo 'volume custody drift before handoff' >&2; exit 1; }
  (( ${#witness} + 1 <= 4096 )) || { echo 'volume witness exceeds Mini bound' >&2; exit 1; }
  handoff_tmp=$(mktemp "$handoff_dir/.witness.XXXXXXXX")
  trap 'rm -f -- "$handoff_tmp"' EXIT
  printf '%s\n' "$witness" > "$handoff_tmp"
  chmod 644 -- "$handoff_tmp"
  chown root:root -- "$handoff_tmp"
  /usr/bin/sync -f "$handoff_tmp"
  [[ $(collect_witness) == "$witness" ]] || { echo 'volume custody drift before publication' >&2; exit 1; }
  mv -fT -- "$handoff_tmp" "$handoff"
  /usr/bin/sync -f "$handoff_dir"
  trap - EXIT
  [[ $(collect_witness) == "$witness" ]] || {
    rm -f -- "$handoff"
    /usr/bin/sync -f "$handoff_dir"
    echo 'volume custody drift after publication' >&2
    exit 1
  }
  [[ $(stat -c '%u:%a:%h' -- "$handoff") == '0:644:1' ]] || {
    echo 'volume witness file identity drift' >&2; exit 1;
  }
fi
echo "verified store=$store resource=$resource uid=$app_uid size_mib=$size_mib mount=$target"
