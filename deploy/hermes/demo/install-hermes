#!/usr/bin/env bash
# install-hermes STEP...  —  the room resident (Hermes) on the demo box.
#
# The exact sequence J14 runs (native/resource-client/journey.d/j14.sh), with
# the box's paths and dregg-infra's controller registration
# (controller-entry.py: mini-controller-register, mini-grain-controller@TASK,
# mini-grain-resident@TASK). Run as root; every Mini command runs as the
# service account through runuser. Steps, in order (each refuses to redo a
# finished step):
#
#   preflight  the Store pins Hermes's purse tariff; the provider table has the
#              pool row for the model; broker client; operator socket; launcher
#   consent    the resident's delegated full consent: a socket-activated `mini
#              serve-controller-consent` runs as the operator (it replays the Store,
#              whose checkpoint key the resident must never read) and answers only the
#              resident uid; its listener is the resident's RUN/consent.sock. The
#              selection the resident's processes need is V/consent.env (root 0644),
#              which every as-resident command here exports and the controller and
#              resident units take as EnvironmentFile=
#   subjects   enroll hermes (room key and tool worker), hhost (parent owner),
#              hprov (provider worker) and the founder; provision + init the
#              founder and Hermes
#   room       the founder's room, its index and the hermes/turn price
#   runtime    the bwrap launcher and the Hermes runtime root
#   create     grain-runtime create: the operator signs the birth (--birth-socket),
#              root gives the root to the RESIDENT, which creates the rest
#   handoff    register Hermes's task for the room; the registry the summon reads
#   summon     the founder summons Hermes as librarian with a budget
#   controller controller.json names the summoned account; register; start
#              mini-grain-controller@TASK
#   dispatch   the sealed hand-off into Hermes's registered inbox
#   dismiss    (repeatable, after resident) the founder's `dismiss ROOM`, its sealed
#              dismissal dispatched into Hermes's inbox, and the wait (up to 10 min) for
#              the running resident to return the budget's remainder to the founder
#   resummon   (repeatable, after dismiss) summon, controller, dispatch and resident
#              again for the founder's new assignment: its budget account has a new
#              name, which the controller config must carry, and a fresh resident state
#   refill     (repeatable, any time after create) the sponsor's Book account burns
#              AMOUNT (50000) credit into a purse: PURSE provider (default: what each
#              model call reserves and settles from; it starts at 50000 and a call on
#              the pool route reserves up to perOp plus the token caps' metered price),
#              parent or tool (PAY P6, `mini pay refill`). A refused reserve is the
#              room's `no-credit` reply until then. An uncertain submit is resolved
#              by the printed lookup, never by a second refill.
#   resident   resident.json names the delivered assignment inbox; with both
#              units stopped, register the resident too; start
#              mini-grain-controller@TASK and mini-grain-resident@TASK
#              (continuous: one pass per intervalSeconds)
#
# Inputs (environment; defaults are the box layout of dregg-infra edge/mini):
#   OPERATOR (mini-core)  RESIDENT (mini-h-INSTANCE)  CAND (/var/lib/mini/candidate/current)  NODE (/var/lib/mini/store/node)
#   HERMES_ROOT      a runtime root from deploy/hermes/build-runtime-root (required at `runtime`)
#   ROOM (hermes-lab)  BUDGET (1000)  PRICE (10)  FOUNDER_FUNDING (5000)
#   POOL_ROW         the provider-table row to pin (default: the pool row listing MODEL)
#   INSTANCE (hermes) BASE (9870000) MODEL (meta-llama/llama-3.1-8b-instruct)
#                    a second resident beside the first: its own subjects (INSTANCE-NAME),
#                    its own state under /var/lib/mini/INSTANCE, tasks BASE+1..3 and
#                    capabilities BASE+11..16, gateway port 18761+(BASE-9870000)/1000
#   TIER             set (e.g. TIER=1 for the subscriber tier): the room is a concierge
#                    workroom with a chat roster, `week` WEEK (4000) per PERIOD (43200
#                    heights: 30 days at one tick a minute), open to any enrolled payer;
#                    step `concierge` writes its controller config (it keeps the chat roster
#                    for each paying subject) and timer; MEMBER_HOMES: the hosted homes
#                    directory (DIR/SUBJECT) that receives each window's join reference
#
#   FOUNDER_MEMBER   a hosted member (e.g. house) founds ROOM instead of the operator's own
#                    founder subject: Hermes is installed for that member's room (created
#                    by `room` when it does not exist yet), the member's own shell does the
#                    room, summon and tariff lines (as mini-s-MEMBER on MEMBER_SOCKET), and
#                    the registry lands in the member's HOME/hermes/registry.json.
#                    MEMBER_ROOT: the hosted homes directory (MEMBER_ROOT/MEMBER, its
#                    workspace/ beneath); TENANT_GROUP (mini-sessions); MEMBER_SOCKET
#                    (NODE/public/mini.sock). Not with TIER.
#
#   The house's shared room (the lobby every member joins at the door; the seed's posts
#   and the tour's Hermes step), installed before deploy/demo-seed/seed.sh runs:
#     INSTANCE=lobby BASE=9872000 ROOM=lobby BUDGET=100 FOUNDER_MEMBER=house MEMBER_ROOT=/var/lib/mini/sessions \
#       HERMES_ROOT=OUT install-hermes preflight route consent subjects room runtime create handoff summon controller dispatch resident
#
#   The subscriber tier (deploy/hermes/README.md "The subscriber tier"):
#     INSTANCE=glm BASE=9871000 MODEL=glm-5.3-flash ROOM=subscribers TIER=1 POOL_ROW=zai-glm \
#       HERMES_ROOT=OUT install-hermes preflight route consent subjects room concierge runtime create handoff summon controller dispatch resident
set -euo pipefail
# Custody files are owner-private whatever the calling shell's umask; explicit
# modes come from install -m.
umask 077
OPERATOR=${OPERATOR:-mini-core}
# The archived candidate by its real path: the registration compares the
# controller's mini/host paths with the root-pinned image.
CAND=${CAND:-$(readlink -f /var/lib/mini/candidate/current)}
NODE=${NODE:-/var/lib/mini/store/node}
ROOM=${ROOM:-hermes-lab} BUDGET=${BUDGET:-1000} PRICE=${PRICE:-10} FOUNDER_FUNDING=${FOUNDER_FUNDING:-5000}
INSTANCE=${INSTANCE:-hermes} BASE=${BASE:-9870000}
# The house resident on the OpenRouter pool runs llama-3.1-8b; the subscriber
# tier's (INSTANCE=glm) runs glm-5.3-flash on the coding plan.
case $INSTANCE in glm) MODEL=${MODEL:-glm-5.3-flash} ;; *) MODEL=${MODEL:-meta-llama/llama-3.1-8b-instruct} ;; esac
case $INSTANCE in *[!a-z0-9]*|'') echo "install-hermes: INSTANCE must be lowercase letters and digits" >&2; exit 64 ;; esac
case $BASE in *[!0-9]*|'') echo "install-hermes: BASE must be a decimal" >&2; exit 64 ;; esac
TIER=${TIER:-} WEEK=${WEEK:-4000} PERIOD=${PERIOD:-43200}
FOUNDER_MEMBER=${FOUNDER_MEMBER:-} TENANT_GROUP=${TENANT_GROUP:-mini-sessions}
case $FOUNDER_MEMBER in *[!a-z0-9-]*) echo "install-hermes: FOUNDER_MEMBER must be a hosted member name" >&2; exit 64 ;; esac
if [ -n "$FOUNDER_MEMBER" ]; then
  [ -z "$TIER" ] || { echo "install-hermes: FOUNDER_MEMBER is not for a TIER room" >&2; exit 64; }
  [ -n "${MEMBER_ROOT:-}" ] || { echo "install-hermes: FOUNDER_MEMBER needs MEMBER_ROOT (the hosted homes directory)" >&2; exit 64; }
fi
PARENT_T=$((BASE + 1)) TOOL_T=$((BASE + 2)) PURSE_T=$((BASE + 3))
GATEWAY_PORT=$((18761 + (BASE - 9870000) / 1000))
RESIDENT=${RESIDENT:-mini-h-$INSTANCE}
V=/var/lib/mini/$INSTANCE          # root 0755, under the registration's allowed write roots
G=$V/g                            # RESIDENT: controller cwd; controller.json lives here
S=$G/state                        # stateDir (room workspace/home/resident state are direct children)
H=$V/homes                        # RESIDENT: hermes, hhost, hprov (keys)
WS=$V/workspaces                  # RESIDENT: hermes's workspace
OPV=$V/operator                   # OPERATOR 0700: founder, concierge, sponsor scratch, records
HO=$OPV/homes WO=$OPV/workspaces
RECORD=$OPV/install               # per-step records (outputs this script reads back)
RUN=$V/run                        # RESIDENT 0700: the resident's operator route (activated)
RSOCKET=$RUN/mini.sock
SPEC=$V/grain-spec.json           # root 0644: read by both accounts (paths only, no secrets)
ROUTE_UNIT=mini-resident-operator-$INSTANCE
CONSENT_UNIT=mini-resident-consent-$INSTANCE
CONSENT_ENV=$V/consent.env
MINI=$CAND/bin/mini HOST=$CAND/bin/minidregg-host GRAIN=$CAND/bin/grain-runtime
BRIDGE=$CAND/bin/grain-provider-bridge LAUNCH_GATE=$CAND/bin/launch-gate
CONFIG=$NODE/deployment/pinned-config.json
SOCKET=$NODE/operator/mini.sock
SPONSOR_WS=$NODE/sponsor
PARAMS=/etc/mini/genesis-params.json
PTABLE=/etc/mini/providers.json KEYS_CLIENT=/etc/mini/keys-client.json
here=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(CDPATH='' cd -- "$here/../../.." && pwd)

die() { echo "install-hermes: $*" >&2; exit 1; }
# Consent anchors: runuser's HOME for both accounts is a root-owned directory,
# so each account names its own persistent anchor directory (the operator's is
# the Store's, as the run sheet's `apps bootstrap` uses; the resident's is
# ANCHORS, which its controller and resident units name too).
ANCHORS=$V/anchors
as_op() { runuser -u "$OPERATOR" -- env MINI_CONSENT_ANCHOR_DIR="$NODE/consent-anchors" "$@"; }
# The resident pins its route's listener creator (systemd, uid 0); every
# child `mini` of its commands inherits the pin.
# Once step consent ran, every resident command selects its delegated consent.
as_res() {
  local sel=()
  [ -f "$CONSENT_ENV" ] && mapfile -t sel <"$CONSENT_ENV"
  runuser -u "$RESIDENT" -- env MINI_OPERATOR_PEER_UID=0 MINI_CONSENT_ANCHOR_DIR="$ANCHORS" "${sel[@]}" "$@"
}
resident_subject() { case $1 in hermes|hhost|hprov) return 0 ;; *) return 1 ;; esac; }
# A hosted founder (FOUNDER_MEMBER) acts as its own tenant account, as its shell does.
hosted_founder() { [ "$1" = founder ] && [ -n "$FOUNDER_MEMBER" ]; }
# Its HOME is its hosted home, as in its shell: the client's retained consent anchors live there
# (native/mini-sdk consent.rs refuses without $HOME or MINI_CONSENT_ANCHOR_DIR).
as_member() { setpriv --reuid="mini-s-$FOUNDER_MEMBER" --regid="$TENANT_GROUP" --init-groups --reset-env -- \
  env -i PATH=/usr/bin:/bin LANG=C.UTF-8 HOME="$MEMBER_ROOT/$FOUNDER_MEMBER" "$@"; }
as_owner() { local who=$1; shift; if hosted_founder "$who"; then as_member "$@"; elif resident_subject "$who"; then as_res "$@"; else as_op "$@"; fi; }
home_of() { if hosted_founder "$1"; then echo "$MEMBER_ROOT/$FOUNDER_MEMBER"; elif resident_subject "$1"; then echo "$H/$1"; else echo "$HO/$1"; fi; }
ws_of() { if [ "$1" = sponsor ]; then echo "$SPONSOR_WS"; elif hosted_founder "$1"; then echo "$MEMBER_ROOT/$FOUNDER_MEMBER/workspace"; elif resident_subject "$1"; then echo "$WS/$1"; else echo "$WO/$1"; fi; }
socket_of() { if hosted_founder "$1"; then echo "${MEMBER_SOCKET:-$NODE/public/mini.sock}"; elif resident_subject "$1"; then echo "$RSOCKET"; else echo "$SOCKET"; fi; }
owner_of() { if hosted_founder "$1"; then echo "mini-s-$FOUNDER_MEMBER"; elif resident_subject "$1"; then echo "$RESIDENT"; else echo "$OPERATOR"; fi; }
group_of() { if hosted_founder "$1"; then echo "$TENANT_GROUP"; else owner_of "$1"; fi; }
sh_line() { # WHO LINE: one shell line in WHO's workspace and home, as WHO's account
  local who=$1; shift
  as_owner "$who" "$MINI" shell --socket "$(socket_of "$who")" --host "$HOST" --config "$CONFIG" \
    --workspace "$(ws_of "$who")" --home "$(home_of "$who")" --line "$1"
}
done_step() { [ -e "$RECORD/$1.done" ]; }
mark() { as_op touch "$RECORD/$1.done"; echo "install-hermes: $1 done"; }
subject() { jq -r .subject "$RECORD/subject-$1.json"; }

step_preflight() {
  [ "$(id -u)" = 0 ] || die "run as root"
  for x in "$MINI" "$HOST" "$GRAIN" "$BRIDGE" "$LAUNCH_GATE" "$CONFIG" "$PARAMS" "$PTABLE" "$KEYS_CLIENT"; do
    [ -e "$x" ] || die "missing $x"; done
  [ -S "$SOCKET" ] || die "no operator socket $SOCKET (mini serve-operator)"
  as_op "$MINI" operator-status --socket "$SOCKET" --host "$HOST" --config "$CONFIG" >/dev/null \
    || die "the operator socket does not answer operator-status"
  jq -e --argjson p "$PURSE_T" --arg m "$MODEL" \
    '.providerServices // [] | any(.providerResourceId == $p and .tariff.model == $m)' "$CONFIG" >/dev/null \
    || die "the pinned config carries no providerServices tariff for purse $PURSE_T and $MODEL (deploy/hermes/demo/provider-services.json belongs in operator.json at genesis)"
  [ "$(stat -c %u "$PTABLE")" = 0 ] || die "$PTABLE must be root-owned"
  POOL_ROW=${POOL_ROW:-$(jq -r --arg m "$MODEL" '[.providers[] | select(.credential == "pool" and (.models | index($m)))][0].name // empty' "$PTABLE")}
  [ -n "$POOL_ROW" ] || die "no pool row in $PTABLE lists $MODEL"
  # The gateway pins a request without max_tokens to maxOutputTokens (1024);
  # the broker refuses a call above the row's per-call cap.
  jq -e --arg r "$POOL_ROW" '.providers[] | select(.name == $r) | (.caps.perCall | tonumber) >= 1024' "$PTABLE" >/dev/null \
    || die "pool row $POOL_ROW caps.perCall is below the controller's maxOutputTokens 1024"
  # As root: the table is root-owned and grain-runtime trusts its own euid as owner (production loads with owner 0).
  "$GRAIN" provider-table check "$PTABLE" >/dev/null || die "grain-runtime refuses $PTABLE"
  [ "$("$GRAIN" --controller-manager-protocol)" = mini-controller-manager-v1 ] || die "grain-runtime lacks the controller-manager contract"
  ! grep -rqs '^RestrictSUIDSGID=yes' /etc/systemd/system/mini-grain-controller@.service /etc/systemd/system/mini-grain-controller@.service.d \
      /etc/systemd/system/mini-grain-resident@.service /etc/systemd/system/mini-grain-resident@.service.d \
    || die "a Hermes unit sets RestrictSUIDSGID=yes (bwrap 0.12 dies with ENOSYS on openat2)"
  # The resident's account: a system user with a same-named group, no login,
  # its own systemd user manager (linger: it starts its workers there), and
  # exactly one supplementary group, the key broker's socket group (the
  # broker answers it as a provider by uid; members are matched by primary
  # gid, so this never makes it a member). The operator socket is reached
  # only through the resident's own route (step `route`).
  local broker_group
  broker_group=$(jq -r '.socketGroup // empty' /etc/mini/keys/broker.json)
  [ -n "$broker_group" ] || die "/etc/mini/keys/broker.json names no socketGroup (split tenancy)"
  broker_group=$(getent group "$broker_group" | cut -d: -f1)
  getent group "$RESIDENT" >/dev/null || groupadd --system "$RESIDENT"
  id "$RESIDENT" >/dev/null 2>&1 || useradd --system --gid "$RESIDENT" --home-dir "$V" --no-create-home \
    --shell /usr/sbin/nologin "$RESIDENT"
  passwd -l "$RESIDENT" >/dev/null 2>&1 || true
  usermod -G "$broker_group" "$RESIDENT"
  [ "$(id -nG "$RESIDENT" | tr ' ' '\n' | sort | tr '\n' ' ')" = "$(printf '%s\n' "$RESIDENT" "$broker_group" | sort | tr '\n' ' ')" ] \
    || die "$RESIDENT must hold exactly its own group and $broker_group ($(id -nG "$RESIDENT"))"
  [ "$(id -u "$RESIDENT")" != "$(id -u "$OPERATOR")" ] || die "the resident must not be the operator"
  loginctl enable-linger "$RESIDENT"
  # Ownership: the instance root and the runtime root are root's; the
  # operator's part is the operator's; everything else is the resident's.
  install -d -o root -g root -m 0755 "$V"
  install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$OPV" "$HO" "$WO" "$RECORD"
  install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$H" "$WS" "$RUN" "$ANCHORS"
  [ -d "$NODE/consent-anchors" ] || install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$NODE/consent-anchors"
  printf '%s\n' "$POOL_ROW" | as_op tee "$RECORD/pool-row" >/dev/null
  mark preflight
}

step_route() {
  local ruid; ruid=$(id -u "$RESIDENT")
  # Two listeners, in this order (fd3, fd4): Host frames and the status-only
  # control. Created by systemd as the resident, served by the operator.
  cat >"/etc/systemd/system/$ROUTE_UNIT.socket" <<EOF
[Unit]
Description=Mini operator route for the $INSTANCE resident ($RESIDENT)
[Socket]
ListenStream=$RSOCKET
ListenStream=$RUN/mini.control
SocketUser=$RESIDENT
SocketGroup=$RESIDENT
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
Accept=no
[Install]
WantedBy=sockets.target
EOF
  cat >"/etc/systemd/system/$ROUTE_UNIT.service" <<EOF
[Unit]
Description=Mini operator route for the $INSTANCE resident ($RESIDENT): its Host operations and status only
Requires=$ROUTE_UNIT.socket
After=$ROUTE_UNIT.socket
[Service]
User=$OPERATOR
Group=$OPERATOR
ExecStart=$MINI serve-resident-operator-proxy --socket $RSOCKET --upstream $SOCKET --config $CONFIG --resident-uid $ruid
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
EOF
  systemctl daemon-reload
  systemctl enable --now "$ROUTE_UNIT.socket"
  as_res "$MINI" operator-status --socket "$RSOCKET" --host "$HOST" --config "$CONFIG" >/dev/null \
    || die "the resident's route does not answer operator-status (journalctl -u $ROUTE_UNIT)"
  mark route
}

step_consent() {
  done_step route || die "consent follows route"
  local ruid consent=$CAND/bin/minidregg-client-consent csock=$RUN/consent.sock image settings
  ruid=$(id -u "$RESIDENT")
  [ -x "$consent" ] || die "missing $consent"
  install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$OPV/consent-anchors"
  image=$(sha256sum "$consent" | cut -d' ' -f1); settings=$(sha256sum "$CONFIG" | cut -d' ' -f1)
  cat >"/etc/systemd/system/$CONSENT_UNIT.socket" <<EOF
[Unit]
Description=Mini delegated consent for the $INSTANCE resident ($RESIDENT)
[Socket]
ListenStream=$csock
SocketUser=$RESIDENT
SocketGroup=$RESIDENT
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
Accept=no
Service=$CONSENT_UNIT.service
[Install]
WantedBy=sockets.target
EOF
  cat >"/etc/systemd/system/$CONSENT_UNIT.service" <<EOF
[Unit]
Description=Mini full consent for the $INSTANCE resident ($RESIDENT): answers only uid $ruid
Requires=$CONSENT_UNIT.socket
After=$CONSENT_UNIT.socket
[Service]
User=$OPERATOR
Group=$OPERATOR
ExecStart=$MINI serve-controller-consent --socket $csock --consent $consent --config $CONFIG --consent-sha256 $image --config-sha256 $settings --controller-uid $ruid --anchors $OPV/consent-anchors
Environment=HOME=$OPV
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
EOF
  systemctl daemon-reload
  systemctl enable --now "$CONSENT_UNIT.socket"
  # The selection (deploy/shell/README.md: the hosted member's variables).
  printf '%s\n' "MINI_CONSENT_SOCKET=$csock" "MINI_CONSENT_PEER_UID=0" "MINI_CONSENT_SHA256=$image" \
    "MINI_CONSENT_CONFIG_SHA256=$settings" "MINI_LOCAL_HOST=$HOST" "MINI_CONSENT_HOST=$consent" \
    "MINI_CONSENT_CONFIG=$CONFIG" >"$CONSENT_ENV.new"
  install -o root -g root -m 0644 "$CONSENT_ENV.new" "$CONSENT_ENV"; rm -f "$CONSENT_ENV.new"
  mark consent
}

enroll() { # NAME: keygen in its home (its owner's account); the sponsor plans, seals and submits its enrollment
  local f=$1 home; home=$(home_of "$1")
  install -d -o "$(owner_of "$f")" -g "$(owner_of "$f")" -m 0700 "$home"
  [ -e "$home/keys/mini.key" ] || sh_line "$f" "keygen mini.key" >/dev/null
  install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$HO/sponsor" "$HO/sponsor/keys"
  install -o "$OPERATOR" -g "$OPERATOR" -m 0600 "$home/keys/mini.key" "$HO/sponsor/keys/$INSTANCE-$f.key"
  sh_line sponsor "enroll plan $INSTANCE-$f $INSTANCE-$f.key $(xxd -p -c 256 "$home/keys/mini.key.next.pub") $(xxd -p -c 256 "$home/keys/mini.key.next.cosign")" >/dev/null
  sh_line sponsor "enroll seal $INSTANCE-$f" >/dev/null
  sh_line sponsor "enroll submit $INSTANCE-$f" | as_op tee "$RECORD/subject-$f.json" >/dev/null
  rm -f "$HO/sponsor/keys/$INSTANCE-$f.key"
  [ -n "$(subject "$f")" ] && [ "$(subject "$f")" != null ] || die "enrollment of $f returned no subject"
}
provision() { # NAME FUNDING: an account owned by NAME, its birth context, its workspace
  local f=$1 funding=$2 permit=$RECORD/permit-all.json home; home=$(home_of "$1")
  printf '%s\n' '{"type":"all","predicates":[]}' | as_op tee "$permit" >/dev/null
  as_op "$MINI" workspace --action provision --dir "$SPONSOR_WS" --name "$INSTANCE-$f" --holder "$(subject "$f")" \
    --funding "$funding" --account-predicate "$permit" --factory-ref factory >/dev/null
  install -d -o "$(owner_of "$f")" -g "$(owner_of "$f")" -m 0700 "$home/provision"
  install -o "$(owner_of "$f")" -g "$(owner_of "$f")" -m 0600 "$SPONSOR_WS/provisions/$INSTANCE-$f/birth-context.json" "$home/provision/birth-context.json"
  sh_line "$f" "init mini.key $(subject "$f")" >/dev/null
}
step_subjects() {
  local names="hermes hhost hprov founder"
  [ -n "$TIER" ] && names="$names con"
  if [ -n "$FOUNDER_MEMBER" ]; then
    # The member is already enrolled, provisioned and funded (the door or the frame).
    names=${names% founder}
    sh_line founder whoami | as_op tee "$RECORD/subject-founder.json" >/dev/null
    [ -n "$(subject founder)" ] && [ "$(subject founder)" != null ] || die "$FOUNDER_MEMBER's whoami names no subject"
  fi
  for f in $names; do [ -s "$RECORD/subject-$f.json" ] || enroll "$f"; done
  [ -n "$FOUNDER_MEMBER" ] || provision founder "$FOUNDER_FUNDING"
  provision hermes 0
  # The concierge's runner pays its own turn fees (J17 funds it 10).
  [ -n "$TIER" ] && provision con "${CONCIERGE_FUNDING:-100}"
  mark subjects
}

step_room() {
  local A; A=$(subject founder)
  if [ -n "$TIER" ]; then
    # A concierge workroom (its till, the concierge's grants, `week` per
    # `period`, the chat roster Hermes reads), open to any enrolled payer.
    sh_line founder "room new $ROOM --template workroom --concierge $(subject con) --period $PERIOD" >/dev/null
    sh_line founder "tariff $ROOM set week $WEEK" >/dev/null
    sh_line founder "tariff $ROOM set open 1" >/dev/null
  elif [ -n "$FOUNDER_MEMBER" ] && grep -qw -- "$ROOM" <<<"$(sh_line founder "chat rooms")"; then
    echo "install-hermes: $FOUNDER_MEMBER's room $ROOM exists; Hermes is installed for it"
  else
    sh_line founder "chat new $ROOM" >/dev/null
  fi
  sh_line founder "doc new $ROOM-index 'any [ not (verb == write), subject == $A ]' --in $ROOM" >/dev/null
  sh_line founder "doc append map $ROOM-index '$ROOM: what we are writing, linked from here'" >/dev/null
  sh_line founder "submit map" >/dev/null
  sh_line founder "tariff $ROOM set hermes/turn $PRICE" >/dev/null
  mark room
}

step_concierge() {
  [ -n "$TIER" ] || die "concierge is a TIER step"
  local C; C=$(subject con)
  install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$HO/con/programs" "$HO/con/inbox" "$HO/con/outbox"
  # The founder's grants to the concierge, and the program its room wrote.
  local f
  for f in "$HO/founder/outbox/$C"/*.json; do
    [ -e "$f" ] && install -o "$OPERATOR" -g "$OPERATOR" -m 0600 "$f" "$HO/con/inbox/"
  done
  install -o "$OPERATOR" -g "$OPERATOR" -m 0600 "$HO/founder/concierge/$ROOM.json" "$HO/con/programs/$ROOM.json"
  # The roster: each paying subject gets a stream and a roster row from the
  # founder (operator custody, the same account), and its window reference in
  # MEMBER_HOMES/SUBJECT/requests/ROOM-invite.json when that home exists.
  jq -n --arg mini "$MINI" --arg ws "$WO/con" --arg p "$HO/con/programs/$ROOM.json" --arg i "$HO/con/inbox" \
    --arg o "$HO/con/outbox" --arg j "$HO/con/journal-$ROOM.jsonl" --arg room "$ROOM" --arg host "$HOST" \
    --arg cfg "$CONFIG" --arg sock "$SOCKET" --arg fws "$WO/founder" --arg fh "$HO/founder" --arg mh "${MEMBER_HOMES:-}" \
    '{type:"minidregg-concierge-controller-v1",mini:$mini,workspace:$ws,program:$p,inbox:$i,outbox:$o,journal:$j,
      roster:({room:$room,host:$host,config:$cfg,socket:$sock,workspace:$fws,home:$fh}
        + (if $mh == "" then {} else {memberHomes:$mh} end))}' \
    | as_op tee "$OPV/concierge-$ROOM.json" >/dev/null
  as_op "$GRAIN" concierge step "$OPV/concierge-$ROOM.json" | as_op tee "$RECORD/concierge-first-pass.json" >/dev/null
  # One pass a minute; each pass decides only from the till's signed ledger.
  cat >"/etc/systemd/system/mini-concierge-$ROOM.service" <<EOF
[Unit]
Description=Mini room concierge for $ROOM (one pass)
[Service]
Type=oneshot
User=$OPERATOR
UMask=0077
NoNewPrivileges=yes
ExecStart=$GRAIN concierge step $OPV/concierge-$ROOM.json
EOF
  cat >"/etc/systemd/system/mini-concierge-$ROOM.timer" <<EOF
[Unit]
Description=Mini room concierge for $ROOM, once a minute
[Timer]
OnBootSec=60
OnUnitActiveSec=60
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now "mini-concierge-$ROOM.timer"
  mark concierge
}

step_runtime() {
  [ -n "${HERMES_ROOT:-}" ] && [ -x "$HERMES_ROOT/hermes-acp" ] && [ -f "$HERMES_ROOT/pins.json" ] \
    || die "HERMES_ROOT must name a root from deploy/hermes/build-runtime-root"
  # The worker's grain-runtime must be the controller's: a root built for
  # another candidate is rebound first (no rebuild).
  [ "$(jq -r .grainRuntimeSha256 "$HERMES_ROOT/pins.json")" = "$(sha256sum "$GRAIN" | cut -d' ' -f1)" ] \
    || die "HERMES_ROOT was built for another candidate: $REPO/deploy/hermes/build-runtime-root --rebind $HERMES_ROOT $CAND"
  install -d -m 0755 "$V/runtime-root"; install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$V/launcher" "$V/worker-work" \
    "$V/worker-work/.hermes" "$V/worker-work/.cache" "$V/worker-work/.config" "$V/worker-work/.local" "$V/worker-work/.local/share"
  cp -a "$HERMES_ROOT"/. "$V/runtime-root/"
  chown -R root:root "$V/runtime-root"; chmod -R go-w "$V/runtime-root"
  local bwrap; bwrap=$(sh "$REPO/deploy/grain-host/resolve-bwrap")
  as_res python3 "$REPO/deploy/grain-host/materialize-bwrap.py" --physical-bwrap "$bwrap" \
    --physical-sha256 "$(sha256sum "$bwrap" | cut -d' ' -f1)" --output "$V/launcher/bwrap"
  install -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$LAUNCH_GATE" "$V/launcher/launch-gate"
  chmod 700 "$V/launcher/bwrap"
  mark runtime
}

step_create() {
  done_step consent || die "create needs the resident's delegated consent (step consent): its own consent cannot read the Store"
  local genesis=$NODE/genesis.json reserve
  # The pool hold covers the fee and the metered charge at the token caps.
  reserve=$(jq -r --argjson p "$PURSE_T" '.providerServices[] | select(.providerResourceId == $p) | .tariff.routes.pool
    | ((.perOp|tonumber) + (((16000 * (.inputMicroPerMillion|tonumber)) + (1024 * (.outputMicroPerMillion|tonumber)) + 999999) / 1000000 | floor)) | tostring' "$CONFIG")
  # The root exists empty and the operator's, for the birth only.
  install -d -o "$OPERATOR" -g "$OPERATOR" -m 0700 "$G"
  jq -n --arg mini "$MINI" --arg host "$HOST" --arg cfg "$CONFIG" --arg sock "$RSOCKET" --arg g "$genesis" \
    --arg ns "$NODE/namespace" --arg root "$G" --arg sk "$NODE/keys/sponsor.key" \
    --arg hk "$H/hhost/keys/mini.key" --arg hs "$(subject hhost)" --arg tk "$H/hermes/keys/mini.key" --arg ts "$(subject hermes)" \
    --arg pk "$H/hprov/keys/mini.key" --arg ps "$(subject hprov)" --arg pt "$PARENT_T" --arg tt "$TOOL_T" --arg ut "$PURSE_T" \
    --arg l "$V/launcher/bwrap" --arg rt "$V/runtime-root" --arg ww "$V/worker-work" --arg table "$PTABLE" \
    --arg kc "$KEYS_CLIENT" --arg gb "127.0.0.1:$GATEWAY_PORT" --arg base "$BASE" --arg m "$MODEL" --arg row "$(cat "$RECORD/pool-row")" --arg reserve "$reserve" \
    --arg ws "$S/resource-workspace" --arg home "$S/room-home" --arg room "$ROOM" \
    --argjson gp "$(jq -c . "$PARAMS")" --argjson op "$(jq -c '{issuer:(.issuer|tostring),ownerBudget:(.ownerBudget|tostring),lifetime:(.lifetime|tostring)}' "$NODE/operator.json")" '
    {type:"mini-grain-create-v1",mini:$mini,host:$host,hostConfig:$cfg,hostSocket:$sock,genesis:$g,namespaceRoot:$ns,
     root:$root,nonce:(($base|tonumber) / 10 | floor | tostring),
     sponsor:{key:$sk,subject:($gp.sponsor.subject|tostring),accountCapability:($gp.sponsor.spendCapabilityId|tostring),
       grants:[{kind:"object",target:($gp.factoryId|tostring),capability:($gp.sponsor.factoryObserveCapabilityId|tostring)},
               {kind:"account",target:($gp.sponsor.accountId|tostring),capability:($gp.sponsor.spendCapabilityId|tostring)}]},
     template:$op,
     owner:{key:$hk,subject:$hs,noPrerotation:false},workerKey:{key:$tk,subject:$ts,noPrerotation:false},
     task:$pt,toolTask:$tt,
     capabilities:{parentObserve:(($base|tonumber)+11|tostring),parentControl:(($base|tonumber)+12|tostring),
       toolObserve:(($base|tonumber)+13|tostring),toolControl:(($base|tonumber)+14|tostring)},
     budgets:{parent:"20000",tool:"20000",witnessMaxCost:"50000"},
     worker:{launcher:$l,runtimeRoot:$rt,workspace:$ww,network:"none",wallTimeSeconds:900,reserve:"3",charge:"1"},
     toolCharges:{reserve:"2",charge:"1"},
     provider:{key:{key:$pk,subject:$ps,noPrerotation:false},task:$ut,observeCapability:(($base|tonumber)+15|tostring),controlCapability:(($base|tonumber)+16|tostring),
       budget:"50000",gateway:{providers:$table,credentialBroker:$kc,gatewayBind:$gb,model:$m,provider:$row,reserve:$reserve,
         maxInputTokens:16000,maxOutputTokens:1024,maxRequestBytes:1048576,maxResponseBytes:8388608,timeoutSeconds:300,
         localFixtureHostNetwork:false}},
     room:{mini:$mini,host:$host,hostConfig:$cfg,socket:$sock,workspace:$ws,home:$home,room:$room,account:"unsummoned"}}' \
    >"$SPEC.new"
  install -o root -g root -m 0644 "$SPEC.new" "$SPEC"; rm -f "$SPEC.new"
  # 1. The operator signs the birth through its own socket (the sponsor key
  #    never leaves the operator); 2. root gives the root to the resident;
  # 3. the resident creates the rest through its route.
  as_op "$GRAIN" create "$SPEC" --birth-socket "$SOCKET" | as_op tee "$RECORD/grain-birth.json"
  chown -R "$RESIDENT:$RESIDENT" "$G"
  as_res "$GRAIN" create "$SPEC" | as_op tee "$RECORD/grain-created.json"
  install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$S/room-home"
  mark create
}

step_handoff() {
  local lab reg; lab=$(jq -r .target "$(ws_of founder)/refs/$ROOM.json")
  install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$V/registrations" "$V/inbox"
  reg=$(home_of founder)/hermes
  install -d -o "$(owner_of founder)" -g "$(group_of founder)" -m 0700 "$reg"
  as_res "$MINI" hermes-handoff --action registration --dir "$S/resource-workspace" --task "$PARENT_T" --room-cell "$lab" \
    --inbox "$V/inbox" --socket "$RSOCKET" | as_res tee "$V/registrations/$PARENT_T.json" >/dev/null
  # The registry the founder's summon reads: made by the resident, handed to the founder by root.
  as_res "$MINI" hermes-handoff --action registry --registrations "$V/registrations" --socket "$RSOCKET" \
    | as_owner founder tee "$reg/registry.json" >/dev/null
  mark handoff
}

step_summon() {
  sh_line founder "summon $ROOM as librarian --budget $BUDGET" | as_op tee "$RECORD/summon.out"
  sed -n 's/.*hand-off in //p' "$RECORD/summon.out" | tail -1 | as_op tee "$RECORD/outbox" >/dev/null
  [ -s "$(cat "$RECORD/outbox")/handoff.json" ] || die "summon left no sealed hand-off"
  # The room names Hermes's provider purse (the page shows its route by that
  # purse's tariff model: meta-llama/... for hermes-lab, glm-5.3-flash for subscribers).
  sh_line founder "tariff $ROOM set hermes/provider $PURSE_T" >/dev/null
  mark summon
}

step_controller() {
  local acct; acct=$(jq -r .account.name "$(cat "$RECORD/outbox")/summon-$ROOM.json")
  as_res sh -c "jq --arg a '$acct' '.toolTask.room.account = \$a' '$G/controller.json' >'$G/controller.json.new' && chmod 600 '$G/controller.json.new' && mv '$G/controller.json.new' '$G/controller.json'"
  mini-controller-register "$PARENT_T" "$G/controller.json"
  systemctl start "mini-grain-controller@$PARENT_T.service"
  for _ in $(seq 1 600); do [ -S "$S/control.sock" ] && break; sleep 0.1; done
  [ -S "$S/control.sock" ] || die "the controller did not open its control socket (journalctl -u mini-grain-controller@$PARENT_T)"
  mark controller
}

step_dispatch() {
  # The founder's sealed bundle, copied by root to where the resident reads it.
  local staged=$V/handoff-staged
  rm -rf "$staged"; install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$staged"
  cp -a "$(cat "$RECORD/outbox")"/. "$staged/"; chown -R "$RESIDENT:$RESIDENT" "$staged"
  as_res "$MINI" hermes-handoff --action dispatch --registration "$V/registrations/$PARENT_T.json" \
    --bundle "$staged/handoff.json" --socket "$RSOCKET"
  mark dispatch
}

step_resident() {
  local current inbox
  current=$(find "$V/inbox" -name current.json | head -1)
  inbox=$(jq -r '.inbox // empty' "$current" 2>/dev/null)
  [ -n "$inbox" ] && [ -d "$inbox" ] || die "no delivered assignment inbox under $V/inbox (run dispatch)"
  # One resident state per assignment: a later summon (after a dismissal) starts
  # its own count and its own return, never the dismissed assignment's.
  local assignment; assignment=$(jq -r '.assignment // empty' "$current")
  case $assignment in ''|*[!0-9]*) die "the assignment pointer $current names no assignment" ;; esac
  jq -n --arg c "$G/controller.json" --arg i "$inbox" --arg s "$S/resident-a$assignment" \
    '{type:"mini-hermes-room-resident-v1",controller:$c,inbox:$i,state:$s,maxPrompts:null,intervalSeconds:60}' \
    | as_res tee "$G/resident.json" >/dev/null
  as_res chmod 600 "$G/resident.json"
  # Adding the resident to a registration requires both units stopped.
  systemctl stop "mini-grain-controller@$PARENT_T.service"
  mini-controller-register "$PARENT_T" "$G/controller.json" "$G/resident.json"
  systemctl start "mini-grain-controller@$PARENT_T.service" "mini-grain-resident@$PARENT_T.service"
  mark resident
}

resident_state() { jq -r '.state // empty' "$G/resident.json" 2>/dev/null; }

step_dismiss() {
  done_step resident || die "dismiss follows a running resident (step resident)"
  local state staged=$V/dismissal-staged
  state=$(resident_state)
  [ -n "$state" ] || die "no resident.json under $G"
  sh_line founder "dismiss $ROOM" | as_op tee "$RECORD/dismiss-$(date -u +%Y%m%dT%H%M%SZ).out"
  [ -s "$(cat "$RECORD/outbox")/dismissal.json" ] || die "the dismissal left no sealed bundle in $(cat "$RECORD/outbox")"
  rm -rf "$staged"; install -d -o "$RESIDENT" -g "$RESIDENT" -m 0700 "$staged"
  install -o "$RESIDENT" -g "$RESIDENT" -m 0600 "$(cat "$RECORD/outbox")/dismissal.json" "$staged/dismissal.json"
  as_res "$MINI" hermes-handoff --action dispatch --registration "$V/registrations/$PARENT_T.json" \
    --bundle "$staged/dismissal.json" --socket "$RSOCKET"
  for _ in $(seq 1 120); do
    [ "$(jq -r '.returned // empty | tostring' "$state/resident.json" 2>/dev/null)" != "" ] && break
    sleep 5
  done
  [ -n "$(jq -r '.returned // empty | tostring' "$state/resident.json" 2>/dev/null)" ] \
    || die "the resident has not returned the budget yet (journalctl -u mini-grain-resident@$PARENT_T); rerun dismiss's wait with: install-hermes resummon (it refuses until the return is journaled)"
  echo "install-hermes: $ROOM dismissed; returned $(jq -c .returned "$state/resident.json")"
}

step_resummon() {
  done_step resident || die "resummon follows a finished install"
  local state; state=$(resident_state)
  [ -n "$(jq -r '.returned // empty | tostring' "$state/resident.json" 2>/dev/null)" ] \
    || die "the current assignment is not dismissed and returned ($state/resident.json): run dismiss first"
  systemctl stop "mini-grain-resident@$PARENT_T.service" "mini-grain-controller@$PARENT_T.service"
  as_op rm -f "$RECORD/summon.done" "$RECORD/controller.done" "$RECORD/dispatch.done" "$RECORD/resident.done"
  step_summon; step_controller; step_dispatch; step_resident
}

step_refill() {
  done_step create || die "refill needs the purses: run create first"
  local amount=${AMOUNT:-50000} task attempt
  case $amount in *[!0-9]*|''|0) die "AMOUNT must be a positive decimal" ;; esac
  case ${PURSE:-provider} in
    provider) task=$PURSE_T ;; parent) task=$PARENT_T ;; tool) task=$TOOL_T ;;
    *) die "PURSE is provider, parent or tool" ;;
  esac
  attempt=$RECORD/refill-${PURSE:-provider}-$(date -u +%Y%m%dT%H%M%SZ)
  # The payer is the sponsor's account (it signs with its own key; the
  # credit asset is the PAY tariff's, so the Store's tariff must be set).
  as_op "$MINI" pay refill --mode submit --host "$HOST" --config "$CONFIG" --socket "$SOCKET" \
    --key "$NODE/keys/sponsor.key" --dir "$attempt" \
    --subject "$(jq -r '.sponsor.subject' "$PARAMS")" --capability "$(jq -r '.sponsor.spendCapabilityId' "$PARAMS")" \
    --account "$(jq -r '.sponsor.accountId' "$PARAMS")" --task "$task" --amount "$amount" \
    | as_op tee "$attempt.out" \
    || die "refill of $task by $amount not confirmed; resolve it with: runuser -u $OPERATOR -- $MINI pay refill --mode lookup --host $HOST --config $CONFIG --socket $SOCKET --dir $attempt"
  echo "install-hermes: purse $task refilled by $amount (record $attempt)"
}

[ $# -gt 0 ] || { sed -n '2,70p' "$0"; exit 64; }
for step in "$@"; do
  case $step in
    preflight|route|consent|subjects|room|concierge|runtime|create|handoff|summon|controller|dispatch|resident) ;;
    refill|dismiss|resummon) done_step preflight || die "run preflight first"; POOL_ROW=$(cat "$RECORD/pool-row"); "step_$step"; continue ;;
    *) die "unknown step $step" ;;
  esac
  [ "$step" = preflight ] || done_step preflight || die "run preflight first"
  if done_step "$step"; then echo "install-hermes: $step already done"; continue; fi
  [ "$step" = preflight ] || POOL_ROW=$(cat "$RECORD/pool-row")
  "step_$step"
done
