#!/usr/bin/env bash
# Generic Simplex gate: runs the four Verify agreement programs the merge gate builds
# (exe-roots) and proves each can go red.
#
#   scripts/gates/check-generic-simplex [BIN_DIR [HELPER_DIR]]
#     BIN_DIR     the Lean executables (default .lake/build/bin)
#     HELPER_DIR  the Rust helpers, a cargo profile directory: minidregg-link-sqlite-store (the source
#                 Store), minidregg-credential-signature-verifier, mini-joint-agreement-crypto (the agreement
#                 helper session), examples/sign-probe (test signer). Not given: the gate builds them from
#                 this tree's native/ crates (cargo, release, into ${CARGO_TARGET_DIR:-target/generic-simplex},
#                 under swarm-build where there is one), so no caller has to know where they are.
#
#   generic-simplex-harness          the native layer (four replicas over in-memory journals: sealed packets,
#                                    COMMIT signatures, relay, drain, checkpoint, certificate), the recorded 00f711 stall, backoff recovery, idle quiescence, normal
#                                    progress, silent-leader fallback, equivocation, crash replay, roster
#   generic-simplex-log-reopen       100 000-frame journals reopened in constant stack; torn tail; checkpoint
#   generic-simplex-load             every operation of a short busy run commits (its timings are printed,
#                                    published, never judged: performance is not a gate)
#   minidregg-four-source-fixture    2-segment checkpointed agreement journal audit (`write-audit-fixture` +
#                                    `audit-journal`); and four participants end to end over four native
#                                    source Stores with the real helpers: one signed birth authored on the
#                                    opened Store, agreed in process (`run`: admission, validation at the
#                                    verified tip, a certificate of three ML-DSA signatures, the ordered
#                                    append, then every helper stopped and every journal and Store reread),
#                                    read back by fresh processes (`lookup-all-call`), then a second birth
#                                    through four standing `serve-replica` processes over TCP and the
#                                    request spool (`await-call`); then replica 3 is stopped, a third birth
#                                    is confirmed to its client by the other three receipts, and replica 3,
#                                    restarted with no further call, asks its peers and holds the record too.
#                                    `append-flatness`: ${GENERIC_SIMPLEX_FLAT_HEIGHTS:-48} births in process;
#                                    the median application hand-off (the ordered append) per KB of appended
#                                    record over the last 8 heights may be at most 2 times that over the first
#                                    8 (a birth's record itself grows with the height; the row bounds what the
#                                    append adds to that). A ratio of medians on one box in one run: a bound
#                                    on growth, not a published timing.
#                                    `rejoin`: one replica stopped for two calls and restarted into an idle
#                                    domain catches up, in process, logical clock, no timer
#
# Plants, each red with its recorded message (a plant that passes, or fails another way, is red):
#   harness --plant fixed-timer                  the recovery run without backoff (the paper's fixed timer)
#   harness --plant split-tip                    replica 1's committed tip is not a prefix of the others'
#   harness --plant forged-digest                the chain digest is the same for every chain, so a COMMIT
#                                                signed for one chain is read with the payloads of another
#   harness --plant undrained-relay              a driver that never forwards what a replica owes a peer
#                                                (`Replica.owed`): a replica four commits behind stays behind
#   log-reopen --plant flip-byte                 one bit flipped in the middle of the delta-frame image
#   four-source-fixture --plant corrupt-segment  live segment snapshot disagrees with previous replayed state
#   four-source-fixture run --plant foreign-history  every participant's running history digest is another
#                                                domain's: the certified record is never ordered or appended
#   four-source-fixture append-flatness --plant revalidate-prefix  every replica replays its whole source
#                                                prefix after each append: the hand-off grows with the height
#   four-source-fixture rejoin --plant silent-rejoin  the restarted replica never tells its peers its height
#   all-receipts                                 a client that waits for all four receipts (`await-call --all`)
#                                                while replica 3 is stopped is left uncertain
set -uo pipefail
bin=${1:-.lake/build/bin}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ -n ${2:-} ]]; then helpers=$2
else
  export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$here/target/generic-simplex}
  wrap=(); command -v swarm-build >/dev/null 2>&1 && wrap=(swarm-build)
  for crate in joint-agreement-crypto hyperdocument-link-sqlite-store; do
    ${wrap[@]+"${wrap[@]}"} cargo build --quiet --locked --release --manifest-path "$here/native/$crate/Cargo.toml" ||
      { echo "check-generic-simplex: cargo build of native/$crate failed" >&2; exit 2; }
  done
  ${wrap[@]+"${wrap[@]}"} cargo build --quiet --locked --release --manifest-path "$here/native/credential-signature-verifier/Cargo.toml" \
      --bin minidregg-credential-signature-verifier --example sign-probe ||
    { echo "check-generic-simplex: cargo build of native/credential-signature-verifier failed" >&2; exit 2; }
  helpers=$CARGO_TARGET_DIR/release
fi
for e in generic-simplex-harness generic-simplex-log-reopen generic-simplex-load minidregg-four-source-fixture; do
  [[ -x $bin/$e ]] || { echo "check-generic-simplex: $bin/$e is not executable" >&2; exit 2; }
done
store=$helpers/minidregg-link-sqlite-store; verifier=$helpers/minidregg-credential-signature-verifier
agreement=$helpers/mini-joint-agreement-crypto; signer=$helpers/examples/sign-probe
for e in "$store" "$verifier" "$agreement" "$signer"; do
  [[ -x $e ]] || { echo "check-generic-simplex: helper $e is not executable (see HELPER_DIR above)" >&2; exit 2; }
done
fixture=$bin/minidregg-four-source-fixture
tmp=$(mktemp -d "${TMPDIR:-/tmp}/generic-simplex-audit.XXXXXX")
serving=()
stop_serving() { for pid in ${serving[@]+"${serving[@]}"}; do kill "$pid" 2>/dev/null; done; serving=(); }  # the pids this script started
trap 'stop_serving; rm -rf "$tmp"' EXIT
# A fresh four-Store world in $tmp/NAME with a 2 s view timeout, and one birth call authored on it.
world() {  # NAME
  "$fixture" probe-key "$signer" 7 "$tmp/$1-alice.pub" && "$fixture" probe-key "$signer" 8 "$tmp/$1-bob.pub" &&
  "$fixture" init "$tmp/$1" "$store" "$verifier" "$agreement" "$tmp/$1-alice.pub" "$tmp/$1-bob.pub" 2000 &&
  "$fixture" author-birth "$tmp/$1" "$store" "$verifier" "$agreement" "$signer" 7001 71 "$tmp/$1-call.bin"
}
# One call through in-process agreement among the world's four participants. ARGS: FUEL [--plant NAME]
run_world() {  # NAME ARGS...
  world "$1" && "$fixture" run "$tmp/$1" "$store" "$verifier" "$agreement" "$tmp/$1-call.bin" "${@:2}"
}
# Four standing replica processes over TCP on the world NAME, one client awaiting a second birth.
peers_of() { local base=$((21000 + $$ % 20000)); echo "127.0.0.1:$base,127.0.0.1:$((base+1)),127.0.0.1:$((base+2)),127.0.0.1:$((base+3))"; }
stand() {  # NAME INDEX: start one standing replica; its pid is serving[INDEX]
  "$fixture" serve-replica "$tmp/$1/replica-$2" "$(peers_of)" "$store" "$verifier" "$agreement" 20 >> "$tmp/$1-serve-$2.log" 2>&1 &
  serving[$2]=$!
}
serve() {  # NAME
  local i
  "$fixture" author-birth "$tmp/$1" "$store" "$verifier" "$agreement" "$signer" 7002 72 "$tmp/$1-call2.bin" || return 1
  for i in 0 1 2 3; do stand "$1" $i; done
  "$fixture" await-call "$tmp/$1" "$tmp/$1-call2.bin" "$tmp/$1-outcome2.bin" 30 second 1; local rc=$?
  stop_serving; sleep 1
  [[ $rc == 0 ]] && "$fixture" lookup-all-call "$tmp/$1" "$store" "$verifier" "$agreement" "$tmp/$1-call2.bin" "$tmp/$1-look2.bin"
}
# Replica 3 stopped: a third birth is answered by the other three receipts. With `all`, the client instead
# waits for all four (the plant) and is left uncertain. Otherwise replica 3 is then restarted and, with no
# further call, must hold the record too (`await-call --all` on the same request).
serve_down() {  # NAME [all]
  local i n=3; [[ ${2:-} == all ]] && n=4
  "$fixture" author-birth "$tmp/$1" "$store" "$verifier" "$agreement" "$signer" $((7000+n)) $((70+n)) "$tmp/$1-call$n.bin" || return 1
  for i in 0 1 2; do stand "$1" $i; done
  if [[ ${2:-} == all ]]; then
    "$fixture" await-call "$tmp/$1" "$tmp/$1-call$n.bin" "$tmp/$1-outcome$n.bin" 15 down$n 0 --all; local rc=$?
    stop_serving; sleep 1; return $rc
  fi
  "$fixture" await-call "$tmp/$1" "$tmp/$1-call$n.bin" "$tmp/$1-outcome$n.bin" 30 down$n 0 || { stop_serving; return 1; }
  stand "$1" 3
  "$fixture" await-call "$tmp/$1" "$tmp/$1-call$n.bin" "$tmp/$1-outcome$n.bin" 30 down$n 0 --all; local rc=$?
  stop_serving; sleep 1
  [[ $rc == 0 ]] && "$fixture" lookup-all-call "$tmp/$1" "$store" "$verifier" "$agreement" "$tmp/$1-call$n.bin" "$tmp/$1-look$n.bin"
}
# COUNT births in process on a fresh world; the ordered append must stay flat. ARGS: COUNT WINDOW FACTOR [--plant NAME]
flat() {  # NAME ARGS...
  world "$1" && "$fixture" append-flatness "$tmp/$1" "$store" "$verifier" "$agreement" "$signer" "${@:2}"
}
# One replica stopped for two calls and restarted into an idle domain, in process. ARGS: [--plant NAME]
rejoin() {  # NAME ARGS...
  world "$1" && "$fixture" rejoin "$tmp/$1" "$store" "$verifier" "$agreement" "$signer" "${@:2}"
}
status=0
start=$(date +%s)
pass() {  # NAME EXPECTED-LAST-LINE-PREFIX CMD...
  local name=$1 want=$2 out rc=0; shift 2
  out=$("$@" 2>&1) || rc=$?
  printf '%s\n' "$out" | tail -n 3
  if [[ $rc == 0 && $(printf '%s\n' "$out" | grep -c "^$want") -ge 1 ]]; then echo "RUN $name PASS"
  else echo "RUN $name FAIL rc=$rc (want exit 0 and a line starting '$want')"; status=1; fi
}
plant() {  # NAME EXPECTED-MESSAGE CMD...
  local name=$1 want=$2 out rc=0; shift 2
  out=$("$@" 2>&1) || rc=$?
  if [[ $rc != 0 && $out == *"$want"* ]]; then echo "PLANT $name RED-AS-EXPECTED ($want)"
  else echo "PLANT $name NOT-CAUGHT-AS-RECORDED rc=$rc (want: $want)"; printf '%s\n' "$out" | tail -n 3; status=1; fi
}
pass harness 'PASS GenericSimplex event harness' "$bin/generic-simplex-harness"
pass log-reopen 'PASS checkpoint-then-append' "$bin/generic-simplex-log-reopen"
pass load "${GENERIC_SIMPLEX_LOAD_OPS:-20}"$'\t' "$bin/generic-simplex-load" "${GENERIC_SIMPLEX_LOAD_OPS:-20}" 10
pass four-source-audit 'AUDITED replica 0: 2 segments from genesis' \
  bash -c '"$1/minidregg-four-source-fixture" write-audit-fixture "$2/ok" && "$1/minidregg-four-source-fixture" audit-journal "$2/ok" 0' _ "$bin" "$tmp"
pass four-source-run 'PASS source lost-response/restart' \
  run_world ok-run 400
pass four-source-lookup 'LOOKUP-ALL exact original receipt and complete prefix on four reopened stores; accepted records per store \[1, 1, 1, 1\]' \
  "$fixture" lookup-all-call "$tmp/ok-run" "$store" "$verifier" "$agreement" "$tmp/ok-run-call.bin" "$tmp/ok-run-look.bin"
pass four-source-serve 'LOOKUP-ALL exact original receipt and complete prefix on four reopened stores; accepted records per store \[2, 2, 2, 2\]' \
  serve ok-run
pass four-source-down 'LOOKUP-ALL exact original receipt and complete prefix on four reopened stores; accepted records per store \[3, 3, 3, 3\]' \
  serve_down ok-run
pass four-source-flat 'FLAT ordered append' \
  flat flat-run "${GENERIC_SIMPLEX_FLAT_HEIGHTS:-48}" 8 2
pass four-source-rejoin 'PASS rejoin' \
  rejoin rejoin-run
plant fixed-timer 'backoff: pending block never committed' "$bin/generic-simplex-harness" --plant fixed-timer
plant split-tip 'normal safety/replay' "$bin/generic-simplex-harness" --plant split-tip
plant forged-digest 'forged running digest: a COMMIT for another chain was read' "$bin/generic-simplex-harness" --plant forged-digest
plant undrained-relay 'relayed evidence: a replica four commits behind was not served' "$bin/generic-simplex-harness" --plant undrained-relay
plant flip-byte 'delta-frames: ' "$bin/generic-simplex-log-reopen" --plant flip-byte
plant corrupt-segment 'segment 1: its snapshot is not the state the previous segment replays to' \
  bash -c '"$1/minidregg-four-source-fixture" write-audit-fixture "$2/bad" --plant corrupt-segment && "$1/minidregg-four-source-fixture" audit-journal "$2/bad" 0' _ "$bin" "$tmp"
plant foreign-history "the commitment's digest is not that of the source prefix" \
  run_world bad-run 40 --plant foreign-history
plant revalidate-prefix 'append flatness: the median application hand-off per KB' \
  flat flat-bad 12 3 2 --plant revalidate-prefix
plant silent-rejoin 'rejoin: the restarted replica stayed behind' \
  rejoin rejoin-bad --plant silent-rejoin
plant all-receipts 'AWAIT down4 uncertain' \
  serve_down ok-run all
echo "GENERIC-SIMPLEX wall=$(( $(date +%s) - start ))s status=$status"
exit $status
