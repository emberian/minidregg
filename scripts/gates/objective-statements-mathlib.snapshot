S def Minidregg.Compiler.hashExec : {F : Type u} → [Field F] → {w : ℕ} → [NeZero w] → Minidregg.Compiler.PermSpec F w → (Fin w → F) → F #4226145299
S def Minidregg.Compiler.hashTerm : {F : Type u} → [Field F] → {Idx : Type u} → {w : ℕ} → [NeZero w] → Minidregg.Compiler.PermSpec F w → Idx → (Fin w → Idx) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) #921860657
S theorem Minidregg.Compiler.hashTerm_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (nullifier : Idx) (note : Fin w → Idx), Minidregg.Compiler.accepts asg (Minidregg.Compiler.hashTerm spec nullifier note) ↔ asg nullifier = Minidregg.Compiler.hashExec spec fun i => asg (note i)
