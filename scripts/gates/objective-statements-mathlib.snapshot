S theorem Minidregg.Kernel.PayObservationProofs.creditTo_observed : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {tariff : Minidregg.Kernel.PayTariff.Tariff} {tip : Minidregg.Kernel.PayCell.ChainTip} (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) {observations : List Minidregg.Kernel.PayObservation.Observation} {credits : List Minidregg.Kernel.PayObservation.Credit}, List.Forall₂ (fun o credit => Minidregg.Kernel.PayObservation.decideObservation store tariff tip o = Except.ok credit) observations credits → Minidregg.Kernel.PayObservationProofs.creditTo account credits = (List.map (fun o => Int.ofNat (tariff.creditFor o.amount)) (List.filter (fun o => Decidable.decide (Minidregg.Kernel.PayCell.assignmentAt store o.index = Option.some account)) observations)).sum
S theorem Minidregg.Kernel.PayObservationProofs.credit_only_breaks_audit : -(Minidregg.Kernel.PayObservationProofs.fixtureBook.creditOnly 8 0 1000).balance 0 0 ≠ -Minidregg.Kernel.PayObservationProofs.fixtureBook.balance 0 0 + Minidregg.Kernel.PayObservationProofs.credited 0 [{ tariff := Minidregg.Kernel.PayTariff.exampleTariff, clock := { now := 0, slot := 0 }, tip := Minidregg.Kernel.PayObservationProofs.fixtureTip, credits := [{ index := 0, payer := 8, amount := 1000, credit := 1000 }] }]
S def Minidregg.Kernel.PayObservationProofs.credited : Minidregg.Theory.CanonicalResourceKernel.AssetId → List Minidregg.Kernel.PayObservation.Plan → ℤ #765723664
S theorem Minidregg.Kernel.PayObservationProofs.decided_credit : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {clock : Minidregg.Kernel.ClockCell.Clock} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {tip : Minidregg.Kernel.PayCell.ChainTip} {observations : List Minidregg.Kernel.PayObservation.Observation} {plan : Minidregg.Kernel.PayObservation.Plan}, Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → ∀ credit ∈ plan.credits, ∃ o ∈ observations, Minidregg.Kernel.PayCell.assignmentAt store o.index = Option.some credit.payer ∧ credit.payer ≠ plan.tariff.asset ∧ credit.credit = plan.tariff.creditFor o.amount
S theorem Minidregg.Kernel.PayObservationProofs.decided_payers : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {clock : Minidregg.Kernel.ClockCell.Clock} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {tip : Minidregg.Kernel.PayCell.ChainTip} {observations : List Minidregg.Kernel.PayObservation.Observation} {plan : Minidregg.Kernel.PayObservation.Plan}, Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → ∀ credit ∈ plan.credits, credit.payer ≠ plan.tariff.asset
