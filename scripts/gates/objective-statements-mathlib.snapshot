S def Minidregg.Kernel.World.turnCheck : {R : Minidregg.Kernel.World.Registry} → {TxId Ev D : Type} → [inst : DecidableEq TxId] → [inst_1 : DecidableEq D] → Minidregg.Kernel.World.History R TxId Ev D → Minidregg.Kernel.World.World R TxId D → Minidregg.Kernel.World.Turn R TxId Ev D → ℕ → Option Minidregg.Kernel.World.Reject #2141531588
S theorem Minidregg.Kernel.World.turnCheck_eq_none_iff : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D} {height : ℕ}, Minidregg.Kernel.World.turnCheck H w t height = Option.none ↔ t.nullifiers.Nodup ∧ (t.notBefore ≤ height ∧ Option.all (fun u => Decidable.decide (height ≤ u)) t.validUntil = Bool.true) ∧ (∀ n ∈ t.nullifiers, w.spent n = Option.none) ∧ t.charge Minidregg.Theory.ResourceCost.Lane.storageBytes = Minidregg.Kernel.World.patchBytes H t ∧ t.charge ≤ w.meter
S theorem Minidregg.Kernel.World.validFrom_createReads : ∀ {R : Minidregg.Kernel.World.Registry} {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)), Minidregg.Theory.Store.Patch.ValidFrom s (List.map (fun c => Minidregg.Theory.Store.Op.read Minidregg.Kernel.World.SysSpace.retired c.1 Option.none) cs) ↔ ∀ c ∈ cs, s ⟨Minidregg.Kernel.World.SysSpace.retired, c.1⟩ = Option.none
S theorem Minidregg.Kernel.World.validFrom_debits : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (lanes : List Minidregg.Theory.ResourceCost.Lane) (charge avail : Minidregg.Theory.ResourceCost.Charge), lanes.Nodup → (Minidregg.Theory.Store.Patch.ValidFrom s (Minidregg.Kernel.World.debits lanes charge avail) ↔ ∀ l ∈ lanes, s ⟨Minidregg.Kernel.World.SysSpace.allowance, l⟩ = Option.some (avail l))
S theorem Minidregg.Kernel.World.validFrom_reads : ∀ {L : Minidregg.Theory.Store.Layout} {s : Minidregg.Theory.Store.Store L} {p : Minidregg.Theory.Store.Patch L}, (∀ op ∈ p, Minidregg.Kernel.World.Op.isRead op = Bool.true) → Minidregg.Theory.Store.Patch.ValidFrom s p → ∀ op ∈ p, Minidregg.Theory.Store.Op.Enabled s op
S theorem Minidregg.Kernel.World.validFrom_spentAllocs : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (ns : List D), Minidregg.Theory.Store.Patch.ValidFrom s (Minidregg.Kernel.World.spentAllocs ns) ↔ ns.Nodup ∧ ∀ n ∈ ns, s ⟨Minidregg.Kernel.World.SysSpace.spent, n⟩ = Option.none
S theorem Minidregg.Kernel.World.validFrom_sysPatch : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge), Minidregg.Theory.Store.Patch.ValidFrom s (Minidregg.Kernel.World.sysPatch H t height logRoot avail) ↔ Minidregg.Theory.Store.Patch.ValidFrom s (Minidregg.Kernel.World.sysCore H t height logRoot) ∧ Minidregg.Theory.Store.Patch.ValidFrom (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysCore H t height logRoot)) (Minidregg.Kernel.World.spentAllocs t.nullifiers) ∧ Minidregg.Theory.Store.Patch.ValidFrom (Minidregg.Theory.Store.Patch.run (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysCore H t height logRoot)) (Minidregg.Kernel.World.spentAllocs t.nullifiers)) (Minidregg.Kernel.World.debits (Minidregg.Kernel.World.chargedLanes t.charge) t.charge avail)
