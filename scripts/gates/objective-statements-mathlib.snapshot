S ctor Minidregg.Compiler.Evaluator.mk : (toMachine : Minidregg.Compiler.Machine) → (Spec : toMachine.Term → toMachine.Output → Prop) → (Crash : toMachine.Term → Prop) → (∀ {fuel : ℕ} {t : toMachine.Term} {o : toMachine.Output}, toMachine.run fuel t = Except.ok o → Spec t o) → (∀ {t : toMachine.Term} {o : toMachine.Output}, Spec t o → ∃ n, ∀ (fuel : ℕ), n ≤ fuel → toMachine.run fuel t = Except.ok o ∧ toMachine.steps fuel t = n) → (∀ {t : toMachine.Term} {o o' : toMachine.Output}, Spec t o → Spec t o' → o = o') → (∀ {t : toMachine.Term}, (∃ fuel, toMachine.run fuel t = Except.error Minidregg.Theory.Eval.Outcome.crash) ↔ Crash t) → (∀ {t : toMachine.Term} {o : toMachine.Output}, Crash t → Spec t o → False) → (∀ {fuel fuel' : ℕ} {t : toMachine.Term} {o : toMachine.Output}, toMachine.run fuel t = Except.ok o → fuel ≤ fuel' → toMachine.run fuel' t = Except.ok o) → (∀ {fuel fuel' : ℕ} {t : toMachine.Term}, toMachine.run fuel t ≠ Except.error Minidregg.Theory.Eval.Outcome.exhausted → fuel ≤ fuel' → toMachine.steps fuel' t = toMachine.steps fuel t) → (∃ t fuel o, toMachine.run fuel t = Except.error Minidregg.Theory.Eval.Outcome.exhausted ∧ Spec t o) → (∀ {bs bs' : List UInt8}, toMachine.canonical bs = Bool.true → toMachine.canonical bs' = Bool.true → toMachine.decode bs = toMachine.decode bs' → bs = bs') → Function.Injective toMachine.encodeInput → Function.Injective toMachine.encodeOutput → (∀ {fuel : ℕ} {input out : List UInt8} {k : ℕ}, toMachine.runBytes fuel input = Minidregg.Theory.Eval.ByteRun.ok k out → ∃ t o, toMachine.decodeTerm input = Option.some t ∧ Spec t o ∧ out = toMachine.encodeOutput o) → (∀ {fuel : ℕ} {input : List UInt8} {k : ℕ}, toMachine.runBytes fuel input = Minidregg.Theory.Eval.ByteRun.crash k → ∃ t, toMachine.decodeTerm input = Option.some t ∧ Crash t) → (∀ (fuel : UInt64) (input : ByteArray), toMachine.exportFn fuel input = { data := (toMachine.runBytes fuel.toNat input.toList).toBytes.toArray }) → (∀ (t : toMachine.Term), toMachine.decodeTerm (toMachine.encodeTerm t) = Option.some t) → (∀ {fuel : ℕ} {t : toMachine.Term} {o : toMachine.Output} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.ok o k → toMachine.run fuel t = Except.ok o ∧ toMachine.steps fuel t = k) → (∀ {fuel : ℕ} {t : toMachine.Term} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.crash k → Crash t) → (∀ {fuel : ℕ} {t : toMachine.Term} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.exhausted k → toMachine.run fuel t = Except.error Minidregg.Theory.Eval.Outcome.exhausted ∧ k = fuel) → (∀ (fuel : ℕ) (t : toMachine.Term), toMachine.runBytes fuel (toMachine.encodeTerm t) = Minidregg.Theory.Eval.Ran.toByteRun toMachine.encodeOutput (toMachine.oracle fuel t)) → (∀ (params : toMachine.Params), toMachine.decodeParams (toMachine.encodeParams params) = Option.some params) → (∀ {bytes : List UInt8} {params : toMachine.Params}, toMachine.decodeParams bytes = Option.some params → toMachine.encodeParams params = bytes) → (∀ {layout : List Minidregg.Compiler.NockProgramCodec.SampleSlot} {s s' : Minidregg.Kernel.NockProgramCell.Sample} {i : toMachine.Input}, toMachine.encodeSample layout s = Option.some i → toMachine.encodeSample layout s' = Option.some i → s = s') → (∀ {abi : Minidregg.Compiler.NockProgramCodec.Abi} {ctx : Minidregg.Kernel.NockProgramCell.Context} {targets : List ℕ} {read : ℕ → String → Option ℤ} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot}, toMachine.overMax read abi.sample = Option.some slot → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx targets read).bind (toMachine.encodeSample abi.sample) = Option.none) → (∀ {read read' : ℕ → String → Option ℤ} {slots : List Minidregg.Compiler.NockProgramCodec.SampleSlot}, (∀ s ∈ slots, read s.target s.slot = read' s.target s.slot) → toMachine.overMax read slots = toMachine.overMax read' slots) → (∀ {abi : Minidregg.Compiler.NockProgramCodec.Abi} {ctx ctx' : Minidregg.Kernel.NockProgramCell.Context} {targets : List ℕ} {read read' : ℕ → String → Option ℤ} {s s' : toMachine.Input} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot}, abi.context = Minidregg.Compiler.NockProgramCodec.ContextMode.pinned → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx targets read).bind (toMachine.encodeSample abi.sample) = Option.some s → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx' targets read').bind (toMachine.encodeSample abi.sample) = Option.some s' → slot ∈ abi.sample → read slot.target slot.slot ≠ read' slot.target slot.slot → (∀ x ∈ abi.sample, x ≠ slot → read x.target x.slot = read' x.target x.slot) → s ≠ s' ∧ toMachine.staleField abi s' (toMachine.encodeInput s) = Option.some slot.key) → (∀ d ∈ toMachine.door, ∀ (state : toMachine.Output), d.decodeState (d.encodeState state) = Option.some state) → (∀ d ∈ toMachine.door, ∀ (stored : Option toMachine.Output) (event : ℕ) (ev : d.Event), d.eventOf (toMachine.encodeInput (d.pokeInput stored event ev)) = Option.some ev) → (∀ d ∈ toMachine.door, ∀ {stored stored' : Option toMachine.Output} {event event' : ℕ} {ev ev' : d.Event}, d.pokeInput stored event ev = d.pokeInput stored' event' ev' → stored = stored' ∧ event = event' ∧ ev = ev') → Minidregg.Compiler.Evaluator
