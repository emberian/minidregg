S theorem Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext.prepared_tuple_exact : ∀ {Incidence : Type z} {layout : Minidregg.Kernel.MultiCellHyperedge.CellLayout Incidence} {Source : Type z} {plan : Minidregg.Kernel.MultiCellHyperedge.PreparationPlan layout Source} (project : Source → ((incidence : Incidence) → Minidregg.Theory.Store.Store (layout.storeLayout incidence)) → Minidregg.Pred.State) (semantics : Minidregg.Theory.TypedAuthorization.Digest) (prepared : Minidregg.Kernel.MultiCellHyperedge.PreparedTuple plan), (Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext.ofPreparedTuple project semantics prepared).preStateRoot = (prepared.pre prepared.primary).root ∧ (Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext.ofPreparedTuple project semantics prepared).effectsDigest = plan.legEffectsDigest prepared.source prepared.primary ∧ (Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext.ofPreparedTuple project semantics prepared).oldState = project prepared.source prepared.logicalPre ∧ (Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext.ofPreparedTuple project semantics prepared).newState = project prepared.source prepared.logicalPost
