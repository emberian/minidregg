S theorem Minidregg.Kernel.JobMoney.plan_balance : ∀ (plan : Minidregg.Kernel.JobMoney.Plan) (book : Minidregg.Theory.CanonicalResourceKernel.Book) (a : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (plan.batch.apply book).balance a asset = book.balance a asset + match plan.move with | Minidregg.Kernel.JobMoney.Move.fund account amount => Minidregg.Kernel.JobMoney.flowIn a asset (Minidregg.Theory.CanonicalResourceKernel.Operation.transfer account plan.job plan.asset amount) | Minidregg.Kernel.JobMoney.Move.claim provider account amount => Minidregg.Kernel.JobMoney.flowIn a asset (Minidregg.Theory.CanonicalResourceKernel.Operation.transfer account plan.job plan.asset amount) | Minidregg.Kernel.JobMoney.Move.settle p => Minidregg.Kernel.JobMoney.flowIn a asset (Minidregg.Theory.CanonicalResourceKernel.Operation.transfer plan.job plan.before.providerAcct plan.asset p.provider) + Minidregg.Kernel.JobMoney.flowIn a asset (Minidregg.Theory.CanonicalResourceKernel.Operation.transfer plan.job plan.before.callerAcct plan.asset p.caller) + Minidregg.Kernel.JobMoney.flowIn a asset (Minidregg.Theory.CanonicalResourceKernel.Operation.burn plan.job plan.asset p.retired)
