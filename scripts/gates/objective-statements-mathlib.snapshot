S def Minidregg.Kernel.JointDecisionRecovery.Commit : {Custody : Type} → {plan : Minidregg.Kernel.JointInvocationCandidate.Plan Custody} → Minidregg.Kernel.JointDecisionRecovery.State plan → Prop := fun {Custody} {plan} s => ∀ (i : Fin plan.candidate.participants.length), s.votes i = Minidregg.Kernel.JointDecisionRecovery.Vote.yes
S def Minidregg.Kernel.JointDecisionRecovery.LastReady : {Custody : Type} → {plan : Minidregg.Kernel.JointInvocationCandidate.Plan Custody} → Minidregg.Kernel.JointDecisionRecovery.State plan → Prop := fun {Custody} {plan} s => (∀ (i : Fin plan.candidate.participants.length), i ≠ plan.last → s.votes i = Minidregg.Kernel.JointDecisionRecovery.Vote.yes) ∧ match s.recovery with | Option.none => False | Option.some job => job.originFence = plan.candidate.originFence ∧ ∀ (i : Fin plan.candidate.participants.length), i ≠ plan.last → s.certificates i ≠ [] ∧ s.certificates i ∈ job.evidence
