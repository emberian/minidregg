S theorem Minidregg.Kernel.PayEnrolV2Decision.expired_is_pending : ∀ (store : Minidregg.Kernel.PayCell.PayStore) (pricing : Minidregg.Kernel.PayEnrolV2Decision.Pricing) (tariff : Minidregg.Kernel.PayTariff.Tariff) (tip : Minidregg.Kernel.PayCell.ChainTip) (o : Minidregg.Kernel.PayObservation.Observation) (memo : Minidregg.Kernel.PayEnrolV2Decision.Memo) (custody : Minidregg.Kernel.PayEnrolV2Decision.Custody) (float : ℕ), custody.stale = Bool.false → memo.unsigned.expiresAtProcessingChainHour < tip.hour → Minidregg.Kernel.PayEnrolV2Decision.classifyTerms store pricing tariff tip o memo custody float = Minidregg.Kernel.PayEnrolV2Decision.Decision.pending (Minidregg.Kernel.PayEnrolV2Decision.pendingPlan o memo custody Minidregg.Kernel.PayEnrolClaim.PendingReason.expired)
S theorem Minidregg.Kernel.PayEnrolV2Decision.fixed_quote_partition : ∀ (amount : ℕ) (tariff : Minidregg.Kernel.PayTariff.Tariff) (birth weeks starter : ℕ) (quote : Minidregg.Kernel.PayEnrolV2Decision.FixedQuote), Minidregg.Kernel.PayEnrolClaim.quoteFixed amount tariff birth weeks starter = Except.ok quote → quote.requestedWeeks = weeks ∧ quote.birthFee + quote.membershipCredit + quote.creditedRemainder = quote.credit ∧ starter ≤ quote.creditedRemainder
S def Minidregg.Kernel.PayEnrolV2Decision.initialIdentity : Minidregg.Kernel.PayEnrolV2Decision.Unsigned → Prop := fun value => value.mode = Minidregg.Kernel.PayEnrolMemoV2.Mode.enroll ∧ value.authorizingKey = value.enrollmentIdentityKey ∧ value.authorityEpoch = 1
