S theorem Minidregg.Kernel.World.sysPatch_valid_plain : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)} {t : Minidregg.Kernel.World.Turn R TxId Ev D} {height : ℕ} {logRoot : D} {avail : Minidregg.Theory.ResourceCost.Charge}, t.creates = [] → t.retires = [] → s ⟨Minidregg.Kernel.World.SysSpace.journal, t.txId⟩ = Option.none → s ⟨Minidregg.Kernel.World.SysSpace.head, ()⟩ = Option.some (height, logRoot) → (t.nullifiers.Nodup ∧ ∀ n ∈ t.nullifiers, s ⟨Minidregg.Kernel.World.SysSpace.spent, n⟩ = Option.none) → (∀ (l : Minidregg.Theory.ResourceCost.Lane), t.charge l ≠ 0 → s ⟨Minidregg.Kernel.World.SysSpace.allowance, l⟩ = Option.some (avail l)) → Minidregg.Theory.Store.Patch.ValidFrom s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)
