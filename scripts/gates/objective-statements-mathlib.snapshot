S theorem Minidregg.Compiler.muxStepExec_zero : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (n s : F), Minidregg.Compiler.muxStepExec spec n (s, 0) = Minidregg.Compiler.compressExec spec n s
