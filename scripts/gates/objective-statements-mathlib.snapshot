S theorem Minidregg.Compiler.orderAux_zero : ∀ {F : Type} [inst : Field F] (width : ℕ) (present : Bool) (a b : ℤ), Minidregg.Compiler.orderAux width present a b 0 = ↑(Minidregg.Compiler.PredOrder.shiftedNat width present a b)
