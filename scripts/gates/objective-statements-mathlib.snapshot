S theorem Minidregg.Theory.AcceptedCellEffect.changed_only_declared : ∀ {L : Minidregg.Theory.Store.Layout} {M : Minidregg.Theory.CellState.Materializer L Minidregg.Theory.TypedAuthorization.Digest} {Nullifier : Type y} {family : Minidregg.Theory.SemanticEffectFamily L M Nullifier} {portal : Minidregg.Theory.TypedAuthorization.Portal} {authState : Minidregg.Theory.TypedAuthorization.AuthState} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {pre : Minidregg.Theory.CellState.Materialized M} {declaration : family.Declaration} {outcome : family.Outcome declaration} (accepted : Minidregg.Theory.AcceptedCellEffect family request pre declaration outcome) (address : Minidregg.Theory.Store.Address L), accepted.prepared.post.logical address ≠ pre.logical address → address ∈ (family.patch declaration outcome).writeFootprint
S def Minidregg.Theory.AcceptedCellEffect.disclosure : {L : Minidregg.Theory.Store.Layout} → {M : Minidregg.Theory.CellState.Materializer L Minidregg.Theory.TypedAuthorization.Digest} → {Nullifier : Type y} → {family : Minidregg.Theory.SemanticEffectFamily L M Nullifier} → {portal : Minidregg.Theory.TypedAuthorization.Portal} → {authState : Minidregg.Theory.TypedAuthorization.AuthState} → {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} → {request : Minidregg.Theory.TypedAuthorization.Request kind} → {pre : Minidregg.Theory.CellState.Materialized M} → {declaration : family.Declaration} → {outcome : family.Outcome declaration} → Minidregg.Theory.AcceptedCellEffect family request pre declaration outcome → Minidregg.Theory.DisclosureDecision (family.Release declaration outcome) (family.DeclassificationAuthority declaration outcome) (family.ReleaseAuthorization declaration outcome) #4197018308
