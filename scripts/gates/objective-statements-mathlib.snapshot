S theorem Minidregg.Kernel.Invitations.spend_once : ∀ {registry next : Minidregg.Kernel.Invitations.Registry} {subject subject' : Minidregg.Theory.TypedAuthorization.SubjectId} {id : Minidregg.Kernel.Invitations.InvitationId} {expect expect' : Minidregg.Kernel.Invitations.Expectation} {invitation : Minidregg.Kernel.Invitations.Invitation}, Minidregg.Kernel.Invitations.spend registry subject id expect = Except.ok (invitation, next) → Minidregg.Kernel.Invitations.spend next subject' id expect' = Except.error (Minidregg.Kernel.Invitations.Refusal.invitationMissing id)
