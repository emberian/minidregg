S theorem Minidregg.Kernel.RealmWellReceiver.decideWell_ok : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {realmOf : ℕ → Option ℕ} {credit : Minidregg.Theory.CanonicalResourceKernel.AssetId} {command : Minidregg.Compiler.RealmWellCodec.Command} {plan : Minidregg.Kernel.RealmWellReceiver.Plan}, Minidregg.Kernel.RealmWellReceiver.decideWell book realmOf credit command = Except.ok plan → command.well ≠ credit ∧ command.account ≠ command.well ∧ 0 < command.amount ∧ ∃ realm, realmOf command.well = Option.some realm ∧ plan = { asset := command.well, realm := realm, op := command.op, account := command.account, amount := command.amount } ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch
S theorem Minidregg.Kernel.RealmWellReceiver.decided_apply : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {realmOf : ℕ → Option ℕ} {credit : Minidregg.Theory.CanonicalResourceKernel.AssetId} {command : Minidregg.Compiler.RealmWellCodec.Command} {plan : Minidregg.Kernel.RealmWellReceiver.Plan}, Minidregg.Kernel.RealmWellReceiver.decideWell book realmOf credit command = Except.ok plan → plan.batch.apply book = plan.operation.apply book ∧ plan.asset = command.well ∧ plan.account = command.account ∧ plan.amount = command.amount ∧ plan.op = command.op
S theorem Minidregg.Kernel.RealmWellReceiver.decided_extends_log : ∀ {initial book : Minidregg.Theory.CanonicalResourceKernel.Book} {log : List Minidregg.Kernel.RealmWellReceiver.Plan} {realmOf : ℕ → Option ℕ} {credit : Minidregg.Theory.CanonicalResourceKernel.AssetId} {command : Minidregg.Compiler.RealmWellCodec.Command} {plan : Minidregg.Kernel.RealmWellReceiver.Plan}, Minidregg.Kernel.RealmWellReceiver.AcceptedLog initial log book → Minidregg.Kernel.RealmWellReceiver.decideWell book realmOf credit command = Except.ok plan → Minidregg.Kernel.RealmWellReceiver.AcceptedLog initial (log ++ [plan]) (plan.batch.apply book)
