S theorem Minidregg.Kernel.World.genesis_wf : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (cells : Minidregg.Kernel.World.Cells R), (Minidregg.Kernel.World.genesis H cells).WF
S theorem Minidregg.Kernel.World.journal_exact : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ (x : TxId) (i : ℕ) (d : D), W.journal x = Option.some (i, d) ↔ ∃ t, log[i]? = Option.some t ∧ t.txId = x ∧ d = H.turnDigest t
S theorem Minidregg.Kernel.World.journal_height_iff : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ (x : TxId) (i : ℕ), Option.map Prod.fst (W.journal x) = Option.some i ↔ Option.map Minidregg.Kernel.World.Turn.txId log[i]? = Option.some x
