S inductive Minidregg.Compiler.SemanticManifest.Manifest.WellFormed : Minidregg.Compiler.SemanticManifest.Manifest → Prop
S theorem Minidregg.Compiler.SemanticManifest.Manifest.WellFormed.bridgeEndpointsClosed : ∀ {manifest : Minidregg.Compiler.SemanticManifest.Manifest}, manifest.WellFormed → ∀ bridge ∈ manifest.bridges, (∃ source, manifest.lookupCarrier bridge.sourceCarrierId = Option.some source) ∧ (∃ target, manifest.lookupCarrier bridge.targetCarrierId = Option.some target) ∧ (∃ sourceCodec, manifest.lookupCodec bridge.sourceCodecId = Option.some sourceCodec) ∧ ∃ targetCodec, manifest.lookupCodec bridge.targetCodecId = Option.some targetCodec
S theorem Minidregg.Compiler.SemanticManifest.Manifest.WellFormed.bridgeIdsUnique : ∀ {manifest : Minidregg.Compiler.SemanticManifest.Manifest}, manifest.WellFormed → manifest.BridgeIdsUnique
