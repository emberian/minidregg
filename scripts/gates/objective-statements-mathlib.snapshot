S theorem Minidregg.Theory.StoreFootprint.footprint_touched_exact : ∀ {L : Minidregg.Theory.Store.Layout} (field : Minidregg.Theory.Store.Address L → Minidregg.Theory.TypedAuthorization.CellField) (amount : (address : Minidregg.Theory.Store.Address L) → L.Value address.fst → ℤ) (pre post : Minidregg.Theory.Store.Store L) (named : Minidregg.Theory.TypedAuthorization.CellField), named ∈ (Minidregg.Theory.StoreFootprint.footprint field amount pre post).touched ↔ ∃ address, pre address ≠ post address ∧ field address = named
S theorem Minidregg.Theory.StoreFootprint.mem_changed : ∀ {L : Minidregg.Theory.Store.Layout} {pre post : Minidregg.Theory.Store.Store L} {address : Minidregg.Theory.Store.Address L}, address ∈ Minidregg.Theory.StoreFootprint.changed pre post ↔ pre address ≠ post address
S def Minidregg.Theory.TowerMulFull : Prop := ∀ (k : ℕ), Function.Bijective (Minidregg.Theory.towerPack k)
S def Minidregg.Theory.TowerRSDistance : Prop := ∀ (k d n : ℕ) (α : Fin n → Minidregg.Theory.binaryTower k), Function.Injective α → ∀ (p q : Polynomial (Minidregg.Theory.binaryTower k)), p.degree < ↑d → q.degree < ↑d → d ≤ n → p ≠ q → n < Nat.card { i // Polynomial.eval (α i) p ≠ Polynomial.eval (α i) q } + d
