S theorem Minidregg.Kernel.NativeHostGenesis.genesis_confines_observer : ∀ {F : Type} [inst : Field F] (profile : Minidregg.Compiler.CanonicalRuntimeProfile.Profile F) (config : Minidregg.Kernel.NativeHostGenesis.Config) (observer : Minidregg.Kernel.NativeHostGenesis.PayObserver), config.payObserver = Option.some observer → (Minidregg.Kernel.NativeHostGenesis.factoryPolicy profile config).predicate = Minidregg.Kernel.NativeHostGenesis.tickerConfinedLaw config.clockTickers (Minidregg.Kernel.NativeHostGenesis.confinedFactoryLaw observer.subject (Minidregg.Kernel.PayClaimLaw.extend config.factoryPredicate)) ∧ Minidregg.Kernel.NativeHostGenesis.capabilityEntry (Minidregg.Kernel.NativeHostGenesis.enrolCapability profile config observer) ∈ Minidregg.Kernel.NativeHostGenesis.entries profile config ∧ (Minidregg.Kernel.NativeHostGenesis.enrolCapability profile config observer).holder = Minidregg.Theory.TypedAuthorization.Holder.subject observer.subject ∧ (Minidregg.Kernel.NativeHostGenesis.enrolCapability profile config observer).scope.targets = Minidregg.Theory.TypedAuthorization.TargetSet.explicit {{ value := config.deployment.factoryId }} ∧ (Minidregg.Kernel.NativeHostGenesis.enrolCapability profile config observer).scope.verbs = {Minidregg.Theory.TypedAuthorization.Verb.installPolicy}
