S theorem Minidregg.Kernel.WorldRootCache.lastVal_cons : ∀ {K C : Type} [inst : DecidableEq K] (e : K × C) (es : List (K × C)) (k : K), Minidregg.Kernel.WorldRootCache.lastVal (e :: es) k = (Minidregg.Kernel.WorldRootCache.lastVal es k).or (if e.1 = k then Option.some e.2 else Option.none)
