S theorem Minidregg.Kernel.World.footprint_pinned : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, ∀ leg ∈ t.legs, leg.cell ∉ List.map Prod.fst t.creates → leg.cell ∉ t.retires → ∀ {pre : Minidregg.Theory.Store.Store (R.layout leg.kind)}, ((w.cells leg.cell).bind fun x => x.storeAt leg.kind) = Option.some pre → ∀ {op : Minidregg.Theory.Store.Op (R.layout leg.kind)}, op ∈ leg.guards → ¬Minidregg.Theory.Store.Op.Enabled pre op → Minidregg.Kernel.World.World.step H w t = Option.none
