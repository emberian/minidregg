S theorem Minidregg.Kernel.PresenceIndex.greatest_of_snoc : ∀ (P : Minidregg.Kernel.DurableReceiver.IntentRecord → Prop) [inst : DecidablePred P] (lookup : List Minidregg.Kernel.DurableReceiver.IntentRecord → Option ℕ), lookup [] = Option.none → (∀ (log : List Minidregg.Kernel.DurableReceiver.IntentRecord) (record : Minidregg.Kernel.DurableReceiver.IntentRecord), lookup (log ++ [record]) = if P record then Option.some (log.length + 1) else lookup log) → ∀ (log : List Minidregg.Kernel.DurableReceiver.IntentRecord) (height : ℕ), lookup log = Option.some height ↔ Minidregg.Kernel.PresenceIndex.Occurs P log height ∧ ∀ (other : ℕ), Minidregg.Kernel.PresenceIndex.Occurs P log other → other ≤ height
