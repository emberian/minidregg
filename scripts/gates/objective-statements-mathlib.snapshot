S theorem Minidregg.Compiler.orderOperands_out_of_range : ∀ {width : ℕ} {q : Minidregg.Pred.Pred} {old new : Minidregg.Pred.State}, q.isOrderAtom = Bool.true → Minidregg.Compiler.inputsInRange (Minidregg.Compiler.CompilerProfile.scalar width) q old new = Bool.false → ¬(-2 ^ width ≤ (Minidregg.Compiler.orderOperands q old new).2 - (Minidregg.Compiler.orderOperands q old new).1 ∧ (Minidregg.Compiler.orderOperands q old new).2 - (Minidregg.Compiler.orderOperands q old new).1 < 2 ^ width)
