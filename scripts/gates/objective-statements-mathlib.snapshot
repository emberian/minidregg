S theorem Minidregg.Pred.eval_all : ∀ (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.Pred.all ps) old new = ps.all fun q => Minidregg.Pred.eval q old new
S theorem Minidregg.Pred.eval_any : ∀ (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.Pred.any ps) old new = ps.any fun q => Minidregg.Pred.eval q old new
S theorem Minidregg.Pred.eval_eq_absent : Minidregg.Pred.eval (Minidregg.Pred.Pred.eq "absent" 0) Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.false
S theorem Minidregg.Pred.eval_le_absent : Minidregg.Pred.eval (Minidregg.Pred.Pred.le "absent" 99) Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.false
