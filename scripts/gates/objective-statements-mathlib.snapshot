S theorem Minidregg.Theory.PlanBinding.Opened.verifyAll_sound : ∀ {K V D : Type} [inst : DecidableEq K] [inst_1 : DecidableEq D] (S : Minidregg.Theory.AuthMap.Scheme K V D) (m : Minidregg.Theory.AuthMap.Map K V) (fp : List (Minidregg.Theory.PlanBinding.Opened.Entry K V D)), (∀ e ∈ fp, S.PathBinding m e.key e.value e.opening) → Minidregg.Theory.PlanBinding.Opened.verifyAll S (S.root m) fp = Bool.true → ∀ e ∈ fp, Minidregg.Theory.AuthMap.lookup S.ix m e.key = e.value
