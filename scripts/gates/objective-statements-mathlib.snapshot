S def Minidregg.Selvage.IsProximityGenerator : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [inst : Field F] → [DecidableEq F] → {ℓ : ℕ} → Minidregg.Selvage.ProximityGenerator F ℓ → Submodule F (ι → F) → ℝ → (ℝ → ℝ) → Prop := fun {ι} [Fintype ι] {F} [Field F] [DecidableEq F] {ℓ} G C B err => ∀ (f : Fin ℓ → ι → F) (δ : ℝ), 0 < δ → δ < 1 - B → (err δ < G.pr fun r => Minidregg.Selvage.close δ C (Minidregg.Selvage.comb r f)) → Minidregg.Selvage.CorrelatedAgreement C δ f
