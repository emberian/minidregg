S theorem Minidregg.Kernel.PayObservationProofs.address_mismatch_refused : Minidregg.Kernel.PayObservation.decideObservations Minidregg.Kernel.PayObservationProofs.fixtureStore Minidregg.Kernel.ClockCell.genesisClock Minidregg.Kernel.PayObservationProofs.fixtureBook Minidregg.Kernel.PayObservationProofs.fixtureTip [Minidregg.Kernel.PayObservationProofs.observed 0 Minidregg.Kernel.PayObservationProofs.rowB Minidregg.Kernel.PayObservationProofs.signature₁ 1000] = Except.error Minidregg.Kernel.PayObservation.Reject.addressMismatch
