S theorem Minidregg.Selvage.card_agreeFinset_lt : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [inst_2 : DecidableEq F] {d : ℕ} {p q : Polynomial F}, p.degree < ↑d → q.degree < ↑d → p ≠ q → (Minidregg.Selvage.agreeFinset p q).card < d
S theorem Minidregg.Selvage.card_agreeSet_lt_of_ne : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] (dom : ι ↪ F) {d : ℕ} {p q : Polynomial F}, p.degree < ↑d → q.degree < ↑d → p ≠ q → {i | Polynomial.eval (dom i) p = Polynomial.eval (dom i) q}.card < d
S theorem Minidregg.Selvage.card_batch_satisfying_le : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] [inst_3 : Fintype F] {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, (∃ c ∈ cs, ¬Minidregg.Selvage.Satisfies f c) → {γ | Minidregg.Selvage.Satisfies f (Minidregg.Selvage.batchConstraint γ cs)}.card ≤ cs.length - 1
S theorem Minidregg.Selvage.card_le_of_subtype : ∀ {C : Type} [inst : Fintype C] (p : C → Prop), ↑(Nat.card { c // p c }) ≤ ↑(Fintype.card C)
S theorem Minidregg.Selvage.card_mono_of_imp : ∀ {C : Type} [Fintype C] {p q : C → Prop}, (∀ (c : C), p c → q c) → ↑(Nat.card { c // p c }) ≤ ↑(Nat.card { c // q c })
S theorem Minidregg.Selvage.card_pi_eq_on : ∀ {C : Type} [inst : Fintype C] {K : Type} [inst_1 : Fintype K] [DecidableEq K] (S : Finset K) (u : K → C), Nat.card { d // ∀ i ∈ S, d i = u i } = Fintype.card C ^ (Fintype.card K - S.card)
S theorem Minidregg.Selvage.card_resolve_runFrom : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (Q : Fin r.k → Minidregg.Selvage.SrMove r s) (u : Fin r.k → r.Chal) (m : ℕ) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)) (S : Finset (Fin r.k)), (∀ i ∈ S, ∀ e ∈ L, e.1 ≠ Q i) → (∀ i ∈ S, ∀ i' ∈ S, i ≠ i' → Q i ≠ Q i') → Nat.card { x // ∀ i ∈ S, Minidregg.Selvage.resolveIn (Minidregg.Selvage.runFrom P L (List.ofFn x.1)) (Q i) (x.2 i) = u i } = Fintype.card r.Chal ^ (m + (r.k - S.card))
S theorem Minidregg.Selvage.card_subtype_fiber_decomp : ∀ {W V : Type} [Fintype W] [inst : Fintype V] (f : W → V) (p : W → Prop), Nat.card { w // p w } = ∑ v, Nat.card { w // f w = v ∧ p w }
S theorem Minidregg.Selvage.card_subtype_pi_succ : ∀ {C D : Type} [inst : Fintype C] [Fintype D] {m : ℕ} (p : (Fin (m + 1) → C) × D → Prop), Nat.card { x // p x } = ∑ ρ, Nat.card { w // p (Fin.cons ρ w.1, w.2) }
S theorem Minidregg.Selvage.card_subtype_prod : ∀ {A B : Type} [inst : Fintype A] [Fintype B] (p : A × B → Prop), Nat.card { x // p x } = ∑ a, Nat.card { b // p (a, b) }
S theorem Minidregg.Selvage.chain_descend : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (st : Minidregg.Selvage.Stmt r) {rounds : List (r.PMsg × r.Chal)}, rounds.length = r.k → ∀ (w' : r.W), ∀ i ≤ r.k, rbr.kstate.state δ st { rounds := List.take i rounds, pending := Option.none } (Minidregg.Selvage.wAt rbr st rounds w' i) = Bool.true → (∃ a π ρ, rounds[↑a]? = Option.some (π, ρ) ∧ Minidregg.Selvage.RoundBad rbr δ st (List.take (↑a) rounds) π ρ) ∨ rbr.kstate.state δ st { rounds := List.take 0 rounds, pending := Option.none } (Minidregg.Selvage.wAt rbr st rounds w' 0) = Bool.true
S def Minidregg.Selvage.chalOf : {F : Type} → [Field F] → {v : ℕ} → (Fin v → F) → ℕ → F #3527394000
S theorem Minidregg.Selvage.chalOf_coe : ∀ {F : Type} [inst : Field F] {v : ℕ} (r : Fin v → F) (i : Fin v), Minidregg.Selvage.chalOf r ↑i = r i
S theorem Minidregg.Selvage.chalOf_restrict : ∀ {F : Type} [inst : Field F] {m : ℕ} (r : Fin m → F), (fun j => Minidregg.Selvage.chalOf r ↑j) = r
S def Minidregg.Selvage.chiEval : {F : Type u_1} → [CommRing F] → {m : ℕ} → (Fin m → Bool) → (Fin m → F) → F #1037254640
S theorem Minidregg.Selvage.chiEval_cubePt : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (b b' : Fin m → Bool), Minidregg.Selvage.chiEval b (Minidregg.Selvage.cubePt b') = if b = b' then 1 else 0
S theorem Minidregg.Selvage.chiEval_update : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (b : Fin m → Bool) (x : Fin m → F) (i : Fin m) (t : F), Minidregg.Selvage.chiEval b (Function.update x i t) = (1 - t) * Minidregg.Selvage.chiEval b (Function.update x i 0) + t * Minidregg.Selvage.chiEval b (Function.update x i 1)
S def Minidregg.Selvage.close : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [inst : Field F] → [DecidableEq F] → ℝ → Submodule F (ι → F) → (ι → F) → Prop := fun {ι} [Fintype ι] {F} [Field F] [DecidableEq F] δ C f => ∃ u ∈ C, Minidregg.Selvage.relDist f u ≤ δ
S theorem Minidregg.Selvage.codeword_eq_of_close_of_close : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] [Nonempty ι] {C : Submodule F (ι → F)} {dC δ : ℝ}, (∀ u ∈ C, ∀ v ∈ C, u ≠ v → dC ≤ Minidregg.Selvage.relDist u v) → ∀ {u v g : ι → F}, u ∈ C → v ∈ C → δ < dC / 2 → Minidregg.Selvage.relDist g u ≤ δ → Minidregg.Selvage.relDist g v ≤ δ → u = v
S theorem Minidregg.Selvage.coe_reedSolomonCode : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] (dom : ι ↪ F) (d : ℕ), ↑(Minidregg.Selvage.reedSolomonCode dom d) = {f | ∃ p, p.degree < ↑d ∧ ∀ (i : ι), f i = Polynomial.eval (dom i) p}
S def Minidregg.Selvage.comb : {ι : Type u_1} → {F : Type u_2} → [Field F] → {ℓ : ℕ} → (Fin ℓ → F) → (Fin ℓ → ι → F) → ι → F #2632079832
S theorem Minidregg.Selvage.comb_affineGenerator : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] [inst_1 : DecidableEq F] [inst_2 : Fintype F] (r : F) (f : Fin 2 → ι → F) (x : ι), Minidregg.Selvage.comb ((Minidregg.Selvage.affineGenerator F).gen r) f x = f 0 x + r * f 1 x
S theorem Minidregg.Selvage.comb_agreesOn : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] {ℓ : ℕ} {S : Finset ι} {r : Fin ℓ → F} {f u : Fin ℓ → ι → F}, (∀ (j : Fin ℓ), Minidregg.Selvage.AgreesOn S (f j) (u j)) → Minidregg.Selvage.AgreesOn S (Minidregg.Selvage.comb r f) (Minidregg.Selvage.comb r u)
S theorem Minidregg.Selvage.comb_mem : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] {ℓ : ℕ} {C : Submodule F (ι → F)} (r : Fin ℓ → F) {u : Fin ℓ → ι → F}, (∀ (j : Fin ℓ), u j ∈ C) → Minidregg.Selvage.comb r u ∈ C
S theorem Minidregg.Selvage.committed_extract_bind : ∀ {Root : Type u_1} {F : Type u_2} {ι : Type u_3} {Op : Type u_4} [inst : Field F] {r : ℕ} (S : Minidregg.Selvage.BindingCommitment Root F ι Op) {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {w e : ι → F} {oe : ι → Op}, A.rt = (↑S).commit w → (∀ (i : ι), (↑S).verifyOpen A.rt i (e i) (oe i)) → Minidregg.Selvage.AccClaim.Satisfies C A e → e = w ∧ Minidregg.Selvage.AccClaim.Satisfies C A w
S theorem Minidregg.Selvage.committed_fold_bind : ∀ {Root : Type u_1} {F : Type u_2} {ι : Type u_3} {Op : Type u_4} [inst : Field F] {r : ℕ} (S : Minidregg.Selvage.BindingCommitment Root F ι Op) (foldRoot : Root → F → Root → Root) {C : Submodule F (ι → F)} {A B : Minidregg.Selvage.AccClaim Root F ι r} {γ : F} {w h : ι → F} {oh : ι → Op}, foldRoot A.rt γ B.rt = (↑S).commit w → (∀ (i : ι), (↑S).verifyOpen (Minidregg.Selvage.foldClaims foldRoot A B γ).rt i (h i) (oh i)) → Minidregg.Selvage.AccClaim.Satisfies C (Minidregg.Selvage.foldClaims foldRoot A B γ) h → h = w ∧ Minidregg.Selvage.AccClaim.Satisfies C (Minidregg.Selvage.foldClaims foldRoot A B γ) w
S def Minidregg.Selvage.consSplit : (m : ℕ) → (C D : Type) → (Fin (m + 1) → C) × D ≃ C × (Fin m → C) × D #3516945850
S def Minidregg.Selvage.constrainedRS : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [Field F] → (ι ↪ F) → ℕ → List (Minidregg.Selvage.LinearConstraint ι F) → Set (ι → F) := fun {ι} [Fintype ι] {F} [Field F] dom d cs => {f | f ∈ Minidregg.Selvage.reedSolomonCode dom d ∧ ∀ c ∈ cs, Minidregg.Selvage.Satisfies f c}
S theorem Minidregg.Selvage.constrainedRS_anti : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (dom : ι ↪ F) (d : ℕ) {cs₁ cs₂ : List (Minidregg.Selvage.LinearConstraint ι F)}, (∀ c ∈ cs₁, c ∈ cs₂) → Minidregg.Selvage.constrainedRS dom d cs₂ ⊆ Minidregg.Selvage.constrainedRS dom d cs₁
S theorem Minidregg.Selvage.constrainedRS_append : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (dom : ι ↪ F) (d : ℕ) (cs₁ cs₂ : List (Minidregg.Selvage.LinearConstraint ι F)), Minidregg.Selvage.constrainedRS dom d (cs₁ ++ cs₂) = Minidregg.Selvage.constrainedRS dom d cs₁ ∩ Minidregg.Selvage.constrainedRS dom d cs₂
S theorem Minidregg.Selvage.constrainedRS_nil : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (dom : ι ↪ F) (d : ℕ), Minidregg.Selvage.constrainedRS dom d [] = ↑(Minidregg.Selvage.reedSolomonCode dom d)
S theorem Minidregg.Selvage.constrainedRS_subset_batch : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (dom : ι ↪ F) (d : ℕ) (γ : F) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), Minidregg.Selvage.constrainedRS dom d cs ⊆ Minidregg.Selvage.constrainedRS dom d [Minidregg.Selvage.batchConstraint γ cs]
S theorem Minidregg.Selvage.constrainedRS_subset_code : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (dom : ι ↪ F) (d : ℕ) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), Minidregg.Selvage.constrainedRS dom d cs ⊆ ↑(Minidregg.Selvage.reedSolomonCode dom d)
S def Minidregg.Selvage.constraintSummand : {ι : Type u_1} → {F : Type} → [Field F] → Minidregg.Selvage.LinearConstraint ι F → (ι → F) → ι → F #3246151639
S theorem Minidregg.Selvage.constraint_as_hypercube_sum : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] {v : ℕ} (e : ι ≃ (Fin v → Bool)) (f : ι → F) (c : Minidregg.Selvage.LinearConstraint ι F), Minidregg.Selvage.Satisfies f c ↔ ∑ b, Minidregg.Selvage.constraintSummand c f (e.symm b) = c.target
S theorem Minidregg.Selvage.constraint_as_sumcheck : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] (f : ι → F) (c : Minidregg.Selvage.LinearConstraint ι F), Minidregg.Selvage.Satisfies f c ↔ ∑ i, Minidregg.Selvage.constraintSummand c f i = c.target
S theorem Minidregg.Selvage.cover : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (Z : Set (Minidregg.Selvage.Stmt r)) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (P : Minidregg.Selvage.SrProver r s) (ω : (Fin t → r.Chal) × (Fin r.k → r.Chal)), ((Minidregg.Selvage.srOut P ω.1).stmt ∈ Z ∧ ¬Minidregg.Selvage.RelaxedMem r.R δ (Minidregg.Selvage.srOut P ω.1).stmt.idx (Minidregg.Selvage.srOut P ω.1).stmt.x (Minidregg.Selvage.srOut P ω.1).stmt.y (Minidregg.Selvage.srExtract rbr s (Minidregg.Selvage.srOut P ω.1) (Minidregg.Selvage.srFinalChal P ω.1 ω.2) (Minidregg.Selvage.srTrace P ω.1)) ∧ ∃ x' y', r.verify (Minidregg.Selvage.srOut P ω.1).stmt.idx (Minidregg.Selvage.srOut P ω.1).stmt.x (Minidregg.Selvage.srOut P ω.1).stmt.y (Minidregg.Selvage.srOut P ω.1).πs (Minidregg.Selvage.srFinalChal P ω.1 ω.2) = Option.some (x', y') ∧ Minidregg.Selvage.RelaxedMem r.R' δ (Minidregg.Selvage.srOut P ω.1).stmt.idx x' y' (Minidregg.Selvage.srOut P ω.1).w') → (∃ a, Minidregg.Selvage.FreshBad rbr Z δ P a ω) ∨ ∃ j, Minidregg.Selvage.HitBad rbr Z δ P j ω
S def Minidregg.Selvage.cubePt : {F : Type u_1} → [CommRing F] → {m : ℕ} → (Fin m → Bool) → Fin m → F #1239836619
S theorem Minidregg.Selvage.cubePt_apply : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (b : Fin m → Bool) (i : Fin m), Minidregg.Selvage.cubePt b i = Minidregg.Selvage.ofBool (b i)
S def Minidregg.Selvage.decider : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → Submodule F (ι → F) → Minidregg.Selvage.AccClaim Root F ι r → (ι → F) → Prop := fun {Root} {F} [Field F] {ι} {r} C A f => f ∈ C ∧ ∀ (i : Fin r), (A.weights i) f = A.targets i
S theorem Minidregg.Selvage.decider_complete : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {f : ι → F}, Minidregg.Selvage.AccClaim.Satisfies C A f → Minidregg.Selvage.decider C A f
S theorem Minidregg.Selvage.decider_constrainedRS : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} [inst_1 : Fintype ι] [DecidableEq ι] [DecidableEq F] {dom : ι ↪ F} {d : ℕ} {rt : Root} {cs : List (Minidregg.Selvage.LinearConstraint ι F)} {f : ι → F}, Minidregg.Selvage.decider (Minidregg.Selvage.reedSolomonCode dom d) (Minidregg.Selvage.AccClaim.ofConstraints rt cs) f ↔ f ∈ Minidregg.Selvage.constrainedRS dom d cs
S theorem Minidregg.Selvage.decider_depth_independent : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (C : Submodule F (ι → F)) (A : Minidregg.Selvage.AccClaim Root F ι r) (links : List (Minidregg.Selvage.AccClaim Root F ι r × F)) (f : ι → F), Minidregg.Selvage.decider C (Minidregg.Selvage.foldChain foldRoot A links) f ↔ f ∈ C ∧ ∀ (i : Fin r), (A.weights i) f = (Minidregg.Selvage.foldChain foldRoot A links).targets i
S theorem Minidregg.Selvage.decider_open_complete : ∀ {Root : Type u_1} {F : Type u_2} {ι : Type u_3} {Op : Type u_4} [inst : Field F] {r : ℕ} (S : Minidregg.Selvage.BindingCommitment Root F ι Op) {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {w : ι → F}, A.rt = (↑S).commit w → Minidregg.Selvage.AccClaim.Satisfies C A w → (∀ (i : ι), (↑S).verifyOpen A.rt i (w i) ((↑S).openAt w i)) ∧ Minidregg.Selvage.decider C A w
S theorem Minidregg.Selvage.decider_open_sound : ∀ {Root : Type u_1} {F : Type u_2} {ι : Type u_3} {Op : Type u_4} [inst : Field F] {r : ℕ} (S : Minidregg.Selvage.BindingCommitment Root F ι Op) {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {w f : ι → F} {of : ι → Op}, A.rt = (↑S).commit w → (∀ (i : ι), (↑S).verifyOpen A.rt i (f i) (of i)) → Minidregg.Selvage.decider C A f → f = w ∧ Minidregg.Selvage.decider C A w
S theorem Minidregg.Selvage.decider_rejects : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {f : ι → F}, ¬Minidregg.Selvage.AccClaim.Satisfies C A f → ¬Minidregg.Selvage.decider C A f
S theorem Minidregg.Selvage.decider_sound : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (C : Submodule F (ι → F)) (A : Minidregg.Selvage.AccClaim Root F ι r) (f : ι → F), Minidregg.Selvage.decider C A f ↔ Minidregg.Selvage.AccClaim.Satisfies C A f
S def Minidregg.Selvage.defectPoly : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [inst : Field F] → (ι → F) → List (Minidregg.Selvage.LinearConstraint ι F) → Polynomial F #91715189
S theorem Minidregg.Selvage.defectPoly_degree_lt : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (f : ι → F) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), (Minidregg.Selvage.defectPoly f cs).degree < ↑cs.length
S theorem Minidregg.Selvage.defectPoly_eval : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (f : ι → F) (γ : F) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), Polynomial.eval γ (Minidregg.Selvage.defectPoly f cs) = Minidregg.Selvage.dotWt (Minidregg.Selvage.batchWt γ cs) f - Minidregg.Selvage.batchTarget γ cs
S theorem Minidregg.Selvage.defectPoly_ne_zero : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, (∃ c ∈ cs, ¬Minidregg.Selvage.Satisfies f c) → Minidregg.Selvage.defectPoly f cs ≠ 0
S def Minidregg.Selvage.dotWt : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [Field F] → (ι → F) → (ι → F) → F #3755540908
S def Minidregg.Selvage.dotWtL : {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → [Fintype ι] → (ι → F) →ₗ[F] (ι → F) →ₗ[F] F #321272797
S theorem Minidregg.Selvage.dotWtL_apply : ∀ {F : Type u_2} [inst : Field F] {ι : Type u_3} [inst_1 : Fintype ι] (a f : ι → F), (Minidregg.Selvage.dotWtL a) f = Minidregg.Selvage.dotWt a f
S theorem Minidregg.Selvage.dotWt_add_left : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (a b f : ι → F), Minidregg.Selvage.dotWt (a + b) f = Minidregg.Selvage.dotWt a f + Minidregg.Selvage.dotWt b f
S theorem Minidregg.Selvage.dotWt_smul_left : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (γ : F) (a f : ι → F), Minidregg.Selvage.dotWt (γ • a) f = γ * Minidregg.Selvage.dotWt a f
S theorem Minidregg.Selvage.dotWt_zero_left : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (f : ι → F), Minidregg.Selvage.dotWt 0 f = 0
S theorem Minidregg.Selvage.err_nonneg : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (i : Fin r.k) (st : Minidregg.Selvage.Stmt r), 0 ≤ rbr.err i st δ
S def Minidregg.Selvage.evalConstraint : {ι : Type u_1} → [DecidableEq ι] → {F : Type u_2} → [Field F] → ι → F → Minidregg.Selvage.LinearConstraint ι F #248387829
S def Minidregg.Selvage.evalOnDomain : {ι : Type u_1} → {F : Type u_2} → [inst : Field F] → (ι ↪ F) → Polynomial F →ₗ[F] ι → F #3709697985
S theorem Minidregg.Selvage.evalOnDomain_apply : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] (dom : ι ↪ F) (p : Polynomial F) (i : ι), (Minidregg.Selvage.evalOnDomain dom) p i = Polynomial.eval (dom i) p
S theorem Minidregg.Selvage.exists_dotWt_eq : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (φ : (ι → F) →ₗ[F] F), ∃ a, ∀ (f : ι → F), Minidregg.Selvage.dotWt a f = φ f
S theorem Minidregg.Selvage.exists_findIdx?_of_find? : ∀ {α : Type} (p : α → Bool) (l : List α) (e : α), List.find? p l = Option.some e → ∃ n, List.findIdx? p l = Option.some n ∧ n < l.length
S theorem Minidregg.Selvage.exists_roundBad_of_event : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (st : Minidregg.Selvage.Stmt r) (πs : Fin r.k → r.PMsg) (ρs : Fin r.k → r.Chal) (w' : r.W), (∃ x' y', r.verify st.idx st.x st.y πs ρs = Option.some (x', y') ∧ Minidregg.Selvage.RelaxedMem r.R' δ st.idx x' y' w') → ¬Minidregg.Selvage.RelaxedMem r.R δ st.idx st.x st.y (Minidregg.Selvage.wAt rbr st (List.ofFn fun i => (πs i, ρs i)) w' 0) → ∃ a, Minidregg.Selvage.RoundBad rbr δ st (List.take (↑a) (List.ofFn fun i => (πs i, ρs i))) (πs a) (ρs a)
S theorem Minidregg.Selvage.find?_eq_none_of_forall_ne : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s}, (∀ e ∈ L, e.1 ≠ q) → List.find? (fun e => Decidable.decide (e.1 = q)) L = Option.none
S theorem Minidregg.Selvage.find?_isSome_of_exists : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s}, (∃ e ∈ L, e.1 = q) → ∃ e', List.find? (fun e => Decidable.decide (e.1 = q)) L = Option.some e'
S def Minidregg.Selvage.foldChain : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → (Root → F → Root → Root) → Minidregg.Selvage.AccClaim Root F ι r → List (Minidregg.Selvage.AccClaim Root F ι r × F) → Minidregg.Selvage.AccClaim Root F ι r #3398817273
S theorem Minidregg.Selvage.foldChain_cons : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A B : Minidregg.Selvage.AccClaim Root F ι r) (γ : F) (links : List (Minidregg.Selvage.AccClaim Root F ι r × F)), Minidregg.Selvage.foldChain foldRoot A ((B, γ) :: links) = Minidregg.Selvage.foldChain foldRoot (Minidregg.Selvage.foldClaims foldRoot A B γ) links
S theorem Minidregg.Selvage.foldChain_nil : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A : Minidregg.Selvage.AccClaim Root F ι r), Minidregg.Selvage.foldChain foldRoot A [] = A
S theorem Minidregg.Selvage.foldChain_weights : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A : Minidregg.Selvage.AccClaim Root F ι r) (links : List (Minidregg.Selvage.AccClaim Root F ι r × F)), (Minidregg.Selvage.foldChain foldRoot A links).weights = A.weights
S def Minidregg.Selvage.foldClaims : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → (Root → F → Root → Root) → Minidregg.Selvage.AccClaim Root F ι r → Minidregg.Selvage.AccClaim Root F ι r → F → Minidregg.Selvage.AccClaim Root F ι r #3486295982
S theorem Minidregg.Selvage.foldClaims_assoc : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A B C' : Minidregg.Selvage.AccClaim Root F ι r) (γ : F), (Minidregg.Selvage.foldClaims foldRoot (Minidregg.Selvage.foldClaims foldRoot A B γ) C' (γ ^ 2)).channel = (Minidregg.Selvage.foldClaims foldRoot A (Minidregg.Selvage.foldClaims foldRoot B C' γ) γ).channel
S theorem Minidregg.Selvage.foldClaims_chain_target : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A B C' : Minidregg.Selvage.AccClaim Root F ι r) (γ : F) (i : Fin r), ((Minidregg.Selvage.foldClaims foldRoot (Minidregg.Selvage.foldClaims foldRoot A B γ) C' (γ ^ 2)).channel i).2 = (A.channel i).2 + γ * (B.channel i).2 + γ ^ 2 * (C'.channel i).2
S theorem Minidregg.Selvage.foldClaims_channel : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A B : Minidregg.Selvage.AccClaim Root F ι r) (γ : F) (i : Fin r), (Minidregg.Selvage.foldClaims foldRoot A B γ).channel i = ((A.channel i).1, (A.channel i).2 + γ * (B.channel i).2)
S theorem Minidregg.Selvage.foldClaims_rt : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) (A B : Minidregg.Selvage.AccClaim Root F ι r) (γ : F), (Minidregg.Selvage.foldClaims foldRoot A B γ).rt = foldRoot A.rt γ B.rt
S theorem Minidregg.Selvage.foldClaims_satisfies : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (foldRoot : Root → F → Root → Root) {C : Submodule F (ι → F)} {A B : Minidregg.Selvage.AccClaim Root F ι r} {f g : ι → F} (γ : F), (∀ (i : Fin r), B.weights i = A.weights i) → Minidregg.Selvage.AccClaim.Satisfies C A f → Minidregg.Selvage.AccClaim.Satisfies C B g → Minidregg.Selvage.AccClaim.Satisfies C (Minidregg.Selvage.foldClaims foldRoot A B γ) (f + γ • g)
S theorem Minidregg.Selvage.foldWord_assoc : ∀ {F : Type u_2} [inst : Field F] {ι : Type u_3} (f g h : ι → F) (γ : F), f + γ • g + γ ^ 2 • h = f + γ • (g + γ • h)
S theorem Minidregg.Selvage.foldl_length_aux : ∀ {α β : Type} (f : List α → β → List α), (∀ (L : List α) (b : β), (f L b).length = L.length + 1) → ∀ (js : List β) (L : List α), (List.foldl f L js).length = L.length + js.length
S theorem Minidregg.Selvage.foldl_stepFn_length : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (js : List (Fin t)) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)), (List.foldl (Minidregg.Selvage.stepFn P c) L js).length = L.length + js.length
S theorem Minidregg.Selvage.foldl_stepFn_prefix : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (js : List (Fin t)) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)), L <+: List.foldl (Minidregg.Selvage.stepFn P c) L js
S def Minidregg.Selvage.fracHamming : {A : Type} → {n : ℕ} → (Fin n → A) → (Fin n → A) → ℝ #329591632
S theorem Minidregg.Selvage.fracHamming_self : ∀ {A : Type} {n : ℕ} (u : Fin n → A), Minidregg.Selvage.fracHamming u u = 0
S def Minidregg.Selvage.freshAt : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → Fin r.k → (Fin t → r.Chal) → Prop := fun {r} {s t} P a c => List.find? (fun e => Decidable.decide (e.1 = (Minidregg.Selvage.srOut P c).query a)) (Minidregg.Selvage.srTrace P c) = Option.none
S theorem Minidregg.Selvage.freshBad_le : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (Z : Set (Minidregg.Selvage.Stmt r)) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ {εrbr : ℝ → ℝ}, 0 ≤ εrbr δ → (∀ (i : Fin r.k), ∀ st ∈ Z, rbr.err i st δ ≤ εrbr δ) → ∀ (P : Minidregg.Selvage.SrProver r s) (a : Fin r.k), Minidregg.Selvage.uniformProb ((Fin t → r.Chal) × (Fin r.k → r.Chal)) (Minidregg.Selvage.FreshBad rbr Z δ P a) ≤ εrbr δ
S theorem Minidregg.Selvage.gameSlotBound_proved : Minidregg.Selvage.GameSlotBound
S def Minidregg.Selvage.glue : {F : Type u_1} → [CommRing F] → {m : ℕ} → (Fin m → F) → (k : ℕ) → Minidregg.Selvage.SuffixCube m k → Fin m → F #686166224
S theorem Minidregg.Selvage.glue_apply : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (r : Fin m → F) (k : ℕ) (b : Minidregg.Selvage.SuffixCube m k) (j : Fin m), Minidregg.Selvage.glue r k b j = if h : k ≤ ↑j then Minidregg.Selvage.ofBool (b ⟨j, h⟩) else r j
S theorem Minidregg.Selvage.glue_suffixSplit_symm : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k < m) (r : Fin m → F) (t : Bool) (b : Minidregg.Selvage.SuffixCube m (k + 1)), Minidregg.Selvage.glue r k ((Minidregg.Selvage.suffixSplit k hk).symm (t, b)) = Minidregg.Selvage.glue (Function.update r ⟨k, hk⟩ (Minidregg.Selvage.ofBool t)) (k + 1) b
S theorem Minidregg.Selvage.glue_update : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} {r : Fin m → F} {i : Fin m} (t : F) (b : Minidregg.Selvage.SuffixCube m (↑i + 1)), Minidregg.Selvage.glue (Function.update r i t) (↑i + 1) b = Function.update (Minidregg.Selvage.glue r (↑i + 1) b) i t
S theorem Minidregg.Selvage.hammingDist_add_card_le_of_agreesOn : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : DecidableEq F] {S : Finset ι} {f u : ι → F}, Minidregg.Selvage.AgreesOn S f u → hammingDist f u + S.card ≤ Fintype.card ι
S theorem Minidregg.Selvage.hasMutualCorrelatedAgreement_of_isProximityGenerator : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] {ℓ : ℕ} [Nonempty ι] (G : Minidregg.Selvage.ProximityGenerator F ℓ) (C : Submodule F (ι → F)) {B : ℝ} {err : ℝ → ℝ} {dC : ℝ}, (∀ u ∈ C, ∀ v ∈ C, u ≠ v → dC ≤ Minidregg.Selvage.relDist u v) → Minidregg.Selvage.IsProximityGenerator G C B err → (∀ {δ₁ δ₂ : ℝ}, 0 < δ₁ → δ₁ ≤ δ₂ → δ₂ < 1 - B → err δ₁ ≤ err δ₂) → (∀ {δ : ℝ}, 0 < δ → δ < 1 - B → 0 ≤ err δ) → Minidregg.Selvage.HasMutualCorrelatedAgreement G C (Max.max (1 - dC / 2) B) err
S theorem Minidregg.Selvage.hasMutualCorrelatedAgreement_top_affine : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] [Nonempty ι] [inst_5 : Fintype F], Minidregg.Selvage.HasMutualCorrelatedAgreement (Minidregg.Selvage.affineGenerator F) ⊤ (Max.max (1 - 1 / ↑(Fintype.card ι) / 2) 0) fun x => 0
S def Minidregg.Selvage.hitAt : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → Fin r.k → Fin t → (Fin t → r.Chal) → Prop := fun {r} {s t} P a j c => List.findIdx? (fun e => Decidable.decide (e.1 = (Minidregg.Selvage.srOut P c).query a)) (Minidregg.Selvage.srTrace P c) = Option.some ↑j
S theorem Minidregg.Selvage.hitBad_fibre_le : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (Z : Set (Minidregg.Selvage.Stmt r)) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ {εrbr : ℝ → ℝ}, 0 ≤ εrbr δ → (∀ (i : Fin r.k), ∀ st ∈ Z, rbr.err i st δ ≤ εrbr δ) → ∀ {t : ℕ} (P : Minidregg.Selvage.SrProver r s) (j : Fin t) (p : Fin ↑j → r.Chal) (Lp : List (Minidregg.Selvage.SrMove r s × r.Chal)), Lp.length = ↑j → (∀ (ρ : r.Chal) (cs : Fin (t - ↑j - 1) → r.Chal), Minidregg.Selvage.srTrace P ((Minidregg.Selvage.splitGame j).symm (p, ρ, cs)) = Minidregg.Selvage.runFrom P (Minidregg.Selvage.stepOnce P Lp ρ) (List.ofFn cs)) → (Minidregg.Selvage.uniformProb (r.Chal × (Fin (t - ↑j - 1) → r.Chal) × (Fin r.k → r.Chal)) fun b => Minidregg.Selvage.HitBad rbr Z δ P j ((Minidregg.Selvage.splitAtGame j).symm (p, b))) ≤ εrbr δ
S def Minidregg.Selvage.idealCommitment : (F : Type u_5) → (ι : Type u_6) → Minidregg.Selvage.BindingCommitment (ι → F) F ι Unit #1364218493
S theorem Minidregg.Selvage.idealCommitment_commit : ∀ {F : Type u_2} {ι : Type u_3} (f : ι → F), (↑(Minidregg.Selvage.idealCommitment F ι)).commit f = f
S theorem Minidregg.Selvage.idealCommitment_openAt : ∀ {F : Type u_2} {ι : Type u_3} (f : ι → F) (i : ι), (↑(Minidregg.Selvage.idealCommitment F ι)).openAt f i = ()
S theorem Minidregg.Selvage.idealCommitment_verifyOpen : ∀ {F : Type u_2} {ι : Type u_3} (rt : ι → F) (i : ι) (v : F) (o : Unit), (↑(Minidregg.Selvage.idealCommitment F ι)).verifyOpen rt i v o ↔ rt i = v
S theorem Minidregg.Selvage.isProximityGenerator_top : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] {ℓ : ℕ} (G : Minidregg.Selvage.ProximityGenerator F ℓ), Minidregg.Selvage.IsProximityGenerator G ⊤ 0 fun x => 0
S def Minidregg.Selvage.launderSet : {F : Type} → [inst : Field F] → [Fintype F] → [DecidableEq F] → {v : ℕ} → ((ℕ → F) → ℕ → Polynomial F) → ((ℕ → F) → ℕ → Polynomial F) → (Fin v → F) → Fin v → Finset F #4142131259
S theorem Minidregg.Selvage.launderSet_card_le : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [inst_2 : DecidableEq F] {v d : ℕ} {prover honest : (ℕ → F) → ℕ → Polynomial F}, (∀ (χ : ℕ → F), ∀ i < v, (prover χ i).degree < ↑(d + 1)) → (∀ (χ : ℕ → F), ∀ i < v, (honest χ i).degree < ↑(d + 1)) → ∀ (r : Fin v → F) (i : Fin v), (Minidregg.Selvage.launderSet prover honest r i).card ≤ d
S theorem Minidregg.Selvage.launderSet_prefixMeas : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [inst_2 : DecidableEq F] {v : ℕ} {prover honest : (ℕ → F) → ℕ → Polynomial F}, Minidregg.Selvage.PrefixMeasurable prover → Minidregg.Selvage.PrefixMeasurable honest → ∀ (i : Fin v) (r r' : Fin v → F), (∀ (j : Fin v), ↑j < ↑i → r j = r' j) → Minidregg.Selvage.launderSet prover honest r i = Minidregg.Selvage.launderSet prover honest r' i
S theorem Minidregg.Selvage.lie_persists : ∀ {F : Type} [inst : Field F] {v : ℕ} {prover honest : ℕ → Polynomial F} {chal claimF truF : ℕ → F}, (∀ i < v, claimF (i + 1) = Polynomial.eval (chal i) (prover i)) → (∀ i < v, truF (i + 1) = Polynomial.eval (chal i) (honest i)) → claimF 0 ≠ truF 0 → (∀ j < v, ¬(claimF j ≠ truF j ∧ Polynomial.eval (chal j) (prover j) = Polynomial.eval (chal j) (honest j))) → ∀ i ≤ v, claimF i ≠ truF i
S theorem Minidregg.Selvage.list_as_single_sumcheck : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] (γ : F) {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, (∀ c ∈ cs, Minidregg.Selvage.Satisfies f c) → ∑ i, Minidregg.Selvage.constraintSummand (Minidregg.Selvage.batchConstraint γ cs) f i = (Minidregg.Selvage.batchConstraint γ cs).target
S theorem Minidregg.Selvage.mem_agreeFinset : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [inst_2 : DecidableEq F] {p q : Polynomial F} {x : F}, x ∈ Minidregg.Selvage.agreeFinset p q ↔ Polynomial.eval x p = Polynomial.eval x q
S theorem Minidregg.Selvage.mem_constrainedRS_iff : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] {dom : ι ↪ F} {d : ℕ} {cs : List (Minidregg.Selvage.LinearConstraint ι F)} {f : ι → F}, f ∈ Minidregg.Selvage.constrainedRS dom d cs ↔ f ∈ Minidregg.Selvage.reedSolomonCode dom d ∧ ∀ c ∈ cs, Minidregg.Selvage.Satisfies f c
S theorem Minidregg.Selvage.mem_reedSolomonCode_iff : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] {dom : ι ↪ F} {d : ℕ} {f : ι → F}, f ∈ Minidregg.Selvage.reedSolomonCode dom d ↔ ∃ p, p.degree < ↑d ∧ ∀ (i : ι), f i = Polynomial.eval (dom i) p
S theorem Minidregg.Selvage.minDistLB_inhabited : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] [Nonempty ι] (C : Submodule F (ι → F)), ∀ u ∈ C, ∀ v ∈ C, u ≠ v → 1 / ↑(Fintype.card ι) ≤ Minidregg.Selvage.relDist u v
S def Minidregg.Selvage.mle : {F : Type u_1} → [CommRing F] → {m : ℕ} → ((Fin m → Bool) → F) → (Fin m → F) → F #1414497233
S def Minidregg.Selvage.mleHonest : {F : Type} → [inst : Field F] → {m : ℕ} → ((Fin m → Bool) → F) → (ℕ → F) → ℕ → Polynomial F #2031963691
S theorem Minidregg.Selvage.mleHonest_boolean_sum : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (r : Fin m → F), ∀ i < m, Polynomial.eval 0 (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r) i) + Polynomial.eval 1 (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r) i) = Minidregg.Selvage.scChain (∑ b, f b) (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.chalOf r) i
S theorem Minidregg.Selvage.mleHonest_boolean_sum_stream : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (χ : ℕ → F), ∀ i < m, Polynomial.eval 0 (Minidregg.Selvage.mleHonest f χ i) + Polynomial.eval 1 (Minidregg.Selvage.mleHonest f χ i) = Minidregg.Selvage.scChain (∑ b, f b) (Minidregg.Selvage.mleHonest f χ) χ i
S theorem Minidregg.Selvage.mleHonest_complete : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (r : Fin m → F), Minidregg.Selvage.SumcheckAccepts (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r)) (∑ b, f b) (∑ b, f b) r
S theorem Minidregg.Selvage.mleHonest_degree : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (χ : ℕ → F), ∀ i < m, (Minidregg.Selvage.mleHonest f χ i).degree < ↑(1 + 1)
S theorem Minidregg.Selvage.mleHonest_prefixMeasurable : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F), Minidregg.Selvage.PrefixMeasurable (Minidregg.Selvage.mleHonest f)
S theorem Minidregg.Selvage.mle_agrees : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (f : (Fin m → Bool) → F) (b : Fin m → Bool), Minidregg.Selvage.mle f (Minidregg.Selvage.cubePt b) = f b
S theorem Minidregg.Selvage.mle_hypercube_sum : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (f : (Fin m → Bool) → F), ∑ b, f b = ∑ b, Minidregg.Selvage.mle f (Minidregg.Selvage.cubePt b)
S theorem Minidregg.Selvage.mle_injective : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ}, Function.Injective Minidregg.Selvage.mle
S theorem Minidregg.Selvage.mle_multilinear : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (f : (Fin m → Bool) → F), Minidregg.Selvage.MultiAffine (Minidregg.Selvage.mle f)
S theorem Minidregg.Selvage.mle_retires_constraint : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [DecidableEq F] {ι : Type u_1} [inst_3 : Fintype ι] {v : ℕ} (e : ι ≃ (Fin v → Bool)) {w : ι → F} {c : Minidregg.Selvage.LinearConstraint ι F}, ¬Minidregg.Selvage.Satisfies w c → ∀ {prover : (ℕ → F) → ℕ → Polynomial F}, Minidregg.Selvage.PrefixMeasurable prover → (∀ (χ : ℕ → F), ∀ i < v, (prover χ i).degree < ↑(1 + 1)) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => Minidregg.Selvage.SumcheckAccepts (prover (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.mleHonest (fun b => Minidregg.Selvage.constraintSummand c w (e.symm b)) (Minidregg.Selvage.chalOf r)) c.target (Minidregg.Selvage.trueSum c w) r) ≤ ↑v * (1 / ↑(Fintype.card F))
S theorem Minidregg.Selvage.mle_sumcheck_soundness : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [DecidableEq F] {m : ℕ} {f : (Fin m → Bool) → F} {prover : (ℕ → F) → ℕ → Polynomial F} {H : F}, Minidregg.Selvage.PrefixMeasurable prover → (∀ (χ : ℕ → F), ∀ i < m, (prover χ i).degree < ↑(1 + 1)) → Minidregg.Selvage.uniformProb (Fin m → F) (Minidregg.Selvage.AdaptiveAcceptsFalse prover (Minidregg.Selvage.mleHonest f) H (∑ b, f b)) ≤ ↑m * (1 / ↑(Fintype.card F))
