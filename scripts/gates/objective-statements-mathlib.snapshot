S theorem Minidregg.Theory.Receiving.Receiver.replay_after_install : ∀ {J : Minidregg.Theory.Receiving.Journal} {m : Type → Type} {verify : Minidregg.Theory.Receiving.SigQuery → m (Except String Bool)} (R : Minidregg.Theory.Receiving.Receiver J verify) {env : R.Env} {state : J.State} {ingress : R.Ingress} (accepted : R.Accepted env state ingress) (later : J.State) (before : J.Snap), J.snap later = J.install before (R.intent accepted) → R.replay env later ingress = Option.some (Except.ok (R.receipt env ingress))
S theorem Minidregg.Theory.Receiving.Receiver.replay_only_original : ∀ {J : Minidregg.Theory.Receiving.Journal} {m : Type → Type} {verify : Minidregg.Theory.Receiving.SigQuery → m (Except String Bool)} (R : Minidregg.Theory.Receiving.Receiver J verify) {env : R.Env} {state : J.State} {ingress : R.Ingress} {selected : J.TxId × J.Event}, R.replay env state ingress = Option.some (Except.ok selected) → selected = R.receipt env ingress ∧ J.lookup (J.snap state) (R.txId env ingress) = Option.some { txId := R.txId env ingress, event := R.event env ingress, nullifiers := R.nullifiers env ingress }
