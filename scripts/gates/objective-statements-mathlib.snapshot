S theorem Minidregg.Theory.PlanBinding.independent_commute : ∀ {L : Minidregg.Theory.Store.Layout} {p q : Minidregg.Theory.PlanBinding.Plan L} {s : Minidregg.Theory.Store.Store L}, Minidregg.Theory.PlanBinding.Independent p q → p.Admits s → q.Admits s → Minidregg.Theory.Store.Patch.run (Minidregg.Theory.Store.Patch.run s p.patch) q.patch = Minidregg.Theory.Store.Patch.run (Minidregg.Theory.Store.Patch.run s q.patch) p.patch
S theorem Minidregg.Theory.PlanBinding.no_toctou : ∀ {L : Minidregg.Theory.Store.Layout} {s₀ s : Minidregg.Theory.Store.Store L} {fp : Minidregg.Theory.PlanBinding.Footprint L} (patch : Minidregg.Theory.Store.Patch L), patch.accessFootprint ⊆ fp.addresses → Minidregg.Theory.PlanBinding.Footprint.Holds s₀ fp → Minidregg.Theory.PlanBinding.Footprint.Holds s fp → (Minidregg.Theory.Store.Patch.ValidFrom s₀ patch ↔ Minidregg.Theory.Store.Patch.ValidFrom s patch) ∧ ∀ (a : Minidregg.Theory.Store.Address L), (Minidregg.Theory.Store.Patch.run s patch) a = if a ∈ patch.writeFootprint then (Minidregg.Theory.Store.Patch.run s₀ patch) a else s a
S theorem Minidregg.Theory.PlanBinding.overlap_refused : ∀ {L : Minidregg.Theory.Store.Layout} {p q : Minidregg.Theory.PlanBinding.Plan L} {s : Minidregg.Theory.Store.Store L}, p.Admits s → ∀ {a : Minidregg.Theory.Store.Address L}, a ∈ p.footprint.addresses → (Minidregg.Theory.Store.Patch.run s q.patch) a ≠ s a → ∃ b, Minidregg.Theory.PlanBinding.Footprint.admit (Minidregg.Theory.Store.Patch.run s q.patch) p.footprint = Except.error (Minidregg.Theory.PlanBinding.Refusal.footprintStale b) ∧ b ∈ p.footprint.addresses ∧ (Minidregg.Theory.Store.Patch.run s q.patch) b ≠ s b
