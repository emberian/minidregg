S theorem Minidregg.Kernel.WorldRootCache.slotsOf_snoc : ∀ {K V D : Type} [inst : DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (es : List (K × V)) (e : K × V), Minidregg.Kernel.WorldRoot.slotsOf S.ix (es ++ [e]) = Minidregg.Theory.AuthMap.write S.ix (Minidregg.Kernel.WorldRoot.slotsOf S.ix es) e.1 (Option.some e.2)
