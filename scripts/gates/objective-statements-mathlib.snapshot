S def Minidregg.Theory.ResourceBirth.Descriptor.AllGrantsBound : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Prop := fun {registry} descriptor => ∀ grant ∈ descriptor.grants, ∃ item ∈ descriptor.births, grant.ForBirth item
S def Minidregg.Theory.ResourceBirth.Descriptor.FeeBound : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Minidregg.Theory.ResourceBirth.CreationTariff → Prop := fun {registry} descriptor tariff => descriptor.fee.amount = descriptor.quotedFee tariff ∧ descriptor.fee.collector = tariff.collector ∧ descriptor.fee.asset = tariff.asset
S def Minidregg.Theory.ResourceBirth.Descriptor.FundingBound : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Prop := fun {registry} descriptor => ∀ funding ∈ descriptor.funding, funding.destination ∈ descriptor.registeredAccounts
S def Minidregg.Theory.ResourceBirth.Descriptor.GrantIdsDistinct : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Prop := fun {registry} descriptor => (List.map (fun grant => grant.capability.head.id) descriptor.grants).Nodup
S def Minidregg.Theory.ResourceBirth.Descriptor.InitialPoliciesBound : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Prop := fun {registry} descriptor => (List.map Minidregg.Theory.ResourceBirth.InitialPolicy.policyId descriptor.initialPolicies).Nodup ∧ (∀ item ∈ descriptor.births, ∃ policy ∈ descriptor.initialPolicies, policy.policyId.value = item.create.cellId) ∧ ∀ policy ∈ descriptor.initialPolicies, ∃ item ∈ descriptor.births, policy.policyId.value = item.create.cellId
S def Minidregg.Theory.ResourceBirth.Descriptor.OwnerGrantsBound : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.Descriptor registry → Prop := fun {registry} descriptor => ∀ item ∈ descriptor.births, ∃ grant ∈ descriptor.grants, grant.NativeForBirth item ∧ grant.capability.head.holder = Minidregg.Theory.TypedAuthorization.Holder.subject item.owner ∧ ∃ control ∈ descriptor.grants, control.PolicyControlForBirth item ∧ control.capability.head.holder = Minidregg.Theory.TypedAuthorization.Holder.subject item.owner ∧ control.capability.head.id ≠ grant.capability.head.id
