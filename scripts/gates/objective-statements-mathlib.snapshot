S def Minidregg.Compiler.CanonicalPolicyAdmission.Verified : {F : Type} → [inst : Field F] → [inst_1 : DecidableEq F] → Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F → {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} → Minidregg.Theory.TypedAuthorization.Request kind → Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F → Prop := fun {F} [Field F] [DecidableEq F] config {kind} request witness => ∃ committed, config.registry.resolve request.policyId request.policyRevision = Option.some committed ∧ committed.record.neutral = Bool.true ∧ committed.record.policyId = request.policyId ∧ committed.record.version = request.policyRevision ∧ committed.record.domain = request.domain ∧ committed.record.semantics = request.semantics ∧ config.recordDigest committed.record = committed.address ∧ witness.address = committed.address ∧ config.stepBinding.matches request witness.oldState witness.newState = Bool.true ∧ config.compilerProfile.compatible config.stepBinding = Bool.true ∧ request.semantics = config.compilerProfile.semantics ∧ Minidregg.Compiler.supported config.compilerProfile.compiler committed.record.predicate = Bool.true ∧ Minidregg.Compiler.inputsInRange config.compilerProfile.compiler committed.record.predicate witness.oldState witness.newState = Bool.true ∧ Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf committed.record.predicate witness.oldState witness.newState) ∧ Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg witness.oldState witness.newState witness.auxiliary) (Minidregg.Compiler.lower config.compilerProfile.compiler committed.record.predicate)
