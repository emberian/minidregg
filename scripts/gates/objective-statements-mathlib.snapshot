S theorem Minidregg.Selvage.reedSolomonCode_hasMutualCorrelatedAgreement : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] {ℓ : ℕ} [Nonempty ι] (G : Minidregg.Selvage.ProximityGenerator F ℓ) (dom : ι ↪ F) (d : ℕ) {B : ℝ} {err : ℝ → ℝ}, Minidregg.Selvage.IsProximityGenerator G (Minidregg.Selvage.reedSolomonCode dom d) B err → (∀ {δ₁ δ₂ : ℝ}, 0 < δ₁ → δ₁ ≤ δ₂ → δ₂ < 1 - B → err δ₁ ≤ err δ₂) → (∀ {δ : ℝ}, 0 < δ → δ < 1 - B → 0 ≤ err δ) → Minidregg.Selvage.HasMutualCorrelatedAgreement G (Minidregg.Selvage.reedSolomonCode dom d) (Max.max (1 - (1 - (↑d - 1) / ↑(Fintype.card ι)) / 2) B) err
S theorem Minidregg.Selvage.reedSolomonCode_hasMutualCorrelatedAgreement_closed : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] {ℓ : ℕ} [Nonempty ι] (G : Minidregg.Selvage.ProximityGenerator F ℓ) (dom : ι ↪ F) (d : ℕ) {B : ℝ} {err : ℝ → ℝ}, Minidregg.Selvage.IsProximityGenerator G (Minidregg.Selvage.reedSolomonCode dom d) B err → (∀ {δ₁ δ₂ : ℝ}, 0 < δ₁ → δ₁ ≤ δ₂ → δ₂ < 1 - B → err δ₁ ≤ err δ₂) → (∀ {δ : ℝ}, 0 < δ → δ < 1 - B → 0 ≤ err δ) → Minidregg.Selvage.HasMutualCorrelatedAgreement G (Minidregg.Selvage.reedSolomonCode dom d) (Max.max ((↑(Fintype.card ι) + ↑d - 1) / (2 * ↑(Fintype.card ι))) B) err
S theorem Minidregg.Selvage.reedSolomonCode_hasMutualCorrelatedAgreement_of_le : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] {ℓ : ℕ} [Nonempty ι] (G : Minidregg.Selvage.ProximityGenerator F ℓ) (dom : ι ↪ F) (d : ℕ) {B : ℝ} {err : ℝ → ℝ}, Minidregg.Selvage.IsProximityGenerator G (Minidregg.Selvage.reedSolomonCode dom d) B err → (∀ {δ₁ δ₂ : ℝ}, 0 < δ₁ → δ₁ ≤ δ₂ → δ₂ < 1 - B → err δ₁ ≤ err δ₂) → (∀ {δ : ℝ}, 0 < δ → δ < 1 - B → 0 ≤ err δ) → B ≤ (↑(Fintype.card ι) + ↑d - 1) / (2 * ↑(Fintype.card ι)) → Minidregg.Selvage.HasMutualCorrelatedAgreement G (Minidregg.Selvage.reedSolomonCode dom d) ((↑(Fintype.card ι) + ↑d - 1) / (2 * ↑(Fintype.card ι))) err
