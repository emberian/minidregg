S theorem Minidregg.Kernel.Seats.deregisterAccounts_balance : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts book accounts).balance account asset = book.balance account asset
S theorem Minidregg.Kernel.Seats.deregisterAccounts_leaseRecords : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId), (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts book accounts).leaseRecords = book.leaseRecords
S theorem Minidregg.Kernel.Seats.deregistrationAdmission_apply : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {operation : Minidregg.Theory.CanonicalResourceKernel.Operation}, Minidregg.Theory.CanonicalResourceKernel.DeregistrationAdmission book account → operation.posting.source ≠ account → operation.posting.destination ≠ account → Minidregg.Theory.CanonicalResourceKernel.DeregistrationAdmission (operation.apply book) account
S theorem Minidregg.Kernel.Seats.deregistrationsAdmitted_afterOperations : ∀ {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {operations : List Minidregg.Theory.CanonicalResourceKernel.Operation}, Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted book accounts → Minidregg.Theory.CanonicalResourceKernel.OperationsAdmitted (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts book accounts) operations → Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted (Minidregg.Theory.CanonicalResourceKernel.applyOperations book operations) accounts
S theorem Minidregg.Kernel.Seats.deregistrationsAdmitted_append : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (first later : List Minidregg.Theory.CanonicalResourceKernel.AccountId), Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted book (first ++ later) ↔ Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted book first ∧ Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts book first) later
S theorem Minidregg.Kernel.Seats.deregistrationsAdmitted_apply : ∀ {operation : Minidregg.Theory.CanonicalResourceKernel.Operation} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId}, Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted book accounts → operation.posting.source ∉ accounts → operation.posting.destination ∉ accounts → Minidregg.Theory.CanonicalResourceKernel.DeregistrationsAdmitted (operation.apply book) accounts
