S def Minidregg.Selvage.batchFunctional : {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → F → (Fin r → (ι → F) →ₗ[F] F) → (ι → F) →ₗ[F] F #2691988665
S theorem Minidregg.Selvage.batchFunctional_apply : ∀ {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (γ : F) (ws : Fin r → (ι → F) →ₗ[F] F) (f : ι → F), (Minidregg.Selvage.batchFunctional γ ws) f = ∑ i, γ ^ ↑i * (ws i) f
