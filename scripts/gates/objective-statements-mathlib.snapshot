S def Minidregg.Compiler.DurableLogTags.TagsHonest : {D T : Type} → (ℕ → D → T) → ℕ → List D → List T → Prop := fun {D T} tag height chains tags => ∀ (i : ℕ) (hi : i < tags.length), ∃ chain, chains[i + 1]? = Option.some chain ∧ tags[i] = tag (height + i + 1) chain
