S theorem Minidregg.Kernel.Run.checkRun_deterministic : ∀ {E : Minidregg.Compiler.Evaluator} {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : E.Input} {claim claim' : Minidregg.Kernel.Run.RunClaim} {writes writes' : List Minidregg.Theory.Eval.FieldWrite} {verdict verdict' : Minidregg.Kernel.Run.Verdict E.Output}, Minidregg.Kernel.Run.checkRun E.toMachine program libraries sample claim writes = Except.ok verdict → Minidregg.Kernel.Run.checkRun E.toMachine program libraries sample claim' writes' = Except.ok verdict' → verdict = verdict' ∧ claim.outputJam = claim'.outputJam ∧ claim.steps = claim'.steps
S theorem Minidregg.Kernel.Run.checkRun_sound : ∀ {E : Minidregg.Compiler.Evaluator} {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : E.Input} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict E.Output}, Minidregg.Kernel.Run.checkRun E.toMachine program libraries sample claim writes = Except.ok verdict → ∃ t, Minidregg.Kernel.Run.runOf E.toMachine program libraries sample = Option.some t ∧ E.Spec t verdict.output ∧ E.writesOf program.abi verdict.output = Option.some verdict.writes ∧ (∀ (w : Minidregg.Theory.Eval.FieldWrite), w ∈ writes ↔ w ∈ verdict.writes) ∧ claim.sampleJam = E.encodeInput sample ∧ claim.outputJam = E.encodeOutput verdict.output ∧ verdict.steps = claim.steps ∧ claim.steps ≤ program.abi.fuel ∧ E.run claim.steps t = Except.ok verdict.output ∧ E.steps claim.steps t = verdict.steps
