S def Minidregg.Kernel.PayObservation.decideObservation : Minidregg.Kernel.PayCell.PayStore → Minidregg.Kernel.PayTariff.Tariff → Minidregg.Kernel.PayCell.ChainTip → Minidregg.Kernel.PayObservation.Observation → Except Minidregg.Kernel.PayObservation.Reject Minidregg.Kernel.PayObservation.Credit #475186355
S theorem Minidregg.Kernel.PayObservation.decideObservation_ok : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {tariff : Minidregg.Kernel.PayTariff.Tariff} {tip : Minidregg.Kernel.PayCell.ChainTip} {o : Minidregg.Kernel.PayObservation.Observation} {credit : Minidregg.Kernel.PayObservation.Credit}, Minidregg.Kernel.PayObservation.decideObservation store tariff tip o = Except.ok credit → o.signature.length = 64 ∧ List.length o.address = 32 ∧ o.mint = tariff.mint ∧ o.tokenProgram = tariff.tokenProgram ∧ Minidregg.Kernel.PayCell.bookAt store o.index = Option.some o.address ∧ Minidregg.Kernel.PayCell.assignmentAt store o.index = Option.some credit.payer ∧ credit.payer ≠ tariff.asset ∧ 0 < o.amount ∧ o.slot ≤ tip.slot ∧ credit = { index := o.index, payer := credit.payer, amount := o.amount, credit := tariff.creditFor o.amount }
