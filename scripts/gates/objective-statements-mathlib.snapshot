S theorem Minidregg.Pred.evalWithAny_ofList : ∀ (O : Minidregg.Pred.Oracle) (l : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWithAny O (Minidregg.Pred.PredList.ofList l) old new = l.any fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Pred.evalWith_all : ∀ (O : Minidregg.Pred.Oracle) (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWith O (Minidregg.Pred.Pred.all ps) old new = ps.all fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Pred.evalWith_any : ∀ (O : Minidregg.Pred.Oracle) (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWith O (Minidregg.Pred.Pred.any ps) old new = ps.any fun q => Minidregg.Pred.evalWith O q old new
