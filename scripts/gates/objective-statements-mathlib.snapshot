S def Minidregg.Compiler.hashConstraint : {F : Type u} → [Field F] → {Idx : Type u} → {w : ℕ} → [NeZero w] → Minidregg.Compiler.PermSpec F w → Idx → (Fin w → Idx) → Minidregg.Compiler.ConstraintSystem F Idx #1857376255
S theorem Minidregg.Compiler.hashConstraint_complete : ∀ {F : Type u} [inst : Field F] {w : ℕ} [inst_1 : NeZero w] (spec : Minidregg.Compiler.PermSpec F w) (noteVals : Fin w → F), ∃ asg, (∀ (i : Fin w), asg (Option.some { down := i }) = noteVals i) ∧ asg Option.none = Minidregg.Compiler.hashExec spec noteVals ∧ Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.hashConstraint spec Option.none fun i => Option.some { down := i })
S theorem Minidregg.Compiler.hashConstraint_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (nullifier : Idx) (note : Fin w → Idx), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.hashConstraint spec nullifier note) ↔ asg nullifier = Minidregg.Compiler.hashExec spec fun i => asg (note i)
S theorem Minidregg.Compiler.hashConstraint_semHolds_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (nullifier : Idx) (note : Fin w → Idx), Minidregg.Compiler.systemSemHolds asg (Minidregg.Compiler.hashConstraint spec nullifier note) ↔ asg nullifier = Minidregg.Compiler.hashExec spec fun i => asg (note i)
S theorem Minidregg.Compiler.hashConstraint_teeth : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (nullifier : Idx) (note : Fin w → Idx), (asg nullifier ≠ Minidregg.Compiler.hashExec spec fun i => asg (note i)) → ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.hashConstraint spec nullifier note)
