S theorem Minidregg.Compiler.PredOrder.wrong_indicator_refused : ∀ {F : Type} [inst : Field F] {Idx : Type} {k : ℕ} {asg : Idx → F} {present left right : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)} {shifted : Idx} {bits : Fin (k + 1) → Idx} {isPresent : Bool} {a b : ℤ}, Minidregg.Compiler.PredOrder.NoWrap F k → Minidregg.Compiler.PredOrder.InputsInRange k isPresent a b → (Minidregg.Compiler.eval asg present = if isPresent = Bool.true then 1 else 0) → Minidregg.Compiler.eval asg left = ↑a → Minidregg.Compiler.eval asg right = ↑b → (Minidregg.Compiler.eval asg (Minidregg.Compiler.PredOrder.indicator k present bits) ≠ if (isPresent && Decidable.decide (a ≤ b)) = Bool.true then 1 else 0) → ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.PredOrder.gadget k present left right shifted bits)
