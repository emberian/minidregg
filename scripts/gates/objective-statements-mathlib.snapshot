S theorem Minidregg.Kernel.LawView.clock_ne_field : ∀ {c : Option ℤ} {q : String × ℤ}, q ∈ Minidregg.Kernel.LawView.clockSlots c → ∀ (N : ℕ) (w : String), Minidregg.Kernel.LawView.lastc w = Option.some 'r' ∨ Minidregg.Kernel.LawView.lastc w = Option.some 'e' ∨ Minidregg.Kernel.LawView.lastc w = Option.some 'a' → w.toList ≠ [] → q.1 ≠ Minidregg.Kernel.DeclaredResourceProjection.fieldName N w
S theorem Minidregg.Kernel.LawView.ev_all : ∀ {o n : Minidregg.Pred.State} {ps : List Minidregg.Pred.Pred}, Minidregg.Pred.eval (Minidregg.Pred.Pred.all ps) o n = Bool.true ↔ ∀ q ∈ ps, Minidregg.Pred.eval q o n = Bool.true
S theorem Minidregg.Kernel.LawView.ev_any : ∀ {o n : Minidregg.Pred.State} {ps : List Minidregg.Pred.Pred}, Minidregg.Pred.eval (Minidregg.Pred.Pred.any ps) o n = Bool.true ↔ ∃ q ∈ ps, Minidregg.Pred.eval q o n = Bool.true
S theorem Minidregg.Kernel.LawView.ev_eq : ∀ {o n : Minidregg.Pred.State} {s : String} {v : ℤ}, Minidregg.Pred.eval (Minidregg.Pred.Pred.eq s v) o n = Bool.true ↔ n.get s = Option.some v
S theorem Minidregg.Kernel.LawView.ev_eqSlots : ∀ {o n : Minidregg.Pred.State} {a b : String}, Minidregg.Pred.eval (Minidregg.Pred.Pred.eqSlots a b) o n = Bool.true ↔ ∃ x, n.get a = Option.some x ∧ n.get b = Option.some x
S theorem Minidregg.Kernel.LawView.ev_le : ∀ {o n : Minidregg.Pred.State} {s : String} {v : ℤ}, Minidregg.Pred.eval (Minidregg.Pred.Pred.le s v) o n = Bool.true ↔ ∃ x, n.get s = Option.some x ∧ x ≤ v
S theorem Minidregg.Kernel.LawView.ev_leSlots : ∀ {o n : Minidregg.Pred.State} {a b : String}, Minidregg.Pred.eval (Minidregg.Pred.Pred.leSlots a b) o n = Bool.true ↔ ∃ x y, n.get a = Option.some x ∧ n.get b = Option.some y ∧ x ≤ y
S theorem Minidregg.Kernel.LawView.ev_leSlotsOff : ∀ {o n : Minidregg.Pred.State} {a b : String} {k : ℤ}, Minidregg.Pred.eval (Minidregg.Pred.Pred.leSlotsOff a b k) o n = Bool.true ↔ ∃ x y, n.get a = Option.some x ∧ n.get b = Option.some y ∧ x ≤ y + k
S theorem Minidregg.Kernel.LawView.ev_memberOf : ∀ {o n : Minidregg.Pred.State} {s : String} {xs : List ℤ}, Minidregg.Pred.eval (Minidregg.Pred.Pred.memberOf s xs) o n = Bool.true ↔ ∃ x, n.get s = Option.some x ∧ x ∈ xs
S theorem Minidregg.Kernel.LawView.ev_monotone : ∀ {o n : Minidregg.Pred.State} {s : String}, Minidregg.Pred.eval (Minidregg.Pred.Pred.monotone s) o n = Bool.true ↔ ∃ a b, o.get s = Option.some a ∧ n.get s = Option.some b ∧ a ≤ b
S theorem Minidregg.Kernel.LawView.ev_not : ∀ {o n : Minidregg.Pred.State} {q : Minidregg.Pred.Pred}, Minidregg.Pred.eval q.not o n = Bool.true ↔ ¬Minidregg.Pred.eval q o n = Bool.true
S theorem Minidregg.Kernel.LawView.fieldName_def : ∀ (N : ℕ) (v : String), Minidregg.Kernel.DeclaredResourceProjection.fieldName N v = "resource/field/" ++ ToString.toString N ++ "/" ++ v
S theorem Minidregg.Kernel.LawView.fieldName_inj : ∀ {a b : ℕ} {v : String}, Minidregg.Kernel.DeclaredResourceProjection.fieldName a v = Minidregg.Kernel.DeclaredResourceProjection.fieldName b v ↔ a = b
S theorem Minidregg.Kernel.LawView.find_none : ∀ {l : List (String × ℤ)} {k : String}, (∀ q ∈ l, q.1 ≠ k) → List.find? (fun q => q.1 == k) l = Option.none
S theorem Minidregg.Kernel.LawView.get_after : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values) (N : ℕ), (Minidregg.Kernel.LawView.view t pre post).get (Minidregg.Kernel.DeclaredResourceProjection.fieldName N "after") = Minidregg.Kernel.DeclaredResourceProjection.get post N
S theorem Minidregg.Kernel.LawView.get_before : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values) (N : ℕ), (Minidregg.Kernel.LawView.view t pre post).get (Minidregg.Kernel.DeclaredResourceProjection.fieldName N "before") = Minidregg.Kernel.DeclaredResourceProjection.get pre N
S theorem Minidregg.Kernel.LawView.get_clock : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values), (Minidregg.Kernel.LawView.view t pre post).get "clock/now" = t.now
S theorem Minidregg.Kernel.LawView.get_delta : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values) (N : ℕ) (o : ℤ), Minidregg.Kernel.DeclaredResourceProjection.get pre N = Option.some o → (Minidregg.Kernel.LawView.view t pre post).get (Minidregg.Kernel.DeclaredResourceProjection.fieldName N "delta") = Option.map (fun x => x - o) (Minidregg.Kernel.DeclaredResourceProjection.get post N)
S theorem Minidregg.Kernel.LawView.get_subject : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values), (Minidregg.Kernel.LawView.view t pre post).get "request/subject" = Option.some t.subject
S theorem Minidregg.Kernel.LawView.get_verb : ∀ (t : Minidregg.Kernel.LawView.Turn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values), (Minidregg.Kernel.LawView.view t pre post).get "request/verb" = Option.some t.verb
S def Minidregg.Kernel.LawView.headc : String → Option Char #4237052815
