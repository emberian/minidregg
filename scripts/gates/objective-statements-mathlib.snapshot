S theorem Minidregg.Kernel.GenericSimplexVAInvariant.honest_vote_has_safe_origin : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → faulty.card ≤ f → ∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) → ∃ earlier ≤ t, ∃ q ∉ faulty, Minidregg.Kernel.GenericSimplexVAInvariant.SafeAt tr earlier q v x
