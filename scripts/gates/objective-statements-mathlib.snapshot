S theorem Minidregg.Kernel.Door.door_load_deterministic : ∀ {E : Minidregg.Compiler.Evaluator} {d : Minidregg.Compiler.EvalDoor E.Params E.Code E.Input E.Output E.Term} {program : Minidregg.Compiler.NockProgramCodec.Program} {view : Minidregg.Kernel.Door.View} {state state' : E.Output} {k : ℕ}, Minidregg.Kernel.Door.stateNow E.toMachine d program view = Except.ok (Minidregg.Theory.Eval.Ran.ok state k) → (∃ code stored, E.decode program.jam = Option.some code ∧ Minidregg.Kernel.Door.loadedState d view = Except.ok stored ∧ E.Spec (d.load code stored) state') → state' = state
S theorem Minidregg.Kernel.Door.door_other_state_stale : ∀ {E : Minidregg.Compiler.Evaluator} {d : Minidregg.Compiler.EvalDoor E.Params E.Code E.Input E.Output E.Term}, d ∈ E.door → ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {code : E.Code} {stored stored' : Option E.Output} {event : ℕ} {ev : d.Event}, E.decode program.jam = Option.some code → Minidregg.Kernel.Door.loadedState d view = Except.ok stored → claim.sampleJam = E.encodeInput (d.pokeInput stored' event ev) → stored' ≠ stored ∨ event ≠ view.event + 1 → Minidregg.Kernel.Door.checkPoke E.toMachine d program door view claim writes = Except.error (Minidregg.Kernel.Run.Refusal.sampleStale Option.none)
S theorem Minidregg.Kernel.Door.door_peek_pure : ∀ {E : Minidregg.Compiler.Evaluator} {d : Minidregg.Compiler.EvalDoor E.Params E.Code E.Input E.Output E.Term} {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {path : E.Input} {out : E.Output} {k : ℕ}, Minidregg.Kernel.Door.peek E.toMachine d program door view path = Except.ok (Minidregg.Theory.Eval.Ran.ok out k) → ∃ code stored, E.decode program.jam = Option.some code ∧ Minidregg.Kernel.Door.loadedState d view = Except.ok stored ∧ E.Spec (d.peek code stored door.peek path) out ∧ E.steps program.abi.fuel (d.peek code stored door.peek path) = k
S theorem Minidregg.Kernel.Door.door_poke_deterministic : ∀ {E : Minidregg.Compiler.Evaluator} {d : Minidregg.Compiler.EvalDoor E.Params E.Code E.Input E.Output E.Term} {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim claim' : Minidregg.Kernel.Run.RunClaim} {writes writes' : List Minidregg.Theory.Eval.FieldWrite} {verdict verdict' : Minidregg.Kernel.Run.Verdict E.Output}, Minidregg.Kernel.Door.checkPoke E.toMachine d program door view claim writes = Except.ok verdict → Minidregg.Kernel.Door.checkPoke E.toMachine d program door view claim' writes' = Except.ok verdict' → claim.sampleJam = claim'.sampleJam → verdict.output = verdict'.output ∧ verdict.writes = verdict'.writes
S theorem Minidregg.Kernel.Door.door_poke_sound : ∀ {E : Minidregg.Compiler.Evaluator} {d : Minidregg.Compiler.EvalDoor E.Params E.Code E.Input E.Output E.Term} {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict E.Output}, Minidregg.Kernel.Door.checkPoke E.toMachine d program door view claim writes = Except.ok verdict → ∃ code stored ev params product effects state decoded, E.decode program.jam = Option.some code ∧ Minidregg.Kernel.Door.loadedState d view = Except.ok stored ∧ d.eventOf claim.sampleJam = Option.some ev ∧ claim.sampleJam = E.encodeInput (d.pokeInput stored (view.event + 1) ev) ∧ E.decodeParams program.params = Option.some params ∧ E.oracle claim.steps (d.poke params code stored (view.event + 1) ev) = Minidregg.Theory.Eval.Ran.ok product claim.steps ∧ E.Spec (d.poke params code stored (view.event + 1) ev) product ∧ d.product product = Option.some (effects, state) ∧ verdict.output = d.claimOutput effects state ∧ claim.outputJam = E.encodeOutput verdict.output ∧ d.effects program.abi.outputs effects = Except.ok decoded ∧ verdict.writes = Minidregg.Kernel.Door.stateWrites door view (d.encodeState state) ++ decoded ∧ (List.map (fun w => (w.target, w.field)) (Minidregg.Kernel.Door.stateWrites door view (d.encodeState state) ++ decoded)).Nodup ∧ (∀ (w : Minidregg.Theory.Eval.FieldWrite), w ∈ writes ↔ w ∈ verdict.writes) ∧ verdict.steps = claim.steps ∧ claim.steps ≤ program.abi.fuel
S theorem Minidregg.Kernel.Door.door_state_stale_refused : ∀ {M : Minidregg.Compiler.Machine} {d : Minidregg.Compiler.EvalDoor M.Params M.Code M.Input M.Output M.Term} {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {code : M.Code} {stored : Option M.Output} {ev : d.Event}, M.decode program.jam = Option.some code → Minidregg.Kernel.Door.loadedState d view = Except.ok stored → d.eventOf claim.sampleJam = Option.some ev → claim.sampleJam ≠ M.encodeInput (d.pokeInput stored (view.event + 1) ev) → Minidregg.Kernel.Door.checkPoke M d program door view claim writes = Except.error (Minidregg.Kernel.Run.Refusal.sampleStale Option.none)
