S theorem Minidregg.Kernel.GeneralSimplexReachability.committed_not_disabled : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f v t p : ℕ} {c : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty v c → p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.disable p v → False
S theorem Minidregg.Kernel.GeneralSimplexReachability.committed_prefix_consistency : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f v w : ℕ} {b c : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty v b → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty w c → b <+: c ∨ c <+: b
