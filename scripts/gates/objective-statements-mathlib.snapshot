S theorem Minidregg.Kernel.HyperdocumentIndexSync.backlinkAt_complete : ∀ {capacity : ℕ} (snapshot : Minidregg.Kernel.HyperdocumentIndexSync.Snapshot capacity), snapshot.Fresh → ∀ (slot : Fin capacity) (entry : Minidregg.Kernel.HyperdocumentIndexSync.SourceEntry), snapshot.corpus slot = Option.some entry → entry.record.tombstonedAt = Option.none → Minidregg.Kernel.HyperdocumentIndexSync.backlinkAt snapshot.index entry.record.target slot = Option.some { linkId := entry.linkId, sourceDocument := entry.record.sourceDocument, sourceRange := entry.record.source, target := entry.record.target, relation := entry.record.relation, operation := entry.record.operation }
S theorem Minidregg.Kernel.HyperdocumentIndexSync.backlinkAt_sound : ∀ {capacity : ℕ} (index : Minidregg.Kernel.HyperdocumentIndexSync.Index capacity) (target : Minidregg.Theory.Hyperdocument.LinkTarget) (slot : Fin capacity) (row : Minidregg.Kernel.HyperdocumentIndexSync.IndexedRow), Minidregg.Kernel.HyperdocumentIndexSync.backlinkAt index target slot = Option.some row → index slot = Option.some row ∧ row.target = target
