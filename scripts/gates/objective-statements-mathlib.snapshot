S theorem Minidregg.Kernel.Seats.empty_want_list_requires_marker : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {id : Minidregg.Kernel.Invitations.InvitationId} {expect : Minidregg.Kernel.Invitations.Expectation} {seatAccount funding payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal} {holder : Option ℕ} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.offer id expect seatAccount funding payee proposal holder) = Except.ok (next, batch) → proposal.want = [] → proposal.donate = Bool.true
S theorem Minidregg.Kernel.Seats.empty_want_requires_marker : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {id : Minidregg.Kernel.Invitations.InvitationId} {expect : Minidregg.Kernel.Invitations.Expectation} {seatAccount funding payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal} {holder : Option ℕ} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.offer id expect seatAccount funding payee proposal holder) = Except.ok (next, batch) → proposal.wantsNothing = Bool.true → proposal.donate = Bool.true
