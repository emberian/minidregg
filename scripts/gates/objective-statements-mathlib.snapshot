S theorem Minidregg.Kernel.LinkIndex.admitWrites_heights : ∀ (height : ℕ) (cell : Minidregg.Kernel.DurableDataIntent.CellId) (writes : List Minidregg.Kernel.DurableDataIntent.DataWrite) (acc : Minidregg.Kernel.LinkIndex.Sources × Bool), ∀ entry ∈ Minidregg.Kernel.LinkIndex.lookup (Minidregg.Kernel.LinkIndex.admitWrites height writes acc).1 cell, (∃ earlier ∈ Minidregg.Kernel.LinkIndex.lookup acc.1 cell, earlier.key = entry.key ∧ earlier.height = entry.height) ∨ entry.height = height ∧ ∃ write ∈ writes, write.cellId = cell ∧ entry.key ∈ Minidregg.Kernel.LinkIndex.liveLinks write.canonicalPostBytes
S theorem Minidregg.Kernel.LinkIndex.admitWrites_keys : ∀ (height : ℕ) (cell : Minidregg.Kernel.DurableDataIntent.CellId) (writes : List Minidregg.Kernel.DurableDataIntent.DataWrite) (acc : Minidregg.Kernel.LinkIndex.Sources × Bool), List.map Minidregg.Kernel.LinkIndex.Entry.key (Minidregg.Kernel.LinkIndex.lookup (Minidregg.Kernel.LinkIndex.admitWrites height writes acc).1 cell) = match (List.filter (fun write => Decidable.decide (write.cellId = cell)) writes).getLast? with | Option.some write => Minidregg.Kernel.LinkIndex.liveLinks write.canonicalPostBytes | Option.none => List.map Minidregg.Kernel.LinkIndex.Entry.key (Minidregg.Kernel.LinkIndex.lookup acc.1 cell)
S theorem Minidregg.Kernel.LinkIndex.admitWrites_nodup : ∀ (height : ℕ) (writes : List Minidregg.Kernel.DurableDataIntent.DataWrite) (acc : Minidregg.Kernel.LinkIndex.Sources × Bool), (List.map Prod.fst acc.1).Nodup → (List.map Prod.fst (Minidregg.Kernel.LinkIndex.admitWrites height writes acc).1).Nodup
