S theorem Minidregg.Compiler.PredOrder.shiftedNat_cast : ∀ {F : Type} [inst : Field F] {k : ℕ} {present : Bool} {a b : ℤ}, Minidregg.Compiler.PredOrder.InputsInRange k present a b → ↑(Minidregg.Compiler.PredOrder.shiftedNat k present a b) = ↑(Minidregg.Compiler.PredOrder.sourceDelta present a b) + 2 ^ k
