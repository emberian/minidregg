S theorem Minidregg.Theory.LogAccumulator.rootOfPath_honest : ∀ {D : Type} (node : D → D → D) (leaf : ℕ → D) (j : ℕ) (nodes : ℕ → ℕ → Option D), (∀ (k e : ℕ), nodes k e = Option.some (Minidregg.Theory.LogAccumulator.block node leaf k e)) → ∀ (k e : ℕ), e - 2 ^ k < j → j ≤ e → Minidregg.Theory.LogAccumulator.rootOfPath node (leaf j) nodes j k e = Option.some (Minidregg.Theory.LogAccumulator.block node leaf k e)
S theorem Minidregg.Theory.LogAccumulator.rootOfPath_sound : ∀ {D : Type} (node : D → D → D) (leaf : ℕ → D) (j : ℕ) (claimed : D) (nodes : ℕ → ℕ → Option D) (k e : ℕ), e - 2 ^ k < j → j ≤ e → Minidregg.Theory.LogAccumulator.rootOfPath node claimed nodes j k e = Option.some (Minidregg.Theory.LogAccumulator.block node leaf k e) → claimed = leaf j ∨ Minidregg.Theory.LogAccumulator.NodeCollision node
