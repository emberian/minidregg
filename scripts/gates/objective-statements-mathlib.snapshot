S theorem Minidregg.Selvage.adaptiveUnionBound_fixedCase : ∀ {F : Type} [Field F] [inst : Fintype F] {v d : ℕ} (b : Fin v → Finset F), (∀ (i : Fin v), (b i).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => ∃ i, r i ∈ (fun _r => b) r i) ≤ ↑v * (↑d / ↑(Fintype.card F))
S theorem Minidregg.Selvage.adaptiveUnionBound_holds : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] {v d : ℕ}, Minidregg.Selvage.AdaptiveUnionBound F v d
S theorem Minidregg.Selvage.adaptive_sumcheck_retires_constraint : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] [inst_2 : Fintype F] [DecidableEq F] {v d : ℕ} {prover honest : (ℕ → F) → ℕ → Polynomial F} {f : ι → F} {c : Minidregg.Selvage.LinearConstraint ι F}, ¬Minidregg.Selvage.Satisfies f c → Minidregg.Selvage.PrefixMeasurable prover → Minidregg.Selvage.PrefixMeasurable honest → (∀ (χ : ℕ → F), ∀ i < v, (prover χ i).degree < ↑(d + 1)) → (∀ (χ : ℕ → F), ∀ i < v, (honest χ i).degree < ↑(d + 1)) → (∀ (r : Fin v → F), ∀ i < v, Polynomial.eval 0 (honest (Minidregg.Selvage.chalOf r) i) + Polynomial.eval 1 (honest (Minidregg.Selvage.chalOf r) i) = Minidregg.Selvage.scChain (Minidregg.Selvage.trueSum c f) (honest (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.chalOf r) i) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => Minidregg.Selvage.SumcheckAccepts (prover (Minidregg.Selvage.chalOf r)) (honest (Minidregg.Selvage.chalOf r)) c.target (Minidregg.Selvage.trueSum c f) r) ≤ ↑v * (↑d / ↑(Fintype.card F))
S theorem Minidregg.Selvage.adaptive_sumcheck_soundness : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [DecidableEq F] {v d : ℕ} {prover honest : (ℕ → F) → ℕ → Polynomial F} {H S : F}, Minidregg.Selvage.PrefixMeasurable prover → Minidregg.Selvage.PrefixMeasurable honest → (∀ (χ : ℕ → F), ∀ i < v, (prover χ i).degree < ↑(d + 1)) → (∀ (χ : ℕ → F), ∀ i < v, (honest χ i).degree < ↑(d + 1)) → (∀ (r : Fin v → F), ∀ i < v, Polynomial.eval 0 (honest (Minidregg.Selvage.chalOf r) i) + Polynomial.eval 1 (honest (Minidregg.Selvage.chalOf r) i) = Minidregg.Selvage.scChain S (honest (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.chalOf r) i) → Minidregg.Selvage.uniformProb (Fin v → F) (Minidregg.Selvage.AdaptiveAcceptsFalse prover honest H S) ≤ ↑v * (↑d / ↑(Fintype.card F))
