S theorem Minidregg.Kernel.Run.no_accepted_of_output_mismatch : ∀ {E : Minidregg.Compiler.Evaluator} {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : E.Input} {writes : List Minidregg.Theory.Eval.FieldWrite} {t : E.Term} {out : E.Output} {decoded : List Minidregg.Theory.Eval.FieldWrite}, Minidregg.Kernel.Run.runOf E.toMachine program libraries sample = Option.some t → E.Spec t out → E.writesOf program.abi out = Option.some decoded → (∃ w, ¬(w ∈ writes ↔ w ∈ decoded)) → ∀ (claim : Minidregg.Kernel.Run.RunClaim) (verdict : Minidregg.Kernel.Run.Verdict E.Output), Minidregg.Kernel.Run.checkRun E.toMachine program libraries sample claim writes ≠ Except.ok verdict
S theorem Minidregg.Kernel.Run.nock.checkRun_deterministic : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : Minidregg.Theory.Noun} {claim claim' : Minidregg.Kernel.Run.RunClaim} {writes writes' : List Minidregg.Theory.Eval.FieldWrite} {verdict verdict' : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample claim writes = Except.ok verdict → Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample claim' writes' = Except.ok verdict' → verdict = verdict' ∧ claim.outputJam = claim'.outputJam ∧ claim.steps = claim'.steps
S theorem Minidregg.Kernel.Run.nock.checkRun_sound : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : Minidregg.Theory.Noun} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample claim writes = Except.ok verdict → ∃ s f, Minidregg.Kernel.Run.runOf Minidregg.Compiler.Machine.nock program libraries sample = Option.some (s, f) ∧ Minidregg.Theory.Nock.Step s f verdict.output ∧ Minidregg.Kernel.NockEntry.decodeWrites program.abi verdict.output = Option.some verdict.writes ∧ (∀ (w : Minidregg.Theory.Eval.FieldWrite), w ∈ writes ↔ w ∈ verdict.writes) ∧ claim.sampleJam = sample.jam ∧ claim.outputJam = verdict.output.jam ∧ verdict.steps = claim.steps ∧ claim.steps ≤ program.abi.fuel ∧ Minidregg.Theory.Nock.run claim.steps s f = Except.ok verdict.output ∧ Minidregg.Theory.Nock.steps claim.steps s f = verdict.steps
S theorem Minidregg.Kernel.Run.nock.no_accepted_of_output_mismatch : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : Minidregg.Theory.Noun} {writes : List Minidregg.Theory.Eval.FieldWrite} {s f out : Minidregg.Theory.Noun} {decoded : List Minidregg.Theory.Eval.FieldWrite}, Minidregg.Kernel.Run.runOf Minidregg.Compiler.Machine.nock program libraries sample = Option.some (s, f) → Minidregg.Theory.Nock.Step s f out → Minidregg.Kernel.NockEntry.decodeWrites program.abi out = Option.some decoded → (∃ w, ¬(w ∈ writes ↔ w ∈ decoded)) → ∀ (claim : Minidregg.Kernel.Run.RunClaim) (verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun), Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample claim writes ≠ Except.ok verdict
S theorem Minidregg.Kernel.Run.nock.pinned_claim_stale_on_field_change : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {ctx ctx' : Minidregg.Kernel.NockProgramCell.Context} {targets : List ℕ} {read read' : ℕ → String → Option ℤ} {sample sample' : Minidregg.Theory.Noun} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot}, program.abi.context = Minidregg.Compiler.NockProgramCodec.ContextMode.pinned → Minidregg.Kernel.NockProgramCell.sampleOf program.abi ctx targets read = Option.some sample → Minidregg.Kernel.NockProgramCell.sampleOf program.abi ctx' targets read' = Option.some sample' → claim.sampleJam = sample.jam → slot ∈ program.abi.sample → read slot.target slot.slot ≠ read' slot.target slot.slot → (∀ s ∈ program.abi.sample, s ≠ slot → read s.target s.slot = read' s.target s.slot) → Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample' claim writes = Except.error (Minidregg.Kernel.Run.Refusal.sampleStale (Option.some slot.key))
S theorem Minidregg.Kernel.Run.nock.steps_equal_oracle : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {sample : Minidregg.Theory.Noun} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.Run.checkRun Minidregg.Compiler.Machine.nock program libraries sample claim writes = Except.ok verdict → ∃ s f, Minidregg.Kernel.Run.runOf Minidregg.Compiler.Machine.nock program libraries sample = Option.some (s, f) ∧ verdict.steps = Minidregg.Theory.Nock.steps program.abi.fuel s f ∧ claim.steps = verdict.steps
S theorem Minidregg.Kernel.Run.nock.steps_of_run : ∀ {fuel fuel' : ℕ} {s f v : Minidregg.Theory.Noun}, Minidregg.Theory.Nock.run fuel s f = Except.ok v → fuel ≤ fuel' → Minidregg.Theory.Nock.steps fuel' s f = Minidregg.Theory.Nock.steps fuel s f
S theorem Minidregg.Kernel.Run.nock_found : List.find? (fun E => Decidable.decide (E.id = Minidregg.Compiler.Evaluator.nock.id)) Minidregg.Compiler.Evaluator.registry = Option.some Minidregg.Compiler.Evaluator.nock
