S theorem Minidregg.Kernel.HyperdocumentIndexSync.applyDelta_matched : ∀ {capacity : ℕ} (snapshot : Minidregg.Kernel.HyperdocumentIndexSync.Snapshot capacity) (delta : Minidregg.Kernel.HyperdocumentIndexSync.Delta capacity), snapshot.MatchesDelta delta → Minidregg.Kernel.HyperdocumentIndexSync.applyDelta snapshot delta = Minidregg.Kernel.HyperdocumentIndexSync.ApplyResult.applied (snapshot.advance delta)
