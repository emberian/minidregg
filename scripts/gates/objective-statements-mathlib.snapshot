S theorem Minidregg.Compiler.CanonicalPolicyAdmission.wrong_policy_rejected : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {committed : Minidregg.Compiler.CanonicalPolicyAdmission.CommittedPolicy} (witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F), config.registry.resolve request.policyId request.policyRevision = Option.some committed → committed.record.policyId ≠ request.policyId → config.verifies request witness = Bool.false
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.wrong_step_binding_rejected : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {committed : Minidregg.Compiler.CanonicalPolicyAdmission.CommittedPolicy} (witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F), config.registry.resolve request.policyId request.policyRevision = Option.some committed → config.stepBinding.matches request witness.oldState witness.newState = Bool.false → config.verifies request witness = Bool.false
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.wrong_version_rejected : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {committed : Minidregg.Compiler.CanonicalPolicyAdmission.CommittedPolicy} (witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F), config.registry.resolve request.policyId request.policyRevision = Option.some committed → committed.record.policyId = request.policyId → committed.record.version ≠ request.policyRevision → config.verifies request witness = Bool.false
