S theorem Minidregg.Compiler.NativeKernelPlan.arbitraryRunner_integrity : ∀ {Error : Type} (manifest : Minidregg.Compiler.SemanticManifest.Manifest) (plan : Minidregg.Compiler.NativeKernelPlan.Plan) (runner : Minidregg.Compiler.NativeKernelPlan.PlanRunner Error), (Minidregg.Compiler.NativeKernelPlan.run manifest plan runner).IsVerified → plan.manifestEncoding = manifest.canonicalEncoding ∧ ∀ instruction ∈ plan.instructions, ∃ response, runner instruction = Except.ok response ∧ ∃ clause, manifest.lookupClause instruction.clauseId = Option.some clause ∧ instruction.call.FullyWellFormed ∧ Minidregg.Compiler.NativeKernelPlan.PublicPrefixExact instruction response ∧ instruction.call.Accepts response.totalWires
