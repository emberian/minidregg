S inductive Minidregg.Kernel.Hyperedge : (ι : Type v) → [Fintype ι] → (Carrier : Type uCarrier) → (Turn : Type uTurn) → (TurnId : Type uTurnId) → (Bal : Type uBal) → [AddCommMonoid Bal] → [DecidableEq TurnId] → (Carrier → Turn → Carrier) → (ι → Carrier → TurnId) → (ι → Carrier → Turn → Bal) → Type (max (max (max uCarrier uTurn) uTurnId) v)
S theorem Minidregg.Kernel.Hyperedge.agree : ∀ {ι : Type v} [inst : Fintype ι] {Carrier : Type uCarrier} {Turn : Type uTurn} {TurnId : Type uTurnId} {Bal : Type uBal} [inst_1 : AddCommMonoid Bal] [inst_2 : DecidableEq TurnId] {step : Carrier → Turn → Carrier} {turnId : ι → Carrier → TurnId} {halfEdge : ι → Carrier → Turn → Bal} (self : Minidregg.Kernel.Hyperedge ι Carrier Turn TurnId Bal step turnId halfEdge) (i : ι), turnId i (step (self.x i) self.t) = self.tid
S theorem Minidregg.Kernel.Hyperedge.balanced : ∀ {ι : Type v} [inst : Fintype ι] {Carrier : Type uCarrier} {Turn : Type uTurn} {TurnId : Type uTurnId} {Bal : Type uBal} [inst_1 : AddCommMonoid Bal] [inst_2 : DecidableEq TurnId] {step : Carrier → Turn → Carrier} {turnId : ι → Carrier → TurnId} {halfEdge : ι → Carrier → Turn → Bal} (self : Minidregg.Kernel.Hyperedge ι Carrier Turn TurnId Bal step turnId halfEdge), ∑ i, halfEdge i (self.x i) self.t = 0
S theorem Minidregg.Kernel.Hyperedge.binary_balanced : ∀ {Carrier : Type uCarrier} {Turn : Type uTurn} {TurnId : Type uTurnId} {Bal : Type uBal} [inst : AddCommMonoid Bal] [inst_1 : DecidableEq TurnId] {step : Carrier → Turn → Carrier} {turnId : Fin 2 → Carrier → TurnId} {halfEdge : Fin 2 → Carrier → Turn → Bal} (H : Minidregg.Kernel.Hyperedge (Fin 2) Carrier Turn TurnId Bal step turnId halfEdge), halfEdge 0 (H.x 0) H.t + halfEdge 1 (H.x 1) H.t = 0
S theorem Minidregg.Kernel.Hyperedge.binding_is_proper : ∃ x t tid step turnId halfEdge, (∀ (i : Unit), turnId i (step (x i) t) = tid) ∧ ∑ i, halfEdge i (x i) t ≠ 0
S theorem Minidregg.Kernel.Hyperedge.legs_agree : ∀ {ι : Type v} [inst : Fintype ι] {Carrier : Type uCarrier} {Turn : Type uTurn} {TurnId : Type uTurnId} {Bal : Type uBal} [inst_1 : AddCommMonoid Bal] [inst_2 : DecidableEq TurnId] {step : Carrier → Turn → Carrier} {turnId : ι → Carrier → TurnId} {halfEdge : ι → Carrier → Turn → Bal} (H : Minidregg.Kernel.Hyperedge ι Carrier Turn TurnId Bal step turnId halfEdge) (i j : ι), turnId i (step (H.x i) H.t) = turnId j (step (H.x j) H.t)
