S def Minidregg.Compiler.descriptorToJson : {p : ℕ} → [NeZero p] → Minidregg.Compiler.ConstraintDescriptor (ZMod p) → Lean.Json #965998116
S def Minidregg.Compiler.dgateFromJson? : {p : ℕ} → Lean.Json → Except String (Minidregg.Compiler.DGate (ZMod p)) #46973379
S def Minidregg.Compiler.dgateToJson : {p : ℕ} → [NeZero p] → Minidregg.Compiler.DGate (ZMod p) → Lean.Json #2533627729
S def Minidregg.Compiler.digestOf : {F : Type} → [Field F] → Minidregg.Pred.State → List Minidregg.Pred.Slot → Minidregg.Pred.Slot → Minidregg.Pred.Slot → F #332039241
S def Minidregg.Compiler.digests : Minidregg.Pred.Pred → Minidregg.Pred.State → List ℤ #1392139372
S def Minidregg.Compiler.digestsL : Minidregg.Pred.PredList → Minidregg.Pred.State → List ℤ #3188306242
S def Minidregg.Compiler.dwireFromJson? : {p : ℕ} → Lean.Json → Except String (Minidregg.Compiler.DWire (ZMod p)) #1091328155
S def Minidregg.Compiler.dwireToJson : {p : ℕ} → [NeZero p] → Minidregg.Compiler.DWire (ZMod p) → Lean.Json #504894145
S def Minidregg.Compiler.emit : {F Idx : Type u} → (Idx → ℕ) → ℕ → ℕ → Minidregg.Compiler.ConstraintSystem F Idx → Minidregg.Compiler.ConstraintDescriptor F #684807959
S def Minidregg.Compiler.emitGate : {F Idx : Type u} → (Idx → ℕ) → ℕ → Minidregg.Compiler.Gate F Idx → Minidregg.Compiler.DGate F #3444459429
S theorem Minidregg.Compiler.emitGate_holds_iff : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (ix : Idx → ℕ) (nVars : ℕ) (wv : ℕ → F) (g : Minidregg.Compiler.Gate F Idx), Minidregg.Compiler.DGate.holds wv (Minidregg.Compiler.emitGate ix nVars g) ↔ Minidregg.Compiler.Gate.holds (Minidregg.Compiler.readVars ix wv) (Minidregg.Compiler.readAux nVars wv) g
S def Minidregg.Compiler.emitWire : {F Idx : Type u} → (Idx → ℕ) → ℕ → Minidregg.Compiler.WireRef F Idx → Minidregg.Compiler.DWire F #1450376074
S theorem Minidregg.Compiler.emitWire_bounded : ∀ {F Idx : Type u} (ix : Idx → ℕ) {nVars N lo hi : ℕ}, (∀ (i : Idx), ix i < nVars) → nVars + hi ≤ N → ∀ {w : Minidregg.Compiler.WireRef F Idx}, Minidregg.Compiler.WireRef.auxIn lo hi w → Minidregg.Compiler.DWire.bounded N (Minidregg.Compiler.emitWire ix nVars w)
S theorem Minidregg.Compiler.emitWire_read : ∀ {F Idx : Type u} (ix : Idx → ℕ) (nVars : ℕ) (wv : ℕ → F) (w : Minidregg.Compiler.WireRef F Idx), Minidregg.Compiler.DWire.read wv (Minidregg.Compiler.emitWire ix nVars w) = Minidregg.Compiler.WireRef.read (Minidregg.Compiler.readVars ix wv) (Minidregg.Compiler.readAux nVars wv) w
S theorem Minidregg.Compiler.emit_accepts_iff : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (ix : Idx → ℕ), Function.Injective ix → ∀ (nPublic nVars : ℕ), (∀ (i : Idx), ix i < nVars) → ∀ (asg : Idx → F) (s : Minidregg.Compiler.ConstraintSystem F Idx), (∃ wv, (∀ (i : Idx), wv (ix i) = asg i) ∧ Minidregg.Compiler.descriptorHolds (Minidregg.Compiler.emit ix nPublic nVars s) wv) ↔ Minidregg.Compiler.systemAccepts asg s
S theorem Minidregg.Compiler.emit_accepts_iff_fin : ∀ {K : Type} [inst : Field K] (m nPublic : ℕ) (asg : Fin m → K) (s : Minidregg.Compiler.ConstraintSystem K (Fin m)), (∃ wv, (∀ (i : Fin m), wv ↑i = asg i) ∧ Minidregg.Compiler.descriptorHolds (Minidregg.Compiler.emit Fin.val nPublic m s) wv) ↔ Minidregg.Compiler.systemAccepts asg s
S theorem Minidregg.Compiler.emit_faithful : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (ix : Idx → ℕ) (nPublic nVars : ℕ) (s : Minidregg.Compiler.ConstraintSystem F Idx) (wv : ℕ → F), Minidregg.Compiler.descriptorHolds (Minidregg.Compiler.emit ix nPublic nVars s) wv ↔ Minidregg.Compiler.gatesHold (Minidregg.Compiler.readVars ix wv) (Minidregg.Compiler.readAux nVars wv) (Minidregg.Compiler.flattenSystem s 0).gates ∧ ∀ r ∈ (Minidregg.Compiler.flattenSystem s 0).roots, Minidregg.Compiler.WireRef.read (Minidregg.Compiler.readVars ix wv) (Minidregg.Compiler.readAux nVars wv) r = 0
S theorem Minidregg.Compiler.emit_semHolds_iff : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (ix : Idx → ℕ), Function.Injective ix → ∀ (nPublic nVars : ℕ), (∀ (i : Idx), ix i < nVars) → ∀ (asg : Idx → F) (s : Minidregg.Compiler.ConstraintSystem F Idx), (∃ wv, (∀ (i : Idx), wv (ix i) = asg i) ∧ Minidregg.Compiler.descriptorHolds (Minidregg.Compiler.emit ix nPublic nVars s) wv) ↔ Minidregg.Compiler.systemSemHolds asg s
S theorem Minidregg.Compiler.emit_wellFormed : ∀ {F Idx : Type u} (ix : Idx → ℕ) (nPublic nVars : ℕ), nPublic ≤ nVars → (∀ (i : Idx), ix i < nVars) → ∀ (s : Minidregg.Compiler.ConstraintSystem F Idx), (Minidregg.Compiler.emit ix nPublic nVars s).WellFormed
S def Minidregg.Compiler.encodeBit : {F : Type u} → [Field F] → Bool → F #2591783372
S def Minidregg.Compiler.encodeStep : {F : Type u} → [Field F] → F × Bool → F × F #2271068934
S def Minidregg.Compiler.eqD : {F : Type} → [Field F] → Minidregg.Pred.Slot → ℤ → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Minidregg.Compiler.Wire) #242139136
S def Minidregg.Compiler.eqSlotsD : {F : Type} → [Field F] → Minidregg.Pred.Slot → Minidregg.Pred.Slot → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Minidregg.Compiler.Wire) #898254620
S def Minidregg.Compiler.eval : {F : Type u} → [Field F] → {Idx : Type u} → (Idx → F) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → F #2324246658
S def Minidregg.Compiler.evalAlg : {F : Type u} → [Field F] → {Idx : Type u} → (Idx → F) → Minidregg.Compiler.Alg (Minidregg.Compiler.AirSig F Idx) F #2354434965
S def Minidregg.Compiler.evalExec : {F : Type u} → [Field F] → {Idx : Type u} → (Idx → F) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → F #152251856
S theorem Minidregg.Compiler.evalExec_isFoldHom : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F), Minidregg.Compiler.IsFoldHom (Minidregg.Compiler.evalAlg asg) (Minidregg.Compiler.evalExec asg)
S theorem Minidregg.Compiler.evalWithAll_toList : ∀ (O : Minidregg.Pred.Oracle) (ps : Minidregg.Pred.PredList) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWithAll O ps old new = ps.toList.all fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Compiler.evalWithAny_toList : ∀ (O : Minidregg.Pred.Oracle) (ps : Minidregg.Pred.PredList) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWithAny O ps old new = ps.toList.any fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Compiler.eval_add' : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (a b : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.add' a b) = Minidregg.Compiler.eval asg a + Minidregg.Compiler.eval asg b
S theorem Minidregg.Compiler.eval_addConst : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (c : F) (e : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.addConst c e) = Minidregg.Compiler.eval asg e + c
S theorem Minidregg.Compiler.eval_agrees_exec : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F), Minidregg.Compiler.evalExec asg = Minidregg.Compiler.eval asg
S theorem Minidregg.Compiler.eval_cst : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (c : F), Minidregg.Compiler.eval asg (Minidregg.Compiler.cst c) = c
S theorem Minidregg.Compiler.eval_eqD : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (s : Minidregg.Pred.Slot) (v : ℤ), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.eqD s v) = Minidregg.Compiler.valOf new s - ↑v
S theorem Minidregg.Compiler.eval_eqSlotsD : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (a b : Minidregg.Pred.Slot), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.eqSlotsD a b) = Minidregg.Compiler.valOf new a - Minidregg.Compiler.valOf new b
S theorem Minidregg.Compiler.eval_hashD : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (v : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.hashD v b c) = Minidregg.Compiler.digestOf new v b c - Minidregg.Compiler.valOf new c
S theorem Minidregg.Compiler.eval_leSlotsOff_source : ∀ (old new : Minidregg.Pred.State) (a b : Minidregg.Pred.Slot) (c : ℤ), Minidregg.Pred.eval (Minidregg.Pred.Pred.leSlotsOff a b c) old new = ((new.get a).isSome && (new.get b).isSome && Decidable.decide (Minidregg.Compiler.intOf new a ≤ Minidregg.Compiler.intOf new b + c))
S theorem Minidregg.Compiler.eval_leSlots_source : ∀ (old new : Minidregg.Pred.State) (a b : Minidregg.Pred.Slot), Minidregg.Pred.eval (Minidregg.Pred.Pred.leSlots a b) old new = ((new.get a).isSome && (new.get b).isSome && Decidable.decide (Minidregg.Compiler.intOf new a ≤ Minidregg.Compiler.intOf new b))
S theorem Minidregg.Compiler.eval_le_source : ∀ (old new : Minidregg.Pred.State) (s : Minidregg.Pred.Slot) (v : ℤ), Minidregg.Pred.eval (Minidregg.Pred.Pred.le s v) old new = ((new.get s).isSome && Decidable.decide (Minidregg.Compiler.intOf new s ≤ v))
S theorem Minidregg.Compiler.eval_levelTerm : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (node : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (sd : Idx × Idx), Minidregg.Compiler.eval asg (Minidregg.Compiler.levelTerm spec node sd) = Minidregg.Compiler.muxStepExec spec (Minidregg.Compiler.eval asg node) (asg sd.1, asg sd.2)
S theorem Minidregg.Compiler.eval_linearLayer : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (M : Fin w → Fin w → F) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (i : Fin w), Minidregg.Compiler.eval asg (Minidregg.Compiler.linearLayer M state i) = ∑ j, M i j * Minidregg.Compiler.eval asg (state j)
S theorem Minidregg.Compiler.eval_memD : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (s : Minidregg.Pred.Slot) (xs : List ℤ), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.memD s xs) = (List.map (fun c => Minidregg.Compiler.valOf new s - ↑c) xs).prod
S theorem Minidregg.Compiler.eval_mkAdd : ∀ {F : Type} [inst : Field F] {Idx : Type} (asg : Idx → F) (k : Bool → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (WType.mk Minidregg.Compiler.AirOp.add k) = Minidregg.Compiler.eval asg (k Bool.false) + Minidregg.Compiler.eval asg (k Bool.true)
S theorem Minidregg.Compiler.eval_mkMul : ∀ {F : Type} [inst : Field F] {Idx : Type} (asg : Idx → F) (k : Bool → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (WType.mk Minidregg.Compiler.AirOp.mul k) = Minidregg.Compiler.eval asg (k Bool.false) * Minidregg.Compiler.eval asg (k Bool.true)
S theorem Minidregg.Compiler.eval_monotone_source : ∀ (old new : Minidregg.Pred.State) (s : Minidregg.Pred.Slot), Minidregg.Pred.eval (Minidregg.Pred.Pred.monotone s) old new = ((old.get s).isSome && (new.get s).isSome && Decidable.decide (Minidregg.Compiler.intOf old s ≤ Minidregg.Compiler.intOf new s))
S theorem Minidregg.Compiler.eval_mul' : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (a b : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.mul' a b) = Minidregg.Compiler.eval asg a * Minidregg.Compiler.eval asg b
S theorem Minidregg.Compiler.eval_muxTerm : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (d a b : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.muxTerm d a b) = Minidregg.Compiler.muxExec (Minidregg.Compiler.eval asg d) (Minidregg.Compiler.eval asg a) (Minidregg.Compiler.eval asg b)
S theorem Minidregg.Compiler.eval_notT : ∀ {F : Type} [inst : Field F] {Idx : Type} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.notT t) = 1 - Minidregg.Compiler.eval asg t
S theorem Minidregg.Compiler.eval_offR : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (b : Minidregg.Pred.Slot) (c : ℤ), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.offR b c) = ↑(Minidregg.Compiler.intOf new b + c)
S theorem Minidregg.Compiler.eval_pathTerm : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (path : List (Idx × Idx)) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.pathTerm spec t path) = Minidregg.Compiler.merkleMuxExec spec (Minidregg.Compiler.eval asg t) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
S theorem Minidregg.Compiler.eval_prodT : ∀ {F : Type} [inst : Field F] {Idx : Type} (asg : Idx → F) (l : List (Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx))), Minidregg.Compiler.eval asg (Minidregg.Compiler.prodT l) = (List.map (Minidregg.Compiler.eval asg) l).prod
S theorem Minidregg.Compiler.eval_prodT_notT : ∀ {F : Type} [inst : Field F] {Idx : Type} (asg : Idx → F) (l : List (Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx))), Minidregg.Compiler.eval asg (Minidregg.Compiler.prodT (List.map Minidregg.Compiler.notT l)) = (List.map (fun x => 1 - x) (List.map (Minidregg.Compiler.eval asg) l)).prod
S theorem Minidregg.Compiler.eval_renameT : ∀ {F : Type} [inst : Field F] {Idx Idx' : Type} (asg : Idx' → F) (f : Idx → Idx') (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.renameT f t) = Minidregg.Compiler.eval (asg ∘ f) t
S theorem Minidregg.Compiler.eval_roundFn : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (a : ℕ) (r : Minidregg.Compiler.Round F w) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), (fun i => Minidregg.Compiler.eval asg (Minidregg.Compiler.roundFn a r state i)) = Minidregg.Compiler.roundExec a r fun i => Minidregg.Compiler.eval asg (state i)
S theorem Minidregg.Compiler.eval_sbox : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (a : ℕ) (e : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), Minidregg.Compiler.eval asg (Minidregg.Compiler.sbox a e) = Minidregg.Compiler.eval asg e ^ a
S theorem Minidregg.Compiler.eval_sboxLayer : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (a : ℕ) (full : Bool) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (i : Fin w), Minidregg.Compiler.eval asg (Minidregg.Compiler.sboxLayer a full state i) = Minidregg.Compiler.sboxLayerExec a full (fun j => Minidregg.Compiler.eval asg (state j)) i
S theorem Minidregg.Compiler.eval_vr : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (i : Idx), Minidregg.Compiler.eval asg (Minidregg.Compiler.vr i) = asg i
S theorem Minidregg.Compiler.eval_weightedSum : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {k : ℕ} (asg : Idx → F) (bits : Fin k → Idx), Minidregg.Compiler.eval asg (Minidregg.Compiler.weightedSum bits) = ∑ i, asg (bits i) * 2 ^ ↑i
S theorem Minidregg.Compiler.eval_woD1 : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (s : Minidregg.Pred.Slot), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.woD1 s) = Minidregg.Compiler.valOf old s
S theorem Minidregg.Compiler.eval_woD2 : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F) (s : Minidregg.Pred.Slot), Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.woD2 s) = Minidregg.Compiler.valOf new s - Minidregg.Compiler.valOf old s
S def Minidregg.Compiler.exAsg : Unit → ZMod 7 #4189468816
S def Minidregg.Compiler.exDescriptor : Minidregg.Compiler.ConstraintDescriptor (ZMod 7) #1108160213
S def Minidregg.Compiler.exFlat : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig (ZMod 7) Unit) #3401135534
S def Minidregg.Compiler.exForced : ℕ → ZMod 7 #1989232400
S theorem Minidregg.Compiler.exists_boolDecomp : ∀ {F : Type u} [inst : Field F] {k : ℕ}, ∀ n < 2 ^ k, ∃ b, (∀ (i : Fin k), b i = 0 ∨ b i = 1) ∧ ↑n = ∑ i, b i * 2 ^ ↑i
S theorem Minidregg.Compiler.exists_boolDigits : ∀ {k : ℕ}, ∀ n < 2 ^ k, ∃ d, (∀ (i : Fin k), d i ≤ 1) ∧ n = ∑ i, d i * 2 ^ ↑i
S theorem Minidregg.Compiler.exists_boolPath : ∀ {F : Type u} [inst : Field F] {path : List (F × F)}, (∀ sd ∈ path, sd.2 = 0 ∨ sd.2 = 1) → ∃ bpath, path = List.map Minidregg.Compiler.encodeStep bpath
S def Minidregg.Compiler.finVecToJson : {p w : ℕ} → [NeZero p] → (Fin w → ZMod p) → Lean.Json #2373782542
S def Minidregg.Compiler.flatten : {F Idx : Type u} → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Minidregg.Compiler.Flat F Idx #3773987992
S def Minidregg.Compiler.flattenAlg : {F Idx : Type u} → Minidregg.Compiler.Alg (Minidregg.Compiler.AirSig F Idx) (Minidregg.Compiler.Flat F Idx) #257903095
S def Minidregg.Compiler.flattenSystem : {F Idx : Type u} → Minidregg.Compiler.ConstraintSystem F Idx → ℕ → Minidregg.Compiler.FlatSystem F Idx #3592434489
S theorem Minidregg.Compiler.flattenSystem_cons_gates : ∀ {F Idx : Type u} (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (ts : Minidregg.Compiler.ConstraintSystem F Idx) (n : ℕ), (Minidregg.Compiler.flattenSystem (t :: ts) n).gates = (Minidregg.Compiler.flatten t n).gates ++ (Minidregg.Compiler.flattenSystem ts (Minidregg.Compiler.flatten t n).next).gates
S theorem Minidregg.Compiler.flattenSystem_cons_next : ∀ {F Idx : Type u} (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (ts : Minidregg.Compiler.ConstraintSystem F Idx) (n : ℕ), (Minidregg.Compiler.flattenSystem (t :: ts) n).next = (Minidregg.Compiler.flattenSystem ts (Minidregg.Compiler.flatten t n).next).next
S theorem Minidregg.Compiler.flattenSystem_cons_roots : ∀ {F Idx : Type u} (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (ts : Minidregg.Compiler.ConstraintSystem F Idx) (n : ℕ), (Minidregg.Compiler.flattenSystem (t :: ts) n).roots = (Minidregg.Compiler.flatten t n).out :: (Minidregg.Compiler.flattenSystem ts (Minidregg.Compiler.flatten t n).next).roots
S theorem Minidregg.Compiler.flattenSystem_forces : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (auxv : ℕ → F) (s : Minidregg.Compiler.ConstraintSystem F Idx) (n₀ : ℕ), Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flattenSystem s n₀).gates → (∀ r ∈ (Minidregg.Compiler.flattenSystem s n₀).roots, Minidregg.Compiler.WireRef.read asg auxv r = 0) → Minidregg.Compiler.systemAccepts asg s
S theorem Minidregg.Compiler.flattenSystem_scoped : ∀ {F Idx : Type u} (s : Minidregg.Compiler.ConstraintSystem F Idx) (n₀ : ℕ), n₀ ≤ (Minidregg.Compiler.flattenSystem s n₀).next ∧ (∀ r ∈ (Minidregg.Compiler.flattenSystem s n₀).roots, Minidregg.Compiler.WireRef.auxIn n₀ (Minidregg.Compiler.flattenSystem s n₀).next r) ∧ ∀ g ∈ (Minidregg.Compiler.flattenSystem s n₀).gates, Minidregg.Compiler.Gate.scopedIn n₀ (Minidregg.Compiler.flattenSystem s n₀).next g
S theorem Minidregg.Compiler.flattenSystem_sound : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (s : Minidregg.Compiler.ConstraintSystem F Idx) (n₀ : ℕ), Minidregg.Compiler.systemAccepts asg s → ∃ auxv, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flattenSystem s n₀).gates ∧ ∀ r ∈ (Minidregg.Compiler.flattenSystem s n₀).roots, Minidregg.Compiler.WireRef.read asg auxv r = 0
S theorem Minidregg.Compiler.flatten_add' : ∀ {F Idx : Type u} (a b : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n : ℕ), Minidregg.Compiler.flatten (Minidregg.Compiler.add' a b) n = have l := Minidregg.Compiler.flatten a n; have r := Minidregg.Compiler.flatten b l.next; { out := Minidregg.Compiler.WireRef.aux r.next, gates := l.gates ++ r.gates ++ [{ op := Minidregg.Compiler.GateOp.add, a := l.out, b := r.out, out := r.next }], next := r.next + 1 }
S theorem Minidregg.Compiler.flatten_aux_unique : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ) {auxv auxv' : ℕ → F}, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates → Minidregg.Compiler.gatesHold asg auxv' (Minidregg.Compiler.flatten t n₀).gates → ∀ (m : ℕ), n₀ ≤ m → m < (Minidregg.Compiler.flatten t n₀).next → auxv m = auxv' m
S theorem Minidregg.Compiler.flatten_constraint_iff : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ), (∃ auxv, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates ∧ Minidregg.Compiler.WireRef.read asg auxv (Minidregg.Compiler.flatten t n₀).out = 0) ↔ Minidregg.Compiler.accepts asg t
S theorem Minidregg.Compiler.flatten_constraint_iff_exec : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ), (∃ auxv, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates ∧ Minidregg.Compiler.WireRef.read asg auxv (Minidregg.Compiler.flatten t n₀).out = 0) ↔ Minidregg.Compiler.semHolds asg t
S theorem Minidregg.Compiler.flatten_covers : ∀ {F Idx : Type u} (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ m : ℕ), n₀ ≤ m → m < (Minidregg.Compiler.flatten t n₀).next → ∃ g ∈ (Minidregg.Compiler.flatten t n₀).gates, g.out = m
S theorem Minidregg.Compiler.flatten_cst : ∀ {F Idx : Type u} (c : F) (n : ℕ), Minidregg.Compiler.flatten (Minidregg.Compiler.cst c) n = { out := Minidregg.Compiler.WireRef.cnst c, gates := [], next := n }
S theorem Minidregg.Compiler.flatten_forces : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ) (auxv : ℕ → F), Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates → Minidregg.Compiler.WireRef.read asg auxv (Minidregg.Compiler.flatten t n₀).out = Minidregg.Compiler.eval asg t
S theorem Minidregg.Compiler.flatten_mk_add : ∀ {F Idx : Type u} (k : Bool → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n : ℕ), Minidregg.Compiler.flatten (WType.mk Minidregg.Compiler.AirOp.add k) n = have l := Minidregg.Compiler.flatten (k Bool.false) n; have r := Minidregg.Compiler.flatten (k Bool.true) l.next; { out := Minidregg.Compiler.WireRef.aux r.next, gates := l.gates ++ r.gates ++ [{ op := Minidregg.Compiler.GateOp.add, a := l.out, b := r.out, out := r.next }], next := r.next + 1 }
S theorem Minidregg.Compiler.flatten_mk_mul : ∀ {F Idx : Type u} (k : Bool → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n : ℕ), Minidregg.Compiler.flatten (WType.mk Minidregg.Compiler.AirOp.mul k) n = have l := Minidregg.Compiler.flatten (k Bool.false) n; have r := Minidregg.Compiler.flatten (k Bool.true) l.next; { out := Minidregg.Compiler.WireRef.aux r.next, gates := l.gates ++ r.gates ++ [{ op := Minidregg.Compiler.GateOp.mul, a := l.out, b := r.out, out := r.next }], next := r.next + 1 }
S theorem Minidregg.Compiler.flatten_mul' : ∀ {F Idx : Type u} (a b : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n : ℕ), Minidregg.Compiler.flatten (Minidregg.Compiler.mul' a b) n = have l := Minidregg.Compiler.flatten a n; have r := Minidregg.Compiler.flatten b l.next; { out := Minidregg.Compiler.WireRef.aux r.next, gates := l.gates ++ r.gates ++ [{ op := Minidregg.Compiler.GateOp.mul, a := l.out, b := r.out, out := r.next }], next := r.next + 1 }
S theorem Minidregg.Compiler.flatten_root_forced : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ) {auxv auxv' : ℕ → F}, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates → Minidregg.Compiler.gatesHold asg auxv' (Minidregg.Compiler.flatten t n₀).gates → Minidregg.Compiler.WireRef.read asg auxv (Minidregg.Compiler.flatten t n₀).out = Minidregg.Compiler.WireRef.read asg auxv' (Minidregg.Compiler.flatten t n₀).out
S theorem Minidregg.Compiler.flatten_scoped : ∀ {F Idx : Type u} (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ), n₀ ≤ (Minidregg.Compiler.flatten t n₀).next ∧ Minidregg.Compiler.WireRef.auxIn n₀ (Minidregg.Compiler.flatten t n₀).next (Minidregg.Compiler.flatten t n₀).out ∧ ∀ g ∈ (Minidregg.Compiler.flatten t n₀).gates, Minidregg.Compiler.Gate.scopedIn n₀ (Minidregg.Compiler.flatten t n₀).next g
S theorem Minidregg.Compiler.flatten_sound : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (t : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (n₀ : ℕ), ∃ auxv, Minidregg.Compiler.gatesHold asg auxv (Minidregg.Compiler.flatten t n₀).gates ∧ Minidregg.Compiler.WireRef.read asg auxv (Minidregg.Compiler.flatten t n₀).out = Minidregg.Compiler.eval asg t
S theorem Minidregg.Compiler.flatten_vr : ∀ {F Idx : Type u} (i : Idx) (n : ℕ), Minidregg.Compiler.flatten (Minidregg.Compiler.vr i) n = { out := Minidregg.Compiler.WireRef.var i, gates := [], next := n }
S def Minidregg.Compiler.fold : {S : Minidregg.Compiler.Signature} → {α : Type w} → Minidregg.Compiler.Alg S α → Minidregg.Compiler.Term S → α #4284751532
S theorem Minidregg.Compiler.fold_eq_elim : ∀ {S : Minidregg.Compiler.Signature} {α : Type w} (alg : Minidregg.Compiler.Alg S α), Minidregg.Compiler.fold alg = WType.elim α ((Minidregg.Compiler.algEquivStructureMap S α) alg)
S theorem Minidregg.Compiler.fold_isFoldHom : ∀ {S : Minidregg.Compiler.Signature} {α : Type w} (alg : Minidregg.Compiler.Alg S α), Minidregg.Compiler.IsFoldHom alg (Minidregg.Compiler.fold alg)
S theorem Minidregg.Compiler.fold_mk : ∀ {S : Minidregg.Compiler.Signature} {α : Type w} (alg : Minidregg.Compiler.Alg S α) (s : S.Op) (k : S.ar s → Minidregg.Compiler.Term S), Minidregg.Compiler.fold alg (WType.mk s k) = alg s fun i => Minidregg.Compiler.fold alg (k i)
S theorem Minidregg.Compiler.fold_termAlg : ∀ (S : Minidregg.Compiler.Signature), Minidregg.Compiler.fold (Minidregg.Compiler.termAlg S) = id
S theorem Minidregg.Compiler.fold_unique : ∀ {S : Minidregg.Compiler.Signature} {α : Type w} (alg : Minidregg.Compiler.Alg S α) (f : Minidregg.Compiler.Term S → α), Minidregg.Compiler.IsFoldHom alg f → f = Minidregg.Compiler.fold alg
