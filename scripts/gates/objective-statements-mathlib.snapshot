S theorem Minidregg.Kernel.Seats.step_exit_closes : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → next.seats = Minidregg.Kernel.Seats.removeSeat world.seats account
S theorem Minidregg.Kernel.Seats.step_exit_deregistrations : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → account ∈ batch.deregistrations
S theorem Minidregg.Kernel.Seats.step_inv : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {action : Minidregg.Kernel.Seats.Action} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Inv world → Minidregg.Kernel.Seats.step world height actor action = Except.ok (next, batch) → Minidregg.Kernel.Seats.Inv next
S theorem Minidregg.Kernel.Seats.step_posts : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {action : Minidregg.Kernel.Seats.Action} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor action = Except.ok (next, batch) → Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ (action.registers = Bool.false → batch.registrations = [])
S theorem Minidregg.Kernel.Seats.terminate_deregisters : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {inst : Minidregg.Kernel.Invitations.InstanceId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.terminate inst) = Except.ok (next, batch) → ∀ seat ∈ Minidregg.Kernel.Seats.openSeatsOf world inst, seat.account ∉ next.book.accounts
