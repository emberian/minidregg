S def Minidregg.Compiler.PredOrder.ForcedIndicator : {F : Type} → [Field F] → {Idx : Type} → (k : ℕ) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Idx → (Fin (k + 1) → Idx) → Prop := fun {F} [Field F] {Idx} k present left right shifted bits => ∀ (asg : Idx → F) (isPresent : Bool) (a b : ℤ), Minidregg.Compiler.PredOrder.NoWrap F k → Minidregg.Compiler.PredOrder.InputsInRange k isPresent a b → (Minidregg.Compiler.eval asg present = if isPresent = Bool.true then 1 else 0) → Minidregg.Compiler.eval asg left = ↑a → Minidregg.Compiler.eval asg right = ↑b → Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.PredOrder.gadget k present left right shifted bits) → Minidregg.Compiler.eval asg (Minidregg.Compiler.PredOrder.indicator k present bits) = if (isPresent && Decidable.decide (a ≤ b)) = Bool.true then 1 else 0
S def Minidregg.Compiler.PredOrder.InputsInRange : ℕ → Bool → ℤ → ℤ → Prop := fun k present a b => present = Bool.true → -2 ^ k ≤ b - a ∧ b - a < 2 ^ k
S def Minidregg.Compiler.PredOrder.NoWrap : (F : Type) → [Field F] → ℕ → Prop := fun F [Field F] k => ∀ (m n : ℕ), m < 2 ^ (k + 1) → n < 2 ^ (k + 1) → ↑m = ↑n → m = n
S def Minidregg.Compiler.PredOrder.WitnessAccepts : {F : Type} → [Field F] → {Idx : Type} → (k : ℕ) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx) → Idx → (Fin (k + 1) → Idx) → Prop := fun {F} [Field F] {Idx} k present left right shifted bits => ∀ (asg : Idx → F) (isPresent : Bool) (a b : ℤ), Minidregg.Compiler.PredOrder.InputsInRange k isPresent a b → (Minidregg.Compiler.eval asg present = if isPresent = Bool.true then 1 else 0) → Minidregg.Compiler.eval asg left = ↑a → Minidregg.Compiler.eval asg right = ↑b → asg shifted = ↑(Minidregg.Compiler.PredOrder.shiftedNat k isPresent a b) → (∀ (i : Fin (k + 1)), asg (bits i) = ↑(Minidregg.Compiler.PredOrder.binaryDigits (k + 1) (Minidregg.Compiler.PredOrder.shiftedNat k isPresent a b) i)) → Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.PredOrder.gadget k present left right shifted bits)
