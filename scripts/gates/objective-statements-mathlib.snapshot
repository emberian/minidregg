S theorem Minidregg.Compiler.PredOrder.shiftedTerm_eval : ∀ {F : Type} [inst : Field F] {Idx : Type} {k : ℕ} {asg : Idx → F} {present left right : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)} {isPresent : Bool} {a b : ℤ}, (Minidregg.Compiler.eval asg present = if isPresent = Bool.true then 1 else 0) → Minidregg.Compiler.eval asg left = ↑a → Minidregg.Compiler.eval asg right = ↑b → Minidregg.Compiler.eval asg (Minidregg.Compiler.PredOrder.shiftedTerm k present left right) = ↑(Minidregg.Compiler.PredOrder.sourceDelta isPresent a b) + 2 ^ k
