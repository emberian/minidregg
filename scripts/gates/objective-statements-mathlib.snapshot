S theorem Minidregg.Kernel.NockDoor.door_effect_not_write_refused : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {params : Minidregg.Kernel.NockEntry.Params} {trap ustate wire cause doorCore effects core : Minidregg.Theory.Noun} {items : List Minidregg.Theory.Noun} {e : Minidregg.Theory.Noun}, Minidregg.Theory.Noun.cue program.jam = Option.some trap → Minidregg.Kernel.NockEntry.decodeParams program.params = Option.some params → Minidregg.Kernel.NockDoor.ustateOf view = Except.ok ustate → Minidregg.Theory.Nock.Step (Minidregg.Kernel.NockEntry.subjectOf trap ustate (Minidregg.Kernel.NockEntry.job (view.event + 1) wire cause)) (Minidregg.Kernel.NockEntry.pokeFormula params.arm) (doorCore.cell (effects.cell core)) → Minidregg.Kernel.NockEntry.itemsOf effects = Option.some items → e ∈ items → Minidregg.Kernel.NockEntry.effectWrite program.abi.outputs e = Option.none → ∀ (claim : Minidregg.Kernel.Run.RunClaim) (writes : List Minidregg.Theory.Eval.FieldWrite) (verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun), (∃ u event, claim.sampleJam = (u.cell (Minidregg.Kernel.NockEntry.job event wire cause)).jam) → Minidregg.Kernel.NockDoor.checkPoke program door view claim writes ≠ Except.ok verdict
S theorem Minidregg.Kernel.NockDoor.door_effects_are_writes : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.NockDoor.checkPoke program door view claim writes = Except.ok verdict → ∃ effects state items, verdict.output = effects.cell state ∧ Minidregg.Kernel.NockEntry.itemsOf effects = Option.some items ∧ ∀ e ∈ items, ∃ w, Minidregg.Kernel.NockEntry.effectWrite program.abi.outputs e = Option.some w ∧ w ∈ writes
S theorem Minidregg.Kernel.NockDoor.door_load_deterministic : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {view : Minidregg.Kernel.Door.View} {state state' : Minidregg.Theory.Noun} {k : ℕ}, Minidregg.Kernel.NockDoor.stateNow program view = Except.ok (Minidregg.Theory.Eval.Ran.ok state k) → (∃ trap ustate, Minidregg.Theory.Noun.cue program.jam = Option.some trap ∧ Minidregg.Kernel.NockDoor.ustateOf view = Except.ok ustate ∧ Minidregg.Theory.Nock.Step (Minidregg.Kernel.NockEntry.subjectOf trap ustate (Minidregg.Theory.Noun.atom 0)) Minidregg.Kernel.NockEntry.stateFormula state') → state' = state
S theorem Minidregg.Kernel.NockDoor.door_peek_pure : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {path out : Minidregg.Theory.Noun} {k : ℕ}, Minidregg.Kernel.NockDoor.peek program door view path = Except.ok (Minidregg.Theory.Eval.Ran.ok out k) → ∃ trap ustate, Minidregg.Theory.Noun.cue program.jam = Option.some trap ∧ Minidregg.Kernel.NockDoor.ustateOf view = Except.ok ustate ∧ Minidregg.Theory.Nock.Step (Minidregg.Kernel.NockEntry.subjectOf trap ustate path) (Minidregg.Kernel.NockEntry.peekFormula door.peek) out ∧ Minidregg.Theory.Nock.steps program.abi.fuel (Minidregg.Kernel.NockEntry.subjectOf trap ustate path) (Minidregg.Kernel.NockEntry.peekFormula door.peek) = k
S theorem Minidregg.Kernel.NockDoor.door_poke_deterministic : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim claim' : Minidregg.Kernel.Run.RunClaim} {writes writes' : List Minidregg.Theory.Eval.FieldWrite} {verdict verdict' : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.NockDoor.checkPoke program door view claim writes = Except.ok verdict → Minidregg.Kernel.NockDoor.checkPoke program door view claim' writes' = Except.ok verdict' → claim.sampleJam = claim'.sampleJam → verdict.output = verdict'.output ∧ verdict.writes = verdict'.writes
S theorem Minidregg.Kernel.NockDoor.door_poke_sound : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Verdict Minidregg.Theory.Noun}, Minidregg.Kernel.NockDoor.checkPoke program door view claim writes = Except.ok verdict → ∃ trap params ustate wire cause doorCore effects core state, Minidregg.Theory.Noun.cue program.jam = Option.some trap ∧ Minidregg.Kernel.NockEntry.decodeParams program.params = Option.some params ∧ Minidregg.Kernel.NockDoor.ustateOf view = Except.ok ustate ∧ claim.sampleJam = (ustate.cell (Minidregg.Kernel.NockEntry.job (view.event + 1) wire cause)).jam ∧ Minidregg.Theory.Nock.Step (Minidregg.Kernel.NockEntry.subjectOf trap ustate (Minidregg.Kernel.NockEntry.job (view.event + 1) wire cause)) (Minidregg.Kernel.NockEntry.pokeFormula params.arm) (doorCore.cell (effects.cell core)) ∧ Minidregg.Theory.Noun.axis 6 core = Option.some state ∧ Minidregg.Theory.Noun.edit 6 state doorCore = Option.some core ∧ verdict.output = effects.cell state ∧ claim.outputJam = verdict.output.jam ∧ { target := 0, field := door.state, value := ↑(Minidregg.Kernel.NockProgramCell.jamAtom state) } ∈ writes ∧ { target := 0, field := door.event, value := ↑view.event + 1 } ∈ writes ∧ (∀ w ∈ writes, w.target = 0 → w.field = door.state → w.value = ↑(Minidregg.Kernel.NockProgramCell.jamAtom state)) ∧ (∀ (w : Minidregg.Theory.Eval.FieldWrite), w ∈ writes ↔ w ∈ verdict.writes) ∧ (∃ decoded, Minidregg.Kernel.NockEntry.decodeEffects program.abi.outputs effects = Except.ok decoded ∧ verdict.writes = Minidregg.Kernel.NockDoor.stateWrites door view state ++ decoded) ∧ verdict.steps = claim.steps ∧ claim.steps ≤ program.abi.fuel
S theorem Minidregg.Kernel.NockDoor.door_state_stale_refused : ∀ {program : Minidregg.Compiler.NockProgramCodec.Program} {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {claim : Minidregg.Kernel.Run.RunClaim} {writes : List Minidregg.Theory.Eval.FieldWrite} {trap ustate ustate' wire cause : Minidregg.Theory.Noun} {event : ℕ}, Minidregg.Theory.Noun.cue program.jam = Option.some trap → Minidregg.Kernel.NockDoor.ustateOf view = Except.ok ustate → claim.sampleJam = (ustate'.cell (Minidregg.Kernel.NockEntry.job event wire cause)).jam → ustate' ≠ ustate ∨ event ≠ view.event + 1 → Minidregg.Kernel.NockDoor.checkPoke program door view claim writes = Except.error (Minidregg.Kernel.Run.Refusal.sampleStale Option.none)
