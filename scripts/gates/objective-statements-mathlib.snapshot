S theorem Minidregg.Compiler.isZero_complete : ∀ {F : Type} [inst : Field F] {Idx : Type} [inst_1 : DecidableEq F] {asg : Idx → F} {d : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)} {b w : Idx}, (asg b = if Minidregg.Compiler.eval asg d = 0 then 1 else 0) → (asg w = if Minidregg.Compiler.eval asg d = 0 then 0 else (Minidregg.Compiler.eval asg d)⁻¹) → Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.isZero d b w)
S theorem Minidregg.Compiler.isZero_forced : ∀ {F : Type} [inst : Field F] {Idx : Type} [inst_1 : DecidableEq F] {asg : Idx → F} {d : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)} {b w : Idx}, Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.isZero d b w) → asg b = if Minidregg.Compiler.eval asg d = 0 then 1 else 0
