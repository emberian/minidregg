S theorem Minidregg.Compiler.LawLeaf.ofRange_names_atom : ∀ (profile : Minidregg.Compiler.CompilerProfile) (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (leaf : Minidregg.Compiler.LawLeaf), Minidregg.Compiler.LawLeaf.ofRange profile law old new = Option.some leaf → law.subterm leaf.path = Option.some leaf.clause ∧ leaf.clause.isOrderAtom = Bool.true ∧ Minidregg.Compiler.inputsInRange profile leaf.clause old new = Bool.false ∧ leaf.before = Option.some (Minidregg.Compiler.orderOperands leaf.clause old new).1 ∧ leaf.after = Option.some (Minidregg.Compiler.orderOperands leaf.clause old new).2
S theorem Minidregg.Compiler.LawLeaf.ofRange_none_iff : ∀ (profile : Minidregg.Compiler.CompilerProfile) (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Compiler.LawLeaf.ofRange profile law old new = Option.none ↔ Minidregg.Compiler.inputsInRange profile law old new = Bool.true
S theorem Minidregg.Compiler.LawLeaf.ofRange_out_of_range : ∀ {width : ℕ} (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (leaf : Minidregg.Compiler.LawLeaf), Minidregg.Compiler.LawLeaf.ofRange (Minidregg.Compiler.CompilerProfile.scalar width) law old new = Option.some leaf → ∃ left right, leaf.before = Option.some left ∧ leaf.after = Option.some right ∧ ¬(-2 ^ width ≤ right - left ∧ right - left < 2 ^ width)
S theorem Minidregg.Compiler.LawLeaf.of_congr : ∀ {o₁ n₁ o₂ n₂ : Minidregg.Pred.State}, (∀ (s : Minidregg.Pred.Slot), o₁.get s = o₂.get s) → (∀ (s : Minidregg.Pred.Slot), n₁.get s = n₂.get s) → ∀ (law : Minidregg.Pred.Pred), Minidregg.Compiler.LawLeaf.of law o₁ n₁ = Minidregg.Compiler.LawLeaf.of law o₂ n₂
