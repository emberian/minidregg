S def Minidregg.Compiler.NativeKernelPlan.dGateInBoundsCheck : Minidregg.Compiler.ConstraintDescriptor Minidregg.Compiler.BabyBear → Minidregg.Compiler.DGate Minidregg.Compiler.BabyBear → Bool #1324685361
S theorem Minidregg.Compiler.NativeKernelPlan.dGateInBoundsCheck_eq_true_iff : ∀ (descriptor : Minidregg.Compiler.ConstraintDescriptor Minidregg.Compiler.BabyBear) (gate : Minidregg.Compiler.DGate Minidregg.Compiler.BabyBear), Minidregg.Compiler.NativeKernelPlan.dGateInBoundsCheck descriptor gate = Bool.true ↔ Minidregg.Compiler.DWire.bounded descriptor.nWires gate.a ∧ Minidregg.Compiler.DWire.bounded descriptor.nWires gate.b ∧ descriptor.nVars ≤ gate.out ∧ gate.out < descriptor.nWires
S def Minidregg.Compiler.NativeKernelPlan.dWireBoundedCheck : ℕ → Minidregg.Compiler.DWire Minidregg.Compiler.BabyBear → Bool #3862200914
