S theorem Minidregg.Compiler.NativeKernelPlan.descriptorFailure_not_certified : ∀ (manifest : Minidregg.Compiler.SemanticManifest.Manifest) (instruction : Minidregg.Compiler.NativeKernelPlan.Instruction) (response : Minidregg.Compiler.NativeKernelPlan.KernelResponse instruction), ¬instruction.call.Accepts response.totalWires → ∀ (certificate : Minidregg.Compiler.NativeKernelPlan.CertifiedResponse manifest instruction response), Minidregg.Compiler.NativeKernelPlan.checkInstruction manifest instruction response ≠ Sum.inr certificate
