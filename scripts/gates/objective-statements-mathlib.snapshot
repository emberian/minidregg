S def Minidregg.Kernel.JobMoney.commit : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Kernel.JobMoney.Plan → Minidregg.Kernel.JobMoney.Reject → Except Minidregg.Kernel.JobMoney.Reject Minidregg.Kernel.JobMoney.Plan #2511450902
S theorem Minidregg.Kernel.JobMoney.commit_ok : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {candidate plan : Minidregg.Kernel.JobMoney.Plan} {refused : Minidregg.Kernel.JobMoney.Reject}, Minidregg.Kernel.JobMoney.commit book candidate refused = Except.ok plan → plan = candidate ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch ∧ Minidregg.Kernel.JobMoney.aggregateDelta book plan = 0
S def Minidregg.Kernel.JobMoney.decideClaim : Minidregg.Kernel.PayTariff.Tariff → Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account) → Minidregg.Theory.TypedAuthorization.SubjectId → Minidregg.Theory.CanonicalResourceKernel.Book → ℕ → Minidregg.Kernel.JobMoney.Job → ℕ → ℕ → Except Minidregg.Kernel.JobMoney.Reject Minidregg.Kernel.JobMoney.Plan #2119188445
S theorem Minidregg.Kernel.JobMoney.decideClaim_ok : ∀ {t : Minidregg.Kernel.PayTariff.Tariff} {stored : Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account)} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {j : Minidregg.Kernel.JobMoney.Job} {account amount : ℕ} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideClaim t stored subject book job j account amount = Except.ok plan → plan = { asset := t.asset, job := job, before := j, move := Minidregg.Kernel.JobMoney.Move.claim subject.value account amount } ∧ j.state = 0 ∧ 0 < j.price ∧ j.escrow = j.price ∧ j.provider = 0 ∧ j.bond = 0 ∧ subject.value ≠ 0 ∧ Minidregg.Kernel.PayAssignmentReceiver.OwnerGrant stored subject account ∧ account ≠ t.asset ∧ account ≠ job ∧ j.price ≤ amount ∧ book.balance job t.asset = Int.ofNat j.held ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch ∧ Minidregg.Kernel.JobMoney.aggregateDelta book plan = 0
S def Minidregg.Kernel.JobMoney.decideFund : Minidregg.Kernel.PayTariff.Tariff → Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account) → Minidregg.Theory.TypedAuthorization.SubjectId → Minidregg.Theory.CanonicalResourceKernel.Book → ℕ → Minidregg.Kernel.JobMoney.Job → ℕ → ℕ → Except Minidregg.Kernel.JobMoney.Reject Minidregg.Kernel.JobMoney.Plan #2075943316
S theorem Minidregg.Kernel.JobMoney.decideFund_ok : ∀ {t : Minidregg.Kernel.PayTariff.Tariff} {stored : Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account)} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {j : Minidregg.Kernel.JobMoney.Job} {account amount : ℕ} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideFund t stored subject book job j account amount = Except.ok plan → plan = { asset := t.asset, job := job, before := j, move := Minidregg.Kernel.JobMoney.Move.fund account amount } ∧ j.state = 0 ∧ subject.value = j.caller ∧ Minidregg.Kernel.PayAssignmentReceiver.OwnerGrant stored subject account ∧ account = j.callerAcct ∧ account ≠ t.asset ∧ account ≠ job ∧ 0 < amount ∧ j.escrow = 0 ∧ j.bond = 0 ∧ job ∉ book.accounts ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch ∧ Minidregg.Kernel.JobMoney.aggregateDelta book plan = 0
S def Minidregg.Kernel.JobMoney.decideMoney : Option Minidregg.Kernel.PayTariff.Tariff → Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account) → Minidregg.Theory.TypedAuthorization.SubjectId → Minidregg.Theory.CanonicalResourceKernel.Book → ℕ → Option Minidregg.Kernel.JobMoney.Job → ℕ → ℕ → ℕ → Except Minidregg.Kernel.JobMoney.Reject Minidregg.Kernel.JobMoney.Plan #784924937
S theorem Minidregg.Kernel.JobMoney.decideMoney_ok : ∀ {tariff : Option Minidregg.Kernel.PayTariff.Tariff} {stored : Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account)} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {jo : Option Minidregg.Kernel.JobMoney.Job} {action account amount : ℕ} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideMoney tariff stored subject book job jo action account amount = Except.ok plan → ∃ t j, tariff = Option.some t ∧ t.valid ∧ job ≠ t.asset ∧ jo = Option.some j ∧ plan.asset = t.asset ∧ plan.job = job ∧ plan.before = j ∧ (action = Minidregg.Kernel.JobMoney.fundAction ∧ Minidregg.Kernel.JobMoney.decideFund t stored subject book job j account amount = Except.ok plan ∨ action = Minidregg.Kernel.JobMoney.claimAction ∧ Minidregg.Kernel.JobMoney.decideClaim t stored subject book job j account amount = Except.ok plan ∨ action = Minidregg.Kernel.JobMoney.settleAction ∧ account = 0 ∧ amount = 0 ∧ Minidregg.Kernel.JobMoney.decideSettle t book job j = Except.ok plan)
S theorem Minidregg.Kernel.JobMoney.decideMoney_plan : ∀ {tariff : Option Minidregg.Kernel.PayTariff.Tariff} {stored : Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account)} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {jo : Option Minidregg.Kernel.JobMoney.Job} {action account amount : ℕ} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideMoney tariff stored subject book job jo action account amount = Except.ok plan → Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch ∧ Minidregg.Kernel.JobMoney.aggregateDelta book plan = 0 ∧ plan.job ≠ plan.asset ∧ plan.job = job ∧ match plan.move with | Minidregg.Kernel.JobMoney.Move.fund account amount => account ≠ plan.asset ∧ account ≠ plan.job ∧ book.balance plan.job plan.asset = Int.ofNat plan.before.held | Minidregg.Kernel.JobMoney.Move.claim provider account amount => account ≠ plan.asset ∧ account ≠ plan.job ∧ book.balance plan.job plan.asset = Int.ofNat plan.before.held | Minidregg.Kernel.JobMoney.Move.settle p => ¬Minidregg.Kernel.JobMoney.Payouts.badPayee plan.asset plan.job plan.before p ∧ book.balance plan.job plan.asset = Int.ofNat plan.before.held
S def Minidregg.Kernel.JobMoney.decideSettle : Minidregg.Kernel.PayTariff.Tariff → Minidregg.Theory.CanonicalResourceKernel.Book → ℕ → Minidregg.Kernel.JobMoney.Job → Except Minidregg.Kernel.JobMoney.Reject Minidregg.Kernel.JobMoney.Plan #491755958
S theorem Minidregg.Kernel.JobMoney.decideSettle_ok : ∀ {t : Minidregg.Kernel.PayTariff.Tariff} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {j : Minidregg.Kernel.JobMoney.Job} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideSettle t book job j = Except.ok plan → ∃ p, Minidregg.Kernel.JobMoney.payouts t.slashCallerPermille j = Option.some p ∧ plan = { asset := t.asset, job := job, before := j, move := Minidregg.Kernel.JobMoney.Move.settle p } ∧ j.state ≠ 6 ∧ ¬Minidregg.Kernel.JobMoney.Payouts.badPayee t.asset job j p ∧ book.balance job t.asset = Int.ofNat j.held ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch ∧ Minidregg.Kernel.JobMoney.aggregateDelta book plan = 0
