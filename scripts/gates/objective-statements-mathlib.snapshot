S theorem Minidregg.Kernel.NativeHostGenesis.observer_replaceable : ∀ {F : Type} [inst : Field F] (profile : Minidregg.Compiler.CanonicalRuntimeProfile.Profile F) (config : Minidregg.Kernel.NativeHostGenesis.Config) (observer : Minidregg.Kernel.NativeHostGenesis.PayObserver), config.payObserver = Option.some observer → Minidregg.Kernel.NativeHostGenesis.capabilityEntry (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer) ∈ Minidregg.Kernel.NativeHostGenesis.entries profile config ∧ (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer).holder = Minidregg.Theory.TypedAuthorization.Holder.subject config.factoryController.subject ∧ (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer).scope.targets = Minidregg.Theory.TypedAuthorization.TargetSet.explicit {{ value := Minidregg.Kernel.PayCell.physicalId config.deployment.domain }} ∧ Minidregg.Theory.TypedAuthorization.Verb.installPolicy ∈ (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer).scope.verbs ∧ Minidregg.Theory.TypedAuthorization.Verb.revokeCapability ∈ (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer).scope.verbs ∧ Minidregg.Theory.TypedAuthorization.Verb.delegateProgram ∈ (Minidregg.Kernel.NativeHostGenesis.payControlCapability profile config observer).scope.verbs ∧ ∀ (old new : Minidregg.Pred.State) (subject verb : ℕ), new.get "request/subject" = Option.some (Int.ofNat subject) → new.get "request/verb" = Option.some (Int.ofNat verb) → (Minidregg.Pred.eval (Minidregg.Kernel.NativeHostGenesis.payPredicate config.factoryController.subject observer) old new = Bool.true ↔ verb = 6 ∧ subject = observer.subject.value ∨ subject = config.factoryController.subject.value ∧ (verb = 1 ∨ verb = 3 ∨ verb = 4 ∨ verb = 5))
