S def Minidregg.Kernel.Seats.offerBatch : Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Kernel.Seats.Proposal → Minidregg.Theory.CanonicalResourceKernel.Batch #1806084448
S def Minidregg.Kernel.Seats.offerSafe : Minidregg.Kernel.Seats.Proposal → Minidregg.Pred.Pred #2189778706
S theorem Minidregg.Kernel.Seats.offer_donation : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {id : Minidregg.Kernel.Invitations.InvitationId} {expect : Minidregg.Kernel.Invitations.Expectation} {seatAccount funding payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal} {holder : Option ℕ} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.offer id expect seatAccount funding payee proposal holder) = Except.ok (next, batch) → proposal.wantsNothing = proposal.donate
S theorem Minidregg.Kernel.Seats.offer_inv : ∀ {world : Minidregg.Kernel.Seats.World}, Minidregg.Kernel.Seats.Inv world → ∀ {seatAccount funding payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {proposal : Minidregg.Kernel.Seats.Proposal} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {inst : Minidregg.Kernel.Invitations.InstanceId} {registry : Minidregg.Kernel.Invitations.Registry} {holder : Option ℕ}, ¬seatAccount < Minidregg.Kernel.Seats.reservedBase → ¬Minidregg.Kernel.Seats.reservedBase ≤ funding → ¬Minidregg.Kernel.Seats.reservedBase ≤ payee → payee ∈ world.book.accounts → Minidregg.Kernel.Seats.LeaseFree world.book seatAccount → Minidregg.Kernel.Seats.admit world.book (Minidregg.Kernel.Seats.offerBatch funding seatAccount proposal) = Except.ok book → Minidregg.Kernel.Seats.safeAt book seatAccount proposal = Bool.true → Minidregg.Kernel.Seats.Inv { book := book, registry := registry, seats := { account := seatAccount, inst := inst, offerer := subject, payee := payee, proposal := proposal, holder := holder } :: world.seats }
S def Minidregg.Kernel.Seats.openSeatsOf : Minidregg.Kernel.Seats.World → Minidregg.Kernel.Invitations.InstanceId → List Minidregg.Kernel.Seats.Seat #2181846428
S theorem Minidregg.Kernel.Seats.openSeatsOf_sub : ∀ (world : Minidregg.Kernel.Seats.World) (inst : Minidregg.Kernel.Invitations.InstanceId), (Minidregg.Kernel.Seats.openSeatsOf world inst).Sublist world.seats
S def Minidregg.Kernel.Seats.opsOf : List Minidregg.Kernel.Seats.Transfer → List Minidregg.Theory.CanonicalResourceKernel.Operation #1586005815
S theorem Minidregg.Kernel.Seats.ops_credit_only : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {transfers : List Minidregg.Kernel.Seats.Transfer} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId}, (∀ transfer ∈ transfers, transfer.source ≠ account) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), book.balance account asset ≤ (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf transfers)).balance account asset
S theorem Minidregg.Kernel.Seats.ops_leaseRecords : ∀ (transfers : List Minidregg.Kernel.Seats.Transfer) (book : Minidregg.Theory.CanonicalResourceKernel.Book), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf transfers)).leaseRecords = book.leaseRecords
S theorem Minidregg.Kernel.Seats.ops_nonneg : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {transfers : List Minidregg.Kernel.Seats.Transfer} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId}, Minidregg.Theory.CanonicalResourceKernel.OperationsAdmitted book (Minidregg.Kernel.Seats.opsOf transfers) → (∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), 0 ≤ book.balance account asset) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), 0 ≤ (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf transfers)).balance account asset
S theorem Minidregg.Kernel.Seats.ops_other_asset : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {transfers : List Minidregg.Kernel.Seats.Transfer} {asset : Minidregg.Theory.CanonicalResourceKernel.AssetId}, (∀ transfer ∈ transfers, transfer.asset ≠ asset) → ∀ (account : Minidregg.Theory.CanonicalResourceKernel.AccountId), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf transfers)).balance account asset = book.balance account asset
S theorem Minidregg.Kernel.Seats.ops_untouched : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {transfers : List Minidregg.Kernel.Seats.Transfer} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId}, (∀ transfer ∈ transfers, transfer.source ≠ account ∧ transfer.destination ≠ account) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf transfers)).balance account asset = book.balance account asset
S theorem Minidregg.Kernel.Seats.ordinary_ne_protected : ∀ {ordinary protected_ : ℕ}, ¬Minidregg.Kernel.Seats.reservedBase ≤ ordinary → ¬protected_ < Minidregg.Kernel.Seats.reservedBase → ordinary ≠ protected_
S def Minidregg.Kernel.Seats.payoutTransfers : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Theory.CanonicalResourceKernel.AccountId → List Minidregg.Theory.CanonicalResourceKernel.AssetId → List Minidregg.Kernel.Seats.Transfer #124388856
S theorem Minidregg.Kernel.Seats.payout_admitted_from : ∀ (pre : Minidregg.Theory.CanonicalResourceKernel.Book) (account payee : Minidregg.Theory.CanonicalResourceKernel.AccountId), payee ≠ account → ∀ (assets : List Minidregg.Theory.CanonicalResourceKernel.AssetId) (book : Minidregg.Theory.CanonicalResourceKernel.Book), assets.Nodup → account ∈ book.accounts → payee ∈ book.accounts → (∀ asset ∈ assets, book.balance account asset = pre.balance account asset ∧ 0 ≤ pre.balance account asset) → Minidregg.Theory.CanonicalResourceKernel.OperationsAdmitted book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers pre account payee assets))
S theorem Minidregg.Kernel.Seats.payout_all_exact : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {account payee : Minidregg.Theory.CanonicalResourceKernel.AccountId}, payee ≠ account → (∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), 0 ≤ book.balance account asset) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers book account payee (Minidregg.Kernel.Seats.heldAssets book account)))).balance account asset = 0 ∧ (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers book account payee (Minidregg.Kernel.Seats.heldAssets book account)))).balance payee asset = book.balance payee asset + book.balance account asset
S theorem Minidregg.Kernel.Seats.payout_credit_only : ∀ (book pre : Minidregg.Theory.CanonicalResourceKernel.Book) (account payee other : Minidregg.Theory.CanonicalResourceKernel.AccountId) (assets : List Minidregg.Theory.CanonicalResourceKernel.AssetId), other ≠ account → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), book.balance other asset ≤ (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers pre account payee assets))).balance other asset
S theorem Minidregg.Kernel.Seats.payout_exact_from : ∀ (pre : Minidregg.Theory.CanonicalResourceKernel.Book) (account payee : Minidregg.Theory.CanonicalResourceKernel.AccountId), payee ≠ account → ∀ (assets : List Minidregg.Theory.CanonicalResourceKernel.AssetId) (book : Minidregg.Theory.CanonicalResourceKernel.Book), assets.Nodup → (∀ asset ∈ assets, book.balance account asset = pre.balance account asset ∧ 0 ≤ pre.balance account asset) → ∀ asset ∈ assets, (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers pre account payee assets))).balance account asset = 0 ∧ (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers pre account payee assets))).balance payee asset = book.balance payee asset + book.balance account asset
S theorem Minidregg.Kernel.Seats.payout_sources : ∀ {book : Minidregg.Theory.CanonicalResourceKernel.Book} {account payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {assets : List Minidregg.Theory.CanonicalResourceKernel.AssetId}, ∀ transfer ∈ Minidregg.Kernel.Seats.payoutTransfers book account payee assets, transfer.source = account
S theorem Minidregg.Kernel.Seats.posts_none : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book), Minidregg.Kernel.Seats.Posts book Minidregg.Kernel.Seats.noPostings book
S theorem Minidregg.Kernel.Seats.reachable_inv : ∀ {genesis world : Minidregg.Kernel.Seats.World}, genesis.seats = [] → Minidregg.Kernel.Seats.Reachable genesis world → Minidregg.Kernel.Seats.Inv world
S theorem Minidregg.Kernel.Seats.reallocate_inv : ∀ {world : Minidregg.Kernel.Seats.World}, Minidregg.Kernel.Seats.Inv world → ∀ {transfers : List Minidregg.Kernel.Seats.Transfer} {book : Minidregg.Theory.CanonicalResourceKernel.Book}, Minidregg.Kernel.Seats.admit world.book { registrations := [], operations := Minidregg.Kernel.Seats.opsOf transfers, deregistrations := [] } = Except.ok book → Minidregg.Kernel.Seats.firstUnsafe world.seats book transfers = Option.none → Minidregg.Kernel.Seats.Inv { book := book, registry := world.registry, seats := world.seats }
S theorem Minidregg.Kernel.Seats.registerAccounts_not_mem : ∀ (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (book : Minidregg.Theory.CanonicalResourceKernel.Book) (accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId), account ∉ book.accounts → account ∉ accounts → account ∉ (Minidregg.Theory.CanonicalResourceKernel.registerAccounts book accounts).accounts
S def Minidregg.Kernel.Seats.removeSeat : List Minidregg.Kernel.Seats.Seat → Minidregg.Theory.CanonicalResourceKernel.AccountId → List Minidregg.Kernel.Seats.Seat #941663561
S theorem Minidregg.Kernel.Seats.removeSeat_map_nodup : ∀ {seats : List Minidregg.Kernel.Seats.Seat}, (List.map Minidregg.Kernel.Seats.Seat.account seats).Nodup → ∀ (account : Minidregg.Theory.CanonicalResourceKernel.AccountId), (List.map Minidregg.Kernel.Seats.Seat.account (Minidregg.Kernel.Seats.removeSeat seats account)).Nodup
S def Minidregg.Kernel.Seats.requestState : ℤ → Minidregg.Pred.State #10520057
