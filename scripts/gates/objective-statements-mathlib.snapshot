S def Minidregg.Kernel.World.romPart : {L : Minidregg.Theory.Store.Layout} → Minidregg.Theory.Store.Store L → Minidregg.Theory.Store.Store L #2143273393
S theorem Minidregg.Kernel.World.romPart_apply : ∀ {L : Minidregg.Theory.Store.Layout} (s : Minidregg.Theory.Store.Store L) (a : Minidregg.Theory.Store.Address L), (Minidregg.Kernel.World.romPart s) a = if L.discipline a.fst = Minidregg.Theory.Store.Discipline.rom then s a else Option.none
