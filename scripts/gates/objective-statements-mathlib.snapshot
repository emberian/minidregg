S theorem Minidregg.Compiler.PredOrder.gadget_correct : ∀ {F : Type} [inst : Field F] {Idx : Type} (k : ℕ) (asg : Idx → F) (present left right : Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (shifted : Idx) (bits : Fin (k + 1) → Idx), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.PredOrder.gadget k present left right shifted bits) ↔ Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.rangeGadget shifted bits) ∧ asg shifted = Minidregg.Compiler.eval asg (Minidregg.Compiler.PredOrder.shiftedTerm k present left right)
