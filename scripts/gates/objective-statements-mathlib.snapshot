S theorem Minidregg.Theory.ResourceBirth.allocate_frame : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → ∀ cellId ∉ List.map Minidregg.Theory.CellRegistry.CreateRequest.cellId requests, after.slots cellId = before.slots cellId
S theorem Minidregg.Theory.ResourceBirth.allocate_of_fresh : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), (List.map Minidregg.Theory.CellRegistry.CreateRequest.cellId requests).Nodup → (∀ request ∈ requests, before.slots request.cellId = Minidregg.Theory.CellRegistry.CellSlot.absent ∧ request.cellId ∉ before.used) → (∀ request ∈ requests, request.expectedPreRoot = Minidregg.Theory.CellRegistry.CellSlot.root registry Minidregg.Theory.CellRegistry.CellSlot.absent) → Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok (Minidregg.Theory.ResourceBirth.inserted registry before requests)
