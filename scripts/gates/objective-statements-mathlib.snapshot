S def Minidregg.Compiler.lowerA : {F : Type} → [Field F] → Minidregg.Compiler.CompilerProfile → Minidregg.Pred.Pred → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Minidregg.Compiler.Wire) × Minidregg.Compiler.ConstraintSystem F Minidregg.Compiler.Wire #269022692
S theorem Minidregg.Compiler.lowerA_complete : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Compiler.supported profile p = Bool.true → Minidregg.Compiler.inputsInRange profile p old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile p old new)) (Minidregg.Compiler.lowerA profile p).2
S theorem Minidregg.Compiler.lowerA_complete_eq : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (s : Minidregg.Pred.Slot) (v : ℤ) (old new : Minidregg.Pred.State), Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile (Minidregg.Pred.Pred.eq s v) old new)) (Minidregg.Compiler.lowerA profile (Minidregg.Pred.Pred.eq s v)).2
S theorem Minidregg.Compiler.lowerA_complete_eqSlots : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (a b : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile (Minidregg.Pred.Pred.eqSlots a b) old new)) (Minidregg.Compiler.lowerA profile (Minidregg.Pred.Pred.eqSlots a b)).2
S theorem Minidregg.Compiler.lowerA_complete_leSlots : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (a b : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), Minidregg.Compiler.supported profile (Minidregg.Pred.Pred.leSlots a b) = Bool.true → Minidregg.Compiler.inputsInRange profile (Minidregg.Pred.Pred.leSlots a b) old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile (Minidregg.Pred.Pred.leSlots a b) old new)) (Minidregg.Compiler.lowerA profile (Minidregg.Pred.Pred.leSlots a b)).2
S theorem Minidregg.Compiler.lowerA_complete_leSlotsOff : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (a b : Minidregg.Pred.Slot) (c : ℤ) (old new : Minidregg.Pred.State), Minidregg.Compiler.supported profile (Minidregg.Pred.Pred.leSlotsOff a b c) = Bool.true → Minidregg.Compiler.inputsInRange profile (Minidregg.Pred.Pred.leSlotsOff a b c) old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile (Minidregg.Pred.Pred.leSlotsOff a b c) old new)) (Minidregg.Compiler.lowerA profile (Minidregg.Pred.Pred.leSlotsOff a b c)).2
S theorem Minidregg.Compiler.lowerA_forced : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F), Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf p old new) → Minidregg.Compiler.supported profile p = Bool.true → Minidregg.Compiler.inputsInRange profile p old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lowerA profile p).2 → Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lowerA profile p).1 = if Minidregg.Pred.eval p old new = Bool.true then 1 else 0
