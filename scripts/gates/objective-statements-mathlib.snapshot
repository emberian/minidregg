S inductive Minidregg.Selvage.AccClaim : Type u_4 → (F : Type u_5) → [Field F] → Type u_6 → ℕ → Type (max (max u_4 u_5) u_6)
S def Minidregg.Selvage.AccClaim.Satisfies : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → Submodule F (ι → F) → Minidregg.Selvage.AccClaim Root F ι r → (ι → F) → Prop := fun {Root} {F} [Field F] {ι} {r} C A f => f ∈ C ∧ ∀ (i : Fin r), (A.weights i) f = A.targets i
S theorem Minidregg.Selvage.AccClaim.Satisfies.mem : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {f : ι → F}, Minidregg.Selvage.AccClaim.Satisfies C A f → f ∈ C
S def Minidregg.Selvage.AccClaim.append : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r₁ r₂ : ℕ} → Minidregg.Selvage.AccClaim Root F ι r₁ → Minidregg.Selvage.AccClaim Root F ι r₂ → Minidregg.Selvage.AccClaim Root F ι (r₁ + r₂) #3723698615
S theorem Minidregg.Selvage.AccClaim.append_satisfies_iff : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r₁ r₂ : ℕ} {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r₁} {B : Minidregg.Selvage.AccClaim Root F ι r₂} {f : ι → F}, Minidregg.Selvage.AccClaim.Satisfies C (A.append B) f ↔ Minidregg.Selvage.AccClaim.Satisfies C A f ∧ Minidregg.Selvage.AccClaim.Satisfies C B f
S def Minidregg.Selvage.AccClaim.batch : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → Minidregg.Selvage.AccClaim Root F ι r → F → Minidregg.Selvage.AccClaim Root F ι 1 #2990298975
S theorem Minidregg.Selvage.AccClaim.batch_ofConstraints : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} [inst_1 : Fintype ι] (rt : Root) (γ : F) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), (Minidregg.Selvage.AccClaim.ofConstraints rt cs).batch γ = Minidregg.Selvage.AccClaim.ofConstraints rt [Minidregg.Selvage.batchConstraint γ cs]
S theorem Minidregg.Selvage.AccClaim.batch_satisfies : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} {C : Submodule F (ι → F)} {A : Minidregg.Selvage.AccClaim Root F ι r} {f : ι → F} (γ : F), Minidregg.Selvage.AccClaim.Satisfies C A f → Minidregg.Selvage.AccClaim.Satisfies C (A.batch γ) f
S def Minidregg.Selvage.AccClaim.channel : {Root : Type u_4} → {F : Type u_5} → [inst : Field F] → {ι : Type u_6} → {r : ℕ} → Minidregg.Selvage.AccClaim Root F ι r → Fin r → ((ι → F) →ₗ[F] F) × F #662265689
S ctor Minidregg.Selvage.AccClaim.mk : {Root : Type u_4} → {F : Type u_5} → [inst : Field F] → {ι : Type u_6} → {r : ℕ} → Root → (Fin r → ((ι → F) →ₗ[F] F) × F) → Minidregg.Selvage.AccClaim Root F ι r
S def Minidregg.Selvage.AccClaim.ofConstraints : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → [Fintype ι] → Root → (cs : List (Minidregg.Selvage.LinearConstraint ι F)) → Minidregg.Selvage.AccClaim Root F ι cs.length #3343855757
S theorem Minidregg.Selvage.AccClaim.ofConstraints_satisfies_iff : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} [inst_1 : Fintype ι] [DecidableEq ι] [DecidableEq F] {dom : ι ↪ F} {d : ℕ} {rt : Root} {cs : List (Minidregg.Selvage.LinearConstraint ι F)} {f : ι → F}, Minidregg.Selvage.AccClaim.Satisfies (Minidregg.Selvage.reedSolomonCode dom d) (Minidregg.Selvage.AccClaim.ofConstraints rt cs) f ↔ f ∈ Minidregg.Selvage.constrainedRS dom d cs
S def Minidregg.Selvage.AccClaim.rt : {Root : Type u_4} → {F : Type u_5} → [inst : Field F] → {ι : Type u_6} → {r : ℕ} → Minidregg.Selvage.AccClaim Root F ι r → Root #3961960834
S def Minidregg.Selvage.AccClaim.targets : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → Minidregg.Selvage.AccClaim Root F ι r → Fin r → F #2631651811
S theorem Minidregg.Selvage.AccClaim.targets_apply : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (A : Minidregg.Selvage.AccClaim Root F ι r) (i : Fin r), A.targets i = (A.channel i).2
S def Minidregg.Selvage.AccClaim.warp : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → Root → ((ι → F) →ₗ[F] F) × F → ((ι → F) →ₗ[F] F) × F → Minidregg.Selvage.AccClaim Root F ι 2 #2166992891
S theorem Minidregg.Selvage.AccClaim.warp_satisfies_iff : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {C : Submodule F (ι → F)} {rt : Root} {wα wβ : (ι → F) →ₗ[F] F} {μ η : F} {f : ι → F}, Minidregg.Selvage.AccClaim.Satisfies C (Minidregg.Selvage.AccClaim.warp rt (wα, μ) (wβ, η)) f ↔ f ∈ C ∧ wα f = μ ∧ wβ f = η
S def Minidregg.Selvage.AccClaim.weights : {Root : Type u_1} → {F : Type u_2} → [inst : Field F] → {ι : Type u_3} → {r : ℕ} → Minidregg.Selvage.AccClaim Root F ι r → Fin r → (ι → F) →ₗ[F] F #2403771736
S theorem Minidregg.Selvage.AccClaim.weights_apply : ∀ {Root : Type u_1} {F : Type u_2} [inst : Field F] {ι : Type u_3} {r : ℕ} (A : Minidregg.Selvage.AccClaim Root F ι r) (i : Fin r), A.weights i = (A.channel i).1
