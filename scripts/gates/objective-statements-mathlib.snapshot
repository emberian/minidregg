S theorem Minidregg.Kernel.World.romPart_zero : ∀ {L : Minidregg.Theory.Store.Layout}, Minidregg.Kernel.World.romPart 0 = 0
S theorem Minidregg.Kernel.World.rom_cell_immutable_after_birth : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {c : Minidregg.Kernel.World.CellId} {k : R.Kind} {s : Minidregg.Theory.Store.Store (R.layout k)}, g.cells c = Option.some { kind := k, store := s } → W.cells c = Option.none ∧ W.retired c = Option.some () ∨ ∃ s', W.cells c = Option.some { kind := k, store := s' } ∧ ∀ (a : Minidregg.Theory.Store.Address (R.layout k)), (R.layout k).discipline a.fst = Minidregg.Theory.Store.Discipline.rom → s' a = s a
