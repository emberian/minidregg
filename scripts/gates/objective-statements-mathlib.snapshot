S theorem Minidregg.Compiler.LawLeaf.coveredFailing_congr : ∀ {covered : Minidregg.Pred.Slot → Bool} {o₁ n₁ o₂ n₂ : Minidregg.Pred.State}, Minidregg.Compiler.LawLeaf.Agree covered o₁ o₂ → Minidregg.Compiler.LawLeaf.Agree covered n₁ n₂ → ∀ (i : ℕ) (qs : List Minidregg.Pred.Pred), Minidregg.Compiler.LawLeaf.coveredFailing covered o₁ n₁ i qs = Minidregg.Compiler.LawLeaf.coveredFailing covered o₂ n₂ i qs
S theorem Minidregg.Compiler.LawLeaf.coveredFailing_sound : ∀ {covered : Minidregg.Pred.Slot → Bool} {old new : Minidregg.Pred.State} (i : ℕ) (qs : List Minidregg.Pred.Pred) (path : List ℕ), Minidregg.Compiler.LawLeaf.coveredFailing covered old new i qs = Option.some path → ∃ j sub q, path = (i + j) :: sub ∧ qs[j]? = Option.some q ∧ Minidregg.Pred.firstFailingLeaf q old new = Option.some sub
