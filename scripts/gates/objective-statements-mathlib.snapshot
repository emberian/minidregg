S theorem Minidregg.Kernel.JobMoney.claim_requires_bond : ∀ {tariff : Option Minidregg.Kernel.PayTariff.Tariff} {stored : Option (Minidregg.Theory.CredentialAuthorityState.StoredCapability Minidregg.Theory.TypedAuthorization.ResourceKind.account)} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {job : ℕ} {jo : Option Minidregg.Kernel.JobMoney.Job} {account amount : ℕ} {plan : Minidregg.Kernel.JobMoney.Plan}, Minidregg.Kernel.JobMoney.decideMoney tariff stored subject book job jo Minidregg.Kernel.JobMoney.claimAction account amount = Except.ok plan → ∃ j, jo = Option.some j ∧ j.state = 0 ∧ j.escrow = j.price ∧ j.provider = 0 ∧ Minidregg.Kernel.PayAssignmentReceiver.OwnerGrant stored subject account ∧ j.price ≤ amount ∧ plan.after.provider = subject.value ∧ plan.after.providerAcct = account ∧ plan.after.bond = amount
