S theorem Minidregg.Kernel.World.sysPost_head : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge), (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)) ⟨Minidregg.Kernel.World.SysSpace.head, ()⟩ = Option.some (height + 1, H.chain logRoot (H.turnDigest t))
S theorem Minidregg.Kernel.World.sysPost_journal : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge) (x : TxId), (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)) ⟨Minidregg.Kernel.World.SysSpace.journal, x⟩ = if x = t.txId then Option.some (height, H.turnDigest t) else s ⟨Minidregg.Kernel.World.SysSpace.journal, x⟩
S theorem Minidregg.Kernel.World.sysPost_parent : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge), (List.map Prod.fst t.creates).Nodup → ∀ {c : Minidregg.Kernel.World.CellId} {b : Minidregg.Kernel.World.Cell R} {room : Minidregg.Kernel.World.CellId}, (c, b, Option.some room) ∈ t.creates → (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)) ⟨Minidregg.Kernel.World.SysSpace.parent, c⟩ = Option.some room
S theorem Minidregg.Kernel.World.sysPost_retired : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge) (c : Minidregg.Kernel.World.CellId), (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)) ⟨Minidregg.Kernel.World.SysSpace.retired, c⟩ = if c ∈ t.retires then Option.some () else s ⟨Minidregg.Kernel.World.SysSpace.retired, c⟩
S theorem Minidregg.Kernel.World.sysPost_spent : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (height : ℕ) (logRoot : D) (avail : Minidregg.Theory.ResourceCost.Charge) (n : D), (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.sysPatch H t height logRoot avail)) ⟨Minidregg.Kernel.World.SysSpace.spent, n⟩ = if n ∈ t.nullifiers then Option.some () else s ⟨Minidregg.Kernel.World.SysSpace.spent, n⟩
