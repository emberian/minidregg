S theorem Minidregg.Selvage.binaryLookupEq_cubePt_off_address : ∀ {F : Type u_1} [inst : Field F] (k : ℕ) (b : Fin k → Bool) {i : Fin (2 ^ k)}, i ≠ (Minidregg.Selvage.binaryCubeIndexEquiv k) b → Minidregg.Selvage.binaryLookupEq k (Minidregg.Selvage.cubePt b) i = 0
