S def Minidregg.Selvage.StraightlineSrKnowledgeSoundness : (r : Minidregg.Selvage.Reduction) → Set (Minidregg.Selvage.Stmt r) → (ℕ → ℕ → ℝ → ℝ) → Prop := fun r Z εsr => ∃ E, ∀ (s t : ℕ), ∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (P : Minidregg.Selvage.SrProver r s), (Minidregg.Selvage.uniformProb ((Fin t → r.Chal) × (Fin r.k → r.Chal)) fun coins => have log := Minidregg.Selvage.srTrace P coins.1; have o := P.out (List.map Prod.snd log); have ρs := Minidregg.Selvage.srFinalChal P coins.1 coins.2; o.stmt ∈ Z ∧ ¬Minidregg.Selvage.RelaxedMem r.R δ o.stmt.idx o.stmt.x o.stmt.y (E s o ρs log) ∧ ∃ x' y', r.verify o.stmt.idx o.stmt.x o.stmt.y o.πs ρs = Option.some (x', y') ∧ Minidregg.Selvage.RelaxedMem r.R' δ o.stmt.idx x' y' o.w') ≤ εsr s t δ
S def Minidregg.Selvage.SuffixCube : ℕ → ℕ → Type #1692126925
S def Minidregg.Selvage.SumcheckAccepts : {F : Type} → [inst : Field F] → {v : ℕ} → (ℕ → Polynomial F) → (ℕ → Polynomial F) → F → F → (Fin v → F) → Prop := fun {F} [Field F] {v} prover honest H S r => (∀ i < v, Polynomial.eval 0 (prover i) + Polynomial.eval 1 (prover i) = Minidregg.Selvage.scChain H prover (Minidregg.Selvage.chalOf r) i) ∧ Minidregg.Selvage.scChain H prover (Minidregg.Selvage.chalOf r) v = Minidregg.Selvage.scChain S honest (Minidregg.Selvage.chalOf r) v
