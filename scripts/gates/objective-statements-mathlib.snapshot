S theorem Minidregg.Selvage.binaryLookupEq_cubePt_at_address : ∀ {F : Type u_1} [inst : Field F] (k : ℕ) (b : Fin k → Bool), Minidregg.Selvage.binaryLookupEq k (Minidregg.Selvage.cubePt b) ((Minidregg.Selvage.binaryCubeIndexEquiv k) b) = 1
