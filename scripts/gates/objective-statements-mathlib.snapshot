S theorem Minidregg.Theory.LogAccumulator.verify_sound : ∀ {D : Type} (node : D → D → D) (leaf : ℕ → D) [inst : DecidableEq D] (n j : ℕ), 1 ≤ j → j ≤ n → ∀ (frontier : List (ℕ × D)), Minidregg.Theory.LogAccumulator.Honest node leaf n frontier → ∀ (claimed : D) (nodes : ℕ → ℕ → Option D), Minidregg.Theory.LogAccumulator.verify node frontier n j claimed nodes = Bool.true → claimed = leaf j ∨ Minidregg.Theory.LogAccumulator.NodeCollision node
