S theorem Minidregg.Compiler.PredOrder.range_top_forced : ∀ {F : Type} [inst : Field F] {Idx : Type} {k n : ℕ} {asg : Idx → F} {shifted : Idx} {bits : Fin (k + 1) → Idx}, Minidregg.Compiler.PredOrder.NoWrap F k → n < 2 ^ (k + 1) → asg shifted = ↑n → Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.rangeGadget shifted bits) → asg (bits (Fin.last k)) = if 2 ^ k ≤ n then 1 else 0
