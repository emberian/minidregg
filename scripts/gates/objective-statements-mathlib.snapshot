S theorem Minidregg.Selvage.KStateFn.empty_iff : ∀ {r : Minidregg.Selvage.Reduction} (self : Minidregg.Selvage.KStateFn r), ∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (st : Minidregg.Selvage.Stmt r) (w : r.W), self.state δ st Minidregg.Selvage.Transcript.empty w = Bool.true ↔ Minidregg.Selvage.RelaxedMem r.R δ st.idx st.x st.y w
S theorem Minidregg.Selvage.KStateFn.full_iff : ∀ {r : Minidregg.Selvage.Reduction} (self : Minidregg.Selvage.KStateFn r), ∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (st : Minidregg.Selvage.Stmt r) (πs : Fin r.k → r.PMsg) (ρs : Fin r.k → r.Chal) (w : r.W), self.state δ st (Minidregg.Selvage.Transcript.ofFull πs ρs) w = Bool.true ↔ ∃ x' y', r.verify st.idx st.x st.y πs ρs = Option.some (x', y') ∧ Minidregg.Selvage.RelaxedMem r.R' δ st.idx x' y' w
S ctor Minidregg.Selvage.KStateFn.mk : {r : Minidregg.Selvage.Reduction} → (state : ℝ → Minidregg.Selvage.Stmt r → Minidregg.Selvage.Transcript r.PMsg r.Chal → r.W → Bool) → (∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (st : Minidregg.Selvage.Stmt r) (w : r.W), state δ st Minidregg.Selvage.Transcript.empty w = Bool.true ↔ Minidregg.Selvage.RelaxedMem r.R δ st.idx st.x st.y w) → (∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (st : Minidregg.Selvage.Stmt r) (rs : List (r.PMsg × r.Chal)) (w : r.W), rs.length < r.k → state δ st { rounds := rs, pending := Option.none } w = Bool.false → ∀ (π : r.PMsg), state δ st { rounds := rs, pending := Option.some π } w = Bool.false) → (∀ δ ∈ Set.Ioo 0 r.δstar, ∀ (st : Minidregg.Selvage.Stmt r) (πs : Fin r.k → r.PMsg) (ρs : Fin r.k → r.Chal) (w : r.W), state δ st (Minidregg.Selvage.Transcript.ofFull πs ρs) w = Bool.true ↔ ∃ x' y', r.verify st.idx st.x st.y πs ρs = Option.some (x', y') ∧ Minidregg.Selvage.RelaxedMem r.R' δ st.idx x' y' w) → Minidregg.Selvage.KStateFn r
