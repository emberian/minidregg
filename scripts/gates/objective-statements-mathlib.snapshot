S theorem Minidregg.Compiler.rangeGadget_complete : ∀ {F : Type u} [inst : Field F] {k : ℕ}, ∀ n < 2 ^ k, ∃ asg, asg Option.none = ↑n ∧ Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.rangeGadget Option.none fun i => Option.some { down := i })
S theorem Minidregg.Compiler.rangeGadget_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {k : ℕ} (asg : Idx → F) (xi : Idx) (bits : Fin k → Idx), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.rangeGadget xi bits) ↔ (∀ (i : Fin k), asg (bits i) = 0 ∨ asg (bits i) = 1) ∧ asg xi = ∑ i, asg (bits i) * 2 ^ ↑i
S theorem Minidregg.Compiler.rangeGadget_semHolds_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {k : ℕ} (asg : Idx → F) (xi : Idx) (bits : Fin k → Idx), Minidregg.Compiler.systemSemHolds asg (Minidregg.Compiler.rangeGadget xi bits) ↔ (∀ (i : Fin k), asg (bits i) = 0 ∨ asg (bits i) = 1) ∧ asg xi = ∑ i, asg (bits i) * 2 ^ ↑i
S theorem Minidregg.Compiler.rangeGadget_val_lt : ∀ {k p : ℕ} [inst : Fact (Nat.Prime p)], 2 ^ k ≤ p → ∀ {Idx : Type} (asg : Idx → ZMod p) (xi : Idx) (bits : Fin k → Idx), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.rangeGadget xi bits) → (asg xi).val < 2 ^ k
