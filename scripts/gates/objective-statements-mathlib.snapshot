S def Minidregg.Kernel.HyperdocumentIndexSync.rebuild : {capacity : ℕ} → Minidregg.Kernel.HyperdocumentIndexSync.Corpus capacity → Minidregg.Kernel.HyperdocumentIndexSync.Index capacity #3412745453
S theorem Minidregg.Kernel.HyperdocumentIndexSync.rebuild_update : ∀ {capacity : ℕ} (corpus : Minidregg.Kernel.HyperdocumentIndexSync.Corpus capacity) (slot : Fin capacity) (entry : Option Minidregg.Kernel.HyperdocumentIndexSync.SourceEntry), Minidregg.Kernel.HyperdocumentIndexSync.rebuild (Function.update corpus slot entry) = Function.update (Minidregg.Kernel.HyperdocumentIndexSync.rebuild corpus) slot (entry.bind Minidregg.Kernel.HyperdocumentIndexSync.SourceEntry.row?)
S def Minidregg.Kernel.HyperdocumentIndexSync.stableRangeAt : {capacity : ℕ} → Minidregg.Kernel.HyperdocumentIndexSync.Index capacity → Minidregg.Theory.Hyperdocument.DocumentId → Minidregg.Theory.Hyperdocument.StableRange → Fin capacity → Option Minidregg.Kernel.HyperdocumentIndexSync.IndexedRow #2467418613
S theorem Minidregg.Kernel.HyperdocumentIndexSync.stableRangeAt_complete : ∀ {capacity : ℕ} (snapshot : Minidregg.Kernel.HyperdocumentIndexSync.Snapshot capacity), snapshot.Fresh → ∀ (slot : Fin capacity) (entry : Minidregg.Kernel.HyperdocumentIndexSync.SourceEntry) (range : Minidregg.Theory.Hyperdocument.StableRange), snapshot.corpus slot = Option.some entry → entry.record.tombstonedAt = Option.none → entry.record.source = Option.some range → Minidregg.Kernel.HyperdocumentIndexSync.stableRangeAt snapshot.index entry.record.sourceDocument range slot = Option.some { linkId := entry.linkId, sourceDocument := entry.record.sourceDocument, sourceRange := entry.record.source, target := entry.record.target, relation := entry.record.relation, operation := entry.record.operation }
S theorem Minidregg.Kernel.HyperdocumentIndexSync.stableRangeAt_sound : ∀ {capacity : ℕ} (index : Minidregg.Kernel.HyperdocumentIndexSync.Index capacity) (document : Minidregg.Theory.Hyperdocument.DocumentId) (range : Minidregg.Theory.Hyperdocument.StableRange) (slot : Fin capacity) (row : Minidregg.Kernel.HyperdocumentIndexSync.IndexedRow), Minidregg.Kernel.HyperdocumentIndexSync.stableRangeAt index document range slot = Option.some row → index slot = Option.some row ∧ row.sourceDocument = document ∧ row.sourceRange = Option.some range
