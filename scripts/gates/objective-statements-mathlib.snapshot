S theorem Minidregg.Kernel.Seats.exitEach_closes : ∀ {height record : ℕ} {world next : Minidregg.Kernel.Seats.World} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.exitEach height record world accounts = Except.ok (next, batch) → ∀ account ∈ accounts, ∀ seat ∈ next.seats, seat.account ≠ account
S theorem Minidregg.Kernel.Seats.exitEach_deregistrations : ∀ {height record : ℕ} {world next : Minidregg.Kernel.Seats.World} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.exitEach height record world accounts = Except.ok (next, batch) → ∀ account ∈ accounts, account ∈ batch.deregistrations
S theorem Minidregg.Kernel.Seats.exitEach_posts : ∀ {height record : ℕ} {world next : Minidregg.Kernel.Seats.World} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.exitEach height record world accounts = Except.ok (next, batch) → Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ batch.registrations = [] ∧ ∀ {genesis : Minidregg.Kernel.Seats.World}, Minidregg.Kernel.Seats.Reachable genesis world → Minidregg.Kernel.Seats.Reachable genesis next
S theorem Minidregg.Kernel.Seats.exitEach_sub : ∀ {height record : ℕ} {world next : Minidregg.Kernel.Seats.World} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.exitEach height record world accounts = Except.ok (next, batch) → ∀ seat ∈ next.seats, seat ∈ world.seats
S theorem Minidregg.Kernel.Seats.exit_admitted : ∀ {world : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → Minidregg.Kernel.Seats.exitAuthorized height actor seat = Bool.true → Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit seat.account) = Except.ok ({ book := (Minidregg.Kernel.Seats.closeBatch world.book seat).apply world.book, registry := world.registry, seats := Minidregg.Kernel.Seats.removeSeat world.seats seat.account }, Minidregg.Kernel.Seats.closeBatch world.book seat)
S theorem Minidregg.Kernel.Seats.exit_after_deadline : ∀ {world : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → ∀ {due height : ℕ}, seat.proposal.exit = Minidregg.Kernel.Seats.ExitRule.afterDeadline due → due ≤ height → ∀ (anyone : Minidregg.Theory.TypedAuthorization.SubjectId), ∃ next, Minidregg.Kernel.Seats.step world height (Minidregg.Kernel.Seats.Actor.subject anyone) (Minidregg.Kernel.Seats.Action.exit seat.account) = Except.ok next
S theorem Minidregg.Kernel.Seats.exit_by_holder : ∀ {world : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → ∀ {record : ℕ}, seat.holder = Option.some record → ∀ (height : ℕ), (∀ (d : ℕ), seat.proposal.exit = Minidregg.Kernel.Seats.ExitRule.afterDeadline d → d ≤ height) → ∃ next, Minidregg.Kernel.Seats.step world height (Minidregg.Kernel.Seats.Actor.activity record) (Minidregg.Kernel.Seats.Action.exit seat.account) = Except.ok next
S theorem Minidregg.Kernel.Seats.exit_deregisters : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → account ∉ next.book.accounts
S theorem Minidregg.Kernel.Seats.exit_enabled : ∀ {world : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → seat.proposal.exit = Minidregg.Kernel.Seats.ExitRule.onDemand → ∀ (height : ℕ), ∃ next, Minidregg.Kernel.Seats.step world height (Minidregg.Kernel.Seats.Actor.subject seat.offerer) (Minidregg.Kernel.Seats.Action.exit seat.account) = Except.ok next
S theorem Minidregg.Kernel.Seats.exit_pays_allocation : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {seat : Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit seat.account) = Except.ok (next, batch) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), next.book.balance seat.account asset = 0 ∧ next.book.balance seat.payee asset = world.book.balance seat.payee asset + world.book.balance seat.account asset
S theorem Minidregg.Kernel.Seats.exit_removes_seat : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → ∀ seat ∈ next.seats, seat.account ≠ account
S theorem Minidregg.Kernel.Seats.exit_spec : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → ∃ seat ∈ world.seats, seat.account = account ∧ Minidregg.Kernel.Seats.exitAuthorized height actor seat = Bool.true ∧ Minidregg.Kernel.Seats.closeSeat world seat = Except.ok (next, batch)
S theorem Minidregg.Kernel.Seats.exit_step_authorized : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → ∃ seat ∈ world.seats, seat.account = account ∧ Minidregg.Kernel.Seats.exitAuthorized height actor seat = Bool.true
S def Minidregg.Kernel.Seats.firstUnsafe : List Minidregg.Kernel.Seats.Seat → Minidregg.Theory.CanonicalResourceKernel.Book → List Minidregg.Kernel.Seats.Transfer → Option Minidregg.Kernel.Seats.Seat #1413880199
S def Minidregg.Kernel.Seats.giveTransfers : Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Kernel.Seats.Proposal → List Minidregg.Kernel.Seats.Transfer #1119463095
S def Minidregg.Kernel.Seats.heldAssets : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Theory.CanonicalResourceKernel.AccountId → List Minidregg.Theory.CanonicalResourceKernel.AssetId #150775839
S theorem Minidregg.Kernel.Seats.heldAssets_nodup : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId), (Minidregg.Kernel.Seats.heldAssets book account).Nodup
S def Minidregg.Kernel.Seats.heldOpen : Minidregg.Kernel.Seats.World → ℕ → ℕ → List Minidregg.Kernel.Seats.Seat #1581088794
S theorem Minidregg.Kernel.Seats.holder_respects_deadline : ∀ {world next : Minidregg.Kernel.Seats.World} {height record : ℕ} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height (Minidregg.Kernel.Seats.Actor.activity record) (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → ∃ seat ∈ world.seats, seat.account = account ∧ seat.holder = Option.some record ∧ ∀ (due : ℕ), seat.proposal.exit = Minidregg.Kernel.Seats.ExitRule.afterDeadline due → due ≤ height
S theorem Minidregg.Kernel.Seats.marked_offer_has_empty_want : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {id : Minidregg.Kernel.Invitations.InvitationId} {expect : Minidregg.Kernel.Invitations.Expectation} {seatAccount funding payee : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal} {holder : Option ℕ} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.offer id expect seatAccount funding payee proposal holder) = Except.ok (next, batch) → proposal.donate = Bool.true → proposal.wantsNothing = Bool.true
S theorem Minidregg.Kernel.Seats.mem_heldAssets : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), asset ∈ Minidregg.Kernel.Seats.heldAssets book account ↔ book.balance account asset ≠ 0
S theorem Minidregg.Kernel.Seats.mem_of_mem_deregisterAccounts : ∀ {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {accounts : List Minidregg.Theory.CanonicalResourceKernel.AccountId}, account ∈ (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts book accounts).accounts → account ∈ book.accounts
S theorem Minidregg.Kernel.Seats.mem_removeSeat : ∀ {seats : List Minidregg.Kernel.Seats.Seat} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {seat : Minidregg.Kernel.Seats.Seat}, seat ∈ Minidregg.Kernel.Seats.removeSeat seats account ↔ seat ∈ seats ∧ seat.account ≠ account
