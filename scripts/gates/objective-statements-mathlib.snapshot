S theorem Minidregg.Pred.evalWith_all : ∀ (O : Minidregg.Pred.Oracle) (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWith O (Minidregg.Pred.Pred.all ps) old new = ps.all fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Pred.evalWith_any : ∀ (O : Minidregg.Pred.Oracle) (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWith O (Minidregg.Pred.Pred.any ps) old new = ps.any fun q => Minidregg.Pred.evalWith O q old new
S theorem Minidregg.Pred.evalWith_not : ∀ (O : Minidregg.Pred.Oracle) (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWith O p.not old new = !Minidregg.Pred.evalWith O p old new
S theorem Minidregg.Pred.eval_all : ∀ (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.Pred.all ps) old new = ps.all fun q => Minidregg.Pred.eval q old new
S theorem Minidregg.Pred.eval_any : ∀ (ps : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.Pred.any ps) old new = ps.any fun q => Minidregg.Pred.eval q old new
