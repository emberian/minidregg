S theorem Minidregg.Selvage.relDist_comm : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : DecidableEq F] (f g : ι → F), Minidregg.Selvage.relDist f g = Minidregg.Selvage.relDist g f
S theorem Minidregg.Selvage.relDist_le_of_agreesOn : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : DecidableEq F] [Nonempty ι] {S : Finset ι} {f u : ι → F} {δ : ℝ}, Minidregg.Selvage.AgreesOn S f u → (1 - δ) * ↑(Fintype.card ι) ≤ ↑S.card → Minidregg.Selvage.relDist f u ≤ δ
S theorem Minidregg.Selvage.relDist_triangle : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : DecidableEq F] [Nonempty ι] (f g h : ι → F), Minidregg.Selvage.relDist f h ≤ Minidregg.Selvage.relDist f g + Minidregg.Selvage.relDist g h
S def Minidregg.Selvage.residualSum : {F : Type u_1} → [CommRing F] → {m : ℕ} → ((Fin m → F) → F) → (Fin m → F) → ℕ → F #2285742653
S theorem Minidregg.Selvage.residualSum_eq_roundSum_bool : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k < m) (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.residualSum g r k = Minidregg.Selvage.roundSum g r ⟨k, hk⟩ 0 + Minidregg.Selvage.roundSum g r ⟨k, hk⟩ 1
S theorem Minidregg.Selvage.residualSum_full : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.residualSum g r m = g r
S theorem Minidregg.Selvage.residualSum_step : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k < m) (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.roundSum g r ⟨k, hk⟩ (r ⟨k, hk⟩) = Minidregg.Selvage.residualSum g r (k + 1)
S theorem Minidregg.Selvage.residualSum_zero : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.residualSum g r 0 = ∑ b, g (Minidregg.Selvage.cubePt b)
S def Minidregg.Selvage.resolveIn : {r : Minidregg.Selvage.Reduction} → {s : ℕ} → List (Minidregg.Selvage.SrMove r s × r.Chal) → Minidregg.Selvage.SrMove r s → r.Chal → r.Chal #1574641784
S theorem Minidregg.Selvage.resolveIn_append_left : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L M : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s} {e : Minidregg.Selvage.SrMove r s × r.Chal}, List.find? (fun e => Decidable.decide (e.1 = q)) L = Option.some e → ∀ (fb : r.Chal), Minidregg.Selvage.resolveIn (L ++ M) q fb = e.2
S theorem Minidregg.Selvage.resolveIn_append_of_ne : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L M : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s}, (∀ e ∈ L, e.1 ≠ q) → ∀ (fb : r.Chal), Minidregg.Selvage.resolveIn (L ++ M) q fb = Minidregg.Selvage.resolveIn M q fb
S theorem Minidregg.Selvage.resolveIn_cons_self : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {M : List (Minidregg.Selvage.SrMove r s × r.Chal)} (q : Minidregg.Selvage.SrMove r s) (ρ fb : r.Chal), Minidregg.Selvage.resolveIn ((q, ρ) :: M) q fb = ρ
S theorem Minidregg.Selvage.resolveIn_found : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s} {e : Minidregg.Selvage.SrMove r s × r.Chal}, List.find? (fun e => Decidable.decide (e.1 = q)) L = Option.some e → ∀ (fb : r.Chal), Minidregg.Selvage.resolveIn L q fb = e.2
S theorem Minidregg.Selvage.resolveIn_of_forall_ne : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} {L : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s}, (∀ e ∈ L, e.1 ≠ q) → ∀ (fb : r.Chal), Minidregg.Selvage.resolveIn L q fb = fb
S theorem Minidregg.Selvage.resolveIn_runFrom_found : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) {L : List (Minidregg.Selvage.SrMove r s × r.Chal)} {q : Minidregg.Selvage.SrMove r s} {e : Minidregg.Selvage.SrMove r s × r.Chal}, List.find? (fun e => Decidable.decide (e.1 = q)) L = Option.some e → ∀ (cs : List r.Chal) (fb : r.Chal), Minidregg.Selvage.resolveIn (Minidregg.Selvage.runFrom P L cs) q fb = e.2
S def Minidregg.Selvage.roundPoly : {F : Type} → [inst : Field F] → {m : ℕ} → ((Fin m → F) → F) → (Fin m → F) → Fin m → Polynomial F #3592828695
S theorem Minidregg.Selvage.roundPoly_degree : ∀ {F : Type} [inst : Field F] {m : ℕ} (g : (Fin m → F) → F) (r : Fin m → F) (i : Fin m), (Minidregg.Selvage.roundPoly g r i).degree < ↑(1 + 1)
S theorem Minidregg.Selvage.roundPoly_eval : ∀ {F : Type} [inst : Field F] {m : ℕ} {g : (Fin m → F) → F} {i : Fin m}, Minidregg.Selvage.AffineInCoord g i → ∀ (r : Fin m → F) (t : F), Polynomial.eval t (Minidregg.Selvage.roundPoly g r i) = Minidregg.Selvage.roundSum g r i t
S def Minidregg.Selvage.roundSum : {F : Type u_1} → [CommRing F] → {m : ℕ} → ((Fin m → F) → F) → (Fin m → F) → Fin m → F → F #1720379070
S theorem Minidregg.Selvage.roundSum_affine : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} {g : (Fin m → F) → F} {i : Fin m}, Minidregg.Selvage.AffineInCoord g i → ∀ (r : Fin m → F) (t : F), Minidregg.Selvage.roundSum g r i t = (1 - t) * Minidregg.Selvage.roundSum g r i 0 + t * Minidregg.Selvage.roundSum g r i 1
S theorem Minidregg.Selvage.roundSum_congr_prefix : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} {g : (Fin m → F) → F} {i : Fin m} {r r' : Fin m → F}, (∀ (j : Fin m), ↑j < ↑i → r j = r' j) → ∀ (t : F), Minidregg.Selvage.roundSum g r i t = Minidregg.Selvage.roundSum g r' i t
S theorem Minidregg.Selvage.roundSum_fold : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k < m) (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.roundSum g r ⟨k, hk⟩ 0 + Minidregg.Selvage.roundSum g r ⟨k, hk⟩ 1 = ∑ b, g (Minidregg.Selvage.glue r k b)
S theorem Minidregg.Selvage.roundSum_last : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} {i : Fin m}, ↑i + 1 = m → ∀ (g : (Fin m → F) → F) (r : Fin m → F) (t : F), Minidregg.Selvage.roundSum g r i t = g (Function.update r i t)
S theorem Minidregg.Selvage.roundSum_succ : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k + 1 < m) (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.roundSum g r ⟨k + 1, hk⟩ 0 + Minidregg.Selvage.roundSum g r ⟨k + 1, hk⟩ 1 = Minidregg.Selvage.roundSum g r ⟨k, Nat.lt_of_succ_lt hk⟩ (r ⟨k, Nat.lt_of_succ_lt hk⟩)
S theorem Minidregg.Selvage.roundSum_zero : ∀ {F : Type u_1} [inst : CommRing F] {m : ℕ} (h0 : 0 < m) (g : (Fin m → F) → F) (r : Fin m → F), Minidregg.Selvage.roundSum g r ⟨0, h0⟩ 0 + Minidregg.Selvage.roundSum g r ⟨0, h0⟩ 1 = ∑ b, g (Minidregg.Selvage.cubePt b)
S def Minidregg.Selvage.runFrom : {r : Minidregg.Selvage.Reduction} → {s : ℕ} → Minidregg.Selvage.SrProver r s → List (Minidregg.Selvage.SrMove r s × r.Chal) → List r.Chal → List (Minidregg.Selvage.SrMove r s × r.Chal) #2430383424
S theorem Minidregg.Selvage.runFrom_append : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)) (cs cs' : List r.Chal), Minidregg.Selvage.runFrom P L (cs ++ cs') = Minidregg.Selvage.runFrom P (Minidregg.Selvage.runFrom P L cs) cs'
S theorem Minidregg.Selvage.runFrom_cons : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)) (ρ : r.Chal) (cs : List r.Chal), Minidregg.Selvage.runFrom P L (ρ :: cs) = Minidregg.Selvage.runFrom P (Minidregg.Selvage.stepOnce P L ρ) cs
S theorem Minidregg.Selvage.runFrom_eq_append : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (cs : List r.Chal) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)), ∃ M, Minidregg.Selvage.runFrom P L cs = L ++ M
S theorem Minidregg.Selvage.runFrom_length : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (cs : List r.Chal) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)), (Minidregg.Selvage.runFrom P L cs).length = L.length + cs.length
S theorem Minidregg.Selvage.runFrom_nil : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)), Minidregg.Selvage.runFrom P L [] = L
S theorem Minidregg.Selvage.satisfies_batch_iff_defect_root : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] {f : ι → F} {γ : F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, Minidregg.Selvage.Satisfies f (Minidregg.Selvage.batchConstraint γ cs) ↔ Polynomial.eval γ (Minidregg.Selvage.defectPoly f cs) = 0
S theorem Minidregg.Selvage.satisfies_batch_of_forall : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] (γ : F) {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, (∀ c ∈ cs, Minidregg.Selvage.Satisfies f c) → Minidregg.Selvage.Satisfies f (Minidregg.Selvage.batchConstraint γ cs)
S theorem Minidregg.Selvage.satisfies_evalConstraint_iff : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {F : Type u_2} [inst_2 : Field F] {f : ι → F} {pt : ι} {σ : F}, Minidregg.Selvage.Satisfies f (Minidregg.Selvage.evalConstraint pt σ) ↔ f pt = σ
S theorem Minidregg.Selvage.satisfies_not_acceptsFalse : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] {v : ℕ} {prover honest : ℕ → Polynomial F} {f : ι → F} {c : Minidregg.Selvage.LinearConstraint ι F}, Minidregg.Selvage.Satisfies f c → ∀ (r : Fin v → F), ¬Minidregg.Selvage.AcceptsFalse prover honest c.target (Minidregg.Selvage.trueSum c f) r
S def Minidregg.Selvage.scChain : {F : Type} → [inst : Field F] → F → (ℕ → Polynomial F) → (ℕ → F) → ℕ → F #2203718656
S theorem Minidregg.Selvage.scChain_mleHonest_final : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (r : Fin m → F), Minidregg.Selvage.scChain (∑ b, f b) (Minidregg.Selvage.mleHonest f (Minidregg.Selvage.chalOf r)) (Minidregg.Selvage.chalOf r) m = Minidregg.Selvage.mle f r
S theorem Minidregg.Selvage.scChain_mleHonest_partial : ∀ {F : Type} [inst : Field F] {m : ℕ} (f : (Fin m → Bool) → F) (χ : ℕ → F) {k : ℕ}, k ≤ m → Minidregg.Selvage.scChain (∑ b, f b) (Minidregg.Selvage.mleHonest f χ) χ k = Minidregg.Selvage.residualSum (Minidregg.Selvage.mle f) (fun j => χ ↑j) k
S def Minidregg.Selvage.slotBad : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.RbrKnowledgeSoundness r → Set (Minidregg.Selvage.Stmt r) → ℝ → Minidregg.Selvage.SrProver r s → Fin r.k → (Fin t → r.Chal) × (Fin r.k → r.Chal) → Prop := fun {r} {s t} rbr Z δ P a ω => (Minidregg.Selvage.srOut P ω.1).stmt ∈ Z ∧ Minidregg.Selvage.RoundBad rbr δ (Minidregg.Selvage.srOut P ω.1).stmt (List.take (↑a) (Minidregg.Selvage.srRounds P ω.1 ω.2)) ((Minidregg.Selvage.srOut P ω.1).πs a) (Minidregg.Selvage.srFinalChal P ω.1 ω.2 a)
S def Minidregg.Selvage.splitAtGame : {C D : Type} → {t : ℕ} → (j : Fin t) → (Fin t → C) × D ≃ (Fin ↑j → C) × C × (Fin (t - ↑j - 1) → C) × D #3734093806
S def Minidregg.Selvage.splitCoord : {n : ℕ} → {β : Type} → (i : Fin n) → (Fin n → β) ≃ ({ j // j ≠ i } → β) × β #949554619
S theorem Minidregg.Selvage.splitCoord_symm_apply_ne : ∀ {n : ℕ} {β : Type} {i j : Fin n} (h : j ≠ i) (x : ({ j // j ≠ i } → β) × β), (Minidregg.Selvage.splitCoord i).symm x j = x.1 ⟨j, h⟩
S theorem Minidregg.Selvage.splitCoord_symm_apply_of_ne : ∀ {F : Type} {v : ℕ} {i : Fin v} (x : ({ j // j ≠ i } → F) × F) {j : Fin v} (hj : j ≠ i), (Minidregg.Selvage.splitCoord i).symm x j = x.1 ⟨j, hj⟩
S theorem Minidregg.Selvage.splitCoord_symm_apply_self : ∀ {n : ℕ} {β : Type} (i : Fin n) (x : ({ j // j ≠ i } → β) × β), (Minidregg.Selvage.splitCoord i).symm x i = x.2
S def Minidregg.Selvage.splitGame : {C : Type} → {t : ℕ} → (j : Fin t) → (Fin t → C) ≃ (Fin ↑j → C) × C × (Fin (t - ↑j - 1) → C) #4090991518
S theorem Minidregg.Selvage.splitGame_symm_apply_gt : ∀ {C : Type} {t : ℕ} (j : Fin t) (y : (Fin ↑j → C) × C × (Fin (t - ↑j - 1) → C)) (i : Fin t) (h : ↑j < ↑i), (Minidregg.Selvage.splitGame j).symm y i = y.2.2 ⟨↑i - ↑j - 1, Decidable.byContradiction fun a => Minidregg.Selvage.splitGame_symm_apply_gt._proof_1 j i h a⟩
S theorem Minidregg.Selvage.splitGame_symm_apply_lt : ∀ {C : Type} {t : ℕ} (j : Fin t) (y : (Fin ↑j → C) × C × (Fin (t - ↑j - 1) → C)) (i : Fin t) (h : ↑i < ↑j), (Minidregg.Selvage.splitGame j).symm y i = y.1 ⟨↑i, h⟩
S theorem Minidregg.Selvage.splitGame_symm_apply_self : ∀ {C : Type} {t : ℕ} (j : Fin t) (y : (Fin ↑j → C) × C × (Fin (t - ↑j - 1) → C)), (Minidregg.Selvage.splitGame j).symm y j = y.2.1
S def Minidregg.Selvage.splitProd1 : {n : ℕ} → {β γ : Type} → (i : Fin n) → (Fin n → β) × γ ≃ (({ j // j ≠ i } → β) × γ) × β #3345471372
S theorem Minidregg.Selvage.splitProd1_symm_fst_ne : ∀ {n : ℕ} {β γ : Type} {i j : Fin n} (h : j ≠ i) (y : (({ j // j ≠ i } → β) × γ) × β), ((Minidregg.Selvage.splitProd1 i).symm y).1 j = y.1.1 ⟨j, h⟩
S theorem Minidregg.Selvage.splitProd1_symm_fst_self : ∀ {n : ℕ} {β γ : Type} (i : Fin n) (y : (({ j // j ≠ i } → β) × γ) × β), ((Minidregg.Selvage.splitProd1 i).symm y).1 i = y.2
S theorem Minidregg.Selvage.splitProd1_symm_snd : ∀ {n : ℕ} {β γ : Type} (i : Fin n) (y : (({ j // j ≠ i } → β) × γ) × β), ((Minidregg.Selvage.splitProd1 i).symm y).2 = y.1.2
S def Minidregg.Selvage.srExtract : {r : Minidregg.Selvage.Reduction} → Minidregg.Selvage.RbrKnowledgeSoundness r → (s : ℕ) → Minidregg.Selvage.SrExtractor r s #3780034862
S def Minidregg.Selvage.srFinalChal : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → (Fin t → r.Chal) → (Fin r.k → r.Chal) → Fin r.k → r.Chal #1120133994
S theorem Minidregg.Selvage.srFinalChal_congr : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) {d d' : Fin r.k → r.Chal} (i : Fin r.k), d i = d' i → Minidregg.Selvage.srFinalChal P c d i = Minidregg.Selvage.srFinalChal P c d' i
S theorem Minidregg.Selvage.srFinalChal_def : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (d : Fin r.k → r.Chal) (i : Fin r.k), Minidregg.Selvage.srFinalChal P c d i = match List.find? (fun e => Decidable.decide (e.1 = (Minidregg.Selvage.srOut P c).query i)) (Minidregg.Selvage.srTrace P c) with | Option.some e => e.2 | Option.none => d i
S theorem Minidregg.Selvage.srFinalChal_eq_resolveIn : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (d : Fin r.k → r.Chal) (i : Fin r.k), Minidregg.Selvage.srFinalChal P c d i = Minidregg.Selvage.resolveIn (Minidregg.Selvage.srTrace P c) ((Minidregg.Selvage.srOut P c).query i) (d i)
S theorem Minidregg.Selvage.srFinalChal_of_none : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (d : Fin r.k → r.Chal) (i : Fin r.k), List.find? (fun e => Decidable.decide (e.1 = (Minidregg.Selvage.srOut P c).query i)) (Minidregg.Selvage.srTrace P c) = Option.none → Minidregg.Selvage.srFinalChal P c d i = d i
S def Minidregg.Selvage.srOut : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → (Fin t → r.Chal) → Minidregg.Selvage.SrOutput r s #2519761076
S def Minidregg.Selvage.srRounds : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → (Fin t → r.Chal) → (Fin r.k → r.Chal) → List (r.PMsg × r.Chal) #85870721
S def Minidregg.Selvage.srTrace : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → (Fin t → r.Chal) → List (Minidregg.Selvage.SrMove r s × r.Chal) #709510621
S theorem Minidregg.Selvage.srTrace_eq_foldl : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal), Minidregg.Selvage.srTrace P c = List.foldl (Minidregg.Selvage.stepFn P c) [] (List.finRange t)
S theorem Minidregg.Selvage.srTrace_eq_runFrom : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal), Minidregg.Selvage.srTrace P c = Minidregg.Selvage.runFrom P [] (List.ofFn c)
S theorem Minidregg.Selvage.srTrace_length : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal), (Minidregg.Selvage.srTrace P c).length = t
S theorem Minidregg.Selvage.srTrace_take : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) {j : ℕ}, j ≤ t → List.take j (Minidregg.Selvage.srTrace P c) = List.foldl (Minidregg.Selvage.stepFn P c) [] (List.take j (List.finRange t))
S theorem Minidregg.Selvage.srTrace_take_agree : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) {c c' : Fin t → r.Chal} {j : ℕ}, j ≤ t → (∀ (i : Fin t), ↑i < j → c i = c' i) → List.take j (Minidregg.Selvage.srTrace P c) = List.take j (Minidregg.Selvage.srTrace P c')
S def Minidregg.Selvage.stepFn : {r : Minidregg.Selvage.Reduction} → {s t : ℕ} → Minidregg.Selvage.SrProver r s → (Fin t → r.Chal) → List (Minidregg.Selvage.SrMove r s × r.Chal) → Fin t → List (Minidregg.Selvage.SrMove r s × r.Chal) #1869001972
S theorem Minidregg.Selvage.stepFn_eq : ∀ {r : Minidregg.Selvage.Reduction} {s t : ℕ} (P : Minidregg.Selvage.SrProver r s) (c : Fin t → r.Chal) (log : List (Minidregg.Selvage.SrMove r s × r.Chal)) (j : Fin t), Minidregg.Selvage.stepFn P c log j = log ++ [(P.move (List.map Prod.snd log), match List.find? (fun e => Decidable.decide (e.1 = P.move (List.map Prod.snd log))) log with | Option.some e => e.2 | Option.none => c j)]
S def Minidregg.Selvage.stepOnce : {r : Minidregg.Selvage.Reduction} → {s : ℕ} → Minidregg.Selvage.SrProver r s → List (Minidregg.Selvage.SrMove r s × r.Chal) → r.Chal → List (Minidregg.Selvage.SrMove r s × r.Chal) #814890952
S theorem Minidregg.Selvage.stepOnce_eq : ∀ {r : Minidregg.Selvage.Reduction} {s : ℕ} (P : Minidregg.Selvage.SrProver r s) (L : List (Minidregg.Selvage.SrMove r s × r.Chal)) (ρ : r.Chal), Minidregg.Selvage.stepOnce P L ρ = L ++ [(P.move (List.map Prod.snd L), match List.find? (fun e => Decidable.decide (e.1 = P.move (List.map Prod.snd L))) L with | Option.some e => e.2 | Option.none => ρ)]
S def Minidregg.Selvage.suffixCubeZero : (m : ℕ) → Minidregg.Selvage.SuffixCube m 0 ≃ (Fin m → Bool) #2825879152
S def Minidregg.Selvage.suffixSplit : {m : ℕ} → (k : ℕ) → k < m → Minidregg.Selvage.SuffixCube m k ≃ Bool × Minidregg.Selvage.SuffixCube m (k + 1) #3799891010
S theorem Minidregg.Selvage.suffixSplit_symm_apply : ∀ {m k : ℕ} (hk : k < m) (tb : Bool × Minidregg.Selvage.SuffixCube m (k + 1)) (j : { j // k ≤ ↑j }), (Minidregg.Selvage.suffixSplit k hk).symm tb j = if h : k + 1 ≤ ↑↑j then tb.2 ⟨↑j, h⟩ else tb.1
S theorem Minidregg.Selvage.sum_glue_fold : ∀ {F : Type u_1} [inst : CommRing F] {m k : ℕ} (hk : k < m) (g : (Fin m → F) → F) (r : Fin m → F), ∑ b, g (Minidregg.Selvage.glue r k b) = ∑ b, g (Minidregg.Selvage.glue (Function.update r ⟨k, hk⟩ 0) (k + 1) b) + ∑ b, g (Minidregg.Selvage.glue (Function.update r ⟨k, hk⟩ 1) (k + 1) b)
S theorem Minidregg.Selvage.sum_ite_card : ∀ {C : Type} [inst : Fintype C] (p : C → Prop) [inst_1 : DecidablePred p], (∑ ρ, if p ρ then 1 else 0) = ↑(Nat.card { ρ // p ρ })
S theorem Minidregg.Selvage.sum_reindex_hypercube : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] {v : ℕ} (e : ι ≃ (Fin v → Bool)) (w : ι → F), ∑ b, w (e.symm b) = ∑ i, w i
S theorem Minidregg.Selvage.sumcheckRound_prob : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [DecidableEq F] {d : ℕ} {g gp : Polynomial F} {H : F}, g.degree < ↑(d + 1) → gp.degree < ↑(d + 1) → Polynomial.eval 0 gp + Polynomial.eval 1 gp = H → H ≠ Polynomial.eval 0 g + Polynomial.eval 1 g → (Minidregg.Selvage.uniformProb F fun r => Polynomial.eval r gp = Polynomial.eval r g) ≤ ↑d / ↑(Fintype.card F)
S theorem Minidregg.Selvage.sumcheckRound_sound : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [inst_2 : DecidableEq F] {d : ℕ} {g gp : Polynomial F} {H : F}, g.degree < ↑(d + 1) → gp.degree < ↑(d + 1) → Polynomial.eval 0 gp + Polynomial.eval 1 gp = H → H ≠ Polynomial.eval 0 g + Polynomial.eval 1 g → (Minidregg.Selvage.agreeFinset gp g).card ≤ d
S theorem Minidregg.Selvage.sumcheck_reduction : ∀ {F : Type} [inst : Field F] {v : ℕ} {prover honest : ℕ → Polynomial F} {chal claimF truF : ℕ → F}, (∀ i < v, claimF (i + 1) = Polynomial.eval (chal i) (prover i)) → (∀ i < v, truF (i + 1) = Polynomial.eval (chal i) (honest i)) → claimF 0 ≠ truF 0 → claimF v = truF v → ∃ j < v, claimF j ≠ truF j ∧ Polynomial.eval (chal j) (prover j) = Polynomial.eval (chal j) (honest j)
S theorem Minidregg.Selvage.sumcheck_retires_batch : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] [inst_2 : Fintype F] [DecidableEq F] {v d : ℕ} {prover honest : ℕ → Polynomial F} {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)} {γ : F}, ¬Minidregg.Selvage.Satisfies f (Minidregg.Selvage.batchConstraint γ cs) → (∀ i < v, (prover i).degree < ↑(d + 1)) → (∀ i < v, (honest i).degree < ↑(d + 1)) → (∀ (r : Fin v → F), ∀ i < v, Polynomial.eval 0 (honest i) + Polynomial.eval 1 (honest i) = Minidregg.Selvage.scChain (Minidregg.Selvage.trueSum (Minidregg.Selvage.batchConstraint γ cs) f) honest (Minidregg.Selvage.chalOf r) i) → Minidregg.Selvage.uniformProb (Fin v → F) (Minidregg.Selvage.SumcheckAccepts prover honest (Minidregg.Selvage.batchConstraint γ cs).target (Minidregg.Selvage.trueSum (Minidregg.Selvage.batchConstraint γ cs) f)) ≤ ↑v * (↑d / ↑(Fintype.card F))
S theorem Minidregg.Selvage.sumcheck_retires_constraint : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] [inst_2 : Fintype F] [DecidableEq F] {v d : ℕ} {prover honest : ℕ → Polynomial F} {f : ι → F} {c : Minidregg.Selvage.LinearConstraint ι F}, ¬Minidregg.Selvage.Satisfies f c → (∀ i < v, (prover i).degree < ↑(d + 1)) → (∀ i < v, (honest i).degree < ↑(d + 1)) → (∀ (r : Fin v → F), ∀ i < v, Polynomial.eval 0 (honest i) + Polynomial.eval 1 (honest i) = Minidregg.Selvage.scChain (Minidregg.Selvage.trueSum c f) honest (Minidregg.Selvage.chalOf r) i) → Minidregg.Selvage.uniformProb (Fin v → F) (Minidregg.Selvage.SumcheckAccepts prover honest c.target (Minidregg.Selvage.trueSum c f)) ≤ ↑v * (↑d / ↑(Fintype.card F))
S theorem Minidregg.Selvage.sumcheck_soundness : ∀ {F : Type} [inst : Field F] [inst_1 : Fintype F] [DecidableEq F] {v d : ℕ} {prover honest : ℕ → Polynomial F} {H S : F}, (∀ i < v, (prover i).degree < ↑(d + 1)) → (∀ i < v, (honest i).degree < ↑(d + 1)) → (∀ (r : Fin v → F), ∀ i < v, Polynomial.eval 0 (honest i) + Polynomial.eval 1 (honest i) = Minidregg.Selvage.scChain S honest (Minidregg.Selvage.chalOf r) i) → Minidregg.Selvage.uniformProb (Fin v → F) (Minidregg.Selvage.AcceptsFalse prover honest H S) ≤ ↑v * (↑d / ↑(Fintype.card F))
S def Minidregg.Selvage.trivialKState : Minidregg.Selvage.KStateFn Minidregg.Selvage.trivialReduction #151182598
S def Minidregg.Selvage.trivialProver : Minidregg.Selvage.SrProver Minidregg.Selvage.trivialReduction 0 #1119457483
S def Minidregg.Selvage.trivialRbr : Minidregg.Selvage.RbrKnowledgeSoundness Minidregg.Selvage.trivialReduction #490141699
S def Minidregg.Selvage.trivialReduction : Minidregg.Selvage.Reduction #3587023487
S def Minidregg.Selvage.trivialStmt : Minidregg.Selvage.Stmt Minidregg.Selvage.trivialReduction #2846200983
S def Minidregg.Selvage.trueSum : {ι : Type u_1} → [Fintype ι] → {F : Type} → [Field F] → Minidregg.Selvage.LinearConstraint ι F → (ι → F) → F #1529424940
S theorem Minidregg.Selvage.trueSum_eq_dotWt : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] (c : Minidregg.Selvage.LinearConstraint ι F) (f : ι → F), Minidregg.Selvage.trueSum c f = Minidregg.Selvage.dotWt c.wt f
S def Minidregg.Selvage.uniformProb : (C : Type) → [Fintype C] → (C → Prop) → ℝ #3461336335
S theorem Minidregg.Selvage.uniformProb_congr : ∀ {C : Type} [inst : Fintype C] {p q : C → Prop}, (∀ (c : C), p c ↔ q c) → Minidregg.Selvage.uniformProb C p = Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_coord_mem : ∀ {F : Type} [inst : Fintype F] {v : ℕ} (i : Fin v) (S : Finset F), (Minidregg.Selvage.uniformProb (Fin v → F) fun r => r i ∈ S) ≤ ↑S.card / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_coord_mem_prefix : ∀ {F : Type} [Field F] [inst : Fintype F] {v d : ℕ} (i : Fin v) (bad : (Fin v → F) → Finset F), (∀ (r r' : Fin v → F), (∀ (j : Fin v), ↑j < ↑i → r j = r' j) → bad r = bad r') → (∀ (r : Fin v → F), (bad r).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => r i ∈ bad r) ≤ ↑d / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_equiv : ∀ {A B : Type} [inst : Fintype A] [inst_1 : Fintype B] (e : A ≃ B) (p : B → Prop), (Minidregg.Selvage.uniformProb A fun a => p (e a)) = Minidregg.Selvage.uniformProb B p
S theorem Minidregg.Selvage.uniformProb_exists_le : ∀ {C : Type} [inst : Fintype C] {m : ℕ} (p : Fin m → C → Prop), (Minidregg.Selvage.uniformProb C fun c => ∃ i, p i c) ≤ ∑ i, Minidregg.Selvage.uniformProb C (p i)
S theorem Minidregg.Selvage.uniformProb_false : ∀ {C : Type} [inst : Fintype C] {p : C → Prop}, (∀ (c : C), ¬p c) → Minidregg.Selvage.uniformProb C p = 0
S theorem Minidregg.Selvage.uniformProb_le_one : ∀ {C : Type} [inst : Fintype C] (p : C → Prop), Minidregg.Selvage.uniformProb C p ≤ 1
S theorem Minidregg.Selvage.uniformProb_mem_finset : ∀ {F : Type} [inst : Fintype F] (S : Finset F), (Minidregg.Selvage.uniformProb F fun x => x ∈ S) = ↑S.card / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_mono : ∀ {C : Type} [inst : Fintype C] {p q : C → Prop}, (∀ (c : C), p c → q c) → Minidregg.Selvage.uniformProb C p ≤ Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_nonneg : ∀ {C : Type} [inst : Fintype C] (p : C → Prop), 0 ≤ Minidregg.Selvage.uniformProb C p
S theorem Minidregg.Selvage.uniformProb_or_le : ∀ {C : Type} [inst : Fintype C] (p q : C → Prop), (Minidregg.Selvage.uniformProb C fun c => p c ∨ q c) ≤ Minidregg.Selvage.uniformProb C p + Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_prod_le : ∀ {A B : Type} [inst : Fintype A] [inst_1 : Fintype B] {p : A × B → Prop} {ε : ℝ}, 0 ≤ ε → (∀ (a : A), (Minidregg.Selvage.uniformProb B fun b => p (a, b)) ≤ ε) → Minidregg.Selvage.uniformProb (A × B) p ≤ ε
S theorem Minidregg.Selvage.uniformProb_pushforward_le : ∀ {C : Type} [inst : Fintype C] {W V : Type} [inst_1 : Fintype W] [inst_2 : Fintype V] {ε : ℝ}, 0 ≤ ε → ∀ (f : C → W → V) (G : V → C → Prop), (∀ (ρ : C) (v : V), ↑(Nat.card { w // f ρ w = v }) * ↑(Fintype.card V) = ↑(Fintype.card W)) → (∀ (v : V), Minidregg.Selvage.uniformProb C (G v) ≤ ε) → (Minidregg.Selvage.uniformProb (C × W) fun x => G (f x.1 x.2) x.1) ≤ ε
S theorem Minidregg.Selvage.uniformProb_roundBad_le : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (st : Minidregg.Selvage.Stmt r) (i : Fin r.k) {rs : List (r.PMsg × r.Chal)}, rs.length = ↑i → ∀ (π : r.PMsg), Minidregg.Selvage.uniformProb r.Chal (Minidregg.Selvage.RoundBad rbr δ st rs π) ≤ rbr.err i st δ
S theorem Minidregg.Selvage.unionBound_fixed : ∀ {F : Type} [Field F] [inst : Fintype F] {v d : ℕ} (bad : Fin v → Finset F), (∀ (i : Fin v), (bad i).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => ∃ i, r i ∈ bad i) ≤ ↑v * (↑d / ↑(Fintype.card F))
