S theorem Minidregg.Compiler.DurableLogTags.firstBadTag_eq_none_iff : ∀ {D T : Type} [inst : DecidableEq T] (tag : ℕ → D → T) (height : ℕ) (chains : List D) (tags : List T), Minidregg.Compiler.DurableLogTags.firstBadTag tag height chains tags = Option.none ↔ Minidregg.Compiler.DurableLogTags.TagsHonest tag height chains tags
S theorem Minidregg.Compiler.DurableLogTags.firstBadTag_names_first : ∀ {D T : Type} [inst : DecidableEq T] (tag : ℕ → D → T) (height : ℕ) (chains : List D) (pre post : List T) (stored : T) (chain : D), Minidregg.Compiler.DurableLogTags.TagsHonest tag height chains pre → chains[pre.length + 1]? = Option.some chain → stored ≠ tag (height + pre.length + 1) chain → Minidregg.Compiler.DurableLogTags.firstBadTag tag height chains (pre ++ stored :: post) = Option.some (height + pre.length + 1)
