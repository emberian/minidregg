S def Minidregg.Selvage.batchTarget : {ι : Type u_1} → {F : Type u_2} → [Field F] → F → List (Minidregg.Selvage.LinearConstraint ι F) → F #935786043
S theorem Minidregg.Selvage.batchTarget_eq_sum : ∀ {ι : Type u_1} {F : Type u_2} [inst : Field F] (γ : F) (cs : List (Minidregg.Selvage.LinearConstraint ι F)), Minidregg.Selvage.batchTarget γ cs = ∑ k, γ ^ ↑k * cs[↑k].target
