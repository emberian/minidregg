S theorem Minidregg.Theory.Channel.Domain.observable_trace_depends_only_on_membership : ∀ {Msg Obs : Type} (X : Minidregg.Theory.Channel.Domain Msg Obs), Minidregg.Theory.Channel.PayloadHidden X.S → Minidregg.Theory.Channel.ConstantEmission X.em → ∀ (pol : Minidregg.Theory.Channel.RelayPolicy) (τ₁ τ₂ : Minidregg.Theory.Channel.Traffic Msg) (p : Minidregg.Theory.Channel.Presences) (me ticks : ℕ), Minidregg.Theory.Channel.Domain.trace (X.wireTick pol τ₁ p) ticks = Minidregg.Theory.Channel.Domain.trace (X.wireTick pol τ₂ p) ticks ∧ Minidregg.Theory.Channel.Domain.trace (X.relayTick τ₁ p) ticks = Minidregg.Theory.Channel.Domain.trace (X.relayTick τ₂ p) ticks ∧ Minidregg.Theory.Channel.Domain.trace (X.operatorTick τ₁ p) ticks = Minidregg.Theory.Channel.Domain.trace (X.operatorTick τ₂ p) ticks ∧ Minidregg.Theory.Channel.Domain.trace (X.witnessTick τ₁ p) ticks = Minidregg.Theory.Channel.Domain.trace (X.witnessTick τ₂ p) ticks ∧ Minidregg.Theory.Channel.Domain.trace (X.memberTick pol τ₁ p me) ticks = Minidregg.Theory.Channel.Domain.trace (X.memberTick pol τ₂ p me) ticks
S def Minidregg.Theory.Channel.Domain.operatorTick : {Msg Obs : Type} → Minidregg.Theory.Channel.Domain Msg Obs → Minidregg.Theory.Channel.Traffic Msg → Minidregg.Theory.Channel.Presences → ℕ → Minidregg.Theory.Channel.Domain.RelayTick Obs × List Bool #3377684131
S theorem Minidregg.Theory.Channel.Domain.posObs_presence_invariant : ∀ {Msg Obs : Type} (X : Minidregg.Theory.Channel.Domain Msg Obs), Minidregg.Theory.Channel.FillHidden X.S X.prf → ∀ (τ : Minidregg.Theory.Channel.Traffic Msg) (p₁ p₂ : Minidregg.Theory.Channel.Presences), X.PresenceAgreesAtDutyTicks p₁ p₂ → ∀ (k : ℕ) {ρ : ℕ}, ρ < X.sched.n → X.cellObs (X.sched.assembleAt X.prf (X.epochOf k) (X.tickOf k) (X.received τ p₁ k) ρ).1 = X.cellObs (X.sched.assembleAt X.prf (X.epochOf k) (X.tickOf k) (X.received τ p₂ k) ρ).1
S theorem Minidregg.Theory.Channel.Domain.posObs_run : ∀ {Msg Obs : Type} (X : Minidregg.Theory.Channel.Domain Msg Obs) (τ : Minidregg.Theory.Channel.Traffic Msg) (p : Minidregg.Theory.Channel.Presences) (k : ℕ) {ρ : ℕ}, ρ < X.sched.n → (fun x => (X.cellObs x.1, x.2)) (X.sched.assembleAt X.prf (X.epochOf k) (X.tickOf k) (X.received τ p k) ρ) = match X.emittedObs τ p k ρ with | Option.some x => (x.2.2, Minidregg.Theory.Channel.Source.holder x.1) | Option.none => ({ header := X.hdr k ρ, len := X.sched.profile.C, body := X.S.observe (X.hdr k ρ) (Minidregg.Theory.Channel.fit X.sched.profile.bodyLen (X.prf (X.hdr k ρ))) }, Minidregg.Theory.Channel.Source.fill)
