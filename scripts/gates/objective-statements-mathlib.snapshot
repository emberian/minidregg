S theorem Minidregg.Kernel.GenericSimplexAuditProjection.ProjectedNetwork.identity : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GenericSimplexAuditProjection.ProjectedNetwork c faulty net → ∀ party < c.parties, party ∉ faulty → (net.localState party).self = party
S ctor Minidregg.Kernel.GenericSimplexAuditProjection.ProjectedNetwork.mk : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, (∀ party < c.parties, party ∉ faulty → (net.localState party).self = party) → (∀ party < c.parties, party ∉ faulty → Minidregg.Kernel.GenericSimplexLocal.OwnedAudit (net.localState party)) → (∀ party < c.parties, party ∉ faulty → Minidregg.Kernel.GenericSimplexAuditProjection.project party net.audit = (net.localState party).audit) → Minidregg.Kernel.GenericSimplexAuditProjection.ProjectedNetwork c faulty net
