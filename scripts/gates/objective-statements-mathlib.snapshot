S theorem Minidregg.Theory.PlanBinding.footprint_extra_only_disjoint : ∀ {L : Minidregg.Theory.Store.Layout} {Root : Type y} (rootOf : Minidregg.Theory.Store.Store L → Root) {s₀ s : Minidregg.Theory.Store.Store L} {fp : Minidregg.Theory.PlanBinding.Footprint L}, Minidregg.Theory.PlanBinding.Footprint.Holds s₀ fp → Minidregg.Theory.PlanBinding.Footprint.admit s fp = Except.ok () → rootOf s ≠ rootOf s₀ → (∃ a, s a ≠ s₀ a) ∧ ∀ (a : Minidregg.Theory.Store.Address L), s a ≠ s₀ a → a ∉ fp.addresses
