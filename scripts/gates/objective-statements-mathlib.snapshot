S theorem Minidregg.Kernel.GenericSimplexVAInvariant.commit_ready_core_same : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f t u v : ℕ} {x : Minidregg.Kernel.GenericSimplex.Block} {a : Minidregg.Kernel.GenericSimplex.Argument}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) (2 * f + 1) → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster u v Minidregg.Kernel.GenericSimplex.Kind.ready a (2 * f + 1) → a = Option.some x
S theorem Minidregg.Kernel.GenericSimplexVAInvariant.committed_excludes_disable : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f t u p q v : ℕ} {x : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → p ∉ faulty → q ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.commit p v x → tr u = Minidregg.Kernel.GenericSimplex.AuditEvent.disable q v → False
S theorem Minidregg.Kernel.GenericSimplexVAInvariant.committed_excludes_other_prepare : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f t u p q v : ℕ} {x y : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → p ∉ faulty → q ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.commit p v x → tr u = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare q v y → y = x
