S theorem Minidregg.Compiler.DurableLogTags.verifyTags_carried : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (tags : List (List UInt8)), tags.length ≤ records.length → Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) tags = Except.ok () → ∀ (i : ℕ) (hi : i < tags.length), ∃ carried, Minidregg.Compiler.DurableHistory.trailerCarried tags[i] = Option.some carried ∧ carried.chain = Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records) ∧ tags[i] = Minidregg.Compiler.DurableHistory.trailer key (height + i + 1) carried
