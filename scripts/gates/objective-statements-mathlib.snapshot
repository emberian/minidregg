S theorem Minidregg.Kernel.World.run_createReads : ∀ {R : Minidregg.Kernel.World.Registry} {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)), Minidregg.Theory.Store.Patch.run s (List.map (fun c => Minidregg.Theory.Store.Op.read Minidregg.Kernel.World.SysSpace.retired c.1 Option.none) cs) = s
S theorem Minidregg.Kernel.World.run_debits_at : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (lanes : List Minidregg.Theory.ResourceCost.Lane) (charge avail : Minidregg.Theory.ResourceCost.Charge) (l : Minidregg.Theory.ResourceCost.Lane), (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.debits lanes charge avail)) ⟨Minidregg.Kernel.World.SysSpace.allowance, l⟩ = if l ∈ lanes then Option.some (avail l - charge l) else s ⟨Minidregg.Kernel.World.SysSpace.allowance, l⟩
S theorem Minidregg.Kernel.World.run_debits_ne : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (lanes : List Minidregg.Theory.ResourceCost.Lane) (charge avail : Minidregg.Theory.ResourceCost.Charge) (a : Minidregg.Theory.Store.Address (Minidregg.Kernel.World.sysLayout TxId D)), a.fst ≠ Minidregg.Kernel.World.SysSpace.allowance → (Minidregg.Theory.Store.Patch.run s (Minidregg.Kernel.World.debits lanes charge avail)) a = s a
S theorem Minidregg.Kernel.World.run_parentAllocs_mem : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (rows : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.CellId)), (List.map Prod.fst rows).Nodup → ∀ (c room : Minidregg.Kernel.World.CellId), (c, room) ∈ rows → (Minidregg.Theory.Store.Patch.run s (List.map (fun row => Minidregg.Theory.Store.Op.allocate Minidregg.Kernel.World.SysSpace.parent row.1 row.2) rows)) ⟨Minidregg.Kernel.World.SysSpace.parent, c⟩ = Option.some room
S theorem Minidregg.Kernel.World.run_parentAllocs_ne : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (rows : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.CellId)) (a : Minidregg.Theory.Store.Address (Minidregg.Kernel.World.sysLayout TxId D)), a.fst ≠ Minidregg.Kernel.World.SysSpace.parent → (Minidregg.Theory.Store.Patch.run s (List.map (fun row => Minidregg.Theory.Store.Op.allocate Minidregg.Kernel.World.SysSpace.parent row.1 row.2) rows)) a = s a
S theorem Minidregg.Kernel.World.run_parentAllocs_other : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (rows : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.CellId)), ∀ c ∉ List.map Prod.fst rows, (Minidregg.Theory.Store.Patch.run s (List.map (fun row => Minidregg.Theory.Store.Op.allocate Minidregg.Kernel.World.SysSpace.parent row.1 row.2) rows)) ⟨Minidregg.Kernel.World.SysSpace.parent, c⟩ = s ⟨Minidregg.Kernel.World.SysSpace.parent, c⟩
S theorem Minidregg.Kernel.World.run_retireAllocs_at : ∀ {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (s : Minidregg.Theory.Store.Store (Minidregg.Kernel.World.sysLayout TxId D)) (rs : List Minidregg.Kernel.World.CellId) (c : Minidregg.Kernel.World.CellId), (Minidregg.Theory.Store.Patch.run s (List.map (fun c => Minidregg.Theory.Store.Op.allocate Minidregg.Kernel.World.SysSpace.retired c ()) rs)) ⟨Minidregg.Kernel.World.SysSpace.retired, c⟩ = if c ∈ rs then Option.some () else s ⟨Minidregg.Kernel.World.SysSpace.retired, c⟩
