S def Minidregg.Kernel.ReceiptContinuity.Valid : Minidregg.Kernel.ReceiptContinuity.Query → Minidregg.Kernel.ReceiptContinuity.Extension → Prop := fun query extension => extension.identity = query.identity ∧ extension.startPoint = query.start ∧ query.start.height ≤ query.target.height ∧ extension.endPoint.height = Min.min (query.start.height + Minidregg.Kernel.ReceiptContinuity.maxSuffix) query.target.height ∧ extension.suffix.length = extension.endPoint.height - extension.startPoint.height ∧ extension.suffix.length ≤ Minidregg.Kernel.ReceiptContinuity.maxSuffix ∧ extension.complete = Decidable.decide (extension.endPoint.height = query.target.height) ∧ (extension.endPoint.height = query.target.height → extension.endPoint.worldRoot = query.target.worldRoot) ∧ (extension.startPoint.height = extension.endPoint.height → extension.startPoint = extension.endPoint) ∧ Minidregg.Kernel.ReceiptContinuity.chainAfterDigests extension.startChain extension.suffix = extension.endChain ∧ Minidregg.Kernel.ReceiptContinuity.opens extension.startPoint extension.startChain extension.fromSiblings = Bool.true ∧ Minidregg.Kernel.ReceiptContinuity.opens extension.endPoint extension.endChain extension.toSiblings = Bool.true
