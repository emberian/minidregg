S theorem Minidregg.Theory.ResourceBirth.allocate_success_created : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → ∀ request ∈ requests, after.slots request.cellId = Minidregg.Theory.CellRegistry.CellSlot.present request.cell
S theorem Minidregg.Theory.ResourceBirth.allocate_success_distinct : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → (List.map Minidregg.Theory.CellRegistry.CreateRequest.cellId requests).Nodup
S theorem Minidregg.Theory.ResourceBirth.allocate_success_fresh : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → ∀ request ∈ requests, request.cellId ∉ before.used
S theorem Minidregg.Theory.ResourceBirth.allocate_success_post : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → after = Minidregg.Theory.ResourceBirth.inserted registry before requests
S theorem Minidregg.Theory.ResourceBirth.allocate_success_used : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (requests : List (Minidregg.Theory.CellRegistry.CreateRequest registry)), Minidregg.Theory.ResourceBirth.allocate registry before requests = Except.ok after → after.used = before.used ∪ (List.map Minidregg.Theory.CellRegistry.CreateRequest.cellId requests).toFinset
S theorem Minidregg.Theory.ResourceBirth.create_success_iff : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before after : Minidregg.Theory.CellRegistry.Directory CellId registry) (request : Minidregg.Theory.CellRegistry.CreateRequest registry), Minidregg.Theory.CellRegistry.create registry before request = Except.ok after ↔ before.slots request.cellId = Minidregg.Theory.CellRegistry.CellSlot.absent ∧ request.cellId ∉ before.used ∧ request.expectedPreRoot = Minidregg.Theory.CellRegistry.CellSlot.root registry Minidregg.Theory.CellRegistry.CellSlot.absent ∧ after = Minidregg.Theory.CellRegistry.Directory.insert registry before request.cellId request.cell
S theorem Minidregg.Theory.ResourceBirth.duplicate_birth_refused : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (before : Minidregg.Theory.CellRegistry.Directory CellId registry) (first second : Minidregg.Theory.CellRegistry.CreateRequest registry), second.cellId = first.cellId → before.slots first.cellId = Minidregg.Theory.CellRegistry.CellSlot.absent → first.cellId ∉ before.used → first.expectedPreRoot = Minidregg.Theory.CellRegistry.CellSlot.root registry Minidregg.Theory.CellRegistry.CellSlot.absent → Minidregg.Theory.ResourceBirth.allocate registry before [first, second] = Except.error Minidregg.Theory.CellRegistry.RejectReason.duplicateCreate
S theorem Minidregg.Theory.ResourceBirth.empty_birth_succeeds : ∀ {Root : Type uRoot} {CellId : Type uCell} [inst : DecidableEq Root] [inst_1 : DecidableEq CellId] (registry : Minidregg.Theory.CellRegistry.TypeRegistry Root) (cellId : CellId) (cell : Minidregg.Theory.CellRegistry.PackedCell registry), Minidregg.Theory.ResourceBirth.allocate registry (Minidregg.Theory.CellRegistry.Directory.empty registry) [{ cellId := cellId, expectedPreRoot := Minidregg.Theory.CellRegistry.CellSlot.root registry Minidregg.Theory.CellRegistry.CellSlot.absent, cell := cell }] = Except.ok (Minidregg.Theory.CellRegistry.Directory.insert registry (Minidregg.Theory.CellRegistry.Directory.empty registry) cellId cell)
