S def Minidregg.Theory.ResourceBirth.AuthorityGrant.ForBirth : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.AuthorityGrant → Minidregg.Theory.ResourceBirth.BirthItem registry → Prop := fun {registry} grant item => grant.NativeForBirth item ∨ grant.PolicyControlForBirth item
