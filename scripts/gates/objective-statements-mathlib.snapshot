S def Minidregg.Selvage.GameSlotBound : Prop := ∀ (r : Minidregg.Selvage.Reduction) (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (Z : Set (Minidregg.Selvage.Stmt r)) (εrbr : ℝ → ℝ), ∀ δ ∈ Set.Ioo 0 r.δstar, 0 ≤ εrbr δ → (∀ (i : Fin r.k), ∀ st ∈ Z, rbr.err i st δ ≤ εrbr δ) → ∀ (s t : ℕ) (P : Minidregg.Selvage.SrProver r s) (j : Fin t), Minidregg.Selvage.uniformProb ((Fin t → r.Chal) × (Fin r.k → r.Chal)) (Minidregg.Selvage.HitBad rbr Z δ P j) ≤ εrbr δ
S def Minidregg.Selvage.HasMutualCorrelatedAgreement : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [inst : Field F] → {ℓ : ℕ} → Minidregg.Selvage.ProximityGenerator F ℓ → Submodule F (ι → F) → ℝ → (ℝ → ℝ) → Prop := fun {ι} [Fintype ι] {F} [Field F] {ℓ} G C Bstar errstar => ∀ (f : Fin ℓ → ι → F) (δ : ℝ), 0 < δ → δ < 1 - Bstar → G.pr (Minidregg.Selvage.MutualCAFailure C δ f) ≤ errstar δ
