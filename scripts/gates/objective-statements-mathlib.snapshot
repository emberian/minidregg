S theorem Minidregg.Kernel.Seats.applyOperations_deregisterAccount : ∀ (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (operations : List Minidregg.Theory.CanonicalResourceKernel.Operation) (book : Minidregg.Theory.CanonicalResourceKernel.Book), Minidregg.Theory.CanonicalResourceKernel.applyOperations (book.deregisterAccount account) operations = (Minidregg.Theory.CanonicalResourceKernel.applyOperations book operations).deregisterAccount account
