S theorem Minidregg.Kernel.WorldRootCache.ofEntries_good_from : ∀ {K V D : Type} [inst : DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (E : ℕ → D) (es₀ rest : List (K × V)) (t : Minidregg.Kernel.WorldRootCache.Tree K V D), Minidregg.Kernel.WorldRootCache.Good S E (Minidregg.Kernel.WorldRoot.slotsOf S.ix es₀) S.depth [] t → Minidregg.Kernel.WorldRootCache.Good S E (Minidregg.Kernel.WorldRoot.slotsOf S.ix (es₀ ++ rest)) S.depth [] (List.foldl (fun t e => Minidregg.Kernel.WorldRootCache.insertWrite S E t e.1 (Option.some e.2)) t rest)
S theorem Minidregg.Kernel.WorldRootCache.ofEntries_root : ∀ {K V D : Type} [inst : DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (E : ℕ → D), (∀ (i : ℕ), E i = Minidregg.Kernel.WorldRoot.empties S i) → ∀ (es : List (K × V)), Minidregg.Kernel.WorldRootCache.Tree.digest S E S.depth (Minidregg.Kernel.WorldRootCache.ofEntries S E es) = S.root (Minidregg.Kernel.WorldRoot.slotsOf S.ix es)
S theorem Minidregg.Kernel.WorldRootCache.set_good : ∀ {K V D : Type} [DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (E : ℕ → D) (f : Option (K × V) → Option (K × V)) (m : Minidregg.Theory.AuthMap.Map K V) (i : ℕ) (bits p : List Bool) (t : Minidregg.Kernel.WorldRootCache.Tree K V D), bits.length = i → Minidregg.Kernel.WorldRootCache.Good S E m i p t → Minidregg.Kernel.WorldRootCache.Good S E (Minidregg.Kernel.WorldRootCache.update m (p ++ bits) f) i p (Minidregg.Kernel.WorldRootCache.Tree.set S E f i bits t)
S theorem Minidregg.Kernel.WorldRootCache.slotsOf_eq_of_lastVal : ∀ {K C : Type} [inst : DecidableEq K] (ix : K → List Bool) {es es' : List (K × C)}, Minidregg.Kernel.WorldRootCache.KeysInjective ix es → (∀ (k : K), Minidregg.Kernel.WorldRootCache.lastVal es k = Minidregg.Kernel.WorldRootCache.lastVal es' k) → Minidregg.Kernel.WorldRoot.slotsOf ix es = Minidregg.Kernel.WorldRoot.slotsOf ix es'
