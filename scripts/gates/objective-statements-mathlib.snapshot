S theorem Minidregg.Kernel.Seats.activity_end_closes_seats : ∀ {world next : Minidregg.Kernel.Seats.World} {height record : ℕ} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeHeld world height record = Except.ok (next, batch) → (∀ seat ∈ Minidregg.Kernel.Seats.heldOpen world height record, ∀ after ∈ next.seats, after.account ≠ seat.account) ∧ (∀ seat ∈ Minidregg.Kernel.Seats.heldOpen world height record, seat.account ∉ next.book.accounts) ∧ Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), next.book.totalAsset asset = world.book.totalAsset asset
