S theorem Minidregg.Kernel.World.classify_conflict : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {i : ℕ} {t t' : Minidregg.Kernel.World.Turn R TxId Ev D}, log[i]? = Option.some t → t'.txId = t.txId → H.turnDigest t ≠ H.turnDigest t' → Minidregg.Kernel.World.classify H W t' = Minidregg.Kernel.World.Resubmission.conflict i
S theorem Minidregg.Kernel.World.classify_fresh : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {t : Minidregg.Kernel.World.Turn R TxId Ev D}, (∀ t' ∈ log, t'.txId ≠ t.txId) → Minidregg.Kernel.World.classify H W t = Minidregg.Kernel.World.Resubmission.fresh
S theorem Minidregg.Kernel.World.classify_replay : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {i : ℕ} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, log[i]? = Option.some t → Minidregg.Kernel.World.classify H W t = Minidregg.Kernel.World.Resubmission.replay i
