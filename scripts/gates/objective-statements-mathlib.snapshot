S def Minidregg.Selvage.AcceptsFalse : {F : Type} → [inst : Field F] → {v : ℕ} → (ℕ → Polynomial F) → (ℕ → Polynomial F) → F → F → (Fin v → F) → Prop := fun {F} [Field F] {v} prover honest H S r => (∀ i < v, Polynomial.eval 0 (prover i) + Polynomial.eval 1 (prover i) = Minidregg.Selvage.scChain H prover (Minidregg.Selvage.chalOf r) i) ∧ Minidregg.Selvage.scChain H prover (Minidregg.Selvage.chalOf r) v = Minidregg.Selvage.scChain S honest (Minidregg.Selvage.chalOf r) v ∧ H ≠ S
S def Minidregg.Selvage.AdaptiveAcceptsFalse : {F : Type} → [inst : Field F] → {v : ℕ} → ((ℕ → F) → ℕ → Polynomial F) → ((ℕ → F) → ℕ → Polynomial F) → F → F → (Fin v → F) → Prop := fun {F} [Field F] {v} prover honest H S r => Minidregg.Selvage.AcceptsFalse (prover (Minidregg.Selvage.chalOf r)) (honest (Minidregg.Selvage.chalOf r)) H S r
S def Minidregg.Selvage.AdaptiveUnionBound : (F : Type) → [Field F] → [Fintype F] → ℕ → ℕ → Prop := fun F [Field F] [Fintype F] v d => ∀ (bad : (Fin v → F) → Fin v → Finset F), (∀ (i : Fin v) (r r' : Fin v → F), (∀ (j : Fin v), ↑j < ↑i → r j = r' j) → bad r i = bad r' i) → (∀ (r : Fin v → F) (i : Fin v), (bad r i).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => ∃ i, r i ∈ bad r i) ≤ ↑v * (↑d / ↑(Fintype.card F))
S def Minidregg.Selvage.AffineInCoord : {F : Type u_1} → [CommRing F] → {m : ℕ} → ((Fin m → F) → F) → Fin m → Prop := fun {F} [CommRing F] {m} g i => ∀ (x : Fin m → F) (t : F), g (Function.update x i t) = (1 - t) * g (Function.update x i 0) + t * g (Function.update x i 1)
S def Minidregg.Selvage.AgreesOn : {ι : Type u_1} → {F : Type u_2} → Finset ι → (ι → F) → (ι → F) → Prop := fun {ι} {F} S f u => ∀ x ∈ S, f x = u x
S theorem Minidregg.Selvage.AgreesOn.mono : ∀ {ι : Type u_1} {F : Type u_2} {S T : Finset ι} {f u : ι → F}, S ⊆ T → Minidregg.Selvage.AgreesOn T f u → Minidregg.Selvage.AgreesOn S f u
