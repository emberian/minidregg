S theorem Minidregg.Kernel.WorldRootCache.write_eq_update : ∀ {K V D : Type} [inst : DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (m : Minidregg.Theory.AuthMap.Map K V) (k : K) (v : Option V), Minidregg.Theory.AuthMap.write S.ix m k v = Minidregg.Kernel.WorldRootCache.update m (S.ix k) fun occupant => Minidregg.Theory.AuthMap.slotAfter occupant k v
