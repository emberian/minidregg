S theorem Minidregg.Compiler.LawLeaf.narrowed_congr : ∀ (fields : Option (Finset Minidregg.Theory.TypedAuthorization.CellField)) (law : Minidregg.Pred.Pred) {o₁ n₁ o₂ n₂ : Minidregg.Pred.State}, Minidregg.Compiler.LawLeaf.Agree (Minidregg.Compiler.LawLeaf.slotCovered fields) o₁ o₂ → Minidregg.Compiler.LawLeaf.Agree (Minidregg.Compiler.LawLeaf.slotCovered fields) n₁ n₂ → Minidregg.Compiler.LawLeaf.narrowed fields law o₁ n₁ = Minidregg.Compiler.LawLeaf.narrowed fields law o₂ n₂
S theorem Minidregg.Compiler.LawLeaf.narrowed_fails : ∀ (fields : Option (Finset Minidregg.Theory.TypedAuthorization.CellField)) (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (leaf : Minidregg.Compiler.LawLeaf), Minidregg.Compiler.LawLeaf.narrowed fields law old new = Option.some leaf → law.subterm leaf.path = Option.some leaf.clause ∧ leaf.clause.isLeaf = Bool.true ∧ Minidregg.Pred.eval leaf.clause old new = Bool.false
S theorem Minidregg.Compiler.LawLeaf.narrowed_none : ∀ (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Compiler.LawLeaf.narrowed Option.none law old new = Minidregg.Compiler.LawLeaf.of law old new
