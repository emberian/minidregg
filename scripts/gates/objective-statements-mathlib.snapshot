S def Minidregg.Kernel.AnswerSlot.decideDelivery : Minidregg.Kernel.AnswerSlot.Slot → Minidregg.Theory.TypedAuthorization.Digest → ℕ → Minidregg.Kernel.AnswerSlot.Decision → Except Minidregg.Kernel.AnswerSlot.Refusal Minidregg.Kernel.AnswerSlot.Slot #308394245
S theorem Minidregg.Kernel.AnswerSlot.decideDelivery_single : ∀ {slot decided : Minidregg.Kernel.AnswerSlot.Slot} {message : Minidregg.Theory.TypedAuthorization.Digest} {height : ℕ} {decision : Minidregg.Kernel.AnswerSlot.Decision}, Minidregg.Kernel.AnswerSlot.decideDelivery slot message height decision = Except.ok decided → slot.decider = Minidregg.Kernel.AnswerSlot.Decider.delivery message ∧ slot.phase = Minidregg.Kernel.AnswerSlot.Phase.opened ∧ decision ≠ Minidregg.Kernel.AnswerSlot.Decision.expired ∧ decided = { name := slot.name, activity := slot.activity, decider := slot.decider, deadline := slot.deadline, phase := Minidregg.Kernel.AnswerSlot.Phase.decided decision height, queued := [] }
S theorem Minidregg.Kernel.AnswerSlot.decideDelivery_subject_refused : ∀ (slot : Minidregg.Kernel.AnswerSlot.Slot) (subject : Minidregg.Theory.TypedAuthorization.SubjectId) (message : Minidregg.Theory.TypedAuthorization.Digest) (height : ℕ) (decision : Minidregg.Kernel.AnswerSlot.Decision), slot.decider = Minidregg.Kernel.AnswerSlot.Decider.subject subject → ∃ reason, Minidregg.Kernel.AnswerSlot.decideDelivery slot message height decision = Except.error reason
S theorem Minidregg.Kernel.AnswerSlot.decide_delivery_refused : ∀ (slot : Minidregg.Kernel.AnswerSlot.Slot) (message : Minidregg.Theory.TypedAuthorization.Digest) (subject : Minidregg.Theory.TypedAuthorization.SubjectId) (height : ℕ) (decision : Minidregg.Kernel.AnswerSlot.Decision), slot.decider = Minidregg.Kernel.AnswerSlot.Decider.delivery message → ∃ reason, Minidregg.Kernel.AnswerSlot.decide slot subject height decision = Except.error reason
S theorem Minidregg.Kernel.AnswerSlot.decide_single_decider : ∀ {slot decided : Minidregg.Kernel.AnswerSlot.Slot} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {height : ℕ} {decision : Minidregg.Kernel.AnswerSlot.Decision}, Minidregg.Kernel.AnswerSlot.decide slot subject height decision = Except.ok decided → slot.decider = Minidregg.Kernel.AnswerSlot.Decider.subject subject ∧ slot.phase = Minidregg.Kernel.AnswerSlot.Phase.opened ∧ height ≤ slot.deadline ∧ decided = { name := slot.name, activity := slot.activity, decider := slot.decider, deadline := slot.deadline, phase := Minidregg.Kernel.AnswerSlot.Phase.decided decision height, queued := slot.queued } ∧ decision ≠ Minidregg.Kernel.AnswerSlot.Decision.expired
S theorem Minidregg.Kernel.AnswerSlot.decided_refuses : ∀ (slot : Minidregg.Kernel.AnswerSlot.Slot), (∃ prior when, slot.phase = Minidregg.Kernel.AnswerSlot.Phase.decided prior when) → ∀ (subject : Minidregg.Theory.TypedAuthorization.SubjectId) (other : Minidregg.Kernel.AnswerSlot.Decision) (now : ℕ), Minidregg.Kernel.AnswerSlot.decide slot subject now other = Except.error Minidregg.Kernel.AnswerSlot.Refusal.notOpen ∧ Minidregg.Kernel.AnswerSlot.expire slot now = Except.error Minidregg.Kernel.AnswerSlot.Refusal.notOpen
