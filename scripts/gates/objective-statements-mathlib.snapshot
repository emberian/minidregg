S theorem Minidregg.Kernel.World.fold_append : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g : Minidregg.Kernel.World.World R TxId D) (l₁ l₂ : List (Minidregg.Kernel.World.Turn R TxId Ev D)), Minidregg.Kernel.World.fold H g (l₁ ++ l₂) = (Minidregg.Kernel.World.fold H g l₁).bind fun w => Minidregg.Kernel.World.fold H w l₂
S theorem Minidregg.Kernel.World.fold_cons : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g : Minidregg.Kernel.World.World R TxId D) (t : Minidregg.Kernel.World.Turn R TxId Ev D) (log : List (Minidregg.Kernel.World.Turn R TxId Ev D)), Minidregg.Kernel.World.fold H g (t :: log) = (Minidregg.Kernel.World.World.step H g t).bind fun w => Minidregg.Kernel.World.fold H w log
S theorem Minidregg.Kernel.World.fold_eq_some_iff : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g : Minidregg.Kernel.World.World R TxId D) (log : List (Minidregg.Kernel.World.Turn R TxId Ev D)) (W : Minidregg.Kernel.World.World R TxId D), Minidregg.Kernel.World.fold H g log = Option.some W ↔ Minidregg.Kernel.World.Reaches H g log W
S theorem Minidregg.Kernel.World.fold_head : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)} {h0 : ℕ} {r0 : D}, g.head = Option.some (h0, r0) → Minidregg.Kernel.World.fold H g log = Option.some W → W.head = Option.some (h0 + log.length, Minidregg.Kernel.World.logChain H r0 log)
S theorem Minidregg.Kernel.World.fold_nil : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g : Minidregg.Kernel.World.World R TxId D), Minidregg.Kernel.World.fold H g [] = Option.some g
S theorem Minidregg.Kernel.World.fold_snoc : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g : Minidregg.Kernel.World.World R TxId D) (l : List (Minidregg.Kernel.World.Turn R TxId Ev D)) (t : Minidregg.Kernel.World.Turn R TxId Ev D), Minidregg.Kernel.World.fold H g (l ++ [t]) = (Minidregg.Kernel.World.fold H g l).bind fun w => Minidregg.Kernel.World.World.step H w t
S theorem Minidregg.Kernel.World.fold_spent_monotone : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {n : D}, g.spent n = Option.some () → W.spent n = Option.some ()
S theorem Minidregg.Kernel.World.fold_txId_unique : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {g W : Minidregg.Kernel.World.World R TxId D} {log : List (Minidregg.Kernel.World.Turn R TxId Ev D)}, Minidregg.Kernel.World.Genesis H g → Minidregg.Kernel.World.fold H g log = Option.some W → ∀ {i j : ℕ} {ti tj : Minidregg.Kernel.World.Turn R TxId Ev D}, log[i]? = Option.some ti → log[j]? = Option.some tj → ti.txId = tj.txId → i = j
