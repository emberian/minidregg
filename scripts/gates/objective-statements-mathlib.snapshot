S def Minidregg.Pred.objectivePin : List ℕ → Minidregg.Pred.Pred #2919494984
S theorem Minidregg.Pred.objectivePin_refuses_unclaimed : ∀ (artifacts : List ℕ) (old new : Minidregg.Pred.State), new.get Minidregg.Pred.objectiveArtifactSlot = Option.some (-1) → Minidregg.Pred.eval (Minidregg.Pred.objectivePin artifacts) old new = Bool.false
S theorem Minidregg.Pred.objectivePin_teeth : Minidregg.Pred.eval (Minidregg.Pred.objectivePin [7]) { slots := [] } { slots := [(Minidregg.Pred.objectiveArtifactSlot, 7)] } = Bool.true ∧ Minidregg.Pred.eval (Minidregg.Pred.objectivePin [8]) { slots := [] } { slots := [(Minidregg.Pred.objectiveArtifactSlot, 7)] } = Bool.false ∧ Minidregg.Pred.eval (Minidregg.Pred.objectivePin [7, 8]) { slots := [] } { slots := [(Minidregg.Pred.objectiveArtifactSlot, -1), (Minidregg.Pred.objectiveArtifactSlot, 7)] } = Bool.false
