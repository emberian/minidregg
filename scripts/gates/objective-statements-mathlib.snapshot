S inductive Minidregg.Theory.PrivacyPortal : Type u_1 → Type u_2 → Type u_3 → Type u_4 → Type (max (max (max u_1 u_2) u_3) u_4)
S def Minidregg.Theory.PrivacyPortal.PreservesObservation : {Source : Type u_1} → {Target : Type u_2} → {SourceObserver : Type u_3} → {TargetObserver : Type u_4} → {SourcePrincipal : Type u_5} → {TargetPrincipal : Type u_6} → {SourcePublic : Type u_7} → {SourceExecution : Type u_8} → {SourceMetadata : Type u_9} → {TargetPublic : Type u_10} → {TargetExecution : Type u_11} → {TargetMetadata : Type u_12} → Minidregg.Theory.PrivacyPortal Source Target SourceObserver TargetObserver → Minidregg.Theory.PrivacyProfile Source SourceObserver SourcePrincipal SourcePublic SourceExecution SourceMetadata → Minidregg.Theory.PrivacyProfile Target TargetObserver TargetPrincipal TargetPublic TargetExecution TargetMetadata → Prop := fun {Source} {Target} {SourceObserver} {TargetObserver} {SourcePrincipal} {TargetPrincipal} {SourcePublic} {SourceExecution} {SourceMetadata} {TargetPublic} {TargetExecution} {TargetMetadata} portal sourceProfile targetProfile => ∀ (observer : SourceObserver) (left right : Source), sourceProfile.ObserverEquivalent observer left right → targetProfile.ObserverEquivalent (portal.mapObserver observer) (portal.run left) (portal.run right)
S def Minidregg.Theory.PrivacyPortal.comp : {A : Type u_1} → {B : Type u_2} → {C : Type u_3} → {OA : Type u_4} → {OB : Type u_5} → {OC : Type u_6} → Minidregg.Theory.PrivacyPortal B C OB OC → Minidregg.Theory.PrivacyPortal A B OA OB → Minidregg.Theory.PrivacyPortal A C OA OC #1915976979
