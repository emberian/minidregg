S def Minidregg.Compiler.lowerL : {F : Type} → [Field F] → Minidregg.Compiler.CompilerProfile → Minidregg.Pred.PredList → ℕ → List (Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Minidregg.Compiler.Wire)) × Minidregg.Compiler.ConstraintSystem F Minidregg.Compiler.Wire #1648685878
S theorem Minidregg.Compiler.lowerL_complete : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile) (ps : Minidregg.Pred.PredList) (i : ℕ) (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F), (∀ (j : ℕ), i ≤ j → ∀ (path : List ℕ) (k : ℕ), A (j :: path) k = Minidregg.Compiler.witL profile ps i old new (j :: path) k) → Minidregg.Compiler.supportedL profile ps = Bool.true → Minidregg.Compiler.inputsInRangeL profile ps old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lowerL profile ps i).2
S theorem Minidregg.Compiler.lowerL_forced : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ (ps : Minidregg.Pred.PredList) (i : ℕ) (old new : Minidregg.Pred.State) (A : List ℕ → ℕ → F), Minidregg.Compiler.castInjOn F (0 :: (Minidregg.Compiler.litsL ps ++ Minidregg.Compiler.stateVals old ++ Minidregg.Compiler.stateVals new ++ Minidregg.Compiler.digestsL ps new)) → Minidregg.Compiler.supportedL profile ps = Bool.true → Minidregg.Compiler.inputsInRangeL profile ps old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lowerL profile ps i).2 → List.map (Minidregg.Compiler.eval (Minidregg.Compiler.stepAsg old new A)) (Minidregg.Compiler.lowerL profile ps i).1 = List.map (fun q => if Minidregg.Pred.eval q old new = Bool.true then 1 else 0) ps.toList
S theorem Minidregg.Compiler.lower_complete : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {p : Minidregg.Pred.Pred} {old new : Minidregg.Pred.State}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf p old new) → Minidregg.Compiler.supported profile p = Bool.true → Minidregg.Compiler.inputsInRange profile p old new = Bool.true → Minidregg.Pred.eval p old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new (Minidregg.Compiler.wit profile p old new)) (Minidregg.Compiler.lower profile p)
S theorem Minidregg.Compiler.lower_correct : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {p : Minidregg.Pred.Pred} {old new : Minidregg.Pred.State}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf p old new) → Minidregg.Compiler.supported profile p = Bool.true → Minidregg.Compiler.inputsInRange profile p old new = Bool.true → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile p)) ↔ Minidregg.Pred.eval p old new = Bool.true)
S theorem Minidregg.Compiler.lower_eqSlots_correct : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {a b : Minidregg.Pred.Slot} {old new : Minidregg.Pred.State}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf (Minidregg.Pred.Pred.eqSlots a b) old new) → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile (Minidregg.Pred.Pred.eqSlots a b))) ↔ ∃ x, new.get a = Option.some x ∧ new.get b = Option.some x)
S theorem Minidregg.Compiler.lower_hashEq_binds : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {v : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {old new : Minidregg.Pred.State}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf (Minidregg.Pred.Pred.hashEq v b c) old new) → ∀ {o : Minidregg.Pred.HashEqDigest.Opening}, o.Admissible → new.get c = Option.some (Minidregg.Pred.HashEqDigest.digestWith Minidregg.Pred.HashEqDigest.deployed o) → ∀ (A : List ℕ → ℕ → F), Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile (Minidregg.Pred.Pred.hashEq v b c)) → Minidregg.Pred.hashEqOpening new v b c = Option.some o ∨ Minidregg.Theory.HashBytes.Collision Minidregg.Pred.HashEqDigest.deployed
S theorem Minidregg.Compiler.lower_hashEq_correct : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {v : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {old new : Minidregg.Pred.State}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf (Minidregg.Pred.Pred.hashEq v b c) old new) → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile (Minidregg.Pred.Pred.hashEq v b c))) ↔ ∃ o, Minidregg.Pred.hashEqOpening new v b c = Option.some o ∧ new.get c = Option.some (Minidregg.Pred.HashEqDigest.digestWith Minidregg.Pred.HashEqDigest.deployed o))
S theorem Minidregg.Compiler.lower_leSlotsOff_correct : ∀ {F : Type} [inst : Field F] [DecidableEq F] {width : ℕ}, (Minidregg.Compiler.CompilerProfile.scalar width).Admissible F → ∀ {a b : Minidregg.Pred.Slot} {c : ℤ} {old new : Minidregg.Pred.State}, (∀ (x y : ℤ), new.get a = Option.some x → new.get b = Option.some y → -2 ^ width ≤ y + c - x ∧ y + c - x < 2 ^ width) → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower (Minidregg.Compiler.CompilerProfile.scalar width) (Minidregg.Pred.Pred.leSlotsOff a b c))) ↔ ∃ x y, new.get a = Option.some x ∧ new.get b = Option.some y ∧ x ≤ y + c)
S theorem Minidregg.Compiler.lower_leSlotsOff_disabled_refuses : ∀ {F : Type} [inst : Field F] (a b : Minidregg.Pred.Slot) (c : ℤ) (asg : Minidregg.Compiler.Wire → F), ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.lower Minidregg.Compiler.CompilerProfile.disabled (Minidregg.Pred.Pred.leSlotsOff a b c))
S theorem Minidregg.Compiler.lower_leSlots_correct : ∀ {F : Type} [inst : Field F] [DecidableEq F] {width : ℕ}, (Minidregg.Compiler.CompilerProfile.scalar width).Admissible F → ∀ {a b : Minidregg.Pred.Slot} {old new : Minidregg.Pred.State}, (∀ (x y : ℤ), new.get a = Option.some x → new.get b = Option.some y → -2 ^ width ≤ y - x ∧ y - x < 2 ^ width) → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower (Minidregg.Compiler.CompilerProfile.scalar width) (Minidregg.Pred.Pred.leSlots a b))) ↔ ∃ x y, new.get a = Option.some x ∧ new.get b = Option.some y ∧ x ≤ y)
S theorem Minidregg.Compiler.lower_leSlots_disabled_refuses : ∀ {F : Type} [inst : Field F] (a b : Minidregg.Pred.Slot) (asg : Minidregg.Compiler.Wire → F), ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.lower Minidregg.Compiler.CompilerProfile.disabled (Minidregg.Pred.Pred.leSlots a b))
S theorem Minidregg.Compiler.lower_le_disabled_refuses : ∀ {F : Type} [inst : Field F] (s : Minidregg.Pred.Slot) (v : ℤ) (asg : Minidregg.Compiler.Wire → F), ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.lower Minidregg.Compiler.CompilerProfile.disabled (Minidregg.Pred.Pred.le s v))
S theorem Minidregg.Compiler.lower_monotone_disabled_refuses : ∀ {F : Type} [inst : Field F] (s : Minidregg.Pred.Slot) (asg : Minidregg.Compiler.Wire → F), ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.lower Minidregg.Compiler.CompilerProfile.disabled (Minidregg.Pred.Pred.monotone s))
S theorem Minidregg.Compiler.lower_sound : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {p : Minidregg.Pred.Pred} {old new : Minidregg.Pred.State} {A : List ℕ → ℕ → F}, Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf p old new) → Minidregg.Compiler.supported profile p = Bool.true → Minidregg.Compiler.inputsInRange profile p old new = Bool.true → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile p) → Minidregg.Pred.eval p old new = Bool.true
S theorem Minidregg.Compiler.lower_subsumes_boolGadget : ∀ {F : Type} [inst : Field F] [DecidableEq F] (profile : Minidregg.Compiler.CompilerProfile), profile.Admissible F → ∀ {old new : Minidregg.Pred.State} {s : Minidregg.Pred.Slot} {x : ℤ}, new.get s = Option.some x → Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf (Minidregg.Compiler.boolPol s) old new) → ((∃ A, Minidregg.Compiler.systemAccepts (Minidregg.Compiler.stepAsg old new A) (Minidregg.Compiler.lower profile (Minidregg.Compiler.boolPol s))) ↔ Minidregg.Compiler.accepts (fun x_1 => ↑x) (Minidregg.Compiler.boolGadget ()))
