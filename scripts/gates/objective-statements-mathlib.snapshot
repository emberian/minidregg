S theorem Minidregg.Kernel.GeneralSimplexReachability.known_eq_committed : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f v : ℕ} {b c : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → Minidregg.Kernel.GeneralSimplexReachability.KnownValue tr faulty v b → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty v c → b = c
S theorem Minidregg.Kernel.GeneralSimplexReachability.known_parent : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f v : ℕ} {b : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → faulty.card ≤ f → 0 < v → Minidregg.Kernel.GeneralSimplexReachability.KnownValue tr faulty v b → ∃ previous < v, Minidregg.Kernel.GeneralSimplexReachability.KnownValue tr faulty previous (List.dropLast b) ∧ ∀ (skipped : ℕ), previous < skipped → skipped < v → ∃ t, ∃ p ∉ faulty, tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.disable p skipped
S theorem Minidregg.Kernel.GeneralSimplexReachability.known_zero : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ} {b : Minidregg.Kernel.GenericSimplex.Block}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → Minidregg.Kernel.GeneralSimplexReachability.KnownValue tr faulty 0 b → b = []
S theorem Minidregg.Kernel.GeneralSimplexReachability.local_output_attestations_committed : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f view : ℕ} {block : Minidregg.Kernel.GenericSimplex.Block}, faulty.card ≤ f → Minidregg.Kernel.GeneralSimplexReachability.LocalCommitOutputAttestations tr roster faulty f view block → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty view block
