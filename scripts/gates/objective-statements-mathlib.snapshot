S theorem private Minidregg.Kernel.ContentResource.resolveRange_congr : ∀ (earlier later : Minidregg.Kernel.ContentResource.ContentStore) (document : Minidregg.Theory.Hyperdocument.DocumentId) (range : Minidregg.Theory.Hyperdocument.StableRange), Minidregg.Theory.Hyperdocument.lookup later Minidregg.Theory.Hyperdocument.Namespace.runs range.start.run = Minidregg.Theory.Hyperdocument.lookup earlier Minidregg.Theory.Hyperdocument.Namespace.runs range.start.run → (∀ (run : Minidregg.Theory.Hyperdocument.Value Minidregg.Theory.Hyperdocument.Namespace.runs), Minidregg.Theory.Hyperdocument.lookup earlier Minidregg.Theory.Hyperdocument.Namespace.runs range.start.run = Option.some run → ∀ atom ∈ run.atoms, Minidregg.Theory.Hyperdocument.lookup later Minidregg.Theory.Hyperdocument.Namespace.atoms atom = Minidregg.Theory.Hyperdocument.lookup earlier Minidregg.Theory.Hyperdocument.Namespace.atoms atom) → Minidregg.Kernel.ContentResource.resolveRange later document range = Minidregg.Kernel.ContentResource.resolveRange earlier document range
S theorem private Minidregg.Kernel.ContentResource.resolveRange_slots : ∀ (store : Minidregg.Kernel.ContentResource.ContentStore) (document : Minidregg.Theory.Hyperdocument.DocumentId) (range : Minidregg.Theory.Hyperdocument.StableRange) (atoms : List Minidregg.Theory.Hyperdocument.AtomId), Minidregg.Kernel.ContentResource.resolveRange store document range = Minidregg.Kernel.ContentResource.RangeResolution.slots atoms → ∃ run, Minidregg.Theory.Hyperdocument.lookup store Minidregg.Theory.Hyperdocument.Namespace.runs range.start.run = Option.some run ∧ ∀ atom ∈ atoms, atom ∈ run.atoms
