S def Minidregg.Kernel.GeneralSimplexReachability.auditTrace : Minidregg.Kernel.GeneralSimplexReachability.Network → Minidregg.Kernel.GenericSimplexVAInvariant.Trace #893346541
S def Minidregg.Kernel.GeneralSimplexReachability.authenticDelivery : Minidregg.Kernel.GenericSimplex.Config → Finset ℕ → Minidregg.Kernel.GeneralSimplexReachability.Network → Minidregg.Kernel.GenericSimplex.Message → Prop := fun c faulty net m => m.sender < c.parties ∧ (m.sender ∈ faulty ∨ Minidregg.Kernel.GenericSimplex.AuditEvent.send m ∈ (net.localState m.sender).audit)
