S def Minidregg.Selvage.RelaxedMem : {Idx X A W : Type} → {n : ℕ} → (Idx → X → (Fin n → A) → W → Prop) → ℝ → Idx → X → (Fin n → A) → W → Prop := fun {Idx X A W} {n} R δ idx x y w => ∃ ystar, R idx x ystar w ∧ Minidregg.Selvage.fracHamming y ystar ≤ δ
S def Minidregg.Selvage.RoundBad : {r : Minidregg.Selvage.Reduction} → Minidregg.Selvage.RbrKnowledgeSoundness r → ℝ → Minidregg.Selvage.Stmt r → List (r.PMsg × r.Chal) → r.PMsg → r.Chal → Prop := fun {r} rbr δ st rs π ρ => ∃ w, rbr.kstate.state δ st { rounds := rs, pending := Option.some π } (rbr.extract st { rounds := rs ++ [(π, ρ)], pending := Option.none } w) = Bool.false ∧ rbr.kstate.state δ st { rounds := rs ++ [(π, ρ)], pending := Option.none } w = Bool.true
S theorem Minidregg.Selvage.SCRExample.adaptive_bound_fires : Minidregg.Selvage.uniformProb (Fin 1 → ZMod 5) (Minidregg.Selvage.AdaptiveAcceptsFalse (fun x x_1 => Polynomial.X) (fun x x_1 => 0) Minidregg.Selvage.CRSExample.evalC.target (Minidregg.Selvage.trueSum Minidregg.Selvage.CRSExample.evalC 0)) ≤ 1 / 5
