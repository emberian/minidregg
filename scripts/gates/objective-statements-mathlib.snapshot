S def Minidregg.Selvage.trivialProver : Minidregg.Selvage.SrProver Minidregg.Selvage.trivialReduction 0 #1119457483
S def Minidregg.Selvage.trivialRbr : Minidregg.Selvage.RbrKnowledgeSoundness Minidregg.Selvage.trivialReduction #490141699
S def Minidregg.Selvage.trivialReduction : Minidregg.Selvage.Reduction #3587023487
S def Minidregg.Selvage.trivialStmt : Minidregg.Selvage.Stmt Minidregg.Selvage.trivialReduction #2846200983
S def Minidregg.Selvage.trueSum : {ι : Type u_1} → [Fintype ι] → {F : Type} → [Field F] → Minidregg.Selvage.LinearConstraint ι F → (ι → F) → F #1529424940
S theorem Minidregg.Selvage.trueSum_eq_dotWt : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] (c : Minidregg.Selvage.LinearConstraint ι F) (f : ι → F), Minidregg.Selvage.trueSum c f = Minidregg.Selvage.dotWt c.wt f
S def Minidregg.Selvage.uniformProb : (C : Type) → [Fintype C] → (C → Prop) → ℝ #3461336335
S theorem Minidregg.Selvage.uniformProb_congr : ∀ {C : Type} [inst : Fintype C] {p q : C → Prop}, (∀ (c : C), p c ↔ q c) → Minidregg.Selvage.uniformProb C p = Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_coord_mem : ∀ {F : Type} [inst : Fintype F] {v : ℕ} (i : Fin v) (S : Finset F), (Minidregg.Selvage.uniformProb (Fin v → F) fun r => r i ∈ S) ≤ ↑S.card / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_coord_mem_prefix : ∀ {F : Type} [Field F] [inst : Fintype F] {v d : ℕ} (i : Fin v) (bad : (Fin v → F) → Finset F), (∀ (r r' : Fin v → F), (∀ (j : Fin v), ↑j < ↑i → r j = r' j) → bad r = bad r') → (∀ (r : Fin v → F), (bad r).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => r i ∈ bad r) ≤ ↑d / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_equiv : ∀ {A B : Type} [inst : Fintype A] [inst_1 : Fintype B] (e : A ≃ B) (p : B → Prop), (Minidregg.Selvage.uniformProb A fun a => p (e a)) = Minidregg.Selvage.uniformProb B p
S theorem Minidregg.Selvage.uniformProb_exists_le : ∀ {C : Type} [inst : Fintype C] {m : ℕ} (p : Fin m → C → Prop), (Minidregg.Selvage.uniformProb C fun c => ∃ i, p i c) ≤ ∑ i, Minidregg.Selvage.uniformProb C (p i)
S theorem Minidregg.Selvage.uniformProb_false : ∀ {C : Type} [inst : Fintype C] {p : C → Prop}, (∀ (c : C), ¬p c) → Minidregg.Selvage.uniformProb C p = 0
S theorem Minidregg.Selvage.uniformProb_le_one : ∀ {C : Type} [inst : Fintype C] (p : C → Prop), Minidregg.Selvage.uniformProb C p ≤ 1
S theorem Minidregg.Selvage.uniformProb_mem_finset : ∀ {F : Type} [inst : Fintype F] (S : Finset F), (Minidregg.Selvage.uniformProb F fun x => x ∈ S) = ↑S.card / ↑(Fintype.card F)
S theorem Minidregg.Selvage.uniformProb_mono : ∀ {C : Type} [inst : Fintype C] {p q : C → Prop}, (∀ (c : C), p c → q c) → Minidregg.Selvage.uniformProb C p ≤ Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_nonneg : ∀ {C : Type} [inst : Fintype C] (p : C → Prop), 0 ≤ Minidregg.Selvage.uniformProb C p
S theorem Minidregg.Selvage.uniformProb_or_le : ∀ {C : Type} [inst : Fintype C] (p q : C → Prop), (Minidregg.Selvage.uniformProb C fun c => p c ∨ q c) ≤ Minidregg.Selvage.uniformProb C p + Minidregg.Selvage.uniformProb C q
S theorem Minidregg.Selvage.uniformProb_prod_le : ∀ {A B : Type} [inst : Fintype A] [inst_1 : Fintype B] {p : A × B → Prop} {ε : ℝ}, 0 ≤ ε → (∀ (a : A), (Minidregg.Selvage.uniformProb B fun b => p (a, b)) ≤ ε) → Minidregg.Selvage.uniformProb (A × B) p ≤ ε
S theorem Minidregg.Selvage.uniformProb_pushforward_le : ∀ {C : Type} [inst : Fintype C] {W V : Type} [inst_1 : Fintype W] [inst_2 : Fintype V] {ε : ℝ}, 0 ≤ ε → ∀ (f : C → W → V) (G : V → C → Prop), (∀ (ρ : C) (v : V), ↑(Nat.card { w // f ρ w = v }) * ↑(Fintype.card V) = ↑(Fintype.card W)) → (∀ (v : V), Minidregg.Selvage.uniformProb C (G v) ≤ ε) → (Minidregg.Selvage.uniformProb (C × W) fun x => G (f x.1 x.2) x.1) ≤ ε
S theorem Minidregg.Selvage.uniformProb_roundBad_le : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {δ : ℝ}, δ ∈ Set.Ioo 0 r.δstar → ∀ (st : Minidregg.Selvage.Stmt r) (i : Fin r.k) {rs : List (r.PMsg × r.Chal)}, rs.length = ↑i → ∀ (π : r.PMsg), Minidregg.Selvage.uniformProb r.Chal (Minidregg.Selvage.RoundBad rbr δ st rs π) ≤ rbr.err i st δ
S theorem Minidregg.Selvage.unionBound_fixed : ∀ {F : Type} [Field F] [inst : Fintype F] {v d : ℕ} (bad : Fin v → Finset F), (∀ (i : Fin v), (bad i).card ≤ d) → (Minidregg.Selvage.uniformProb (Fin v → F) fun r => ∃ i, r i ∈ bad i) ≤ ↑v * (↑d / ↑(Fintype.card F))
S def Minidregg.Selvage.wAt : {r : Minidregg.Selvage.Reduction} → Minidregg.Selvage.RbrKnowledgeSoundness r → Minidregg.Selvage.Stmt r → List (r.PMsg × r.Chal) → r.W → ℕ → r.W #3984333500
S theorem Minidregg.Selvage.wAt_of_le : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (st : Minidregg.Selvage.Stmt r) (rounds : List (r.PMsg × r.Chal)) (w' : r.W) {i : ℕ}, rounds.length ≤ i → Minidregg.Selvage.wAt rbr st rounds w' i = w'
S theorem Minidregg.Selvage.wAt_of_lt : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) (st : Minidregg.Selvage.Stmt r) (rounds : List (r.PMsg × r.Chal)) (w' : r.W) {i : ℕ}, i < rounds.length → Minidregg.Selvage.wAt rbr st rounds w' i = rbr.extract st { rounds := List.take (i + 1) rounds, pending := Option.none } (Minidregg.Selvage.wAt rbr st rounds w' (i + 1))
S theorem Minidregg.Selvage.εrbr_nonneg_of_nonempty : ∀ {r : Minidregg.Selvage.Reduction} (rbr : Minidregg.Selvage.RbrKnowledgeSoundness r) {Z : Set (Minidregg.Selvage.Stmt r)}, Z.Nonempty → ∀ {εrbr : ℝ → ℝ}, (∀ (i : Fin r.k), ∀ st ∈ Z, ∀ δ ∈ Set.Ioo 0 r.δstar, rbr.err i st δ ≤ εrbr δ) → ∀ δ ∈ Set.Ioo 0 r.δstar, 0 ≤ εrbr δ
S inductive Minidregg.Theory.AcceptedCellEffect : {L : Minidregg.Theory.Store.Layout} → {M : Minidregg.Theory.CellState.Materializer L Minidregg.Theory.TypedAuthorization.Digest} → {Nullifier : Type y} → (family : Minidregg.Theory.SemanticEffectFamily L M Nullifier) → {portal : Minidregg.Theory.TypedAuthorization.Portal} → {authState : Minidregg.Theory.TypedAuthorization.AuthState} → {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} → Minidregg.Theory.TypedAuthorization.Request kind → Minidregg.Theory.CellState.Materialized M → (declaration : family.Declaration) → family.Outcome declaration → Type (max u v w y z)
