S theorem Minidregg.Compiler.lawDeniedFor_fails : ∀ (fields : Option (Finset Minidregg.Theory.TypedAuthorization.CellField)) (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (leaf : Minidregg.Compiler.LawLeaf), Minidregg.Compiler.Refusal.lawDeniedFor fields law old new = Minidregg.Compiler.Refusal.lawDenied (Option.some leaf) → law.subterm leaf.path = Option.some leaf.clause ∧ leaf.clause.isLeaf = Bool.true ∧ Minidregg.Pred.eval leaf.clause old new = Bool.false
S theorem Minidregg.Compiler.lawDeniedFor_none : ∀ (law : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval law old new = Bool.false → Minidregg.Compiler.Refusal.lawDeniedFor Option.none law old new = Minidregg.Compiler.Refusal.lawDenied (Minidregg.Compiler.LawLeaf.of law old new)
S theorem Minidregg.Compiler.lawInputRangeFor_hidden : ∀ (fields : Option (Finset Minidregg.Theory.TypedAuthorization.CellField)) (leaf : Minidregg.Compiler.LawLeaf), Minidregg.Compiler.LawLeaf.readsOnly (Minidregg.Compiler.LawLeaf.slotCovered fields) leaf.clause = Bool.false → Minidregg.Compiler.Refusal.lawInputRangeFor fields leaf = Minidregg.Compiler.Refusal.lawDeniedOutsideGrant
