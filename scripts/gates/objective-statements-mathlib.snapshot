S theorem Minidregg.Compiler.CanonicalPolicyAdmission.verifies_sound : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F}, config.verifies request witness = Bool.true → ∃ committed, config.registry.resolve request.policyId request.policyRevision = Option.some committed ∧ Minidregg.Pred.eval committed.record.predicate witness.oldState witness.newState = Bool.true
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.wrong_address_rejected : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {committed : Minidregg.Compiler.CanonicalPolicyAdmission.CommittedPolicy} (witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F), config.registry.resolve request.policyId request.policyRevision = Option.some committed → witness.address ≠ committed.address → config.verifies request witness = Bool.false
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.wrong_compiler_semantics_rejected : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} (witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F), request.semantics ≠ config.compilerProfile.semantics → config.verifies request witness = Bool.false
