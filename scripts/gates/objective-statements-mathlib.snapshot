S def Minidregg.Kernel.ObjectAudienceController.Bound : ℕ → ℕ → ℕ → Option Minidregg.Theory.ObjectAudience.State → Option Minidregg.Theory.ObjectAudience.State → Prop := fun object authorityRoot deviceRoot before after => Minidregg.Kernel.ObjectAudienceController.Valid object before after ∧ match before, after with | Option.none, Option.some state => state.authoritySnapshot = authorityRoot ∧ state.deviceSnapshot = deviceRoot | Option.some old, Option.some next => if old.mode = Minidregg.Theory.ObjectAudience.Mode.frozen ∧ next.mode = Minidregg.Theory.ObjectAudience.Mode.active then next.authoritySnapshot = authorityRoot ∧ next.deviceSnapshot = deviceRoot else True | x, x_1 => True
S def Minidregg.Kernel.ObjectAudienceController.Initial : ℕ → Minidregg.Theory.ObjectAudience.State → Prop := fun object state => state.object = object ∧ state.mode = Minidregg.Theory.ObjectAudience.Mode.active ∧ state.manifest ≠ 0
S def Minidregg.Kernel.ObjectAudienceController.Valid : ℕ → Option Minidregg.Theory.ObjectAudience.State → Option Minidregg.Theory.ObjectAudience.State → Prop := fun object before after => match before, after with | Option.none, Option.none => True | Option.none, Option.some state => Minidregg.Kernel.ObjectAudienceController.Initial object state | Option.some old, Option.none => False | Option.some old, Option.some next => old.object = object ∧ (next = old ∨ old.mode = Minidregg.Theory.ObjectAudience.Mode.active ∧ next = { object := old.object, epoch := old.epoch, parent := old.transition, transition := next.transition, audience := old.audience, devices := old.devices, history := old.history, manifest := old.manifest, mode := Minidregg.Theory.ObjectAudience.Mode.frozen, authoritySnapshot := old.authoritySnapshot, deviceSnapshot := old.deviceSnapshot } ∧ next.transition ≠ old.transition ∨ old.mode = Minidregg.Theory.ObjectAudience.Mode.frozen ∧ next = { object := old.object, epoch := old.epoch + 1, parent := old.parent, transition := old.transition, audience := next.audience, devices := next.devices, history := next.history, manifest := next.manifest, mode := Minidregg.Theory.ObjectAudience.Mode.active, authoritySnapshot := next.authoritySnapshot, deviceSnapshot := next.deviceSnapshot } ∧ next.manifest ≠ 0 ∧ next.manifest ≠ old.manifest)
S theorem Minidregg.Kernel.ObjectAudienceController.cannot_drop : ∀ (object : ℕ) (old : Minidregg.Theory.ObjectAudience.State), Minidregg.Kernel.ObjectAudienceController.check object (Option.some old) Option.none = Bool.false
