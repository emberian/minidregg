S def Minidregg.Kernel.LinkIndex.latestLinks : Minidregg.Kernel.DurableDataIntent.CellId → List Minidregg.Kernel.DurableReceiver.IntentRecord → List Minidregg.Kernel.LinkIndex.LinkKey #1419484396
S theorem Minidregg.Kernel.LinkIndex.latestLinks_snoc : ∀ (cell : Minidregg.Kernel.DurableDataIntent.CellId) (log : List Minidregg.Kernel.DurableReceiver.IntentRecord) (record : Minidregg.Kernel.DurableReceiver.IntentRecord), Minidregg.Kernel.LinkIndex.latestLinks cell (log ++ [record]) = match Minidregg.Kernel.LinkIndex.lastWrite cell record with | Option.some write => Minidregg.Kernel.LinkIndex.liveLinks write.canonicalPostBytes | Option.none => Minidregg.Kernel.LinkIndex.latestLinks cell log
