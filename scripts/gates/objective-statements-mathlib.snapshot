S theorem Minidregg.Compiler.DurableLogTags.verifyTags_ok_iff : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (tags : List (List UInt8)), tags.length ≤ records.length → (Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) tags = Except.ok () ↔ ∀ (i : ℕ) (hi : i < tags.length), ∃ root, tags[i] = Minidregg.Compiler.DurableCheckpointCodec.entryTag key (height + i + 1) (Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records)) root)
S theorem Minidregg.Compiler.DurableLogTags.verifyTags_refuses_at : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (pre post : List (List UInt8)) (stored : List UInt8), pre.length < records.length → (∀ (i : ℕ) (hi : i < pre.length), ∃ root, pre[i] = Minidregg.Compiler.DurableCheckpointCodec.entryTag key (height + i + 1) (Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records)) root) → (∀ (root : Minidregg.Theory.TypedAuthorization.Digest), stored ≠ Minidregg.Compiler.DurableCheckpointCodec.entryTag key (height + pre.length + 1) (Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (pre.length + 1) records)) root) → Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) (pre ++ stored :: post) = Except.error (Minidregg.Compiler.DurableLogTags.tagRefusal (height + pre.length + 1))
S theorem Minidregg.Compiler.DurableLogTags.verifyTags_refuses_head : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (pre : List (List UInt8)) (stored : List UInt8), pre.length + 1 = records.length → (∀ (i : ℕ) (hi : i < pre.length), ∃ root, pre[i] = Minidregg.Compiler.DurableCheckpointCodec.entryTag key (height + i + 1) (Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records)) root) → (∀ (root : Minidregg.Theory.TypedAuthorization.Digest), stored ≠ Minidregg.Compiler.DurableCheckpointCodec.entryTag key (height + records.length) (Minidregg.Compiler.DurableCheckpointCodec.chainAfter start records) root) → Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) (pre ++ [stored]) = Except.error (Minidregg.Compiler.DurableLogTags.tagRefusal (height + records.length))
