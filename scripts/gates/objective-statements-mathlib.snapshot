S theorem Minidregg.Kernel.JobMoney.griefing_cost_bounded : ∀ (split : ℕ) (j : Minidregg.Kernel.JobMoney.Job) (book : Minidregg.Theory.CanonicalResourceKernel.Book) (submitter asset fee : ℕ), j.state = 3 → j.price ≤ j.escrow → Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book (Minidregg.Kernel.JobMoney.truthFee submitter asset fee) → submitter ≠ asset → ((Minidregg.Kernel.JobMoney.truthFee submitter asset fee).apply book).balance submitter asset = book.balance submitter asset - Int.ofNat fee ∧ ((Minidregg.Kernel.JobMoney.truthFee submitter asset fee).apply book).totalAsset asset = book.totalAsset asset ∧ Minidregg.Kernel.JobMoney.payouts split j = Option.some { provider := j.price + j.bond, caller := j.escrow - j.price, retired := 0 }
