S def Minidregg.Kernel.LinkIndex.liveLinks : List UInt8 → List Minidregg.Kernel.LinkIndex.LinkKey #1391496902
S def Minidregg.Kernel.LinkIndex.lookup : {κ α : Type} → [DecidableEq κ] → List (κ × List α) → κ → List α #1832207310
S theorem Minidregg.Kernel.LinkIndex.lookup_addPair : ∀ (reverse : Minidregg.Kernel.LinkIndex.Reverse) (pair : Minidregg.Kernel.DurableDataIntent.CellId × Minidregg.Kernel.LinkIndex.Entry) (key : Minidregg.Kernel.LinkIndex.TargetKey), Minidregg.Kernel.LinkIndex.lookup (Minidregg.Kernel.LinkIndex.addPair reverse pair) key = if Minidregg.Kernel.LinkIndex.TargetKey.of pair.2.record.target = key then pair :: Minidregg.Kernel.LinkIndex.lookup reverse key else Minidregg.Kernel.LinkIndex.lookup reverse key
S theorem Minidregg.Kernel.LinkIndex.lookup_admitWrite : ∀ (height : ℕ) (acc : Minidregg.Kernel.LinkIndex.Sources × Bool) (write : Minidregg.Kernel.DurableDataIntent.DataWrite) (cell : Minidregg.Kernel.DurableDataIntent.CellId), Minidregg.Kernel.LinkIndex.lookup (Minidregg.Kernel.LinkIndex.admitWrite height acc write).1 cell = if write.cellId = cell then Minidregg.Kernel.LinkIndex.refresh (Minidregg.Kernel.LinkIndex.lookup acc.1 cell) height (Minidregg.Kernel.LinkIndex.liveLinks write.canonicalPostBytes) else Minidregg.Kernel.LinkIndex.lookup acc.1 cell
S theorem Minidregg.Kernel.LinkIndex.lookup_filter_ne : ∀ {κ α : Type} [inst : DecidableEq κ] (map : List (κ × List α)) {key key' : κ}, key ≠ key' → Minidregg.Kernel.LinkIndex.lookup (List.filter (fun entry => Decidable.decide (entry.1 ≠ key)) map) key' = Minidregg.Kernel.LinkIndex.lookup map key'
S theorem Minidregg.Kernel.LinkIndex.lookup_nil_or_mem : ∀ {κ α : Type} [inst : DecidableEq κ] (map : List (κ × List α)) (key : κ), Minidregg.Kernel.LinkIndex.lookup map key = [] ∨ (key, Minidregg.Kernel.LinkIndex.lookup map key) ∈ map
S theorem Minidregg.Kernel.LinkIndex.lookup_of_mem : ∀ {κ α : Type} [inst : DecidableEq κ] {map : List (κ × List α)}, (List.map Prod.fst map).Nodup → ∀ {pair : κ × List α}, pair ∈ map → Minidregg.Kernel.LinkIndex.lookup map pair.1 = pair.2
