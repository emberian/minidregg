S theorem private Minidregg.Kernel.World.getElem?_snoc : ∀ {α : Type} (l : List α) (t : α) (i : ℕ), (l ++ [t])[i]? = if i < l.length then l[i]? else if i = l.length then Option.some t else Option.none
S theorem private Minidregg.Pred.HashEqDigest.toNat_eq : ∀ {a b : ℤ}, 0 ≤ a → 0 ≤ b → a.toNat = b.toNat → a = b
S theorem private Minidregg.Pred.HashEqDigest.toNat_lt : ∀ {a : ℤ} {k : ℕ}, 0 ≤ a → a < ↑k → a.toNat < k
S theorem private Minidregg.Selvage.one_sub_half_rsDist_eq : ∀ {n dR : ℝ}, n ≠ 0 → 1 - (1 - (dR - 1) / n) / 2 = (n + dR - 1) / (2 * n)
S def private Minidregg.Theory.CanonicalResourceKernel.admissionConditions : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Theory.CanonicalResourceKernel.Operation → Prop := fun book operation => operation.posting.source ∈ book.accounts ∧ operation.posting.destination ∈ book.accounts ∧ (operation.isIssuerMint = Bool.true ∨ Int.ofNat operation.posting.amount ≤ book.balance operation.posting.source operation.posting.asset) ∧ match operation with | Minidregg.Theory.CanonicalResourceKernel.Operation.lease leaseId holder lessor asset rate epochs startsAt => 0 < epochs ∧ book.leases leaseId = Option.none | x => True
