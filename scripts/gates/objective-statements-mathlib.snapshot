S theorem Minidregg.Compiler.prod_ind : ∀ {F : Type} [inst : Field F] {α : Type} (l : List α) (f : α → Bool), (List.map (fun q => if f q = Bool.true then 1 else 0) l).prod = if l.all f = Bool.true then 1 else 0
S theorem Minidregg.Compiler.prod_one_sub_ind : ∀ {F : Type} [inst : Field F] {α : Type} (l : List α) (f : α → Bool), (List.map (fun x => 1 - x) (List.map (fun q => if f q = Bool.true then 1 else 0) l)).prod = if (l.all fun q => !f q) = Bool.true then 1 else 0
