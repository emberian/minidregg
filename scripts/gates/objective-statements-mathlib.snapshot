S theorem Minidregg.Kernel.World.meter_system : ∀ {R : Minidregg.Kernel.World.Registry} {TxId D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] {w : Minidregg.Kernel.World.World R TxId D} (l : Minidregg.Theory.ResourceCost.Lane), w.meter l = (w.system ⟨Minidregg.Kernel.World.SysSpace.allowance, l⟩).getD 0
S theorem Minidregg.Kernel.World.op_apply_allocate : ∀ {L : Minidregg.Theory.Store.Layout} (s : Minidregg.Theory.Store.Store L) (sp : L.Namespace) (k : L.Key sp) (v : L.Value sp), Minidregg.Theory.Store.Op.apply s (Minidregg.Theory.Store.Op.allocate sp k v) = s.set ⟨sp, k⟩ (Option.some v)
S theorem Minidregg.Kernel.World.op_apply_write : ∀ {L : Minidregg.Theory.Store.Layout} (s : Minidregg.Theory.Store.Store L) (sp : L.Namespace) (k : L.Key sp) (b a : L.Value sp), Minidregg.Theory.Store.Op.apply s (Minidregg.Theory.Store.Op.write sp k b a) = s.set ⟨sp, k⟩ (Option.some a)
