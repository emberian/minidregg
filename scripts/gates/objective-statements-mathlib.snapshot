S theorem Minidregg.Pred.evalWithAll_ofList : ∀ (O : Minidregg.Pred.Oracle) (l : List Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.evalWithAll O (Minidregg.Pred.PredList.ofList l) old new = l.all fun q => Minidregg.Pred.evalWith O q old new
