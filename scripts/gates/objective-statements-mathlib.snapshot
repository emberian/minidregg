S theorem Minidregg.Compiler.CanonicalPolicyAdmission.canonical_context_verifies_sound : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F} (context : Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext), config.stepBinding = Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepBinding.canonical context → config.verifies request witness = Bool.true → request.preStateRoot = context.preStateRoot ∧ request.effectsDigest = context.effectsDigest ∧ request.semantics = context.semantics ∧ ∃ committed, config.registry.resolve request.policyId request.policyRevision = Option.some committed ∧ Minidregg.Pred.eval committed.record.predicate context.oldState context.newState = Bool.true
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.canonical_step_matches_iff : ∀ {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} (context : Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext) (request : Minidregg.Theory.TypedAuthorization.Request kind) (oldState newState : Minidregg.Pred.State), (Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepBinding.canonical context).matches request oldState newState = Bool.true ↔ request.preStateRoot = context.preStateRoot ∧ request.effectsDigest = context.effectsDigest ∧ request.semantics = context.semantics ∧ oldState = context.oldState ∧ newState = context.newState
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.canonical_verifies_iff_eval : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {committed : Minidregg.Compiler.CanonicalPolicyAdmission.CommittedPolicy} {oldState newState : Minidregg.Pred.State}, config.registry.resolve request.policyId request.policyRevision = Option.some committed → committed.record.neutral = Bool.true → committed.record.policyId = request.policyId → committed.record.version = request.policyRevision → committed.record.domain = request.domain → committed.record.semantics = request.semantics → config.recordDigest committed.record = committed.address → config.stepBinding.matches request oldState newState = Bool.true → config.compilerProfile.compatible config.stepBinding = Bool.true → request.semantics = config.compilerProfile.semantics → Minidregg.Compiler.supported config.compilerProfile.compiler committed.record.predicate = Bool.true → Minidregg.Compiler.inputsInRange config.compilerProfile.compiler committed.record.predicate oldState newState = Bool.true → Minidregg.Compiler.castInjOn F (Minidregg.Compiler.intsOf committed.record.predicate oldState newState) → (config.verifies request (Minidregg.Compiler.CanonicalPolicyAdmission.canonicalWitness config.compilerProfile.compiler committed oldState newState) = Bool.true ↔ Minidregg.Pred.eval committed.record.predicate oldState newState = Bool.true)
S theorem Minidregg.Compiler.CanonicalPolicyAdmission.canonical_verifies_profile_bound : ∀ {F : Type} [inst : Field F] [inst_1 : DecidableEq F] {config : Minidregg.Compiler.CanonicalPolicyAdmission.CanonicalPolicyConfig F} {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} {request : Minidregg.Theory.TypedAuthorization.Request kind} {witness : Minidregg.Compiler.CanonicalPolicyAdmission.CompiledPolicyWitness F} (context : Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepContext), config.stepBinding = Minidregg.Compiler.CanonicalPolicyAdmission.PolicyStepBinding.canonical context → config.verifies request witness = Bool.true → ∃ descriptor, config.compilerProfile.descriptor? = Option.some descriptor ∧ request.semantics = descriptor.digest ∧ descriptor.compilerVersion = Minidregg.Compiler.CanonicalPolicyAdmission.compilerSemanticVersion ∧ CharP F descriptor.characteristic ∧ match descriptor.orderWidth with | Option.none => True | Option.some width => Minidregg.Compiler.PredOrder.NoWrap F width
