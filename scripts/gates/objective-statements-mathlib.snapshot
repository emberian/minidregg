S theorem Minidregg.Pred.firstFailingLeaf_none_iff_eval : ∀ (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.firstFailingLeaf p old new = Option.none ↔ Minidregg.Pred.eval p old new = Bool.true
S theorem Minidregg.Pred.firstFailingLeaf_some_leaf : ∀ (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (path : List ℕ), Minidregg.Pred.firstFailingLeaf p old new = Option.some path → ∃ q, p.subterm path = Option.some q ∧ q.isLeaf = Bool.true ∧ Minidregg.Pred.eval q old new = Bool.false
S def Minidregg.Pred.hashEqCellSlot : Minidregg.Pred.Slot #2322854147
S def Minidregg.Pred.hashEqHolds : Minidregg.Theory.HashBytes.Hash → Minidregg.Pred.State → List Minidregg.Pred.Slot → Minidregg.Pred.Slot → Minidregg.Pred.Slot → Bool #3146613579
S theorem Minidregg.Pred.hashEqHolds_iff : ∀ (H : Minidregg.Theory.HashBytes.Hash) (s : Minidregg.Pred.State) (vs : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot), Minidregg.Pred.hashEqHolds H s vs b c = Bool.true ↔ ∃ o, Minidregg.Pred.hashEqOpening s vs b c = Option.some o ∧ s.get c = Option.some (Minidregg.Pred.HashEqDigest.digestWith H o)
S def Minidregg.Pred.hashEqOpening : Minidregg.Pred.State → List Minidregg.Pred.Slot → Minidregg.Pred.Slot → Minidregg.Pred.Slot → Option Minidregg.Pred.HashEqDigest.Opening #3830582507
S theorem Minidregg.Pred.hashEqOpening_eq_some : ∀ {s : Minidregg.Pred.State} {vs : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {o : Minidregg.Pred.HashEqDigest.Opening}, Minidregg.Pred.hashEqOpening s vs b c = Option.some o ↔ s.get Minidregg.Pred.hashEqCellSlot = Option.some o.cell ∧ s.getAll vs = Option.some o.values ∧ s.get b = Option.some o.blinder ∧ o.valueSlots = vs ∧ o.blinderSlot = b ∧ o.commitSlot = c ∧ o.Admissible
S theorem Minidregg.Pred.hashEq_absent_blinder_refused : ∀ (vs : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), new.get b = Option.none → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.false
S theorem Minidregg.Pred.hashEq_absent_cell_refused : ∀ (vs : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), new.get "request/target" = Option.none → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.false
S theorem Minidregg.Pred.hashEq_absent_value_refused : ∀ {v : Minidregg.Pred.Slot} {vs : List Minidregg.Pred.Slot}, v ∈ vs → ∀ (b c : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), new.get v = Option.none → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.false
S theorem Minidregg.Pred.hashEq_admits : ∀ (o : Minidregg.Pred.HashEqDigest.Opening), o.Admissible → ∀ (old new : Minidregg.Pred.State), new.get "request/target" = Option.some o.cell → new.getAll o.valueSlots = Option.some o.values → new.get o.blinderSlot = Option.some o.blinder → new.get o.commitSlot = Option.some (Minidregg.Pred.HashEqDigest.digestWith Minidregg.Pred.HashEqDigest.deployed o) → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq o.valueSlots o.blinderSlot o.commitSlot) old new = Bool.true
S theorem Minidregg.Pred.hashEq_binds_or_collides : ∀ {vs vs' : List Minidregg.Pred.Slot} {b c b' c' : Minidregg.Pred.Slot} {old new old' new' : Minidregg.Pred.State}, Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs' b' c') old' new' = Bool.true → new.get c = new'.get c' → (∃ o, Minidregg.Pred.hashEqOpening new vs b c = Option.some o ∧ Minidregg.Pred.hashEqOpening new' vs' b' c' = Option.some o) ∨ Minidregg.Theory.HashBytes.Collision Minidregg.Pred.HashEqDigest.deployed
S theorem Minidregg.Pred.hashEq_context_bound : ∀ {vs vs' : List Minidregg.Pred.Slot} {b c b' c' : Minidregg.Pred.Slot} {old new old' new' : Minidregg.Pred.State}, Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs' b' c') old' new' = Bool.true → new.get c = new'.get c' → new.get "request/target" ≠ new'.get "request/target" ∨ vs ≠ vs' ∨ b ≠ b' ∨ c ≠ c' → Minidregg.Theory.HashBytes.Collision Minidregg.Pred.HashEqDigest.deployed
S theorem Minidregg.Pred.hashEq_opens_every_field : ∀ {vs : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {old new : Minidregg.Pred.State}, Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true → ∀ v ∈ vs, (new.get v).isSome = Bool.true
S theorem Minidregg.Pred.hashEq_reveal_binds : ∀ {vs : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {old new old' new' : Minidregg.Pred.State}, Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old' new' = Bool.true → new.get c = new'.get c → new.getAll vs = new'.getAll vs ∧ new.get b = new'.get b ∨ Minidregg.Theory.HashBytes.Collision Minidregg.Pred.HashEqDigest.deployed
S theorem Minidregg.Pred.hashEq_reveal_binds_each : ∀ {vs : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {old new old' new' : Minidregg.Pred.State}, Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old' new' = Bool.true → new.get c = new'.get c → (∀ v ∈ vs, new.get v = new'.get v) ∨ Minidregg.Theory.HashBytes.Collision Minidregg.Pred.HashEqDigest.deployed
S theorem Minidregg.Pred.hashEq_reveal_binds_each.getAll_agree : ∀ {s s' : Minidregg.Pred.State} {vs : List Minidregg.Pred.Slot} {xs : List ℤ}, s.getAll vs = Option.some xs → s'.getAll vs = Option.some xs → ∀ {v : Minidregg.Pred.Slot}, v ∈ vs → s.get v = s'.get v
S theorem Minidregg.Pred.hashEq_sound : ∀ (vs : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.true ↔ ∃ cell xs r, new.get "request/target" = Option.some cell ∧ new.getAll vs = Option.some xs ∧ new.get b = Option.some r ∧ { cell := cell, valueSlots := vs, blinderSlot := b, commitSlot := c, values := xs, blinder := r }.Admissible ∧ new.get c = Option.some (Minidregg.Pred.HashEqDigest.digestWith Minidregg.Pred.HashEqDigest.deployed { cell := cell, valueSlots := vs, blinderSlot := b, commitSlot := c, values := xs, blinder := r })
S theorem Minidregg.Pred.hashEq_wide_blinder_refused : ∀ (vs : List Minidregg.Pred.Slot) (b c : Minidregg.Pred.Slot) (old new : Minidregg.Pred.State) (r : ℤ), new.get b = Option.some r → ¬(0 ≤ r ∧ r < 2 ^ 256) → Minidregg.Pred.eval (Minidregg.Pred.Pred.hashEq vs b c) old new = Bool.false
S theorem Minidregg.Pred.hiding_at_equality_is_a_collision : ∀ (H : Minidregg.Theory.HashBytes.Hash), (Minidregg.Pred.HashEqHiding H fun x1 x2 => x1 = x2) → Minidregg.Theory.HashBytes.Collision H
S theorem Minidregg.Pred.identity_not_hashEqHiding : ¬Minidregg.Pred.HashEqHiding id fun x1 x2 => x1 = x2
S def Minidregg.Pred.keystone : Prop := (∃ old new, Minidregg.Pred.eval Minidregg.Pred.demoPred old new = Bool.true) ∧ Minidregg.Pred.eval (Minidregg.Pred.Pred.monotone "x") Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.true ∧ Minidregg.Pred.eval (Minidregg.Pred.Pred.monotone "x") Minidregg.Pred.sX5 Minidregg.Pred.sX3 = Bool.false ∧ Minidregg.Pred.eval (Minidregg.Pred.Pred.witnessed { id := "vk-1" }) Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.false ∧ Minidregg.Pred.evalWith (fun x x_1 x_2 => Bool.true) (Minidregg.Pred.Pred.witnessed { id := "vk-1" }) Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.true
S theorem Minidregg.Pred.keystone_holds : Minidregg.Pred.keystone
S def Minidregg.Pred.leafWith : Minidregg.Pred.Oracle → Minidregg.Pred.Pred → Minidregg.Pred.State → Minidregg.Pred.State → Option (List ℕ) #4233130931
S def Minidregg.Pred.leafWithAll : Minidregg.Pred.Oracle → Minidregg.Pred.PredList → Minidregg.Pred.State → Minidregg.Pred.State → Option (List ℕ) #1094282909
S theorem Minidregg.Pred.leafWithAll_none_iff : ∀ (O : Minidregg.Pred.Oracle) (ps : Minidregg.Pred.PredList) (old new : Minidregg.Pred.State), Minidregg.Pred.leafWithAll O ps old new = Option.none ↔ Minidregg.Pred.evalWithAll O ps old new = Bool.true
S theorem Minidregg.Pred.leafWithAll_sound : ∀ (O : Minidregg.Pred.Oracle) (ps : Minidregg.Pred.PredList) (old new : Minidregg.Pred.State) (path : List ℕ), Minidregg.Pred.leafWithAll O ps old new = Option.some path → ∃ i rest q, path = i :: rest ∧ ps.subterm i rest = Option.some q ∧ q.isLeaf = Bool.true ∧ Minidregg.Pred.evalWith O q old new = Bool.false
S theorem Minidregg.Pred.leafWith_none_iff : ∀ (O : Minidregg.Pred.Oracle) (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.leafWith O p old new = Option.none ↔ Minidregg.Pred.evalWith O p old new = Bool.true
S theorem Minidregg.Pred.leafWith_sound : ∀ (O : Minidregg.Pred.Oracle) (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State) (path : List ℕ), Minidregg.Pred.leafWith O p old new = Option.some path → ∃ q, p.subterm path = Option.some q ∧ q.isLeaf = Bool.true ∧ Minidregg.Pred.evalWith O q old new = Bool.false
S theorem Minidregg.Pred.lengthHash_admits_any_reveal : ∀ {s s' : Minidregg.Pred.State} {vs : List Minidregg.Pred.Slot} {b c : Minidregg.Pred.Slot} {o o' : Minidregg.Pred.HashEqDigest.Opening}, Minidregg.Pred.hashEqOpening s vs b c = Option.some o → Minidregg.Pred.hashEqOpening s' vs b c = Option.some o' → o'.cell = o.cell → s'.get c = s.get c → Minidregg.Pred.hashEqHolds Minidregg.Pred.HashEqDigest.lengthHash s' vs b c = Minidregg.Pred.hashEqHolds Minidregg.Pred.HashEqDigest.lengthHash s vs b c
