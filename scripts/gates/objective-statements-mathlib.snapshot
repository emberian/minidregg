S theorem Minidregg.Kernel.AnswerSlot.decide_single_decider : ∀ {slot decided : Minidregg.Kernel.AnswerSlot.Slot} {subject : Minidregg.Theory.TypedAuthorization.SubjectId} {height : ℕ} {decision : Minidregg.Kernel.AnswerSlot.Decision}, Minidregg.Kernel.AnswerSlot.decide slot subject height decision = Except.ok decided → subject = slot.decider ∧ slot.phase = Minidregg.Kernel.AnswerSlot.Phase.opened ∧ height ≤ slot.deadline ∧ decided = { name := slot.name, activity := slot.activity, decider := slot.decider, deadline := slot.deadline, phase := Minidregg.Kernel.AnswerSlot.Phase.decided decision height } ∧ decision ≠ Minidregg.Kernel.AnswerSlot.Decision.expired
S theorem Minidregg.Kernel.AnswerSlot.decided_refuses : ∀ (slot : Minidregg.Kernel.AnswerSlot.Slot), (∃ prior when, slot.phase = Minidregg.Kernel.AnswerSlot.Phase.decided prior when) → ∀ (subject : Minidregg.Theory.TypedAuthorization.SubjectId) (other : Minidregg.Kernel.AnswerSlot.Decision) (now : ℕ), Minidregg.Kernel.AnswerSlot.decide slot subject now other = Except.error Minidregg.Kernel.AnswerSlot.Refusal.notOpen ∧ Minidregg.Kernel.AnswerSlot.expire slot now = Except.error Minidregg.Kernel.AnswerSlot.Refusal.notOpen
