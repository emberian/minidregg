S theorem private Minidregg.Compiler.eval_linFold : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (row : Fin w → F) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (l : List (Fin w)), Minidregg.Compiler.eval asg (List.foldr (fun j acc => Minidregg.Compiler.add' (Minidregg.Compiler.mul' (Minidregg.Compiler.cst (row j)) (state j)) acc) (Minidregg.Compiler.cst 0) l) = (List.map (fun j => row j * Minidregg.Compiler.eval asg (state j)) l).sum
