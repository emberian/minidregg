S theorem Minidregg.Kernel.World.admit_of : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D} {height : ℕ} {logRoot : D} {cells : Minidregg.Kernel.World.Cells R}, Minidregg.Kernel.World.Shaped t → w.head = Option.some (height, logRoot) → w.journal t.txId = Option.none → Minidregg.Kernel.World.turnCheck H w t height = Option.none → Minidregg.Theory.Store.Patch.ValidFrom w.system (Minidregg.Kernel.World.sysPatch H t height logRoot w.meter) → Minidregg.Kernel.World.applyCells w.cells t = Except.ok cells → Minidregg.Kernel.World.World.admit H w t = Except.ok { cells := cells, system := Minidregg.Theory.Store.Patch.run w.system (Minidregg.Kernel.World.sysPatch H t height logRoot w.meter) }
S theorem Minidregg.Kernel.World.admit_ok : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.admit H w t = Except.ok w' → Minidregg.Kernel.World.Shaped t ∧ ∃ height logRoot, w.head = Option.some (height, logRoot) ∧ w.journal t.txId = Option.none ∧ Minidregg.Theory.Store.Patch.ValidFrom w.system (Minidregg.Kernel.World.sysPatch H t height logRoot w.meter) ∧ Minidregg.Kernel.World.applyCells w.cells t = Except.ok w'.cells ∧ w'.system = Minidregg.Theory.Store.Patch.run w.system (Minidregg.Kernel.World.sysPatch H t height logRoot w.meter)
S theorem Minidregg.Kernel.World.admit_ok_turnCheck : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.admit H w t = Except.ok w' → ∃ height logRoot, w.head = Option.some (height, logRoot) ∧ Minidregg.Kernel.World.turnCheck H w t height = Option.none
S theorem Minidregg.Kernel.World.admit_retry_refused : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.step H w t = Option.some w' → Minidregg.Kernel.World.World.admit H w' t = Except.error Minidregg.Kernel.World.Reject.replayedTransaction
S def Minidregg.Kernel.World.applyCells : {R : Minidregg.Kernel.World.Registry} → {TxId Ev D : Type} → Minidregg.Kernel.World.Cells R → Minidregg.Kernel.World.Turn R TxId Ev D → Except Minidregg.Kernel.World.Reject (Minidregg.Kernel.World.Cells R) #3144697851
S theorem Minidregg.Kernel.World.applyCells_ok : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [DecidableEq D] {cells cells' : Minidregg.Kernel.World.Cells R} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.applyCells cells t = Except.ok cells' → ∃ c1 c2, Minidregg.Kernel.World.applyCreates cells t.creates = Except.ok c1 ∧ Minidregg.Kernel.World.applyLegs c1 t.legs = Except.ok c2 ∧ Minidregg.Kernel.World.applyRetires c2 t.retires = Except.ok cells'
S def Minidregg.Kernel.World.applyCreates : {R : Minidregg.Kernel.World.Registry} → Minidregg.Kernel.World.Cells R → List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId) → Except Minidregg.Kernel.World.Reject (Minidregg.Kernel.World.Cells R) #2651537338
S theorem Minidregg.Kernel.World.applyCreates_frame : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)}, Minidregg.Kernel.World.applyCreates cells cs = Except.ok cells' → ∀ x ∉ List.map Prod.fst cs, cells' x = cells x
S theorem Minidregg.Kernel.World.applyCreates_image_refused : ∀ {R : Minidregg.Kernel.World.Registry} (cells : Minidregg.Kernel.World.Cells R) (c : Minidregg.Kernel.World.CellId) (b : Minidregg.Kernel.World.Cell R) (p : Option Minidregg.Kernel.World.CellId) (rest : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)), cells c = Option.none → Minidregg.Kernel.World.roomPresent cells p = Bool.true → ¬Minidregg.Kernel.World.RomOnly b.store → Minidregg.Kernel.World.applyCreates cells ((c, b, p) :: rest) = Except.error (Minidregg.Kernel.World.Reject.imageNotRom c)
S theorem Minidregg.Kernel.World.applyCreates_mem : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)}, Minidregg.Kernel.World.applyCreates cells cs = Except.ok cells' → (List.map Prod.fst cs).Nodup → ∀ (c : Minidregg.Kernel.World.CellId) (b : Minidregg.Kernel.World.Cell R) (p : Option Minidregg.Kernel.World.CellId), (c, b, p) ∈ cs → cells c = Option.none ∧ cells' c = Option.some b
S theorem Minidregg.Kernel.World.applyCreates_missing_room : ∀ {R : Minidregg.Kernel.World.Registry} (cells : Minidregg.Kernel.World.Cells R) (c : Minidregg.Kernel.World.CellId) (b : Minidregg.Kernel.World.Cell R) (room : Minidregg.Kernel.World.CellId) (rest : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)), cells c = Option.none → cells room = Option.none → Minidregg.Kernel.World.applyCreates cells ((c, b, Option.some room) :: rest) = Except.error (Minidregg.Kernel.World.Reject.missingParent c room)
S theorem Minidregg.Kernel.World.applyCreates_present : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)}, Minidregg.Kernel.World.applyCreates cells cs = Except.ok cells' → ∀ (x : Minidregg.Kernel.World.CellId), cells' x ≠ Option.none → cells x ≠ Option.none ∨ x ∈ List.map Prod.fst cs
S theorem Minidregg.Kernel.World.applyCreates_romOnly : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)}, Minidregg.Kernel.World.applyCreates cells cs = Except.ok cells' → ∀ (c : Minidregg.Kernel.World.CellId) (b : Minidregg.Kernel.World.Cell R) (p : Option Minidregg.Kernel.World.CellId), (c, b, p) ∈ cs → Minidregg.Kernel.World.RomOnly b.store
S theorem Minidregg.Kernel.World.applyCreates_room : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {cs : List (Minidregg.Kernel.World.CellId × Minidregg.Kernel.World.Cell R × Option Minidregg.Kernel.World.CellId)}, Minidregg.Kernel.World.applyCreates cells cs = Except.ok cells' → ∀ (c : Minidregg.Kernel.World.CellId) (k : Minidregg.Kernel.World.Cell R) (room : Minidregg.Kernel.World.CellId), (c, k, Option.some room) ∈ cs → cells room ≠ Option.none ∨ room ∈ List.map Prod.fst cs
S def Minidregg.Kernel.World.applyLeg : {R : Minidregg.Kernel.World.Registry} → Minidregg.Kernel.World.Cells R → Minidregg.Kernel.World.Leg R → Except Minidregg.Kernel.World.Reject (Minidregg.Kernel.World.Cells R) #50248247
S theorem Minidregg.Kernel.World.applyLeg_ok : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {leg : Minidregg.Kernel.World.Leg R}, Minidregg.Kernel.World.applyLeg cells leg = Except.ok cells' → ∃ cell pre, cells leg.cell = Option.some cell ∧ cell.storeAt leg.kind = Option.some pre ∧ Minidregg.Theory.Store.Patch.ValidFrom pre leg.patch ∧ cells' = DFinsupp.update cells leg.cell (Option.some { kind := leg.kind, store := Minidregg.Theory.Store.Patch.run pre leg.patch })
S def Minidregg.Kernel.World.applyLegs : {R : Minidregg.Kernel.World.Registry} → Minidregg.Kernel.World.Cells R → List (Minidregg.Kernel.World.Leg R) → Except Minidregg.Kernel.World.Reject (Minidregg.Kernel.World.Cells R) #3441690717
S theorem Minidregg.Kernel.World.applyLegs_frame : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {legs : List (Minidregg.Kernel.World.Leg R)}, Minidregg.Kernel.World.applyLegs cells legs = Except.ok cells' → ∀ x ∉ List.map Minidregg.Kernel.World.Leg.cell legs, cells' x = cells x
S theorem Minidregg.Kernel.World.applyLegs_mem : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {legs : List (Minidregg.Kernel.World.Leg R)}, Minidregg.Kernel.World.applyLegs cells legs = Except.ok cells' → (List.map Minidregg.Kernel.World.Leg.cell legs).Nodup → ∀ leg ∈ legs, ∃ pre, ((cells leg.cell).bind fun x => x.storeAt leg.kind) = Option.some pre ∧ Minidregg.Theory.Store.Patch.ValidFrom pre leg.patch ∧ cells' leg.cell = Option.some { kind := leg.kind, store := Minidregg.Theory.Store.Patch.run pre leg.patch }
S theorem Minidregg.Kernel.World.applyLegs_present : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {legs : List (Minidregg.Kernel.World.Leg R)}, Minidregg.Kernel.World.applyLegs cells legs = Except.ok cells' → ∀ (x : Minidregg.Kernel.World.CellId), cells' x ≠ Option.none → cells x ≠ Option.none
S def Minidregg.Kernel.World.applyRetires : {R : Minidregg.Kernel.World.Registry} → Minidregg.Kernel.World.Cells R → List Minidregg.Kernel.World.CellId → Except Minidregg.Kernel.World.Reject (Minidregg.Kernel.World.Cells R) #2618867744
S theorem Minidregg.Kernel.World.applyRetires_frame : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {rs : List Minidregg.Kernel.World.CellId}, Minidregg.Kernel.World.applyRetires cells rs = Except.ok cells' → ∀ x ∉ rs, cells' x = cells x
S theorem Minidregg.Kernel.World.applyRetires_mem : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {rs : List Minidregg.Kernel.World.CellId}, Minidregg.Kernel.World.applyRetires cells rs = Except.ok cells' → rs.Nodup → ∀ c ∈ rs, (∃ cell, cells c = Option.some cell ∧ cell.store = 0) ∧ cells' c = Option.none
S theorem Minidregg.Kernel.World.applyRetires_present : ∀ {R : Minidregg.Kernel.World.Registry} {cells cells' : Minidregg.Kernel.World.Cells R} {rs : List Minidregg.Kernel.World.CellId}, Minidregg.Kernel.World.applyRetires cells rs = Except.ok cells' → ∀ (x : Minidregg.Kernel.World.CellId), cells' x ≠ Option.none → cells x ≠ Option.none
S theorem Minidregg.Kernel.World.cells_update_ne : ∀ {R : Minidregg.Kernel.World.Registry} (cells : Minidregg.Kernel.World.Cells R) {c x : Minidregg.Kernel.World.CellId} (v : Option (Minidregg.Kernel.World.Cell R)), x ≠ c → (DFinsupp.update cells c v) x = cells x
S theorem Minidregg.Kernel.World.cells_update_self : ∀ {R : Minidregg.Kernel.World.Registry} (cells : Minidregg.Kernel.World.Cells R) (c : Minidregg.Kernel.World.CellId) (v : Option (Minidregg.Kernel.World.Cell R)), (DFinsupp.update cells c v) c = v
S theorem Minidregg.Kernel.World.charge_is_patch_bytes : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.step H w t = Option.some w' → t.charge Minidregg.Theory.ResourceCost.Lane.storageBytes = Minidregg.Kernel.World.patchBytes H t
S theorem Minidregg.Kernel.World.charge_le_allowance : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.step H w t = Option.some w' → t.charge ≤ w.meter ∧ ∀ (l : Minidregg.Theory.ResourceCost.Lane), w'.meter l = w.meter l - t.charge l
