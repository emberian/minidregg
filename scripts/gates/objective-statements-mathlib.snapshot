S inductive Minidregg.Kernel.NativeHostGenesis.Config : Type
S def Minidregg.Kernel.NativeHostGenesis.Config.Valid : {F : Type} → [inst : Field F] → Minidregg.Compiler.CanonicalRuntimeProfile.Profile F → Minidregg.Kernel.NativeHostGenesis.Config → Prop := fun {F} [Field F] profile config => config.expectedSemantics = profile.semantics ∧ config.deployment.Valid ∧ config.enrollments ≠ [] ∧ (List.map (fun x => x.key.subject) config.enrollments).Nodup ∧ (List.map (fun x => x.key.keyId) config.enrollments).Nodup ∧ (List.map (fun x => x.key.publicKey) config.enrollments).Nodup ∧ (List.map (fun x => x.accountId) config.enrollments ++ [config.deployment.factoryId, config.deployment.resourceBookId, config.deployment.authorityCellId]).Nodup ∧ config.tariff.asset ∉ List.map (fun x => x.accountId) config.enrollments ∧ (config.factoryController.capabilityId :: List.flatMap (fun enrollment => [enrollment.spendCapabilityId, enrollment.controlCapabilityId, enrollment.factoryObserveCapabilityId]) config.enrollments ++ (Option.map (fun x => x.capabilityId) config.payObserver).toList ++ (Option.map (fun x => x.controlCapabilityId) config.payObserver).toList ++ (Option.map (fun x => x.enrolCapabilityId) config.payObserver).toList).Nodup ∧ config.factoryController.subject.value ∈ List.map (fun x => x.key.subject) config.enrollments ∧ (∀ observer ∈ config.payObserver, observer.subject.value ∈ List.map (fun x => x.key.subject) config.enrollments) ∧ profile.template.lifetime > 0 ∧ (∀ enrollment ∈ config.enrollments, enrollment.key.algorithm = Minidregg.Compiler.CredentialSignatureAdmission.ed25519Algorithm ∧ enrollment.key.publicKey.length = 32 ∧ enrollment.key.activeFrom ≤ Minidregg.Kernel.NativeHostGenesis.initialAuthorityRevision ∧ Minidregg.Kernel.NativeHostGenesis.initialAuthorityRevision ≤ enrollment.key.activeUntil) ∧ (List.map (fun x => x.subject.value) config.clockTickers).Nodup ∧ (∀ ticker ∈ config.clockTickers, ticker.subject.value ∈ List.map (fun x => x.key.subject) config.enrollments) ∧ config.factoryController.subject.value ∉ List.map (fun x => x.subject.value) config.clockTickers ∧ (List.map (fun x => x.capabilityId) config.clockTickers ++ config.factoryController.capabilityId :: List.flatMap (fun enrollment => [enrollment.spendCapabilityId, enrollment.controlCapabilityId, enrollment.factoryObserveCapabilityId]) config.enrollments ++ (Option.map (fun x => x.capabilityId) config.payObserver).toList ++ (Option.map (fun x => x.controlCapabilityId) config.payObserver).toList ++ (Option.map (fun x => x.enrolCapabilityId) config.payObserver).toList).Nodup
