S theorem Minidregg.Kernel.LinkIndex.backlinks_complete : ∀ (log : List Minidregg.Kernel.DurableReceiver.IntentRecord) (visible : Minidregg.Kernel.DurableDataIntent.CellId → Bool) (keys : List Minidregg.Kernel.LinkIndex.TargetKey) {cell : Minidregg.Kernel.DurableDataIntent.CellId} {key : Minidregg.Kernel.LinkIndex.LinkKey}, key ∈ Minidregg.Kernel.LinkIndex.latestLinks cell log → visible cell = Bool.true → Minidregg.Kernel.LinkIndex.TargetKey.of key.2.target ∈ keys → ∃ entry, entry.key = key ∧ (cell, entry) ∈ (Minidregg.Kernel.LinkIndex.ofRecords log).backlinks visible keys
S theorem Minidregg.Kernel.LinkIndex.backlinks_covered : ∀ (index : Minidregg.Kernel.LinkIndex.Index) (visible : Minidregg.Kernel.DurableDataIntent.CellId → Bool) (keys : List Minidregg.Kernel.LinkIndex.TargetKey) {pair : Minidregg.Kernel.DurableDataIntent.CellId × Minidregg.Kernel.LinkIndex.Entry}, pair ∈ index.backlinks visible keys → visible pair.1 = Bool.true
S theorem Minidregg.Kernel.LinkIndex.backlinks_sound : ∀ (log : List Minidregg.Kernel.DurableReceiver.IntentRecord) (visible : Minidregg.Kernel.DurableDataIntent.CellId → Bool) (keys : List Minidregg.Kernel.LinkIndex.TargetKey) {pair : Minidregg.Kernel.DurableDataIntent.CellId × Minidregg.Kernel.LinkIndex.Entry}, pair ∈ (Minidregg.Kernel.LinkIndex.ofRecords log).backlinks visible keys → visible pair.1 = Bool.true ∧ Minidregg.Kernel.LinkIndex.TargetKey.of pair.2.record.target ∈ keys ∧ pair.2.key ∈ Minidregg.Kernel.LinkIndex.latestLinks pair.1 log ∧ Minidregg.Kernel.PresenceIndex.Occurs (Minidregg.Kernel.LinkIndex.WroteLink pair.1 pair.2.key) log pair.2.height
