achine.encodeTerm t) = Option.some t) → (∀ {fuel : ℕ} {t : toMachine.Term} {o : toMachine.Output} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.ok o k → toMachine.run fuel t = Except.ok o ∧ toMachine.steps fuel t = k) → (∀ {fuel : ℕ} {t : toMachine.Term} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.crash k → Crash t) → (∀ {fuel : ℕ} {t : toMachine.Term} {k : ℕ}, toMachine.oracle fuel t = Minidregg.Theory.Eval.Ran.exhausted k → toMachine.run fuel t = Except.error Minidregg.Theory.Eval.Outcome.exhausted ∧ k = fuel) → (∀ (fuel : ℕ) (t : toMachine.Term), toMachine.runBytes fuel (toMachine.encodeTerm t) = Minidregg.Theory.Eval.Ran.toByteRun toMachine.encodeOutput (toMachine.oracle fuel t)) → (∀ (params : toMachine.Params), toMachine.decodeParams (toMachine.encodeParams params) = Option.some params) → (∀ {bytes : List UInt8} {params : toMachine.Params}, toMachine.decodeParams bytes = Option.some params → toMachine.encodeParams params = bytes) → (∀ {layout : List Minidregg.Compiler.NockProgramCodec.SampleSlot} {s s' : Minidregg.Kernel.NockProgramCell.Sample} {i : toMachine.Input}, toMachine.encodeSample layout s = Option.some i → toMachine.encodeSample layout s' = Option.some i → s = s') → (∀ {abi : Minidregg.Compiler.NockProgramCodec.Abi} {ctx : Minidregg.Kernel.NockProgramCell.Context} {targets : List ℕ} {read : ℕ → String → Option ℤ} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot}, toMachine.overMax read abi.sample = Option.some slot → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx targets read).bind (toMachine.encodeSample abi.sample) = Option.none) → (∀ {read read' : ℕ → String → Option ℤ} {slots : List Minidregg.Compiler.NockProgramCodec.SampleSlot}, (∀ s ∈ slots, read s.target s.slot = read' s.target s.slot) → toMachine.overMax read slots = toMachine.overMax read' slots) → (∀ {abi : Minidregg.Compiler.NockProgramCodec.Abi} {ctx ctx' : Minidregg.Kernel.NockProgramCell.Context} {targets : List ℕ} {read read' : ℕ → String → Option ℤ} {s s' : toMachine.Input} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot}, abi.context = Minidregg.Compiler.NockProgramCodec.ContextMode.pinned → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx targets read).bind (toMachine.encodeSample abi.sample) = Option.some s → (Minidregg.Kernel.NockProgramCell.sampleRecord abi ctx' targets read').bind (toMachine.encodeSample abi.sample) = Option.some s' → slot ∈ abi.sample → read slot.target slot.slot ≠ read' slot.target slot.slot → (∀ x ∈ abi.sample, x ≠ slot → read x.target x.slot = read' x.target x.slot) → s ≠ s' ∧ toMachine.staleField abi s' (toMachine.encodeInput s) = Option.some slot.key) → (∀ d ∈ toMachine.door, ∀ (state : toMachine.Output), d.decodeState (d.encodeState state) = Option.some state) → (∀ d ∈ toMachine.door, ∀ (stored : Option toMachine.Output) (event : ℕ) (ev : d.Event), d.eventOf (toMachine.encodeInput (d.pokeInput stored event ev)) = Option.some ev) → (∀ d ∈ toMachine.door, ∀ {stored stored' : Option toMachine.Output} {event event' : ℕ} {ev ev' : d.Event}, d.pokeInput stored event ev = d.pokeInput stored' event' ev' → stored = stored' ∧ event = event' ∧ ev = ev') → Minidregg.Compiler.Evaluator
