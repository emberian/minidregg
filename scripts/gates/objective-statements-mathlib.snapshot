S theorem Minidregg.Kernel.Door.keys_unique : ∀ {door : Minidregg.Compiler.NockProgramCodec.Door} {view : Minidregg.Kernel.Door.View} {encoded : ℕ} {decoded : List Minidregg.Theory.Eval.FieldWrite}, (List.map (fun w => (w.target, w.field)) (Minidregg.Kernel.Door.stateWrites door view encoded ++ decoded)).Nodup → ∀ {w : Minidregg.Theory.Eval.FieldWrite}, w ∈ Minidregg.Kernel.Door.stateWrites door view encoded ++ decoded → w.target = 0 ∧ w.field = door.state → w.value = ↑encoded
