S theorem Minidregg.Kernel.World.checkpoint_suffix : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) (g W_h : Minidregg.Kernel.World.World R TxId D) (log : List (Minidregg.Kernel.World.Turn R TxId Ev D)) (h : ℕ), Minidregg.Kernel.World.fold H g (List.take h log) = Option.some W_h → Minidregg.Kernel.World.fold H W_h (List.drop h log) = Minidregg.Kernel.World.fold H g log
