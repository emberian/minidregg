S theorem Minidregg.Kernel.PayObservation.decideObservations_ok : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {clock : Minidregg.Kernel.ClockCell.Clock} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {tip : Minidregg.Kernel.PayCell.ChainTip} {observations : List Minidregg.Kernel.PayObservation.Observation} {plan : Minidregg.Kernel.PayObservation.Plan}, Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → Minidregg.Kernel.PayCell.tariffOf store = Option.some plan.tariff ∧ plan.clock = clock ∧ plan.tariff.valid ∧ plan.clock.slot ≤ tip.slot ∧ ¬(observations = [] ∧ tip.slot < plan.clock.slot + plan.tariff.minTickSlots) ∧ (Minidregg.Kernel.PayObservation.transfers observations).Nodup ∧ Minidregg.Kernel.PayObservation.decideAll store plan.tariff tip observations = Except.ok plan.credits ∧ plan.tip = tip ∧ Minidregg.Theory.CanonicalResourceKernel.Batch.Admission book plan.batch
S theorem Minidregg.Kernel.PayObservation.decideObservations_tip : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {clock : Minidregg.Kernel.ClockCell.Clock} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {tip : Minidregg.Kernel.PayCell.ChainTip} {observations : List Minidregg.Kernel.PayObservation.Observation} {plan : Minidregg.Kernel.PayObservation.Plan}, Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → plan.tip = tip
S theorem Minidregg.Kernel.PayObservation.enrol_index_not_ordinary : ∀ {store : Minidregg.Kernel.PayCell.PayStore} {clock : Minidregg.Kernel.ClockCell.Clock} {book : Minidregg.Theory.CanonicalResourceKernel.Book} {tip : Minidregg.Kernel.PayCell.ChainTip} {observations : List Minidregg.Kernel.PayObservation.Observation} {plan : Minidregg.Kernel.PayObservation.Plan}, Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → ∀ o ∈ observations, plan.tariff.enrolIndex ≠ Option.some o.index
