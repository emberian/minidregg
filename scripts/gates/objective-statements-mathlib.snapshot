S theorem Minidregg.Compiler.NativeKernelPlan.firstInstructionError_blocks : ∀ {Error : Type} (manifest : Minidregg.Compiler.SemanticManifest.Manifest) (plan : Minidregg.Compiler.NativeKernelPlan.Plan) (runner : Minidregg.Compiler.NativeKernelPlan.PlanRunner Error) (instruction : Minidregg.Compiler.NativeKernelPlan.Instruction) (rest : List Minidregg.Compiler.NativeKernelPlan.Instruction) (error : Error), plan.manifestEncoding = manifest.canonicalEncoding → plan.instructions = instruction :: rest → runner instruction = Except.error error → Minidregg.Compiler.NativeKernelPlan.run manifest plan runner = Minidregg.Compiler.NativeKernelPlan.Outcome.blocked error
