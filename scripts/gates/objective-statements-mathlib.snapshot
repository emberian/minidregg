S def Minidregg.Kernel.Seats.runPlan : ℕ → Minidregg.Kernel.Invitations.Instance → (ℕ → Minidregg.Kernel.Invitations.InvitationId) → Minidregg.Kernel.Seats.World → ℕ → List Minidregg.Kernel.Seats.PlanAction → Except Minidregg.Kernel.Seats.Refusal (Minidregg.Kernel.Seats.World × Minidregg.Theory.CanonicalResourceKernel.Batch) #4278045774
S theorem Minidregg.Kernel.Seats.runPlan_posts : ∀ {height : ℕ} {inst : Minidregg.Kernel.Invitations.Instance} {mintId : ℕ → Minidregg.Kernel.Invitations.InvitationId} {world next : Minidregg.Kernel.Seats.World} {index : ℕ} {plan : List Minidregg.Kernel.Seats.PlanAction} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.runPlan height inst mintId world index plan = Except.ok (next, batch) → Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ batch.registrations = []
S theorem Minidregg.Kernel.Seats.runPlan_reachable : ∀ {height : ℕ} {inst : Minidregg.Kernel.Invitations.Instance} {mintId : ℕ → Minidregg.Kernel.Invitations.InvitationId} {genesis world next : Minidregg.Kernel.Seats.World} {index : ℕ} {plan : List Minidregg.Kernel.Seats.PlanAction} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Reachable genesis world → Minidregg.Kernel.Seats.runPlan height inst mintId world index plan = Except.ok (next, batch) → Minidregg.Kernel.Seats.Reachable genesis next
S def Minidregg.Kernel.Seats.safeAt : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Theory.CanonicalResourceKernel.AccountId → Minidregg.Kernel.Seats.Proposal → Bool #4079117061
S theorem Minidregg.Kernel.Seats.safeAt_congr : ∀ {book book' : Minidregg.Theory.CanonicalResourceKernel.Book} {account account' : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal}, (∀ asset ∈ proposal.assets, book.balance account asset = book'.balance account' asset) → Minidregg.Kernel.Seats.safeAt book account proposal = Minidregg.Kernel.Seats.safeAt book' account' proposal
S theorem Minidregg.Kernel.Seats.safeAt_mono : ∀ {book book' : Minidregg.Theory.CanonicalResourceKernel.Book} {account account' : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal}, (∀ asset ∈ proposal.assets, book.balance account asset ≤ book'.balance account' asset) → Minidregg.Kernel.Seats.safeAt book account proposal = Bool.true → Minidregg.Kernel.Seats.safeAt book' account' proposal = Bool.true
S theorem Minidregg.Kernel.Seats.seat?_eq : ∀ {world : Minidregg.Kernel.Seats.World}, (List.map Minidregg.Kernel.Seats.Seat.account world.seats).Nodup → ∀ {seat : Minidregg.Kernel.Seats.Seat}, seat ∈ world.seats → world.seat? seat.account = Option.some seat
S theorem Minidregg.Kernel.Seats.seat_conserves : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {action : Minidregg.Kernel.Seats.Action} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor action = Except.ok (next, batch) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), next.book.totalAsset asset = world.book.totalAsset asset
S theorem Minidregg.Kernel.Seats.seat_debit_authorized : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {action : Minidregg.Kernel.Seats.Action} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Inv world → Minidregg.Kernel.Seats.step world height actor action = Except.ok (next, batch) → ∀ {seat : Minidregg.Kernel.Seats.Seat}, seat ∈ world.seats → ∀ {asset : Minidregg.Theory.CanonicalResourceKernel.AssetId}, next.book.balance seat.account asset < world.book.balance seat.account asset → (actor = Minidregg.Kernel.Seats.Actor.inst seat.inst ∧ ∃ transfers, action = Minidregg.Kernel.Seats.Action.reallocate seat.inst transfers) ∨ action = Minidregg.Kernel.Seats.Action.exit seat.account ∨ actor = Minidregg.Kernel.Seats.Actor.inst seat.inst ∧ action = Minidregg.Kernel.Seats.Action.terminate seat.inst
S theorem Minidregg.Kernel.Seats.seat_offer_safe_forever : ∀ {genesis world : Minidregg.Kernel.Seats.World}, genesis.seats = [] → Minidregg.Kernel.Seats.Reachable genesis world → ∀ seat ∈ world.seats, Minidregg.Kernel.Seats.safeAt world.book seat.account seat.proposal = Bool.true
