S theorem Minidregg.Kernel.Job.jget : ∀ (p : Minidregg.Kernel.Job.Params) (t : Minidregg.Kernel.Job.JobTurn) (pre post : Minidregg.Kernel.DeclaredResourceProjection.Values) (k : String), (Minidregg.Kernel.Job.jview p t pre post).get k = ((Minidregg.Kernel.LawView.view t.base pre post).get k).or ({ slots := Minidregg.Kernel.Job.extraSlots p t }.get k)
