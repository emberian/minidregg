S def Minidregg.Kernel.Seats.closeSeat : Minidregg.Kernel.Seats.World → Minidregg.Kernel.Seats.Seat → Except Minidregg.Kernel.Seats.Refusal (Minidregg.Kernel.Seats.World × Minidregg.Theory.CanonicalResourceKernel.Batch) #2192498079
S theorem Minidregg.Kernel.Seats.closeSeat_book : ∀ {world next : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeSeat world seat = Except.ok (next, batch) → next.book = Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts (Minidregg.Theory.CanonicalResourceKernel.applyOperations world.book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers world.book seat.account seat.payee (Minidregg.Kernel.Seats.heldAssets world.book seat.account)))) [seat.account]
S theorem Minidregg.Kernel.Seats.closeSeat_inv : ∀ {world next : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → Minidregg.Kernel.Seats.closeSeat world seat = Except.ok (next, batch) → Minidregg.Kernel.Seats.Inv next
S theorem Minidregg.Kernel.Seats.closeSeat_seats : ∀ {world next : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeSeat world seat = Except.ok (next, batch) → next.seats = Minidregg.Kernel.Seats.removeSeat world.seats seat.account
S theorem Minidregg.Kernel.Seats.closeSeat_spec : ∀ {world next : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeSeat world seat = Except.ok (next, batch) → batch = Minidregg.Kernel.Seats.closeBatch world.book seat ∧ Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ next = { book := next.book, registry := world.registry, seats := Minidregg.Kernel.Seats.removeSeat world.seats seat.account }
S theorem Minidregg.Kernel.Seats.close_accounts : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (operations : List Minidregg.Theory.CanonicalResourceKernel.Operation) (closed : Minidregg.Theory.CanonicalResourceKernel.AccountId), (Minidregg.Theory.CanonicalResourceKernel.deregisterAccounts (Minidregg.Theory.CanonicalResourceKernel.applyOperations book operations) [closed]).accounts = book.accounts.erase closed
S theorem Minidregg.Kernel.Seats.closed_seat_posting_refused : ∀ {world next : Minidregg.Kernel.Seats.World} {height : ℕ} {actor : Minidregg.Kernel.Seats.Actor} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.step world height actor (Minidregg.Kernel.Seats.Action.exit account) = Except.ok (next, batch) → ∀ (later : Minidregg.Theory.CanonicalResourceKernel.Batch), account ∉ later.registrations → (∃ operation ∈ later.operations, operation.posting.source = account ∨ operation.posting.destination = account) → ¬Minidregg.Theory.CanonicalResourceKernel.Batch.Admission next.book later
