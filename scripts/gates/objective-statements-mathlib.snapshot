S theorem Minidregg.Selvage.AccExample.fold_honest : ∀ (γ : ZMod 5), Minidregg.Selvage.AccClaim.Satisfies (Minidregg.Selvage.reedSolomonCode Minidregg.Selvage.RSExample.dom₅ 2) (Minidregg.Selvage.foldClaims Minidregg.Selvage.AccExample.trivialRoot Minidregg.Selvage.AccExample.evalA Minidregg.Selvage.AccExample.evalB0 γ) (Minidregg.Selvage.RSExample.xWord + γ • 0)
S theorem Minidregg.Selvage.AccExample.fold_honest_nonzero : ∀ (γ : ZMod 5), Minidregg.Selvage.AccClaim.Satisfies (Minidregg.Selvage.reedSolomonCode Minidregg.Selvage.RSExample.dom₅ 2) (Minidregg.Selvage.foldClaims Minidregg.Selvage.AccExample.trivialRoot Minidregg.Selvage.AccExample.evalA Minidregg.Selvage.AccExample.evalB1 γ) (Minidregg.Selvage.RSExample.xWord + γ • Minidregg.Selvage.AccExample.oneWord)
S theorem Minidregg.Selvage.AccExample.fold_teeth : ∀ (γ : ZMod 5), γ ≠ 0 → ¬Minidregg.Selvage.AccClaim.Satisfies (Minidregg.Selvage.reedSolomonCode Minidregg.Selvage.RSExample.dom₅ 2) (Minidregg.Selvage.foldClaims Minidregg.Selvage.AccExample.trivialRoot Minidregg.Selvage.AccExample.evalA Minidregg.Selvage.AccExample.evalB1 γ) (Minidregg.Selvage.RSExample.xWord + γ • 0)
