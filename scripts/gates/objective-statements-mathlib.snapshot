S def Minidregg.Theory.ResourceBirth.AuthorityGrant.NativeForBirth : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.AuthorityGrant → Minidregg.Theory.ResourceBirth.BirthItem registry → Prop := fun {registry} grant item => grant.kind = item.resourceKind ∧ (grant.capability.head.scope.targets = Minidregg.Theory.TypedAuthorization.TargetSet.explicit {{ value := item.create.cellId }} ∨ grant.capability.head.scope.targets = Minidregg.Theory.TypedAuthorization.TargetSet.under item.create.cellId) ∧ grant.capability.head.policyId.value = item.create.cellId ∧ grant.capability.head.policyEpoch = 0
S def Minidregg.Theory.ResourceBirth.AuthorityGrant.PolicyControlForBirth : {registry : Minidregg.Theory.CellRegistry.TypeRegistry Minidregg.Theory.TypedAuthorization.Digest} → Minidregg.Theory.ResourceBirth.AuthorityGrant → Minidregg.Theory.ResourceBirth.BirthItem registry → Prop := fun {registry} grant item => match grant with | { kind := Minidregg.Theory.TypedAuthorization.ResourceKind.program, capability := capability } => capability.head.scope.targets = Minidregg.Theory.TypedAuthorization.TargetSet.explicit {{ value := item.create.cellId }} ∧ capability.head.scope.verbs = {Minidregg.Theory.TypedAuthorization.Verb.installPolicy, Minidregg.Theory.TypedAuthorization.Verb.revokeCapability} ∧ capability.head.policyId.value = item.create.cellId ∧ capability.head.policyEpoch = 0 | x => False
