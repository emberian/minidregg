S theorem Minidregg.Selvage.binaryTableDot_lookupEq_cubePt : ∀ {F : Type u_1} [inst : Field F] (k : ℕ) (table : Fin (2 ^ k) → F) (b : Fin k → Bool), Minidregg.Selvage.binaryTableDot table (Minidregg.Selvage.binaryLookupEq k (Minidregg.Selvage.cubePt b)) = table ((Minidregg.Selvage.binaryCubeIndexEquiv k) b)
