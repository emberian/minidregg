S def Minidregg.Kernel.GenericSimplexStructure.Preserves : Minidregg.Kernel.GenericSimplex.State → Minidregg.Kernel.GenericSimplex.State → Prop := fun before after => (after.self = before.self ∧ before.audit <+: after.audit) ∧ (Minidregg.Kernel.GenericSimplexLocal.OwnedAudit before → Minidregg.Kernel.GenericSimplexLocal.OwnedAudit after)
