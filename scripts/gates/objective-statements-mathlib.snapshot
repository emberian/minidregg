S def Minidregg.Compiler.memberAtDepth : {F : Type u} → [Field F] → Minidregg.Compiler.PermSpec F 2 → ℕ → F → F → Prop := fun {F} [Field F] spec k root leaf => ∃ bpath, bpath.length = k ∧ Minidregg.Compiler.merkleExec spec leaf bpath = root
S theorem Minidregg.Compiler.memberAtDepth_of_muxFold : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf root : F) (pvals : List (F × F)), (∀ sd ∈ pvals, sd.2 = 0 ∨ sd.2 = 1) → root = Minidregg.Compiler.merkleMuxExec spec leaf pvals → Minidregg.Compiler.memberAtDepth spec pvals.length root leaf
S def Minidregg.Compiler.membershipGadget : {F : Type u} → [Field F] → {Idx : Type u} → Minidregg.Compiler.PermSpec F 2 → Idx → Idx → List (Idx × Idx) → Minidregg.Compiler.ConstraintSystem F Idx #1220037517
S theorem Minidregg.Compiler.membership_complete : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf root : F) (bpath : List (F × Bool)), Minidregg.Compiler.merkleExec spec leaf bpath = root → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.canonAsg leaf root bpath) (Minidregg.Compiler.membershipGadget spec Minidregg.Compiler.MWire.leafW Minidregg.Compiler.MWire.rootW (Minidregg.Compiler.canonPath bpath.length))
S theorem Minidregg.Compiler.membership_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (leafW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.membershipGadget spec leafW rootW path) ↔ (∀ sd ∈ path, asg sd.2 = 0 ∨ asg sd.2 = 1) ∧ asg rootW = Minidregg.Compiler.merkleMuxExec spec (asg leafW) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
S theorem Minidregg.Compiler.membership_meaning : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (k : ℕ) (leaf root : F), (∃ asg, asg Minidregg.Compiler.MWire.leafW = leaf ∧ asg Minidregg.Compiler.MWire.rootW = root ∧ Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.membershipGadget spec Minidregg.Compiler.MWire.leafW Minidregg.Compiler.MWire.rootW (Minidregg.Compiler.canonPath k))) ↔ Minidregg.Compiler.memberAtDepth spec k root leaf
S theorem Minidregg.Compiler.membership_semHolds_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (leafW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemSemHolds asg (Minidregg.Compiler.membershipGadget spec leafW rootW path) ↔ (∀ sd ∈ path, asg sd.2 = 0 ∨ asg sd.2 = 1) ∧ asg rootW = Minidregg.Compiler.merkleMuxExec spec (asg leafW) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
S theorem Minidregg.Compiler.membership_sound : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (k : ℕ) (asg : Minidregg.Compiler.MWire k → F), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.membershipGadget spec Minidregg.Compiler.MWire.leafW Minidregg.Compiler.MWire.rootW (Minidregg.Compiler.canonPath k)) → Minidregg.Compiler.memberAtDepth spec k (asg Minidregg.Compiler.MWire.rootW) (asg Minidregg.Compiler.MWire.leafW)
S theorem Minidregg.Compiler.membership_teeth : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (leafW rootW : Idx) (path : List (Idx × Idx)), asg rootW ≠ Minidregg.Compiler.merkleMuxExec spec (asg leafW) (List.map (fun sd => (asg sd.1, asg sd.2)) path) → ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.membershipGadget spec leafW rootW path)
S theorem Minidregg.Compiler.membership_teeth_bit : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (leafW rootW : Idx) (path : List (Idx × Idx)), ∀ sd ∈ path, asg sd.2 ≠ 0 → asg sd.2 ≠ 1 → ¬Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.membershipGadget spec leafW rootW path)
S def Minidregg.Compiler.merkleExec : {F : Type u} → [Field F] → Minidregg.Compiler.PermSpec F 2 → F → List (F × Bool) → F #4081771578
S theorem Minidregg.Compiler.merkleExec_cons : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf : F) (sd : F × Bool) (path : List (F × Bool)), Minidregg.Compiler.merkleExec spec leaf (sd :: path) = Minidregg.Compiler.merkleExec spec (bif sd.2 then Minidregg.Compiler.compressExec spec sd.1 leaf else Minidregg.Compiler.compressExec spec leaf sd.1) path
S theorem Minidregg.Compiler.merkleExec_nil : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf : F), Minidregg.Compiler.merkleExec spec leaf [] = leaf
S def Minidregg.Compiler.merkleMuxExec : {F : Type u} → [Field F] → Minidregg.Compiler.PermSpec F 2 → F → List (F × F) → F #2090264801
S theorem Minidregg.Compiler.merkleMuxExec_cons : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf : F) (sd : F × F) (path : List (F × F)), Minidregg.Compiler.merkleMuxExec spec leaf (sd :: path) = Minidregg.Compiler.merkleMuxExec spec (Minidregg.Compiler.muxStepExec spec leaf sd) path
S theorem Minidregg.Compiler.merkleMuxExec_encode : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (bpath : List (F × Bool)) (leaf : F), Minidregg.Compiler.merkleMuxExec spec leaf (List.map Minidregg.Compiler.encodeStep bpath) = Minidregg.Compiler.merkleExec spec leaf bpath
S theorem Minidregg.Compiler.merkleMuxExec_nil : ∀ {F : Type u} [inst : Field F] (spec : Minidregg.Compiler.PermSpec F 2) (leaf : F), Minidregg.Compiler.merkleMuxExec spec leaf [] = leaf
