S theorem Minidregg.Selvage.reedSolomonCode_minDist : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type u_2} [inst_1 : Field F] [inst_2 : DecidableEq F] (dom : ι ↪ F) (d : ℕ), ∀ u ∈ Minidregg.Selvage.reedSolomonCode dom d, ∀ v ∈ Minidregg.Selvage.reedSolomonCode dom d, u ≠ v → 1 - (↑d - 1) / ↑(Fintype.card ι) ≤ Minidregg.Selvage.relDist u v
