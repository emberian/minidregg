S theorem Minidregg.Kernel.World.step_head : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {w w' : Minidregg.Kernel.World.World R TxId D} {t : Minidregg.Kernel.World.Turn R TxId Ev D}, Minidregg.Kernel.World.World.step H w t = Option.some w' → ∃ height logRoot, w.head = Option.some (height, logRoot) ∧ w'.head = Option.some (height + 1, H.chain logRoot (H.turnDigest t))
