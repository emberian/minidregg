S def Minidregg.Kernel.PayEnrolV2Decision.classifyTerms : Minidregg.Kernel.PayCell.PayStore → Minidregg.Kernel.PayEnrolV2Decision.Pricing → Minidregg.Kernel.PayTariff.Tariff → Minidregg.Kernel.PayCell.ChainTip → Minidregg.Kernel.PayObservation.Observation → Minidregg.Kernel.PayEnrolV2Decision.Memo → Minidregg.Kernel.PayEnrolV2Decision.Custody → ℕ → Minidregg.Kernel.PayEnrolV2Decision.Decision #2247285096
S theorem Minidregg.Kernel.PayEnrolV2Decision.classifyTerms_success_partition : ∀ (store : Minidregg.Kernel.PayCell.PayStore) (pricing : Minidregg.Kernel.PayEnrolV2Decision.Pricing) (tariff : Minidregg.Kernel.PayTariff.Tariff) (tip : Minidregg.Kernel.PayCell.ChainTip) (o : Minidregg.Kernel.PayObservation.Observation) (memo : Minidregg.Kernel.PayEnrolV2Decision.Memo) (custody : Minidregg.Kernel.PayEnrolV2Decision.Custody) (float : ℕ) (quote : Minidregg.Kernel.PayEnrolV2Decision.FixedQuote), (Minidregg.Kernel.PayEnrolV2Decision.classifyTerms store pricing tariff tip o memo custody float).quote = Option.some quote → quote.amountAtomic = o.amount ∧ quote.credit = tariff.creditFor o.amount ∧ quote.requestedWeeks = memo.unsigned.weeks ∧ quote.birthFee + quote.membershipCredit + quote.creditedRemainder = quote.credit ∧ memo.unsigned.minimumStarterCredit ≤ quote.creditedRemainder
S theorem Minidregg.Kernel.PayEnrolV2Decision.classifyTerms_success_quote : ∀ (store : Minidregg.Kernel.PayCell.PayStore) (pricing : Minidregg.Kernel.PayEnrolV2Decision.Pricing) (tariff : Minidregg.Kernel.PayTariff.Tariff) (tip : Minidregg.Kernel.PayCell.ChainTip) (o : Minidregg.Kernel.PayObservation.Observation) (memo : Minidregg.Kernel.PayEnrolV2Decision.Memo) (custody : Minidregg.Kernel.PayEnrolV2Decision.Custody) (float : ℕ) (quote : Minidregg.Kernel.PayEnrolV2Decision.FixedQuote), (Minidregg.Kernel.PayEnrolV2Decision.classifyTerms store pricing tariff tip o memo custody float).quote = Option.some quote → ∃ birth, Minidregg.Kernel.PayEnrolClaim.quoteFixed o.amount tariff birth memo.unsigned.weeks memo.unsigned.minimumStarterCredit = Except.ok quote
