S theorem Minidregg.Theory.Receiving.Receiver.receive_committed : ∀ {J : Minidregg.Theory.Receiving.Journal} {verify : Minidregg.Theory.Receiving.SigQuery → Id (Except String Bool)} (R : Minidregg.Theory.Receiving.Receiver J verify) {Exact : J.State → J.Intent → Type} {Other : Type} {append : (state : J.State) → (intent : J.Intent) → Id (Minidregg.Theory.Receiving.Receiver.Commit (Exact state intent) Other)} {env : R.Env} {state : J.State} {bytes : List UInt8} {ingress : R.Ingress} {admission : R.Admitted env state ingress} {witness : Exact state (R.intent admission.accepted)}, R.receive append env state bytes = Pure.pure (Minidregg.Theory.Receiving.Receiver.Outcome.committed ingress admission witness) → R.decode bytes = Option.some ingress ∧ R.replay env state ingress = Option.none ∧ R.admitVia env state ingress = Pure.pure (Except.ok admission) ∧ append state (R.intent admission.accepted) = Pure.pure (Minidregg.Theory.Receiving.Receiver.Commit.exact witness)
S theorem Minidregg.Theory.Receiving.Receiver.receive_committed_lawFault : ∀ {J : Minidregg.Theory.Receiving.Journal} {verify : Minidregg.Theory.Receiving.SigQuery → Id (Except String Bool)} (R : Minidregg.Theory.Receiving.Receiver J verify) {Exact : J.State → J.Intent → Type} {Other : Type} {append : (state : J.State) → (intent : J.Intent) → Id (Minidregg.Theory.Receiving.Receiver.Commit (Exact state intent) Other)} {env : R.Env} {state : J.State} {bytes : List UInt8} {ingress : R.Ingress} {admission : R.Admitted env state ingress} {witness : Exact state (R.intent admission.accepted)}, R.receive append env state bytes = Pure.pure (Minidregg.Theory.Receiving.Receiver.Outcome.committed ingress admission witness) → R.shape admission.accepted.prepared = Bool.true ∧ R.lawFault admission.accepted.prepared = Option.none
