S theorem Minidregg.Kernel.GeneralSimplexReachability.refined_engine_commits_compatible : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement c faulty net → c.parties = 3 * c.faults + 1 → faulty.card ≤ c.faults → ∀ {p q v w : ℕ} {b d : Minidregg.Kernel.GenericSimplex.Block}, p < c.parties → q < c.parties → p ∉ faulty → q ∉ faulty → (Minidregg.Kernel.GenericSimplex.viewAt (net.localState p) v).committed = Option.some b → (Minidregg.Kernel.GenericSimplex.viewAt (net.localState q) w).committed = Option.some d → b <+: d ∨ d <+: b
