S theorem Minidregg.Theory.Receiving.Receiver.receive_committed_verified : ∀ {J : Minidregg.Theory.Receiving.Journal} {v : Minidregg.Theory.Receiving.SigQuery → Bool} (R : Minidregg.Theory.Receiving.Receiver J (Minidregg.Theory.Receiving.Receiver.pureVerifier v)) {Exact : J.State → J.Intent → Type} {Other : Type} {append : (state : J.State) → (intent : J.Intent) → Id (Minidregg.Theory.Receiving.Receiver.Commit (Exact state intent) Other)} {env : R.Env} {state : J.State} {bytes : List UInt8} {ingress : R.Ingress} {admission : R.Admitted env state ingress} {witness : Exact state (R.intent admission.accepted)}, R.receive append env state bytes = Pure.pure (Minidregg.Theory.Receiving.Receiver.Outcome.committed ingress admission witness) → ∃ claims, R.claims env state ingress = Except.ok claims ∧ ∀ claim ∈ claims, v claim = Bool.true
