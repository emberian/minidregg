S theorem Minidregg.Compiler.Machine.admit_fuelZero : ∀ {M : Minidregg.Compiler.Machine} {program : Minidregg.Compiler.NockProgramCodec.Program}, (M.decode program.jam).isSome = Bool.true → M.canonical program.jam = Bool.true → program.abi.version = Minidregg.Compiler.NockProgramCodec.abiVersion → Minidregg.Compiler.NockProgramCodec.NamesNulFree program.abi → program.abi.fuel = 0 → M.admit program = Except.error Minidregg.Compiler.NockProgramCodec.Refusal.fuelZero
