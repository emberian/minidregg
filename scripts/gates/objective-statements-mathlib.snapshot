S theorem Minidregg.Kernel.PayObservationProofs.observation_mints_exactly : ∀ (store : Minidregg.Kernel.PayCell.PayStore) (clock : Minidregg.Kernel.ClockCell.Clock) (book : Minidregg.Theory.CanonicalResourceKernel.Book) (tip : Minidregg.Kernel.PayCell.ChainTip) (o : Minidregg.Kernel.PayObservation.Observation) (plan : Minidregg.Kernel.PayObservation.Plan), Minidregg.Kernel.PayObservation.decideObservations store clock book tip [o] = Except.ok plan → ∃ payer, Minidregg.Kernel.PayCell.tariffOf store = Option.some plan.tariff ∧ Minidregg.Kernel.PayCell.assignmentAt store o.index = Option.some payer ∧ payer ≠ plan.tariff.asset ∧ (plan.batch.apply book).balance payer plan.tariff.asset = book.balance payer plan.tariff.asset + Int.ofNat (plan.tariff.creditFor o.amount)
