S theorem Minidregg.Kernel.PayObservationProofs.mint_account_balance : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (asset destination : Minidregg.Theory.CanonicalResourceKernel.AccountId) (amount : ℕ) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId), account ≠ asset → ((Minidregg.Theory.CanonicalResourceKernel.Operation.mint asset destination amount).apply book).balance account asset = book.balance account asset + if destination = account then Int.ofNat amount else 0
