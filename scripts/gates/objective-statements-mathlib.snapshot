S def Minidregg.Kernel.World.rejectOf : {α : Type} → Except Minidregg.Kernel.World.Reject α → Option Minidregg.Kernel.World.Reject #1785492768
S theorem Minidregg.Kernel.World.resume_sound : ∀ {R : Minidregg.Kernel.World.Registry} {TxId Ev D : Type} [inst : DecidableEq TxId] [inst_1 : DecidableEq D] (H : Minidregg.Kernel.World.History R TxId Ev D) {Root : Type} [inst_2 : DecidableEq Root] (rootOf : Minidregg.Kernel.World.World R TxId D → Root) (g W_h : Minidregg.Kernel.World.World R TxId D) (log : List (Minidregg.Kernel.World.Turn R TxId Ev D)) (c : Minidregg.Kernel.World.Checkpoint R TxId D Root), Minidregg.Kernel.World.fold H g (List.take c.height log) = Option.some W_h → c.root = rootOf W_h → (rootOf c.world = rootOf W_h → c.world = W_h) → Minidregg.Kernel.World.Checkpoint.check rootOf c = Bool.true → Minidregg.Kernel.World.Checkpoint.resume H rootOf c (List.drop c.height log) = Minidregg.Kernel.World.fold H g log
S def Minidregg.Kernel.World.romOnlyDecidable : {L : Minidregg.Theory.Store.Layout} → (s : Minidregg.Theory.Store.Store L) → Decidable (Minidregg.Kernel.World.RomOnly s) #3860959988
