S theorem Minidregg.Compiler.presOf_both : ∀ {F : Type} [inst : Field F] (old new : Minidregg.Pred.State) (s : Minidregg.Pred.Slot), Minidregg.Compiler.presOf old s * Minidregg.Compiler.presOf new s = if ((old.get s).isSome && (new.get s).isSome) = Bool.true then 1 else 0
