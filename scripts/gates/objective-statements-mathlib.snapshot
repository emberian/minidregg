S theorem Minidregg.Kernel.WorldRootCache.insertWrite_root : ∀ {K V D : Type} [inst : DecidableEq K] (S : Minidregg.Theory.AuthMap.Scheme K V D) (E : ℕ → D), (∀ (i : ℕ), E i = Minidregg.Kernel.WorldRoot.empties S i) → ∀ {m : Minidregg.Theory.AuthMap.Map K V} {t : Minidregg.Kernel.WorldRootCache.Tree K V D}, Minidregg.Kernel.WorldRootCache.Good S E m S.depth [] t → ∀ (k : K) (v : Option V), Minidregg.Kernel.WorldRootCache.Tree.digest S E S.depth (Minidregg.Kernel.WorldRootCache.insertWrite S E t k v) = S.root (Minidregg.Theory.AuthMap.write S.ix m k v)
