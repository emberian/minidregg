S theorem Minidregg.Kernel.JobMoney.applyOperations_balance : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (ops : List Minidregg.Theory.CanonicalResourceKernel.Operation), (∀ op ∈ ops, Minidregg.Kernel.JobMoney.plainOp op) → ∀ (a : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book ops).balance a asset = book.balance a asset + (List.map (Minidregg.Kernel.JobMoney.flowIn a asset) ops).sum
S theorem Minidregg.Kernel.JobMoney.applyPosting_balance : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (p : Minidregg.Theory.CanonicalResourceKernel.Posting) (a : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (book.applyPosting p).balance a asset = book.balance a asset + ((if a = p.destination ∧ asset = p.asset then Int.ofNat p.amount else 0) - if a = p.source ∧ asset = p.asset then Int.ofNat p.amount else 0)
S theorem Minidregg.Kernel.JobMoney.apply_balance : ∀ (op : Minidregg.Theory.CanonicalResourceKernel.Operation), Minidregg.Kernel.JobMoney.plainOp op → ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (a : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (op.apply book).balance a asset = book.balance a asset + Minidregg.Kernel.JobMoney.flowIn a asset op
