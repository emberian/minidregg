S theorem Minidregg.Compiler.rootTerm_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F 2) (leafW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.accepts asg (Minidregg.Compiler.rootTerm spec leafW rootW path) ↔ asg rootW = Minidregg.Compiler.merkleMuxExec spec (asg leafW) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
