S theorem private Minidregg.Compiler.eval_weightedFold : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {k : ℕ} (asg : Idx → F) (bits : Fin k → Idx) (l : List (Fin k)), Minidregg.Compiler.eval asg (List.foldr (fun i acc => Minidregg.Compiler.add' (Minidregg.Compiler.mul' (Minidregg.Compiler.vr (bits i)) (Minidregg.Compiler.cst (2 ^ ↑i))) acc) (Minidregg.Compiler.cst 0) l) = (List.map (fun i => asg (bits i) * 2 ^ ↑i) l).sum
