S def Minidregg.Selvage.HasMutualCorrelatedAgreement : {ι : Type u_1} → [Fintype ι] → {F : Type u_2} → [inst : Field F] → {ℓ : ℕ} → Minidregg.Selvage.ProximityGenerator F ℓ → Submodule F (ι → F) → ℝ → (ℝ → ℝ) → Prop := fun {ι} [Fintype ι] {F} [Field F] {ℓ} G C Bstar errstar => ∀ (f : Fin ℓ → ι → F) (δ : ℝ), 0 < δ → δ < 1 - Bstar → G.pr (Minidregg.Selvage.MutualCAFailure C δ f) ≤ errstar δ
