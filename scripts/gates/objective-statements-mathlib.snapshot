S theorem Minidregg.Compiler.DurableLogTags.verifyTags_refuses_at : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (pre post : List (List UInt8)) (stored : List UInt8), pre.length < records.length → (∀ (i : ℕ) (hi : i < pre.length), ∃ carried, carried.chain = Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records) ∧ pre[i] = Minidregg.Compiler.DurableHistory.trailer key (height + i + 1) carried) → (∀ (carried : Minidregg.Compiler.DurableHistory.Carried), carried.chain = Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (pre.length + 1) records) → stored ≠ Minidregg.Compiler.DurableHistory.trailer key (height + pre.length + 1) carried) → Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) (pre ++ stored :: post) = Except.error (Minidregg.Compiler.DurableLogTags.tagRefusal (height + pre.length + 1))
S theorem Minidregg.Compiler.DurableLogTags.verifyTags_refuses_head : ∀ (key : Minidregg.Compiler.DurableCheckpointCodec.MacKey) (height : ℕ) (start : Minidregg.Theory.TypedAuthorization.Digest) (records : List Minidregg.Kernel.DurableReceiver.IntentRecord) (pre : List (List UInt8)) (stored : List UInt8), pre.length + 1 = records.length → (∀ (i : ℕ) (hi : i < pre.length), ∃ carried, carried.chain = Minidregg.Compiler.DurableCheckpointCodec.chainAfter start (List.take (i + 1) records) ∧ pre[i] = Minidregg.Compiler.DurableHistory.trailer key (height + i + 1) carried) → (∀ (carried : Minidregg.Compiler.DurableHistory.Carried), carried.chain = Minidregg.Compiler.DurableCheckpointCodec.chainAfter start records → stored ≠ Minidregg.Compiler.DurableHistory.trailer key (height + records.length) carried) → Minidregg.Compiler.DurableLogTags.verifyTags key height (Minidregg.Compiler.DurableLogTags.chainPrefixes start records) (pre ++ [stored]) = Except.error (Minidregg.Compiler.DurableLogTags.tagRefusal (height + records.length))
