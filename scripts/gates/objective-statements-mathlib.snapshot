S theorem Minidregg.Compiler.permGadget_evalExec : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)), (fun i => Minidregg.Compiler.evalExec asg (Minidregg.Compiler.permGadget spec state i)) = Minidregg.Compiler.permExec spec fun i => Minidregg.Compiler.evalExec asg (state i)
S theorem Minidregg.Compiler.permGadget_eval_apply : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w : ℕ} (asg : Idx → F) (spec : Minidregg.Compiler.PermSpec F w) (state : Fin w → Minidregg.Compiler.Term (Minidregg.Compiler.AirSig F Idx)) (i : Fin w), Minidregg.Compiler.eval asg (Minidregg.Compiler.permGadget spec state i) = Minidregg.Compiler.permExec spec (fun j => Minidregg.Compiler.eval asg (state j)) i
