S theorem Minidregg.Theory.Channel.Domain.assembleAt_run : ∀ {Msg Obs : Type} (X : Minidregg.Theory.Channel.Domain Msg Obs) (τ : Minidregg.Theory.Channel.Traffic Msg) (p : Minidregg.Theory.Channel.Presences) (k : ℕ) {ρ : ℕ}, ρ < X.sched.n → X.sched.assembleAt X.prf (X.epochOf k) (X.tickOf k) (X.received τ p k) ρ = match X.emitted τ p k ρ with | Option.some x => (x.2.2, Minidregg.Theory.Channel.Source.holder x.1) | Option.none => (Minidregg.Theory.Channel.fillCell X.sched.profile X.prf (X.hdr k ρ), Minidregg.Theory.Channel.Source.fill)
