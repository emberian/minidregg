S theorem Minidregg.Kernel.Base64.group_redecodes : ∀ (b₀ b₁ b₂ : UInt8), Minidregg.Kernel.Base64.b64Val (Minidregg.Kernel.Base64.b64Char (b₀.toNat / 4)) = Option.some (b₀.toNat / 4) ∧ Minidregg.Kernel.Base64.b64Val (Minidregg.Kernel.Base64.b64Char (b₀.toNat % 4 * 16 + b₁.toNat / 16)) = Option.some (b₀.toNat % 4 * 16 + b₁.toNat / 16) ∧ Minidregg.Kernel.Base64.b64Val (Minidregg.Kernel.Base64.b64Char (b₁.toNat % 16 * 4 + b₂.toNat / 64)) = Option.some (b₁.toNat % 16 * 4 + b₂.toNat / 64) ∧ Minidregg.Kernel.Base64.b64Val (Minidregg.Kernel.Base64.b64Char (b₂.toNat % 64)) = Option.some (b₂.toNat % 64) ∧ UInt8.ofNat (b₀.toNat / 4 * 4 + (b₀.toNat % 4 * 16 + b₁.toNat / 16) / 16) = b₀ ∧ UInt8.ofNat ((b₀.toNat % 4 * 16 + b₁.toNat / 16) % 16 * 16 + (b₁.toNat % 16 * 4 + b₂.toNat / 64) / 4) = b₁ ∧ UInt8.ofNat ((b₁.toNat % 16 * 4 + b₂.toNat / 64) % 4 * 64 + b₂.toNat % 64) = b₂
S theorem Minidregg.Kernel.Base64.group_reencodes : ∀ {c₀ c₁ c₂ c₃ : UInt8} {s₀ s₁ s₂ s₃ : ℕ}, Minidregg.Kernel.Base64.b64Val c₀ = Option.some s₀ → Minidregg.Kernel.Base64.b64Val c₁ = Option.some s₁ → Minidregg.Kernel.Base64.b64Val c₂ = Option.some s₂ → Minidregg.Kernel.Base64.b64Val c₃ = Option.some s₃ → Minidregg.Kernel.Base64.b64Char ((UInt8.ofNat (s₀ * 4 + s₁ / 16)).toNat / 4) = c₀ ∧ Minidregg.Kernel.Base64.b64Char ((UInt8.ofNat (s₀ * 4 + s₁ / 16)).toNat % 4 * 16 + (UInt8.ofNat (s₁ % 16 * 16 + s₂ / 4)).toNat / 16) = c₁ ∧ Minidregg.Kernel.Base64.b64Char ((UInt8.ofNat (s₁ % 16 * 16 + s₂ / 4)).toNat % 16 * 4 + (UInt8.ofNat (s₂ % 4 * 64 + s₃)).toNat / 64) = c₂ ∧ Minidregg.Kernel.Base64.b64Char ((UInt8.ofNat (s₂ % 4 * 64 + s₃)).toNat % 64) = c₃
