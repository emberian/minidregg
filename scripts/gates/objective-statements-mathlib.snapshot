S ctor Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful.mk : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, (∀ (t u p v : ℕ) (x y : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr u p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some y) → x = y) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) (2 * f + 1)) → (∀ (t u p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block) (a : Minidregg.Kernel.GenericSimplex.Argument), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr u p v Minidregg.Kernel.GenericSimplex.Kind.candidate a → a = Option.some x) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.candidate (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) (f + 1)) → (∀ (t p v : ℕ) (a : Minidregg.Kernel.GenericSimplex.Argument), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.ready a → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.candidate a (2 * f + 1) ∨ Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.ready a (f + 1)) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) (2 * f + 1) ∨ Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.ready (Option.some x) (2 * f + 1) ∨ Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) (2 * f + 1)) → (∀ (t p v : ℕ), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.disable p v → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.ready Option.none (2 * f + 1)) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.commit p v x → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) (2 * f + 1)) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.SafeAt tr t p v x ∨ ∃ earlier < t, tr earlier = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x → 0 < v) → (∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.commit p v x → 0 < v) → (∀ (t p v : ℕ), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.disable p v → 0 < v) → Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f
S theorem Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful.prepareOutput : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → ∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x → Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) (2 * f + 1) ∨ Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.ready (Option.some x) (2 * f + 1) ∨ Minidregg.Kernel.GenericSimplexVAInvariant.Support tr roster t v Minidregg.Kernel.GenericSimplex.Kind.commit (Option.some x) (2 * f + 1)
S theorem Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful.preparePositive : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → ∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → tr t = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x → 0 < v
