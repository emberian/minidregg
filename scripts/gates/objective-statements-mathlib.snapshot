S theorem Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful.voteOnce : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → ∀ (t u p v : ℕ) (x y : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr u p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some y) → x = y
S theorem Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful.voteOrigin : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → ∀ (t p v : ℕ) (x : Minidregg.Kernel.GenericSimplex.Block), p ∉ faulty → Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr t p v Minidregg.Kernel.GenericSimplex.Kind.vote (Option.some x) → Minidregg.Kernel.GenericSimplexVAInvariant.SafeAt tr t p v x ∨ ∃ earlier < t, tr earlier = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare p v x
S def Minidregg.Kernel.GenericSimplexVAInvariant.PreparedBefore : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → ℕ → ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop := fun tr time party view block => view = 0 ∧ block = [] ∨ ∃ earlier < time, tr earlier = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare party view block
S def Minidregg.Kernel.GenericSimplexVAInvariant.SafeAt : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → ℕ → ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop := fun tr time party view block => block ≠ [] ∧ ∃ previous < view, Minidregg.Kernel.GenericSimplexVAInvariant.PreparedBefore tr time party previous (List.dropLast block) ∧ ∀ (skipped : ℕ), previous < skipped → skipped < view → ∃ earlier < time, tr earlier = Minidregg.Kernel.GenericSimplex.AuditEvent.disable party skipped
S def Minidregg.Kernel.GenericSimplexVAInvariant.Sent : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → ℕ → ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Kind → Minidregg.Kernel.GenericSimplex.Argument → Prop := fun tr time party view kind arg => tr time = Minidregg.Kernel.GenericSimplex.AuditEvent.send { sender := party, view := view, kind := kind, value := arg }
S def Minidregg.Kernel.GenericSimplexVAInvariant.Support : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → Finset ℕ → ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Kind → Minidregg.Kernel.GenericSimplex.Argument → ℕ → Prop := fun tr roster time view kind arg threshold => ∃ voters ⊆ roster, threshold ≤ voters.card ∧ ∀ party ∈ voters, ∃ sentTime < time, Minidregg.Kernel.GenericSimplexVAInvariant.Sent tr sentTime party view kind arg
