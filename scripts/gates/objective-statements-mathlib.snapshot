S theorem Minidregg.Kernel.Seats.atLeast_mono : ∀ {book book' : Minidregg.Theory.CanonicalResourceKernel.Book} {account account' : Minidregg.Theory.CanonicalResourceKernel.AccountId} {proposal : Minidregg.Kernel.Seats.Proposal}, (∀ asset ∈ proposal.assets, book.balance account asset ≤ book'.balance account' asset) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId) (amount : ℕ), Minidregg.Pred.eval (Minidregg.Kernel.Seats.atLeast asset amount) (Minidregg.Kernel.Seats.view book account proposal) (Minidregg.Kernel.Seats.view book account proposal) = Bool.true → Minidregg.Pred.eval (Minidregg.Kernel.Seats.atLeast asset amount) (Minidregg.Kernel.Seats.view book' account' proposal) (Minidregg.Kernel.Seats.view book' account' proposal) = Bool.true
S theorem Minidregg.Kernel.Seats.balance_op : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (transfer : Minidregg.Kernel.Seats.Transfer) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), (transfer.op.apply book).balance account asset = (book.balance account asset - if account = transfer.source ∧ asset = transfer.asset then ↑transfer.amount else 0) + if account = transfer.destination ∧ asset = transfer.asset then ↑transfer.amount else 0
S def Minidregg.Kernel.Seats.closeAll : Minidregg.Kernel.Seats.World → List Minidregg.Kernel.Seats.Seat → Except Minidregg.Kernel.Seats.Refusal (Minidregg.Kernel.Seats.World × Minidregg.Theory.CanonicalResourceKernel.Batch) #3183067673
S theorem Minidregg.Kernel.Seats.closeAll_credit_only : ∀ {world next : Minidregg.Kernel.Seats.World} {seats : List Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch} {account : Minidregg.Theory.CanonicalResourceKernel.AccountId}, Minidregg.Kernel.Seats.closeAll world seats = Except.ok (next, batch) → (∀ seat ∈ seats, seat.account ≠ account) → ∀ (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), world.book.balance account asset ≤ next.book.balance account asset
S theorem Minidregg.Kernel.Seats.closeAll_deregisters : ∀ {world next : Minidregg.Kernel.Seats.World} {seats : List Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeAll world seats = Except.ok (next, batch) → ∀ seat ∈ seats, seat.account ∉ next.book.accounts
S theorem Minidregg.Kernel.Seats.closeAll_deregistrations : ∀ {world next : Minidregg.Kernel.Seats.World} {seats : List Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeAll world seats = Except.ok (next, batch) → ∀ seat ∈ seats, seat.account ∈ batch.deregistrations
S theorem Minidregg.Kernel.Seats.closeAll_inv : ∀ {world next : Minidregg.Kernel.Seats.World} {seats : List Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.Inv world → (∀ s ∈ seats, s ∈ world.seats) → (List.map Minidregg.Kernel.Seats.Seat.account seats).Nodup → Minidregg.Kernel.Seats.closeAll world seats = Except.ok (next, batch) → Minidregg.Kernel.Seats.Inv next
S theorem Minidregg.Kernel.Seats.closeAll_posts : ∀ {world next : Minidregg.Kernel.Seats.World} {seats : List Minidregg.Kernel.Seats.Seat} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.closeAll world seats = Except.ok (next, batch) → Minidregg.Kernel.Seats.Posts world.book batch next.book ∧ batch.registrations = []
S def Minidregg.Kernel.Seats.closeBatch : Minidregg.Theory.CanonicalResourceKernel.Book → Minidregg.Kernel.Seats.Seat → Minidregg.Theory.CanonicalResourceKernel.Batch #2111417711
S theorem Minidregg.Kernel.Seats.closeBatch_admitted : ∀ {world : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → Minidregg.Theory.CanonicalResourceKernel.Batch.Admission world.book (Minidregg.Kernel.Seats.closeBatch world.book seat)
S theorem Minidregg.Kernel.Seats.closeBatch_balance : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (seat : Minidregg.Kernel.Seats.Seat) (account : Minidregg.Theory.CanonicalResourceKernel.AccountId) (asset : Minidregg.Theory.CanonicalResourceKernel.AssetId), ((Minidregg.Kernel.Seats.closeBatch book seat).apply book).balance account asset = (Minidregg.Theory.CanonicalResourceKernel.applyOperations book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers book seat.account seat.payee (Minidregg.Kernel.Seats.heldAssets book seat.account)))).balance account asset
S theorem Minidregg.Kernel.Seats.closeDeregistration : ∀ {world : Minidregg.Kernel.Seats.World} {seat : Minidregg.Kernel.Seats.Seat}, Minidregg.Kernel.Seats.Inv world → seat ∈ world.seats → Minidregg.Theory.CanonicalResourceKernel.DeregistrationAdmission (Minidregg.Theory.CanonicalResourceKernel.applyOperations world.book (Minidregg.Kernel.Seats.opsOf (Minidregg.Kernel.Seats.payoutTransfers world.book seat.account seat.payee (Minidregg.Kernel.Seats.heldAssets world.book seat.account)))) seat.account
S def Minidregg.Kernel.Seats.closeHeld : Minidregg.Kernel.Seats.World → ℕ → ℕ → Except Minidregg.Kernel.Seats.Refusal (Minidregg.Kernel.Seats.World × Minidregg.Theory.CanonicalResourceKernel.Batch) #4054965100
