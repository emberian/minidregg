S theorem Minidregg.Kernel.Seats.admit_posts : ∀ {book next : Minidregg.Theory.CanonicalResourceKernel.Book} {batch : Minidregg.Theory.CanonicalResourceKernel.Batch}, Minidregg.Kernel.Seats.admit book batch = Except.ok next → Minidregg.Kernel.Seats.Posts book batch next
S theorem Minidregg.Kernel.Seats.applyOperations_accounts_eq : ∀ (book : Minidregg.Theory.CanonicalResourceKernel.Book) (operations : List Minidregg.Theory.CanonicalResourceKernel.Operation), (Minidregg.Theory.CanonicalResourceKernel.applyOperations book operations).accounts = book.accounts
