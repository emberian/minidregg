S theorem Minidregg.Pred.eval_memberOf_out : Minidregg.Pred.eval (Minidregg.Pred.Pred.memberOf "x" [1, 2]) Minidregg.Pred.sX3 Minidregg.Pred.sX5 = Bool.false
S theorem Minidregg.Pred.eval_not : ∀ (p : Minidregg.Pred.Pred) (old new : Minidregg.Pred.State), Minidregg.Pred.eval p.not old new = !Minidregg.Pred.eval p old new
S theorem Minidregg.Pred.eval_objectivePin : ∀ (artifacts : List ℕ) (old new : Minidregg.Pred.State), Minidregg.Pred.eval (Minidregg.Pred.objectivePin artifacts) old new = Bool.true ↔ ∃ a ∈ artifacts, new.get Minidregg.Pred.objectiveArtifactSlot = Option.some (Int.ofNat a)
