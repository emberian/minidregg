S theorem Minidregg.Kernel.PayObservationProofs.clock_monotone_by_observation : ∀ (store : Minidregg.Kernel.PayCell.PayStore) (clock : Minidregg.Kernel.ClockCell.Clock) (book : Minidregg.Theory.CanonicalResourceKernel.Book) (tip : Minidregg.Kernel.PayCell.ChainTip) (observations : List Minidregg.Kernel.PayObservation.Observation) (plan : Minidregg.Kernel.PayObservation.Plan), Minidregg.Kernel.PayObservation.decideObservations store clock book tip observations = Except.ok plan → plan.clock = clock ∧ clock.slot ≤ tip.slot ∧ clock.now ≤ plan.nextClock.now ∧ plan.nextClock.slot = tip.slot
