S theorem Minidregg.Selvage.affineGenerator_hasMutualCorrelatedAgreement : ∀ {ι : Type u_1} [inst : Fintype ι] [DecidableEq ι] {F : Type u_2} [inst_2 : Field F] [inst_3 : DecidableEq F] [Nonempty ι] [inst_5 : Fintype F] (C : Submodule F (ι → F)) {B : ℝ} {err : ℝ → ℝ} {dC : ℝ}, (∀ u ∈ C, ∀ v ∈ C, u ≠ v → dC ≤ Minidregg.Selvage.relDist u v) → Minidregg.Selvage.IsProximityGenerator (Minidregg.Selvage.affineGenerator F) C B err → (∀ {δ₁ δ₂ : ℝ}, 0 < δ₁ → δ₁ ≤ δ₂ → δ₂ < 1 - B → err δ₁ ≤ err δ₂) → (∀ {δ : ℝ}, 0 < δ → δ < 1 - B → 0 ≤ err δ) → Minidregg.Selvage.HasMutualCorrelatedAgreement (Minidregg.Selvage.affineGenerator F) C (Max.max (1 - dC / 2) B) err
