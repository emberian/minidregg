S theorem Minidregg.Theory.AuthorizationDeclaration.Capability.admissible_iff_components : ∀ {kind : Minidregg.Theory.TypedAuthorization.ResourceKind} (cap : Minidregg.Theory.TypedAuthorization.Capability kind) (state : Minidregg.Theory.TypedAuthorization.AuthState) (request : Minidregg.Theory.TypedAuthorization.Request kind), cap.Admissible state request ↔ cap.holder.Covers request.subject ∧ cap.scope.Covers state.parent request ∧ cap.notBefore ≤ request.height ∧ request.height ≤ cap.notAfter ∧ cap.scope.targets.RequestLaw cap.policyId cap.policyEpoch request ∧ cap.policyEpoch = state.policyEpoch cap.policyId ∧ cap.issuerEpoch = state.issuerEpoch cap.issuer ∧ Minidregg.Theory.TypedAuthorization.RevocationKey.capability cap.id ∉ state.revoked ∧ (∀ ancestor ∈ cap.ancestors, Minidregg.Theory.TypedAuthorization.RevocationKey.capability ancestor ∉ state.revoked) ∧ ∀ channel ∈ cap.channels, Minidregg.Theory.TypedAuthorization.RevocationKey.channel channel ∉ state.revoked
