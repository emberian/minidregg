S def Minidregg.Compiler.noteSpendSystem : {F : Type u} → [Field F] → {Idx : Type u} → {w k : ℕ} → [NeZero w] → Minidregg.Compiler.PermSpec F w → Minidregg.Compiler.PermSpec F w → Minidregg.Compiler.PermSpec F 2 → (Fin w → Idx) → Fin w → (Fin k → Idx) → Idx → Idx → Idx → List (Idx × Idx) → Minidregg.Compiler.ConstraintSystem F Idx #2317380358
S theorem Minidregg.Compiler.noteSpend_binds : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w k : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (nfSpec cmSpec : Minidregg.Compiler.PermSpec F w) (trSpec : Minidregg.Compiler.PermSpec F 2) (noteW : Fin w → Idx) (vIdx : Fin w) (bitsW : Fin k → Idx) (nullifierW commitW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec noteW vIdx bitsW nullifierW commitW rootW path) → Minidregg.Compiler.ValidSpend nfSpec cmSpec trSpec vIdx k path.length (asg nullifierW) (asg rootW) fun i => asg (noteW i)
S theorem Minidregg.Compiler.noteSpend_complete : ∀ {F : Type u} [inst : Field F] {w k : ℕ} [inst_1 : NeZero w] (nfSpec cmSpec : Minidregg.Compiler.PermSpec F w) (trSpec : Minidregg.Compiler.PermSpec F 2) (vIdx : Fin w) (note : Fin w → F) (b : Fin k → F) (root : F) (bpath : List (F × Bool)), (∀ (i : Fin k), b i = 0 ∨ b i = 1) → note vIdx = ∑ i, b i * 2 ^ ↑i → Minidregg.Compiler.merkleExec trSpec (Minidregg.Compiler.hashExec cmSpec note) bpath = root → Minidregg.Compiler.systemAccepts (Minidregg.Compiler.spendAsg note b (Minidregg.Compiler.hashExec nfSpec note) (Minidregg.Compiler.hashExec cmSpec note) root bpath) (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec Minidregg.Compiler.SWire.noteW vIdx Minidregg.Compiler.SWire.bitW Minidregg.Compiler.SWire.nullifierW Minidregg.Compiler.SWire.commitW Minidregg.Compiler.SWire.rootW (Minidregg.Compiler.spendPath w k bpath.length))
S theorem Minidregg.Compiler.noteSpend_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w k : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (nfSpec cmSpec : Minidregg.Compiler.PermSpec F w) (trSpec : Minidregg.Compiler.PermSpec F 2) (noteW : Fin w → Idx) (vIdx : Fin w) (bitsW : Fin k → Idx) (nullifierW commitW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec noteW vIdx bitsW nullifierW commitW rootW path) ↔ ((∀ (i : Fin k), asg (bitsW i) = 0 ∨ asg (bitsW i) = 1) ∧ asg (noteW vIdx) = ∑ i, asg (bitsW i) * 2 ^ ↑i) ∧ (asg nullifierW = Minidregg.Compiler.hashExec nfSpec fun i => asg (noteW i)) ∧ (asg commitW = Minidregg.Compiler.hashExec cmSpec fun i => asg (noteW i)) ∧ (∀ sd ∈ path, asg sd.2 = 0 ∨ asg sd.2 = 1) ∧ asg rootW = Minidregg.Compiler.merkleMuxExec trSpec (asg commitW) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
S theorem Minidregg.Compiler.noteSpend_meaning : ∀ {F : Type u} [inst : Field F] {w : ℕ} [inst_1 : NeZero w] (nfSpec cmSpec : Minidregg.Compiler.PermSpec F w) (trSpec : Minidregg.Compiler.PermSpec F 2) (vIdx : Fin w) (k depth : ℕ) (nf root : F), (∃ asg, asg Minidregg.Compiler.SWire.nullifierW = nf ∧ asg Minidregg.Compiler.SWire.rootW = root ∧ Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec Minidregg.Compiler.SWire.noteW vIdx Minidregg.Compiler.SWire.bitW Minidregg.Compiler.SWire.nullifierW Minidregg.Compiler.SWire.commitW Minidregg.Compiler.SWire.rootW (Minidregg.Compiler.spendPath w k depth))) ↔ ∃ note, Minidregg.Compiler.ValidSpend nfSpec cmSpec trSpec vIdx k depth nf root note
S theorem Minidregg.Compiler.noteSpend_semHolds_correct : ∀ {F : Type u} [inst : Field F] {Idx : Type u} {w k : ℕ} [inst_1 : NeZero w] (asg : Idx → F) (nfSpec cmSpec : Minidregg.Compiler.PermSpec F w) (trSpec : Minidregg.Compiler.PermSpec F 2) (noteW : Fin w → Idx) (vIdx : Fin w) (bitsW : Fin k → Idx) (nullifierW commitW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemSemHolds asg (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec noteW vIdx bitsW nullifierW commitW rootW path) ↔ ((∀ (i : Fin k), asg (bitsW i) = 0 ∨ asg (bitsW i) = 1) ∧ asg (noteW vIdx) = ∑ i, asg (bitsW i) * 2 ^ ↑i) ∧ (asg nullifierW = Minidregg.Compiler.hashExec nfSpec fun i => asg (noteW i)) ∧ (asg commitW = Minidregg.Compiler.hashExec cmSpec fun i => asg (noteW i)) ∧ (∀ sd ∈ path, asg sd.2 = 0 ∨ asg sd.2 = 1) ∧ asg rootW = Minidregg.Compiler.merkleMuxExec trSpec (asg commitW) (List.map (fun sd => (asg sd.1, asg sd.2)) path)
S theorem Minidregg.Compiler.noteSpend_value_lt : ∀ {w k : ℕ} [inst : NeZero w] {p : ℕ} [inst_1 : Fact (Nat.Prime p)], 2 ^ k ≤ p → ∀ {Idx : Type} (asg : Idx → ZMod p) (nfSpec cmSpec : Minidregg.Compiler.PermSpec (ZMod p) w) (trSpec : Minidregg.Compiler.PermSpec (ZMod p) 2) (noteW : Fin w → Idx) (vIdx : Fin w) (bitsW : Fin k → Idx) (nullifierW commitW rootW : Idx) (path : List (Idx × Idx)), Minidregg.Compiler.systemAccepts asg (Minidregg.Compiler.noteSpendSystem nfSpec cmSpec trSpec noteW vIdx bitsW nullifierW commitW rootW path) → (asg (noteW vIdx)).val < 2 ^ k
