S theorem Minidregg.Theory.PlanBinding.Opened.twoLevel_complete : ∀ {I A X E D : Type} [inst : DecidableEq I] [inst_1 : DecidableEq A] [inst_2 : DecidableEq E] [inst_3 : DecidableEq D] (Cs : Minidregg.Theory.AuthMap.Scheme A X E) (W : Minidregg.Theory.AuthMap.Scheme I E D) (w : Minidregg.Theory.AuthMap.Map I (Minidregg.Theory.AuthMap.Map A X)) (c : I) (cell : Minidregg.Theory.AuthMap.Map A X), Minidregg.Theory.AuthMap.lookup W.ix w c = Option.some cell → ∀ (keys : List A), W.verify (Minidregg.Theory.AuthMap.worldRoot W Cs.root w) c (Option.some (Cs.root cell)) (W.opening (Minidregg.Theory.AuthMap.worldSlots Cs.root w) c) = Bool.true ∧ Minidregg.Theory.PlanBinding.Opened.verifyAll Cs (Cs.root cell) (Minidregg.Theory.PlanBinding.Opened.openAll Cs cell keys) = Bool.true
S theorem Minidregg.Theory.PlanBinding.Opened.twoLevel_sound : ∀ {I A X E D : Type} [inst : DecidableEq I] [inst_1 : DecidableEq A] [inst_2 : DecidableEq E] [inst_3 : DecidableEq D] (Cs : Minidregg.Theory.AuthMap.Scheme A X E) (W : Minidregg.Theory.AuthMap.Scheme I E D) (w : Minidregg.Theory.AuthMap.Map I (Minidregg.Theory.AuthMap.Map A X)) (c : I) (r : E) (πw : Minidregg.Theory.AuthMap.Scheme.Opening I E D) (fp : List (Minidregg.Theory.PlanBinding.Opened.Entry A X E)), W.PathBinding (Minidregg.Theory.AuthMap.worldSlots Cs.root w) c (Option.some r) πw → W.verify (Minidregg.Theory.AuthMap.worldRoot W Cs.root w) c (Option.some r) πw = Bool.true → (∀ (cell : Minidregg.Theory.AuthMap.Map A X), Minidregg.Theory.AuthMap.lookup W.ix w c = Option.some cell → ∀ e ∈ fp, Cs.PathBinding cell e.key e.value e.opening) → Minidregg.Theory.PlanBinding.Opened.verifyAll Cs r fp = Bool.true → ∃ cell, Minidregg.Theory.AuthMap.lookup W.ix w c = Option.some cell ∧ ∀ e ∈ fp, Minidregg.Theory.AuthMap.lookup Cs.ix cell e.key = e.value
S def Minidregg.Theory.PlanBinding.Opened.verifyAll : {K V D : Type} → [DecidableEq K] → [DecidableEq D] → Minidregg.Theory.AuthMap.Scheme K V D → D → List (Minidregg.Theory.PlanBinding.Opened.Entry K V D) → Bool #2558464635
S theorem Minidregg.Theory.PlanBinding.Opened.verifyAll_openAll : ∀ {K V D : Type} [inst : DecidableEq K] [inst_1 : DecidableEq D] (S : Minidregg.Theory.AuthMap.Scheme K V D) (m : Minidregg.Theory.AuthMap.Map K V) (keys : List K), Minidregg.Theory.PlanBinding.Opened.verifyAll S (S.root m) (Minidregg.Theory.PlanBinding.Opened.openAll S m keys) = Bool.true
S theorem Minidregg.Theory.PlanBinding.Opened.verifyAll_sound : ∀ {K V D : Type} [inst : DecidableEq K] [inst_1 : DecidableEq D] (S : Minidregg.Theory.AuthMap.Scheme K V D) (m : Minidregg.Theory.AuthMap.Map K V) (fp : List (Minidregg.Theory.PlanBinding.Opened.Entry K V D)), (∀ e ∈ fp, S.PathBinding m e.key e.value e.opening) → Minidregg.Theory.PlanBinding.Opened.verifyAll S (S.root m) fp = Bool.true → ∀ e ∈ fp, Minidregg.Theory.AuthMap.lookup S.ix m e.key = e.value
