S theorem Minidregg.Kernel.GeneralSimplexReachability.committed_ancestor_of_later : ∀ {tr : Minidregg.Kernel.GenericSimplexVAInvariant.Trace} {roster faulty : Finset ℕ} {f : ℕ}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful tr roster faulty f → roster.card = 3 * f + 1 → faulty.card ≤ f → ∀ (v previous : ℕ) (b c : Minidregg.Kernel.GenericSimplex.Block), Minidregg.Kernel.GeneralSimplexReachability.KnownValue tr faulty v b → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt tr faulty previous c → previous ≤ v → c <+: b
