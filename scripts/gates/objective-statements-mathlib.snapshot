S def Minidregg.Kernel.HyperdocumentIndexSync.Snapshot.Fresh : {capacity : ℕ} → Minidregg.Kernel.HyperdocumentIndexSync.Snapshot capacity → Prop := fun {capacity} snapshot => snapshot.indexCheckpoint = snapshot.sourceCheckpoint ∧ snapshot.cursor.checkpoint = snapshot.sourceCheckpoint ∧ Minidregg.Kernel.HyperdocumentIndexSync.SyncCursor.Complete capacity snapshot.cursor ∧ snapshot.index = Minidregg.Kernel.HyperdocumentIndexSync.rebuild snapshot.corpus
S def Minidregg.Kernel.HyperdocumentIndexSync.Snapshot.MatchesDelta : {capacity : ℕ} → Minidregg.Kernel.HyperdocumentIndexSync.Snapshot capacity → Minidregg.Kernel.HyperdocumentIndexSync.Delta capacity → Prop := fun {capacity} snapshot delta => snapshot.sourceCheckpoint = delta.beforeCheckpoint ∧ snapshot.corpus delta.slot = delta.before ∧ delta.beforeCheckpoint.Follows delta.afterCheckpoint
