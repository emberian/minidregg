S def Minidregg.Kernel.GeneralSimplexReachability.AllowedInput : Minidregg.Kernel.GenericSimplex.Config → Finset ℕ → (Minidregg.Kernel.GeneralSimplexReachability.Network → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop) → Minidregg.Kernel.GeneralSimplexReachability.Network → ℕ → Minidregg.Kernel.GenericSimplex.Input → Prop := fun c faulty sourceChecked net receiver input => receiver < c.parties ∧ receiver ∉ faulty ∧ match input with | Minidregg.Kernel.GenericSimplex.Input.delivery m => Minidregg.Kernel.GeneralSimplexReachability.authenticDelivery c faulty net m | Minidregg.Kernel.GenericSimplex.Input.deliveryAt now m => Minidregg.Kernel.GeneralSimplexReachability.authenticDelivery c faulty net m | Minidregg.Kernel.GenericSimplex.Input.checked block => sourceChecked net receiver block | Minidregg.Kernel.GenericSimplex.Input.tick now => True | Minidregg.Kernel.GenericSimplex.Input.offer payload => True | Minidregg.Kernel.GenericSimplex.Input.poll => True
S inductive Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement : Minidregg.Kernel.GenericSimplex.Config → Finset ℕ → Minidregg.Kernel.GeneralSimplexReachability.Network → Prop
S theorem Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement.commits : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement c faulty net → ∀ (party view : ℕ) (block : Minidregg.Kernel.GenericSimplex.Block), party < c.parties → party ∉ faulty → (Minidregg.Kernel.GenericSimplex.viewAt (net.localState party) view).committed = Option.some block → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) faulty view block
S theorem Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement.delivered : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement c faulty net → ∀ (party : ℕ) (block : Minidregg.Kernel.GenericSimplex.Block), party < c.parties → party ∉ faulty → block ∈ (net.localState party).delivered → ∃ view, Minidregg.Kernel.GeneralSimplexReachability.CommittedAt (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) faulty view block
S theorem Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement.faithful : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement c faulty net → Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) (Finset.range c.parties) faulty c.faults
S ctor Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement.mk : ∀ {c : Minidregg.Kernel.GenericSimplex.Config} {faulty : Finset ℕ} {net : Minidregg.Kernel.GeneralSimplexReachability.Network}, Minidregg.Kernel.GenericSimplexVAInvariant.LocalFaithful (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) (Finset.range c.parties) faulty c.faults → (∀ (party view : ℕ) (block : Minidregg.Kernel.GenericSimplex.Block), party < c.parties → party ∉ faulty → (Minidregg.Kernel.GenericSimplex.viewAt (net.localState party) view).committed = Option.some block → Minidregg.Kernel.GeneralSimplexReachability.CommittedAt (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) faulty view block) → (∀ (party : ℕ) (block : Minidregg.Kernel.GenericSimplex.Block), party < c.parties → party ∉ faulty → block ∈ (net.localState party).delivered → ∃ view, Minidregg.Kernel.GeneralSimplexReachability.CommittedAt (Minidregg.Kernel.GeneralSimplexReachability.auditTrace net) faulty view block) → Minidregg.Kernel.GeneralSimplexReachability.AuditRefinement c faulty net
S def Minidregg.Kernel.GeneralSimplexReachability.CommittedAt : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → Finset ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop := fun tr faulty view block => view = 0 ∧ block = [] ∨ ∃ time, ∃ party ∉ faulty, tr time = Minidregg.Kernel.GenericSimplex.AuditEvent.commit party view block
S def Minidregg.Kernel.GeneralSimplexReachability.KnownValue : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → Finset ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop := fun tr faulty view block => view = 0 ∧ block = [] ∨ ∃ time, ∃ party ∉ faulty, tr time = Minidregg.Kernel.GenericSimplex.AuditEvent.prepare party view block ∨ tr time = Minidregg.Kernel.GenericSimplex.AuditEvent.commit party view block
S def Minidregg.Kernel.GeneralSimplexReachability.LocalCommitOutputAttestations : Minidregg.Kernel.GenericSimplexVAInvariant.Trace → Finset ℕ → Finset ℕ → ℕ → ℕ → Minidregg.Kernel.GenericSimplex.Block → Prop := fun tr roster faulty f view block => ∃ signers ⊆ roster, 2 * f + 1 ≤ signers.card ∧ ∀ party ∈ signers, party ∉ faulty → ∃ time, tr time = Minidregg.Kernel.GenericSimplex.AuditEvent.commit party view block
