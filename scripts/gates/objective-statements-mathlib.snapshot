S theorem Minidregg.Kernel.DeclaredResourceController.pinned_claim_stale_on_field_change : ∀ {E : Minidregg.Compiler.Evaluator} {program : Minidregg.Compiler.NockProgramCodec.Program} {validatedFundingIndex : Option ℕ} {libraries : List Minidregg.Compiler.NockProgramCodec.Program} {ambient ambient' : Minidregg.Kernel.DeclaredResourceController.Ambient} {command command' : Minidregg.Kernel.DeclaredResourceController.Command} {validatedFundingIndex' : Option ℕ} {pre : (i : Fin command.targets.length) → Minidregg.Theory.Store.Store command.targets[i].layout} {pre' : (i : Fin command'.targets.length) → Minidregg.Theory.Store.Store command'.targets[i].layout} {claim : Minidregg.Kernel.Run.RunClaim} {writes writes' : List Minidregg.Theory.Eval.FieldWrite} {verdict : Minidregg.Kernel.Run.Accepted} {slot : Minidregg.Compiler.NockProgramCodec.SampleSlot} {sample' : E.Input}, program.abi.door = Option.none → program.abi.context = Minidregg.Compiler.NockProgramCodec.ContextMode.pinned → Minidregg.Kernel.DeclaredResourceController.programTargets command' validatedFundingIndex' = Minidregg.Kernel.DeclaredResourceController.programTargets command validatedFundingIndex → Minidregg.Kernel.DeclaredResourceController.checkProgram E program libraries ambient command pre claim writes validatedFundingIndex = Except.ok verdict → E.sampleOf program.abi (Minidregg.Kernel.DeclaredResourceController.runContext ambient' command') (Minidregg.Kernel.DeclaredResourceController.programTargets command' validatedFundingIndex') (Minidregg.Kernel.DeclaredResourceController.programSampleRead command' pre' validatedFundingIndex') = Option.some sample' → slot ∈ program.abi.sample → Minidregg.Kernel.DeclaredResourceController.programSampleRead command pre validatedFundingIndex slot.target slot.slot ≠ Minidregg.Kernel.DeclaredResourceController.programSampleRead command' pre' validatedFundingIndex' slot.target slot.slot → (∀ s ∈ program.abi.sample, s ≠ slot → Minidregg.Kernel.DeclaredResourceController.programSampleRead command pre validatedFundingIndex s.target s.slot = Minidregg.Kernel.DeclaredResourceController.programSampleRead command' pre' validatedFundingIndex' s.target s.slot) → Minidregg.Kernel.DeclaredResourceController.checkProgram E program libraries ambient' command' pre' claim writes' validatedFundingIndex' = Except.error (Minidregg.Kernel.Run.Refusal.sampleStale (Option.some slot.key))
