S theorem Minidregg.Theory.PlanBinding.Opened.IdToy.stale_opening_refused : Minidregg.Theory.AuthMap.lookup Minidregg.Theory.AuthMap.IdToy.ix Minidregg.Theory.PlanBinding.Opened.IdToy.moved 1 = Option.some 7 ∧ Minidregg.Theory.AuthMap.IdToy.scheme.verify (Minidregg.Theory.AuthMap.IdToy.scheme.root Minidregg.Theory.PlanBinding.Opened.IdToy.moved) 1 (Option.some 7) (Minidregg.Theory.AuthMap.IdToy.scheme.opening Minidregg.Theory.AuthMap.IdToy.m 1) = Bool.false ∧ Minidregg.Theory.AuthMap.IdToy.scheme.verify (Minidregg.Theory.AuthMap.IdToy.scheme.root Minidregg.Theory.PlanBinding.Opened.IdToy.moved) 1 (Option.some 7) (Minidregg.Theory.AuthMap.IdToy.scheme.opening Minidregg.Theory.PlanBinding.Opened.IdToy.moved 1) = Bool.true
S theorem Minidregg.Theory.PlanBinding.Opened.LengthToy.forged_verifies_held_refuses : Minidregg.Theory.PlanBinding.Opened.verifyAll Minidregg.Theory.AuthMap.LengthToy.scheme (Minidregg.Theory.AuthMap.LengthToy.scheme.root Minidregg.Theory.AuthMap.LengthToy.m) [{ key := 5, value := Option.some 8, opening := Minidregg.Theory.AuthMap.LengthToy.forged }] = Bool.true ∧ Minidregg.Theory.PlanBinding.Opened.firstStaleHeld? Minidregg.Theory.AuthMap.LengthToy.scheme Minidregg.Theory.AuthMap.LengthToy.m [{ key := 5, value := Option.some 8, opening := Minidregg.Theory.AuthMap.LengthToy.forged }] = Option.some 5
