S theorem Minidregg.Selvage.batch_survives_prob_le : ∀ {ι : Type u_1} [inst : Fintype ι] {F : Type} [inst_1 : Field F] [inst_2 : Fintype F] [DecidableEq F] {f : ι → F} {cs : List (Minidregg.Selvage.LinearConstraint ι F)}, (∃ c ∈ cs, ¬Minidregg.Selvage.Satisfies f c) → (Minidregg.Selvage.uniformProb F fun γ => Minidregg.Selvage.Satisfies f (Minidregg.Selvage.batchConstraint γ cs)) ≤ ↑(cs.length - 1) / ↑(Fintype.card F)
