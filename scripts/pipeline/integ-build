#!/usr/bin/env bash
# scripts/pipeline/integ-build SHA -- the builder's build of SHA in the warm integration tree $BUILDER_ROOT/src
# (was hbox's box-local integ-build6.sh; now in the repo so any build box runs the same stages).
#   prime-cargo (the --offline stages' crates) -> rust-check -> host -> consent -> rust -> pack -> candidates/<sha>/READY, then umbrella-tree (a second warm
#   tree; src is freed for the next build once it has synced) and the fixture rerecord.
# Every stage under swarm-build; stage lines `stage NAME rc=N Ns` go to $BUILDER_ROOT/COMMANDS.log (the builder
# reads them). One build per tree: build.lock. Stops below 25 GB free.
# Box knobs (env): BUILDER_ROOT (default /srv/integ), SEATS (MINIDREGG_LEAN_SEATS, default 16), JOBS (native jobs, 8),
# MEM (SWARM_MEM_MAX of the host stage, 64G), UMBRELLA_SEATS (4), UMBRELLA_MEM (32G).
set -u
I=${BUILDER_ROOT:-/srv/integ}; SHA=${1:?usage: integ-build SHA}; src=$I/src; LOG=$I/COMMANDS.log
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}
export PATH=$HOME/.elan/bin:$HOME/.cargo/bin:/usr/local/bin:$PATH
export LANE_DIR=$I MINIDREGG_LEAN_SEAT_ROOT=${MINIDREGG_LEAN_SEAT_ROOT:-$I/seats} MINIDREGG_LEAN_SEATS=${SEATS:-16} \
  MINIDREGG_NATIVE_JOBS=${JOBS:-8} SWARM_MEM_MAX=${MEM:-64G}
say() { echo "$(date -Is) $*" >> "$LOG"; }
exec 9>"$I/build.lock"; flock -n 9 || { say "STOP: another build holds $I/build.lock"; exit 75; }
free=$(df -BG --output=avail "$I" | tail -1 | tr -dc 0-9); [ "$free" -ge 25 ] || { say "STOP disk $free G free under $I"; exit 70; }
cd "$src" || exit 2
git fetch -q origin || { say "fetch failed"; exit 3; }
git checkout -q --detach "$SHA" || { say "checkout $SHA failed"; exit 3; }
SHA=$(git rev-parse HEAD); touch .minidregg-native-snapshot
say "BUILD ${SHA:0:12} start (seats $MINIDREGG_LEAN_SEATS mem $SWARM_MEM_MAX, $(hostname))"
mkdir -p "$I/old" "$I/logs" "$I/candidates"
for d in native-out consent-out artifacts fixtures; do [ ! -e "$I/$d" ] || mv "$I/$d" "$I/old/$d.$(date +%s)"; done
# keep one generation of old outputs: the rest is disk (hbox filled this way)
ls -1dt "$I"/old/* 2>/dev/null | tail -n +5 | xargs -r rm -rf
stage() { local n=$1 t; shift; t=$(date +%s); swarm-build deploy/candidate/lane-build.sh "$@" > "$I/logs/$n.log" 2>&1; local rc=$?
  say "stage $n rc=$rc $(( $(date +%s) - t ))s"; return $rc; }
t=$(date +%s); scripts/pipeline/prime-cargo "$src" > "$I/logs/prime-cargo.log" 2>&1; rc=$?; say "stage prime-cargo rc=$rc $(( $(date +%s) - t ))s"
[ $rc = 0 ] || exit 9
stage rust-check rust-check || exit 10
stage host host || exit 11
stage consent consent || exit 12
stage rust rust || exit 13
C=$I/candidates/$SHA; [ -e "$C/READY" ] && { say "candidate $C already READY"; exit 0; }; rm -rf "$C"
stage pack pack "$C" || exit 14
date -Is > "$C/READY" && say "READY $C"
# candidates: keep the newest 6 (and green's, if present)
green=$(git rev-parse -q --verify origin/green 2>/dev/null || true)
ls -1dt "$I"/candidates/*/ 2>/dev/null | tail -n +7 | while read -r d; do [ "$(basename "$d")" = "$green" ] || rm -rf "$d"; done
# The umbrellas. This build keeps build.lock (src) until the umbrella tree has synced from src, then frees src:
# the builder starts the next tip's build while these umbrellas run. One umbrella tree, so a previous tip's
# umbrellas finish first (that wait holds src, the only queueing left). Stage lines here carry the sha
# (`stage umbrella-tree SHA12 rc=N`): they land after the next build's lines in COMMANDS.log.
s12=${SHA:0:12}; U=$I/logs/umbrella-tree-$s12.log; synced=$I/logs/umbrella-synced-$s12; rm -f "$synced"
while [ -d "$I/umbrella-src.lock" ] && kill -0 "$(cat "$I/umbrella-src.pid" 2>/dev/null)" 2>/dev/null; do sleep 20; done
t=$(date +%s)
MINIDREGG_LEAN_SEATS=${UMBRELLA_SEATS:-4} SWARM_MEM_MAX=${UMBRELLA_MEM:-32G} UMBRELLA_SYNCED=$synced \
  scripts/pipeline/umbrella-tree --src "$src" --tree "$I/umbrella-src" --out "$I/umbrella-tree-out" "$SHA" > "$U" 2>&1 9>&- &
upid=$!
while kill -0 $upid 2>/dev/null && [ ! -f "$synced" ]; do sleep 5; done
exec 9>&-; touch "$synced"   # src is free (also when umbrella-tree stopped before its sync); the umbrella tree
# never had fd 9 (`9>&-` above): a child holding it kept build.lock until the umbrellas ended (10-31 round 960da1d8)
wait $upid; say "stage umbrella-tree $s12 rc=$? $(( $(date +%s) - t ))s"
# The fixtures follow the Objective front end and the codec (scripts/native-accepted-fixture/rerecord.sh), run in
# the umbrella tree where the Fixtures oleans are: "unchanged" (0), "recorded fixture-regen/<sha12> <commit>"
# (0; pushed for review), "authority-differs <diff>" (4: a person's reviewed commit), 1 = a step failed.
if [ -x "$I/umbrella-src/scripts/native-accepted-fixture/rerecord.sh" ]; then
  R=$I/rerecord/${SHA:0:12}-$(date +%s); mkdir -p "$I/rerecord"; t=$(date +%s)
  ( cd "$I/umbrella-src" && MINIDREGG_LEAN_SEATS=${UMBRELLA_SEATS:-4} SWARM_MEM_MAX=${UMBRELLA_MEM:-32G} \
    swarm-build scripts/native-accepted-fixture/rerecord.sh "$C" "$R" ) > "$I/logs/rerecord-$s12.log" 2>&1; rc=$?
  last=$(tail -n1 "$I/logs/rerecord-$s12.log")
  say "stage rerecord $s12 rc=$rc $(( $(date +%s) - t ))s: $last"
  case "$last" in recorded\ fixture-regen/*) b=$(echo "$last" | cut -d' ' -f2)
    git -C "$I/umbrella-src" push -q origin "$b" && say "rerecord pushed $b" ;; esac
fi
