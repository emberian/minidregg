#!/usr/bin/env bash
# scripts/pipeline/lean-ask-selftest -- can lean-ask go red, and does it refuse a stale environment? (a falsifier)
#
#   scripts/pipeline/lean-ask-selftest WARM_TREE SCRATCH_DIR
#
# Makes a private warm copy (clone-warm) of WARM_TREE in SCRATCH_DIR, starts a lean-ask session there
# and asserts, against module M (default Theory.ObjectiveBendTypes) and a probe file importing it:
#   (1) check of a probe with a true theorem: exit 0;  (2) the same probe with a FALSE theorem: exit 1;
#   (3) goals at a tactic line returns a proof state;  (4) eval '#check' against M: exit 0, eval of a
#   false `example`: exit 1;  (5) after a committed change to M (a rebase would bring one), check AND
#   eval REFUSE (exit 3) naming M's source;  (6) --reload makes M current in a build slot and both
#   then see the planted declaration;  (7) WARM_TREE's M.olean is byte-identical before and after.
# Exit 0 only if all hold. Builds one module (and its importers in the probe's closure) in a slot.
set -uo pipefail
PIPELINE_PROG=lean-ask-selftest
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib.sh"
base=${1:?WARM_TREE}; S=${2:?SCRATCH_DIR}
[ ! -e "$S" ] || pipeline_die "refusing existing $S"
M=${SELFTEST_MODULE:-Theory.ObjectiveBendTypes}; mf=${M//.//}.lean
bo=$base/.lake/build/lib/lean/${M//.//}.olean
[ -f "$base/$mf" ] && [ -f "$bo" ] || pipeline_die "$M is not a built module of $base"
before=$(sha256sum "$bo" | cut -d' ' -f1)
"$here/clone-warm" "$base" "$S/src" >/dev/null || exit 1
cd "$S/src"
LA="$here/lean-ask"; fails=0
ok() { echo "ok   $*"; }; bad() { echo "FAIL $*"; fails=$((fails+1)); }
expect() { local want=$1 what=$2; shift 2; "$@" >"$S/last.out" 2>&1; local rc=$?
  [ "$rc" = "$want" ] && ok "$what (exit $rc)" || { bad "$what: exit $rc, wanted $want"; sed 's/^/     /' "$S/last.out" | head -12; }; }
P=.lake/lean-ask/probe/Probe.lean; mkdir -p "$(dirname "$P")"
printf 'import %s\n\ntheorem laneAskProbe (n : Nat) : n + 0 = n := by\n  simp\n' "$M" >"$P"
t0=$(date +%s%N)
expect 0 "(1) check, true theorem" "$LA" check "$P"
echo "     first check (session start + import load): $(( ($(date +%s%N) - t0) / 1000000 )) ms"
printf 'import %s\n\ntheorem laneAskProbe (n : Nat) : n + 1 = n := by\n  simp\n' "$M" >"$P"
expect 1 "(2) check, FALSE theorem goes red" "$LA" check "$P"
"$LA" goals "$P:4:2" >"$S/goals.out" 2>&1; grep -q '⊢' "$S/goals.out" && ok "(3) goals at the tactic: $(grep -m1 '⊢' "$S/goals.out")" || { bad "(3) goals"; cat "$S/goals.out"; }
expect 0 "(4a) eval #check against $M" "$LA" eval "#check Nat.succ" --imports "$M"
expect 1 "(4b) eval of a false example goes red" "$LA" eval "example : (2 : Nat) + 2 = 5 := by decide" --imports "$M"
cp -p "$mf" "$mf.t" && mv -f "$mf.t" "$mf"          # never write a shared inode in place
printf '\n/-- lean-ask-selftest probe. -/\ndef leanAskPlanted20261006 : Nat := 42\n' >>"$mf"
git -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -qam "selftest: plant a declaration in $M"
printf 'import %s\n\n#check @leanAskPlanted20261006\n' "$M" >"$P"
expect 3 "(5a) check REFUSES after $M changed" "$LA" check "$P"
grep -q "$mf" "$S/last.out" && ok "(5a') the refusal names $mf" || bad "(5a') refusal does not name $mf"
expect 3 "(5b) eval REFUSES after $M changed" "$LA" eval "#check @leanAskPlanted20261006" --imports "$M"
expect 0 "(6a) check --reload rebuilds and sees the planted declaration" "$LA" check "$P" --reload
grep -q 'leanAskPlanted20261006 : Nat' "$S/last.out" && ok "(6a') planted declaration visible" || bad "(6a') not visible"
expect 0 "(6b) eval --reload sees it" "$LA" eval "#check @leanAskPlanted20261006" --imports "$M" --reload
"$LA" stop
after=$(sha256sum "$bo" | cut -d' ' -f1)
[ "$before" = "$after" ] && ok "(7) base $M.olean unchanged" || bad "(7) BASE $M.olean CHANGED ($before -> $after)"
[ "$fails" = 0 ] && echo "lean-ask-selftest: PASS" || { echo "lean-ask-selftest: $fails FAILED"; exit 1; }
