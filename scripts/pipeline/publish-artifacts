#!/usr/bin/env bash
# scripts/pipeline/publish-artifacts -- build one tip's native binaries ONCE and publish them.
#
#   scripts/pipeline/publish-artifacts TIP LABEL [WARM_TREE]
#
# PIPELINE regime item 3 (artifacts once per tip), on the gate box. TIP is a 40-hex commit,
# LABEL one or more of main|green|next joined by + (main+green). WARM_TREE is a built clone at TIP (the merge keeper's gated tree,
# the warm base, the `next` base); default: found by pipeline_find_tree. Without one at TIP, the
# newest warm base is copied and moved to TIP, and the Lean delta compiles here, once.
#
# Steps, all in a private copy (scripts/pipeline/clone-warm) so the keeper's tree is never written:
#   host     deploy/candidate/lane-build.sh host --umbrella --umbrella-target Host.Main (links
#            minidregg-host; Lake builds the Host closure, which replays on a gated tree:
#            compiled_source_modules=0; the gate's own umbrella is the merge keeper's)
#   consent  lane-build.sh consent                            (minidregg-client-consent)
#   prime    scripts/pipeline/prime-cargo: the box's shared cargo cache gets every crate of the tip
#            (online), so the offline candidate build and every lane's offline cargo never miss one
#   rust     lane-build.sh rust: every role of `package.py --rust-roles` (mini, mini-keys, the spk
#            pieces, ...) through the fixed build root, with the box's shared sccache
#   pack     lane-build.sh pack $ARTIFACT_ROOT/TIP: the candidate format (bin/, SHA256SUMS,
#            provenance.json, manifest.json with absolute paths under $ARTIFACT_ROOT/TIP)
# host+consent+rust run under swarm-build: 16G and no build slot on a gated tree (nothing Lean
# compiles), one slot and 32G when the Lean delta compiles here.
# Then scripts/pipeline/smoke-artifacts: the packed set must RUN (every binary executes, the
# consent companion answers, journey J0+J1 on a scratch world) before it may be READY.
# RESUMABLE: each step that succeeds leaves .work/TIP/logs/STEP.done; a failed run keeps its work
# directory, and the next run (artifact-watch retries PIPELINE_PUBLISH_RETRIES times, or by hand)
# continues from the first step without a .done, in the same private clone.
# Then: PROVENANCE (one line: tip, label, toolchains, build command, wall seconds), timings.tsv,
# commits.tsv (commits since the previous green set: sha, subject, files; the journey runner
# names owners from it), logs/pipeline/, READY, the LABEL symlink, and the mirrors
# (scripts/pipeline/mirror-artifacts). A READY set is never rebuilt; only relabelled.
set -euo pipefail
PIPELINE_PROG=publish-artifacts
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib.sh"
tip=$(pipeline_full_sha "${1:?TIP}"); label=${2:?LABEL}; tree=${3:-}
labels=${label//+/ }        # the keeper writes compound labels: main+green
for l in $labels; do case "$l" in main|green|next) ;; *) pipeline_die "LABEL must be main|green|next joined by +" ;; esac; done
out=$ARTIFACT_ROOT/$tip
# The BUILDER (lane-build.sh + lib.sh) is the pipeline's own, not the tip's: the fixed build root
# and sccache are properties of how this box builds, and an older tip's copy predates them. The
# tip supplies everything compiled and the role list (deploy/candidate/package.py, from the tree).
builder=""
for d in "$here/../../deploy/candidate" "$here/../candidate"; do
  [ -x "$d/lane-build.sh" ] && grep -q candidate_build_root "$d/lib.sh" 2>/dev/null && { builder=$(CDPATH='' cd -- "$d" && pwd -P); break; }
done
[ -n "$builder" ] || pipeline_die "no builder with the fixed build root next to $here"
mkdir -p "$ARTIFACT_ROOT/.work"
exec 8>"$ARTIFACT_ROOT/.work/$tip.lock"
flock -n 8 || { pipeline_log "$tip is being published by another run"; exit 0; }
if [ -f "$out/READY" ]; then
  for l in $labels; do pipeline_label "$l" "$tip"; done; pipeline_log "$tip already READY; labelled $label"; exit 0
fi
t0=$(date +%s)
from=$(pipeline_find_tree "$tip" "$tree")
moved=""
if [ -z "$from" ]; then
  from=$(CDPATH='' cd -- /srv/warm-base/src && pwd -P)
  moved=" (warm base $(git -C "$from" rev-parse --short=12 HEAD) moved to the tip; Lean delta compiled here)"
fi
W=$ARTIFACT_ROOT/.work/$tip
rm -rf "$out"                           # a packed set is never resumed: pack + smoke rerun whole
if [ -f "$W/logs/clone.done" ] && [ "$(git -C "$W/src" rev-parse HEAD 2>/dev/null)" = "$tip" ] \
   && [ -z "$(git -C "$W/src" status --porcelain --untracked-files=no)" ]; then
  [ -f "$W/moved" ] && moved=$(cat "$W/moved") || moved=""
  pipeline_log "RESUMING $tip from $W (done: $(cd "$W/logs" && ls *.done 2>/dev/null | sed 's/\.done$//' | paste -sd' '))"
else
  rm -rf "$W"                           # no usable earlier attempt: start clean
  mkdir -p "$W/logs"
  "$here/clone-warm" "$from" "$W/src" >"$W/logs/clone.log" 2>&1 || { cat "$W/logs/clone.log" >&2; rm -rf "$W"; exit 1; }
  if [ "$(git -C "$W/src" rev-parse HEAD)" != "$tip" ]; then
    git -C "$W/src" cat-file -e "$tip^{commit}" 2>/dev/null || git -C "$W/src" fetch -q "$PIPELINE_REPO_URL" "$tip" "+refs/heads/*:refs/remotes/github/*" "+refs/tags/*:refs/tags/*"
    git -C "$W/src" checkout -q -B main "$tip"
  fi
  printf '%s' "$moved" >"$W/moved"; : >"$W/logs/timings.tsv"; touch "$W/logs/clone.done"
fi
cd "$W/src"
t_clone=$(date +%s)
pipeline_log "building $tip ($label) from $from$moved"

# --- the build chain, one slot, one memory cap ------------------------------------------------
cat >"$W/chain.sh" <<CHAIN
#!/usr/bin/env bash
set -euo pipefail
cd "$W/src"
export LANE_DIR="$W" MINI_CANDIDATE_CARGO_JOBS=\${MINI_CANDIDATE_CARGO_JOBS:-8}
[ -f "$PIPELINE_ROOT/sccache.env" ] && . "$PIPELINE_ROOT/sccache.env"
if [ -n "$moved" ] && [ ! -f "$W/logs/umbrella.done" ]; then   # not a gated tree: compile the delta in parallel first (the native builder serializes Lean)
  s=\$(date +%s)
  LEAN_NUM_THREADS=\${PIPELINE_LEAN_THREADS:-\${LEAN_NUM_THREADS:-8}} lake build Minidregg +Host.Main:leanArts ObjectiveProofs >"$W/logs/umbrella.log" 2>&1
  printf 'umbrella\t%s\n' \$(( \$(date +%s) - s )) >>"$W/logs/timings.tsv"; touch "$W/logs/umbrella.done"
fi
for step in host consent prime rust; do
  [ -f "$W/logs/\$step.done" ] && continue
  s=\$(date +%s); echo \$step >"$W/logs/current"
  # a failed attempt's partial output (build-native-host refuses an existing output directory)
  case \$step in host) rm -rf "$W/native-out" ;; consent) rm -rf "$W/consent-out" ;; esac
  case \$step in
    # The publisher links binaries of a tip the merge gate already judged: its Lake step is the
    # Host closure (Host.Main), not the gate's umbrella (a red Assurance fixture that can only be
    # regenerated FROM these binaries must not block them). Older tips' builders lack the option.
    host) if grep -q -- '--umbrella-target' scripts/build-native-host.sh; then
            "$builder/lane-build.sh" host --umbrella --umbrella-target Host.Main
          else "$builder/lane-build.sh" host --umbrella; fi ;;
    prime) "$here/prime-cargo" "$W/src" ;;
    *) "$builder/lane-build.sh" \$step ;;
  esac >"$W/logs/\$step.log" 2>&1
  printf '%s\t%s\n' \$step \$(( \$(date +%s) - s )) >>"$W/logs/timings.tsv"; touch "$W/logs/\$step.done"
done
rm -f "$W/logs/current"
CHAIN
chmod +x "$W/chain.sh"
# A gated tree compiles no Lean here (the umbrella replays; the native builder links and compiles C
# at 2 jobs): no build slot, 16G, so the keeper's gate never waits on a publication (2x32G + 16G
# < the 84G slice). Moving a base to the tip compiles Lean: then a slot and 32G, like any build.
# (one of the box's lane slots, $PIPELINE_SLOTS: the merge keeper's gate slots are never in it)
if [ -n "$moved" ]; then run=(pipeline_slot env SWARM_MEM_MAX="${SWARM_MEM_MAX:-32G}" swarm-build)
else run=(env SWARM_MEM_MAX="${PIPELINE_PUBLISH_MEM_MAX:-16G}" swarm-build); fi
"${run[@]}" "$W/chain.sh" \
  || { pipeline_log "build chain FAILED for $tip at step $(cat "$W/logs/current" 2>/dev/null); the next run resumes there; logs in $W/logs"; tail -30 "$W/logs/$(cat "$W/logs/current" 2>/dev/null || echo host).log" >&2 || true; exit 1; }
t_build=$(date +%s)
LANE_DIR=$W "$builder/lane-build.sh" pack "$out" >"$W/logs/pack.log" 2>&1 || { cat "$W/logs/pack.log" >&2; exit 1; }

# --- provenance, owners, timings ------------------------------------------------------------
prev=""
[ -L "$ARTIFACT_ROOT/green" ] && prev=$(readlink "$ARTIFACT_ROOT/green")
[ -n "$prev" ] && git cat-file -e "$prev^{commit}" 2>/dev/null && git merge-base --is-ancestor "$prev" "$tip" || prev=$(git rev-parse "$tip~1")
git log --no-merges --format='%x01%H%x09%s' --name-only "$prev..$tip" | python3 -c '
import sys
for rec in sys.stdin.read().split("\x01")[1:]:
    lines=[l for l in rec.splitlines() if l.strip()]
    sha,subj=lines[0].split("\t",1)
    print(sha+"\t"+subj+"\t"+",".join(lines[1:]))' >"$out/commits.tsv"
mkdir -p "$out/logs/pipeline"
cp "$W"/logs/*.log "$W/logs/timings.tsv" "$out/logs/pipeline/"
cp "$W/native-out/manifest.txt" "$out/logs/pipeline/host-build-manifest.txt"
t_end=$(date +%s)
{ cat "$W/logs/timings.tsv"; printf 'pack\t%s\n' $((t_end - t_build)); } >"$out/timings.tsv"   # steps of every (resumed) attempt; wall_s = their sum
rust=$(sed -n 's/^channel *= *"\(.*\)"$/\1/p' rust-toolchain.toml)
printf 'tip=%s label=%s lean=%s rust=%s built_on=%s from=%s%s command="clone-warm + lane-build.sh host --umbrella(-target Host.Main), consent, rust (fixed build root, sccache), pack" compiled_source_modules=%s wall_s=%s finished=%s\n' \
  "$tip" "$label" "$(cat lean-toolchain)" "$rust" "$(hostname)" "$from" "$moved" \
  "$(sed -n 's/^compiled_source_modules=//p' "$W/native-out/manifest.txt" "$W/logs/host.log" 2>/dev/null | head -1)" \
  "$(awk -F'\t' '{s+=$2} END {print s+0}' "$out/timings.tsv" | head -1)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$out/PROVENANCE"
(cd "$out" && sha256sum --quiet -c SHA256SUMS) || pipeline_die "fresh set fails its own SHA256SUMS"
s=$(date +%s)
"$here/smoke-artifacts" "$out" "$W/logs/smoke" >"$W/logs/smoke.log" 2>&1 \
  || { cat "$W/logs/smoke.log" >&2; rm -rf "$out"; pipeline_die "the set does not run (smoke above; logs $W/logs/smoke); not READY"; }
cp -r "$W/logs/smoke" "$W/logs/smoke.log" "$out/logs/pipeline/"
printf 'smoke\t%s\n' $(( $(date +%s) - s )) >>"$out/timings.tsv"
date -u +%Y-%m-%dT%H:%M:%SZ >"$out/READY"
for l in $labels; do pipeline_label "$l" "$tip"; done
pipeline_log "READY $out ($((t_end - t0)) s)"
"$here/mirror-artifacts" "$tip" "$label" "$W/src" || pipeline_log "mirror of $tip incomplete (see above); the set is READY here"
cd "$ARTIFACT_ROOT" && rm -rf "$W"
