#!/usr/bin/env python3
"""scripts/pipeline/warm-link -- make DST's Lake build outputs as warm as SRC's, by hard links.

    scripts/pipeline/warm-link SRC/.lake/build DST/.lake/build

Per module (one `lib/lean/<Module>.trace` in SRC), newest wins: when SRC's trace is newer than DST's (or DST
has none), DST takes SRC's files for that module:
  - outputs (.olean, .olean.private, .olean.server, .ilean, .ir, .ir.sig, .c, .o) as HARD LINKS;
  - its .trace and .hash files as COPIES (lake writes .trace in place);
  - never its .setup.json (lake writes it in place, and it names SRC's absolute paths; lake writes DST's own
    when DST rebuilds the module).
A module only DST has keeps DST's files. Each file lands by rename(2), so a reader never sees half a file.

Why links are safe: Lean v4.35.0 and leanc write every output above to a temporary and rename(2) it, so a
rebuild in either tree gives that tree a new inode and leaves the other's untouched (measured 2026-10-30: a
rebuilt module's outputs split, every untouched module's stay shared). The two in-place writers (.trace,
.setup.json) are never shared. Lake's traces decide what DST rebuilds, so a module whose DST source differs
from SRC's is rebuilt in DST, never trusted: the sync can cost rebuilds, never correctness.
Prints one summary line. Exit 0, or 2 on bad arguments.
"""
import os
import sys

SHARE = ('.olean', '.olean.private', '.olean.server', '.ilean', '.ir', '.ir.sig', '.c', '.o')


def kind(name):
    if name.endswith('.setup.json'):
        return 'skip'
    if name.endswith('.trace') or name.endswith('.hash'):
        return 'copy'
    if name.endswith(SHARE):
        return 'link'
    return 'copy'


def place(src, dst, how):
    tmp = dst + '.wl.tmp'
    if os.path.lexists(tmp):
        os.unlink(tmp)
    if how == 'link':
        os.link(src, tmp)
    else:
        with open(src, 'rb') as a, open(tmp, 'wb') as b:
            b.write(a.read())
        st = os.stat(src)
        os.utime(tmp, (st.st_atime, st.st_mtime))
    os.replace(tmp, dst)


def main(src, dst):
    lib = os.path.join(src, 'lib', 'lean')
    if not os.path.isdir(lib):
        print(f'warm-link: {lib} is not a Lake build directory', file=sys.stderr)
        return 2
    os.makedirs(dst, exist_ok=True)
    linked = copied = modules = 0
    for root, _, files in os.walk(lib):
        for f in files:
            if not f.endswith('.trace'):
                continue
            mod = os.path.relpath(os.path.join(root, f[:-len('.trace')]), lib)
            s_tr = os.path.join(lib, mod + '.trace')
            d_tr = os.path.join(dst, 'lib', 'lean', mod + '.trace')
            if os.path.exists(d_tr) and os.stat(d_tr).st_mtime >= os.stat(s_tr).st_mtime:
                continue
            modules += 1
            base = os.path.basename(mod)
            for sub in ('lib/lean', 'ir'):
                sdir = os.path.join(src, sub, os.path.dirname(mod))
                ddir = os.path.join(dst, sub, os.path.dirname(mod))
                if not os.path.isdir(sdir):
                    continue
                names = [n for n in os.listdir(sdir) if n.startswith(base + '.') and not n.endswith('.wl.tmp')]
                if not names:
                    continue
                os.makedirs(ddir, exist_ok=True)
                for n in sorted(names, key=lambda n: n.endswith('.trace')):  # the trace last
                    how = kind(n)
                    if how == 'skip':
                        continue
                    s, d = os.path.join(sdir, n), os.path.join(ddir, n)
                    if how == 'link' and os.path.exists(d) and os.stat(d).st_ino == os.stat(s).st_ino:
                        continue
                    place(s, d, how)
                    if how == 'link':
                        linked += 1
                    else:
                        copied += 1
    print(f'warm-link: {modules} modules from {src} ({linked} links, {copied} copies)')
    return 0


if __name__ == '__main__':
    if len(sys.argv) != 3:
        print(__doc__.strip().split('\n')[2], file=sys.stderr)
        sys.exit(2)
    sys.exit(main(os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])))
