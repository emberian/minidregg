#!/usr/bin/env bash
# scripts/pipeline/box-env -- write this box's topology, the one box-local file lib.sh reads.
#
#   scripts/pipeline/box-env --slots 'S1 S2 ...' --lean-threads N [--origin U@H] [--mirrors 'U@H ...']
#                            [--small-slots 'S1 S2'] [--peer ALIAS] [--gate-slots 'S...'] [--fetch-from U@H] [--spk PATH]
#
# Writes $PIPELINE_ROOT/box.env (exports only). Lanes get it by `. /srv/pipeline/box.env` (put that
# line in ~/.profile); every pipeline script gets it through lib.sh. Keys:
#   PIPELINE_SLOTS        the lane build slots (flock files), one Lean build each; never the gate's
#   LEAN_NUM_THREADS      threads per Lean build: slots x threads ~= the box's hardware threads
#   PIPELINE_SMALL_SLOTS  small-check slots: rebuilds of <= 50 stale modules (lean-ask --reload,
#                         lane-check) at 2 threads, never queued behind a full build
#   PIPELINE_ORIGIN       the box that builds artifact sets; PIPELINE_MIRRORS the boxes it copies to
#   PIPELINE_GATE_SLOTS   the merge gate's slots: never a lane's, never reclaimed by `slots`
#   PIPELINE_PEER         the sibling box's peer alias (setup-box-peer): `slots` shows its free slots
#   PIPELINE_FETCH_FROM   where fetch-artifacts pulls a set this box lacks (needs that box's peer key)
#   SPK                   the signed spk package the SPK fixture journeys install (fixture-v4.sh)
set -euo pipefail
PIPELINE_PROG=box-env
. "$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/lib.sh"
gate="" peer="" small="" slots="" threads="" origin="" mirrors="" from="" spk=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slots) slots=$2 ;; --lean-threads) threads=$2 ;; --origin) origin=$2 ;;
    --mirrors) mirrors=$2 ;; --fetch-from) from=$2 ;; --spk) spk=$2 ;; --small-slots) small=$2 ;; --peer) peer=$2 ;; --gate-slots) gate=$2 ;;
    *) pipeline_die "unknown argument $1" ;;
  esac; shift 2
done
[ -n "$slots" ] && [ -n "$threads" ] || pipeline_die "--slots and --lean-threads are required"
for s in $slots $small; do [ -e "$s" ] || pipeline_die "slot file $s does not exist (create it first)"; done
{ printf '# Written by scripts/pipeline/box-env on %s at %s. Exports only.\n' "$(hostname)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'export PIPELINE_SLOTS=%q\nexport LEAN_NUM_THREADS=%q\n' "$slots" "$threads"
  [ -n "$small" ] && printf 'export PIPELINE_SMALL_SLOTS=%q\n' "$small"
  [ -n "$gate" ] && printf 'export PIPELINE_GATE_SLOTS=%q\n' "$gate"
  [ -n "$peer" ] && printf 'export PIPELINE_PEER=%q\n' "$peer"
  [ -n "$origin" ] && printf 'export PIPELINE_ORIGIN=%q\n' "$origin"
  [ -n "$mirrors" ] && printf 'export PIPELINE_MIRRORS=%q\n' "$mirrors"
  [ -n "$from" ] && printf 'export PIPELINE_FETCH_FROM=%q\n' "$from"
  [ -n "$spk" ] && printf 'export SPK=%q\n' "$spk"
  [ -f "$PIPELINE_ROOT/sccache.env" ] && printf '. %q\n' "$PIPELINE_ROOT/sccache.env"
  # the shared Lake artifact cache, for trees with restoreAllArtifacts (scripts/pipeline/lake-shim/lake)
  printf 'export PIPELINE_LAKE_CACHE=${PIPELINE_LAKE_CACHE:-/srv/lake-cache}\nexport PATH=%q:$PATH\n' "$PIPELINE_ROOT/scripts/lake-shim"
  true; } >"$PIPELINE_ROOT/box.env.new"
mv -f "$PIPELINE_ROOT/box.env.new" "$PIPELINE_ROOT/box.env"
cat "$PIPELINE_ROOT/box.env"
