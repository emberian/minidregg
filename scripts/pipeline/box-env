#!/usr/bin/env bash
# scripts/pipeline/box-env -- write this box's topology, the one box-local file lib.sh reads.
#
#   scripts/pipeline/box-env --slots 'S1 S2 ...' --lean-threads N [--origin U@H] [--mirrors 'U@H ...']
#                            [--small-slots 'S1 S2'] [--peer ALIAS] [--gate-slots 'S...'] [--fetch-from U@H] [--spk PATH]
#                            [--layout DIR] [--shared-git PATH] [--set 'K=V ...'] [--lake-cache DIR]
#
# Writes $PIPELINE_ROOT/box.env (exports only). Lanes get it by `. /srv/pipeline/box.env` (put that
# line in ~/.profile); every pipeline script gets it through lib.sh. Keys:
#   PIPELINE_SLOTS        the lane build slots (flock files), one Lean build each; never the gate's
#   LEAN_NUM_THREADS      threads per Lean build: slots x threads ~= the box's hardware threads
#   PIPELINE_SMALL_SLOTS  small-check slots: rebuilds of <= 50 stale modules (lean-ask --reload,
#                         lane-check) at 2 threads, never queued behind a full build
#   PIPELINE_ORIGIN       the box that builds artifact sets; PIPELINE_MIRRORS the boxes it copies to
#   PIPELINE_GATE_SLOTS   the merge gate's slots: never a lane's, never reclaimed by `slots`
#   PIPELINE_PEER         the sibling box's peer alias (setup-box-peer): `slots` shows its free slots
#   PIPELINE_FETCH_FROM   where fetch-artifacts pulls a set this box lacks (needs that box's peer key)
#   SPK                   the signed spk package the SPK fixture journeys install (fixture-v4.sh)
#   --layout DIR          a box whose pipeline does not live under /srv (hbox: /tank/dregg-build/pipeline):
#                         PIPELINE_ROOT=DIR and ARTIFACT_ROOT, JOURNEY_ROOT, PIPELINE_LANES, PIPELINE_WARM_BASE,
#                         PIPELINE_NEXT_BASE = DIR/{artifacts,journeys,lanes,warm-base,next-base}; the first
#                         --gate-slots entry becomes PIPELINE_GATE_SLOT (slot-mk.sh). Generalizes the /srv
#                         defaults of lib.sh, mk-lane.sh, advance-base-burst.sh and slot-mk.sh: one file, no fork.
#   --shared-git PATH     PIPELINE_SHARED_GIT, the box's shared bare repo (mk-lane's `shared` remote)
#   --set 'K=V ...'       further exports, verbatim (e.g. PIPELINE_LEANENV_WAIT_S=0 on a box without lean envs)
#   --lake-cache DIR      the box's ONE shared Lake artifact cache (default $PIPELINE_ROOT/lake-cache, created).
#                         Always on: box.env exports LAKE_CACHE_DIR=DIR and LAKE_ARTIFACT_CACHE=true, so a module
#                         any lane, the warm base or the gate compiled from identical inputs is restored (hard
#                         link, restoreAllArtifacts in lakefile.toml) instead of compiled again. A caller's own
#                         LAKE_ARTIFACT_CACHE=false or LAKE_CACHE_DIR wins. No PATH entry, no installed shim: the
#                         guard (lake-cache-audit) runs from the TIP tree's lib.sh (pipeline_cache_audit) before
#                         every slot build, lane-check, landing gate and publish.
set -euo pipefail
PIPELINE_PROG=box-env
. "$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/lib.sh"
gate="" peer="" small="" slots="" threads="" origin="" mirrors="" from="" spk="" layout="" sharedgit="" sets="" lakecache=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slots) slots=$2 ;; --lean-threads) threads=$2 ;; --origin) origin=$2 ;;
    --mirrors) mirrors=$2 ;; --fetch-from) from=$2 ;; --spk) spk=$2 ;; --small-slots) small=$2 ;; --peer) peer=$2 ;; --gate-slots) gate=$2 ;;
    --layout) layout=$2 ;; --shared-git) sharedgit=$2 ;; --set) sets=$2 ;; --lake-cache) lakecache=$2 ;;
    --no-lake-shim) pipeline_die "--no-lake-shim is gone: the shared Lake cache is on by construction (box.env exports LAKE_CACHE_DIR + LAKE_ARTIFACT_CACHE; no shim on PATH). Drop the flag; --lake-cache DIR picks the directory." ;;
    *) pipeline_die "unknown argument $1" ;;
  esac; shift 2
done
[ -n "$slots" ] && [ -n "$threads" ] || pipeline_die "--slots and --lean-threads are required"
if [ -n "$layout" ]; then
  layout=$(realpath -m "$layout"); [ -d "$layout" ] || pipeline_die "--layout $layout is not a directory"
  PIPELINE_ROOT=$layout
fi
for s in $slots $small $gate; do [ -e "$s" ] || pipeline_die "slot file $s does not exist (create it first)"; done
lakecache=${lakecache:-$PIPELINE_ROOT/lake-cache}
mkdir -p "$lakecache" && lakecache=$(realpath "$lakecache") || pipeline_die "cannot create the Lake cache directory $lakecache"
{ printf '# Written by scripts/pipeline/box-env on %s at %s. Exports only.\n' "$(hostname)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ -n "$layout" ]; then
    printf 'export PIPELINE_ROOT=%q\nexport ARTIFACT_ROOT=%q\nexport JOURNEY_ROOT=%q\nexport PIPELINE_LANES=%q\nexport PIPELINE_WARM_BASE=%q\nexport PIPELINE_NEXT_BASE=%q\n' \
      "$layout" "$layout/artifacts" "$layout/journeys" "$layout/lanes" "$layout/warm-base" "$layout/next-base"
    [ -n "$gate" ] && printf 'export PIPELINE_GATE_SLOT=%q\n' "${gate%% *}"
  fi
  [ -n "$sharedgit" ] && printf 'export PIPELINE_SHARED_GIT=%q\n' "$sharedgit"
  printf 'export PIPELINE_SLOTS=%q\nexport LEAN_NUM_THREADS=%q\n' "$slots" "$threads"
  [ -n "$small" ] && printf 'export PIPELINE_SMALL_SLOTS=%q\n' "$small"
  [ -n "$gate" ] && printf 'export PIPELINE_GATE_SLOTS=%q\n' "$gate"
  [ -n "$peer" ] && printf 'export PIPELINE_PEER=%q\n' "$peer"
  [ -n "$origin" ] && printf 'export PIPELINE_ORIGIN=%q\n' "$origin"
  [ -n "$mirrors" ] && printf 'export PIPELINE_MIRRORS=%q\n' "$mirrors"
  [ -n "$from" ] && printf 'export PIPELINE_FETCH_FROM=%q\n' "$from"
  [ -n "$spk" ] && printf 'export SPK=%q\n' "$spk"
  [ -f "$PIPELINE_ROOT/sccache.env" ] && printf '. %q\n' "$PIPELINE_ROOT/sccache.env"
  # the box's shared Lake artifact cache (lakefile.toml restoreAllArtifacts; guard: lib.sh pipeline_cache_audit)
  printf 'export PIPELINE_LAKE_CACHE=%q\n' "$lakecache"
  printf 'export LAKE_CACHE_DIR=${LAKE_CACHE_DIR:-%q}\nexport LAKE_ARTIFACT_CACHE=${LAKE_ARTIFACT_CACHE:-true}\n' "$lakecache"
  for kv in $sets; do printf 'export %s=%q\n' "${kv%%=*}" "${kv#*=}"; done
  true; } >"$PIPELINE_ROOT/box.env.new"
mv -f "$PIPELINE_ROOT/box.env.new" "$PIPELINE_ROOT/box.env"
cat "$PIPELINE_ROOT/box.env"
