}

product_pay_step() {
  local id=$1 d=$SRC/native/resource-client/journey.d/jpay$1.sh artifact rc
  [ -f "$d" ] || return 99
  product_native || return $?
  product_tools cmp || return $?
  python3 -c 'import nacl.signing' 2>/dev/null || { echo "missing input: Python nacl.signing" >&2; return 98; }
  if [ "$id" = 1 ] || [ "$id" = 4 ]; then product_input PAY_WATCHER_BIN executable || return $?; fi
  if [ "$id" = 6 ]; then
    product_systemd || return $?
    product_tools sudo || return $?
    sudo -n true 2>/dev/null || { echo "no sudo: sudo -n probe failed" >&2; return 98; }
    product_userns /usr/bin/bwrap /usr/local/libexec/mini-grain-bwrap || return $?
    local name
    for name in GRAIN TEST_PROVIDER LAUNCH_GATE; do product_input "$name" executable || return $?; done
  fi
  mkdir -p "$RUN/pay$id"
  JOURNEY_STEP_DIR=$RUN/pay$id product_exec "JPAY$id" bash "$d"; rc=$?
  # Drivers name their deciding artifact on their last stdout line.
  artifact=$(tail -1 "$OUT/JPAY$id.out")
  # A driver that binds sockets runs in a short dir (journey.d/lib/shortdir.sh) copied back to
  # STEP_DIR/rt on exit; its named artifact moves with it, as journey.sh rewrites a hook's.
  if [ -f "$RUN/pay$id/rt.origin" ]; then
    local origin; origin=$(cat "$RUN/pay$id/rt.origin")
    case "$artifact" in "$origin"/*) artifact=$RUN/pay$id/rt${artifact#"$origin"} ;; esac
  fi
  if [ -n "$artifact" ] && [[ $artifact == "$RUN/"* ]] && [ -s "$artifact" ]; then cp "$artifact" "$OUT/JPAY$id-result.txt"; fi
  [ "$rc" = 0 ] || return "$rc"
  product_evidence "$OUT/JPAY$id-result.txt" || return 1
  grep -Eq "^J-PAY-$id PASS [1-9][0-9]*/[1-9][0-9]*" "$OUT/JPAY$id.err" || { echo "missing expected evidence: JPAY$id completion verdict" >&2; return 1; }
  if [ "$id" != 1 ]; then
    awk -F'\t' 'NR>1 {n++; if($1!="PASS") bad=1} END {exit !(n>0 && !bad)}' "$OUT/JPAY$id-result.txt" || { echo "invalid expected evidence: JPAY$id rows" >&2; return 1; }
  fi
  tail -1 "$OUT/JPAY$id.err" >&2
}
# world: genesis, OWED a template: JPAY2/E2/4/6 write their own genesis (observer, friends 8/9/31, the tariff); a template once those are the fixture's knobs
row_jpay() {
  local id t rc status detail overall=0
  : >"$OUT/subrows.tsv"
  for id in 1 2 3 4 6; do
    t=$(date +%s)
    product_pay_step "$id" 2>"$OUT/JPAY$id-detail.err"; rc=$?
    case "$rc" in 0) status=PASS ;; 98) status=UNCONFIGURED ;; 99) status=ABSENT ;; *) status=FAIL ;; esac
    case "$rc" in
      0) ;;
      98) [ "$overall" != 0 ] || overall=98 ;;
      *) overall=1 ;;
    esac
    detail=$(tail -1 "$OUT/JPAY$id-detail.err" | tr '\t\n' '  ')
    printf 'JPAY%s\t%s\t%s\t%s\n' "$id" "$status" "$(( $(date +%s)-t ))" "$detail" >>"$OUT/subrows.tsv"
  done
  echo "JPAY1-4 and JPAY6: $(cut -f1,2 "$OUT/subrows.tsv" | tr '\n' ';')" >&2
  return "$overall"
}
# The fn consumer worker's row (fn-r route): poll a fresh local fn node, admit
# the selected release at the recipient, replay it through the unit's own
# ExecStart (deploy/fn/mini-fn-receive@.service). No live fn is contacted.
# exchange: two Stores with distinct domains (NEWPARTICIPANT_DOMAIN), one of them a selected-release recipient;
# the second is not the fixture's default world. Left on its own constructor.
# unit_verify_warns TEXT: does systemd-analyze verify's output carry a warning? Only lines in its
# message shape (a unit or path, an optional :LINE, then ": "), and the warning words as whole words
# bounded by spaces or punctuation, never inside a hyphenated or slashed path component.
unit_verify_warns() {
  printf '%s\n' "$1" | grep -Eiq '^[^:[:space:]]+(:[0-9]+)?: (.*[[:space:]])?(invalid|ignoring|unknown|failed|bad)([[:space:],.;:]|$)'
}
# world: template: the fixture's per-candidate world restored, the row's own heights on top (two domains: two variants)
row_exchange() {
  local d=$SRC/native/resource-client/selected-exchange-journey.sh rc name
  [ -f "$d" ] || return 99
  for name in MINI_FN_LAUNCHER MINI_FN_CORE; do
    product_input "$name" value || return $?
    case "$(realpath -m "${!name}")" in /tank/fn|/tank/fn/*) echo "forbidden fn input: $name under /tank/fn" >&2; return 98;; esac
  done
  product_input MINI_FN_LAUNCHER executable || return $?
  product_input MINI_FN_CORE file || return $?
  product_native || return $?
  product_tools openssl od ss systemd-analyze || return $?
  # Static check of the fn consumer unit as systemd parses it: a template is
  # verified through one instance, and any parse warning (an unquoted
  # Environment= value is split and "ignored") fails the row.
  local unitdir verify
  unitdir=$(mktemp -d) || return 1
  cp "$SRC/deploy/fn/mini-fn-receive@.service" "$unitdir/mini-fn-receive@probe.service"
  cp "$SRC/deploy/fn/mini-fn-receive@.timer" "$unitdir/mini-fn-receive@probe.timer"
  verify=$(cd "$unitdir" && systemd-analyze verify "$unitdir/mini-fn-receive@probe.service" "$unitdir/mini-fn-receive@probe.timer" 2>&1); rc=$?
  rm -rf "$unitdir"
  printf '%s\n' "$verify" >"$OUT/unit-verify.log"
  # The verdict reads systemd-analyze's own message shape (UNIT[:LINE]: MESSAGE) and its words as
  # words, so a path in a message (x86_64-unknown-linux-gnu) never reads as a warning. Self-check
  # first: one harmless line must pass and one real warning must fail, or the row refuses itself.
  if unit_verify_warns 'mini-fn-receive@probe.service: Using /opt/x86_64-unknown-linux-gnu/lib/libfoo-bad-1.so (bad-free path)' \
     || ! unit_verify_warns "mini-fn-receive@probe.service:7: Unknown key name 'Foo' in section 'Service', ignoring."; then
    echo "row_exchange: the systemd-analyze verdict pattern fails its own self-check" >&2; return 1
  fi
  if [ "$rc" != 0 ] || unit_verify_warns "$verify"; then
    echo "fn consumer unit failed systemd-analyze verify: $verify" >&2; return 1
  fi
  product_exec exchange bash "$d" "$HOST" "$MINI" "$STORE" "$VERIFIER" "$MINI_FN_LAUNCHER" "$MINI_FN_CORE" "$RUN/x"; rc=$?
  product_keep "$RUN/x/public-summary.json" "$RUN/x/timings.tsv" "$RUN/x/input-sha256.txt"
  if [ -f "$RUN/x/negative/control-attempt/request-0000.outcome.json" ]; then
    cp "$RUN/x/negative/control-attempt/request-0000.outcome.json" "$OUT/positive-control-outcome.json"
  fi
  [ "$rc" = 0 ] || return "$rc"
  product_evidence "$OUT/public-summary.json" || return 1
  jq -e '.type=="minidregg-selected-exchange-two-credentials-v1" and
    .localFn.host=="127.0.0.1" and .localFn.freshStore==true and .localFn.stopped==true and
    .storeA.sponsorPublicKey != .storeB.sponsorPublicKey and
    .recipientReceipt.acceptedCount=="5" and .positiveControl.confirmation=="installed" and
    .disclosure.fnStoredBodyEqualsPacket==true and .disclosure.fnStoredBodySelected==1 and
    .disclosure.fnStoredBodyUnselected==0 and .refusals.bImageUnchangedByRefusals==true and
    (all(.refusals.tamperedPacket,.refusals.wrongSigner,.refusals.wrongRoot;
      .type=="refused" and .phase=="61646d697373696f6e"))' "$OUT/public-summary.json" >/dev/null || {
    echo "exchange summary failed local fn/admission/disclosure checks" >&2; return 1;
  }
  echo "exchange PASS: local fn stopped; exact selected packet admitted, replayed by the fn consumer unit, signed readback verified" >&2
}
