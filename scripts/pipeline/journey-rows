# scripts/pipeline/journey-rows -- THE journey set the continuous runner runs on every new artifact
# set (PIPELINE regime item 4). Sourced by scripts/pipeline/journey-runner from the TIP's own tree
# (so a lane that adds a journey adds its row here in the same commit), falling back to the
# runner's copy for a tip that predates this file.
#
# A row is a function row_<NAME> listed in JOURNEY_ROWS. It runs in a fresh scratch directory and
# sees: SRC (the tip's tree), SET (the READY artifact set), BIN (= SET/bin), MANIFEST (the set's
# journey-format manifest), RUN (a fresh SHORT scratch dir, deleted after the row: sockets fit
# sun_path), OUT (kept: the row's evidence), LEANENV (1 when SRC has the tip's built oleans).
# Exit 0 PASS; 99 ABSENT (the driver is not in this tree: reported, not red); 98 UNCONFIGURED (an
# input the runner lacks, e.g. no lean env: reported, not red); anything else FAIL. A row may write
# OUT/subrows.tsv (ID<TAB>STATUS<TAB>WALL_S<TAB>DETAIL) to report one table row per step; the
# last stderr line is the row's detail. Rows generate their own test keys inside RUN; no secret
# ever reaches the box. OWNER hints: OUT/owner (a lane name) when the row can tell.
JOURNEY_ROWS=(journey demo objective rooms activity seats bounty call send domain upgrade hostupgrade objectrecord welcomecontinuity sshe2e m3 m4 hermes m6grain m7 m8 fleetsign jpay exchange chargedfailure jbend births jserve perf jprivate rate)
# growth (1000 records through journey.sh, 30-90 min, judged on UPDATES) belongs to the nightly, not to a landing:
# it runs only when PIPELINE_NIGHTLY=1 (docs/PIPELINE-HBOX.md "Nightly"). The bar is judged per landing by births.
# kernel (journey.sh JOURNEY_SET=kernel without G: the steps no public surface needs) is nightly too.
if [ "${PIPELINE_NIGHTLY:-0}" = 1 ]; then JOURNEY_ROWS+=(growth kernel); fi

# J0-J8 + the rotation rows (JROT, JROTL, and JRLANE, JAUDIT and any *SEAT* step when the tip's journey.sh
# has them), one fresh Store, through native/resource-client/journey.sh.
# world: template: the fixture's per-candidate world restored, the row's own heights on top (J0 restores; J1's enrolment is a step on the restored world, not its genesis)
row_journey() {
  local js=$SRC/native/resource-client/journey.sh steps extra
  [ -f "$js" ] || return 99
  extra=$(sed -n 's/^STEPS=(\(.*\))$/\1/p' "$js" | tr ' ' '\n' | grep -E '^(JRLANE|JGATE|JAUDIT|.*SEAT.*)$' | paste -sd' ')
  steps="J0 J1 J2 J3 J4 J5 J6 J7 J8 JROT JROTL${extra:+ $extra}"
  # every red step reports its own failure, not its dependency's shadow (journey.sh --keep-going)
  JOURNEY_KEEP_GOING=${JOURNEY_KEEP_GOING:-1} JOURNEY_STEPS="$steps" JOURNEY_GROWTH_LEVELS=10 bash "$js" "$MANIFEST" "$RUN/j" >"$OUT/journey.out" 2>"$OUT/journey.err"
  local rc=$?
  [ -s "$RUN/j/journey-result.json" ] || { tail -1 "$OUT/journey.err" >&2; return 1; }
  cp "$RUN/j/journey-result.json" "$OUT/"
  jq -r --arg want " $steps " '.steps[] | . as $s | select($want | contains(" " + $s.id + " ")) |
    [.id, .status, (.wallSeconds|tostring), (.detail // "" | gsub("[\t\n]"; " "))] | @tsv' \
    "$RUN/j/journey-result.json" >"$OUT/subrows.tsv"
  # keep each red step's own logs (the world itself goes with RUN)
  jq -r '.steps[] | select(.status != "PASS") | .id' "$RUN/j/journey-result.json" | while read -r id; do
    [ -d "$RUN/j/steps/$id" ] && cp -r "$RUN/j/steps/$id" "$OUT/step-$id" 2>/dev/null
  done
  echo "frontier $(jq -r .frontier "$RUN/j/journey-result.json")" >&2
  return $rc
}

# journey_set_row SET OWNED...: one journey of journey.sh's partition (JOURNEY_SET; `journey.sh --list-set`)
# on one fresh Store, minus the steps another row already runs (OWNED; the spine J0-J8 always runs: every
# step depends on part of it). One sub-row per step that is not the spine (the `journey` row reports those).
journey_set_row() {
  local set=$1 js=$SRC/native/resource-client/journey.sh steps id spine="J0 J1 J2 J3 J4 J5 J6 J7 J8"; shift
  [ -f "$js" ] || return 99
  bash "$js" --list-set "$set" >"$OUT/set.txt" 2>"$OUT/set.err" || return 99   # a tree before the split
  steps=""
  while read -r id; do
    case " $* " in *" $id "*) continue ;; esac
    steps="$steps $id"
  done <"$OUT/set.txt"
  # the journey's own wall budget ends 400 s inside the runner's row timeout, so a slow run is a named red
  # J14 and J17 name the grain runtime GRAIN_RUNTIME; the runner exports the set's as GRAIN
  JOURNEY_KEEP_GOING=${JOURNEY_KEEP_GOING:-1} JOURNEY_STEPS="${steps# }" JOURNEY_GROWTH_LEVELS=10 JOURNEY_BUDGET_S=$(( ${PIPELINE_ROW_TIMEOUT_S:-5400} - 400 )) \
    GRAIN_RUNTIME=${GRAIN_RUNTIME:-${GRAIN:-$BIN/grain-runtime}} bash "$js" "$MANIFEST" "$RUN/j" >"$OUT/journey.out" 2>"$OUT/journey.err"
  local rc=$?
  [ -s "$RUN/j/journey-result.json" ] || { tail -1 "$OUT/journey.err" >&2; return 1; }
  cp "$RUN/j/journey-result.json" "$OUT/"
  jq -r --arg spine " $spine " '.steps[] | select($spine | contains(" " + .id + " ") | not) |
    [.id, .status, (.wallSeconds|tostring), (.detail // "" | gsub("[\t\n]"; " "))] | @tsv' \
    "$RUN/j/journey-result.json" >"$OUT/subrows.tsv"
  jq -r '.steps[] | select(.status != "PASS") | .id' "$RUN/j/journey-result.json" | while read -r id; do
    [ -d "$RUN/j/steps/$id" ] && cp -r "$RUN/j/steps/$id" "$OUT/step-$id" 2>/dev/null
  done
  echo "$set journey: $(jq -r '[.steps[] | select(.status == "PASS")] | length' "$RUN/j/journey-result.json")/$(jq -r '.steps | length' "$RUN/j/journey-result.json") PASS, frontier $(jq -r .frontier "$RUN/j/journey-result.json")" >&2
  return $rc
}
