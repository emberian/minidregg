# The native Objective acceptance (Accepted receipt + every refusal) on its own two scratch worlds.
# world: template: the fixture's per-candidate world restored, the row's own heights on top (both scratch worlds: the policy and knobs are constant, so one variant each)
row_objective() {
  local d=$SRC/native/resource-client/objective-native-acceptance.py lean=$SRC
  [ -f "$d" ] || return 99
  if [ "$LEANENV" != 1 ]; then
    # --source-tree unbinds leanenv even when the box holds the tip's own oleans
    # ($ARTIFACT_ROOT/.leanenv/TIP, the very tree the standing pipeline runs rows from):
    # take them by the tip's name before declaring the row unconfigured.
    lean=${ARTIFACT_ROOT:-/srv/artifacts}/.leanenv/${SET##*/}
    if [ ! -f "$lean/.pipeline-leanenv-complete" ] || [ ! -f "$lean/native/resource-client/objective-native-acceptance.py" ]; then
      echo "missing input: the tip's lean env ($lean with .pipeline-leanenv-complete; the mutations run lake env lean)" >&2
      return 98
    fi
    d=$lean/native/resource-client/objective-native-acceptance.py
  fi
  (cd "$lean" && python3 "$d" all --bin "$BIN" --root "$RUN/o") >"$OUT/objective.out" 2>"$OUT/objective.err"
  local rc=$?
  cp "$RUN/o/results/summary.json" "$OUT/" 2>/dev/null
  tail -1 "$OUT/objective.out" >&2
  return $rc
}

