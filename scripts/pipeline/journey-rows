# judged: loadavg N (quiet: no other unit >= Q cores)", and the detail still records p50/p99 and the counts.
# The real bar run is the nightly on a dedicated burst box (scripts/pipeline/nightly-burst.sh).
# Plant: JOURNEY_PLANT_BIRTHS=bar-1ms judges the same run against a 0.001 s write bar (must FAIL by name).
# world: genesis: the genesis and the first births ARE the measurement
row_births() {
  local d=$SRC/scripts/perf/workload.py bar_ms=5000 reopen_ms=60000 rc n la0 la1 f
  [ -f "$d" ] && grep -q -- '--births-only' "$d" || return 99
  case "${JOURNEY_PLANT_BIRTHS:-}" in
    '') ;;
    bar-1ms) bar_ms=1 ;;
    *) echo "unknown JOURNEY_PLANT_BIRTHS ${JOURNEY_PLANT_BIRTHS} (known: bar-1ms)" >&2; return 2 ;;
  esac
  if [ "${PIPELINE_NIGHTLY:-0}" = 1 ]; then n=${PERF_BIRTHS_N:-1000}; else n=${PERF_BIRTHS_N:-64}; fi
  la0=$(cut -d' ' -f1 /proc/loadavg)
  local q0 q1 qt=${PIPELINE_QUIET_CORES:-0.5}
  python3 "$SRC/scripts/perf/box.py" quiet "$OUT/quiet-start.json" 3 "$qt" >"$OUT/quiet-start.out"; q0=$?
  (cd "$SRC" && python3 "$d" --bin "$BIN" --root "$RUN/b" --births "$n" --births-only) >"$OUT/births.out" 2>"$OUT/births.err"
  rc=$?
  la1=$(cut -d' ' -f1 /proc/loadavg)
  python3 "$SRC/scripts/perf/box.py" quiet "$OUT/quiet-end.json" 3 "$qt" >"$OUT/quiet-end.out"; q1=$?
  for f in results.tsv table.txt summary.json results.json; do cp "$RUN/b/$f" "$OUT/" 2>/dev/null; done
  if [ ! -s "$OUT/summary.json" ] || [ ! -s "$OUT/results.tsv" ]; then
    echo "births FAIL: workload exited $rc with no summary (N=$n; load $la0->$la1): $(tail -1 "$OUT/births.err")" >&2; return 1
  fi
  python3 - "$OUT/results.tsv" "$OUT/summary.json" "$n" "$bar_ms" "$reopen_ms" "$la0" "$la1" "$rc" "$OUT/subrows.tsv" <<'PY'
import json, sys
res_f, sum_f, n, bar, reopen_bar, la0, la1, rc, sub_f = sys.argv[1:]
n, bar, reopen_bar = int(n), int(bar), int(reopen_bar)
ops, wall = {}, {}
for l in open(res_f).read().splitlines()[1:]:
    p = l.split('\t')
    if len(p) != 7: continue
    if p[1] == 'TOTAL': wall[p[0]] = p[6]
    else: ops[(p[0], p[1])] = {'n': int(p[2]), 'p50': int(p[3]), 'p99': int(p[4]), 'max': int(p[5])}
s = json.load(open(sum_f))
def fmt(k):
    o = ops.get(k)
    return f'{k[0]}/{k[1]} n={o["n"]} p50 {o["p50"]} p99 {o["p99"]} max {o["max"]} ms' if o else f'{k[0]}/{k[1]} none'
fails = []
if rc != '0': fails.append(f'workload exit {rc}')
if s.get('phasesFailed'): fails.append('phases failed: ' + ','.join(s['phasesFailed']))
if not s.get('allTurnsOk'): fails.append('a turn judged red')
subs = []
for k, key, b in ((('births', 'create'), 'p99', bar), (('births', 'resource'), 'p99', bar),
                  (('reopen', 'to-first-read'), 'max', reopen_bar)):
    o, why = ops.get(k), None
    if o is None: why = f'{k[0]}/{k[1]} not measured'
    elif k[0] == 'births' and o['n'] != n: why = f'{k[0]}/{k[1]} completed {o["n"]} of {n}'
    elif o[key] > b: why = f'{k[0]}/{k[1]} {key} {o[key]} ms > {b} ms bar'
    if why: fails.append(why)
    subs.append(f'{k[1] if k[0] == "births" else "reopen"}\t{"FAIL" if why else "PASS"}\t{wall.get(k[0], "")}\t{fmt(k)}; bar {key} <= {b} ms\n')
open(sub_f, 'w').write(''.join(subs))
cert = ops.get(('checkpoint', 'certify'))
r = ops.get(('reopen', 'to-first-read'))
detail = (f'N={n} create p50 {ops.get(("births", "create"), {}).get("p50", "?")} p99 {ops.get(("births", "create"), {}).get("p99", "?")} '
          f'max {ops.get(("births", "create"), {}).get("max", "?")} ms; resource p99 {ops.get(("births", "resource"), {}).get("p99", "?")} ms; '
          f'reopen {r["max"] if r else "?"} ms; cells {s.get("objectCount")} records {s.get("records")} store {s.get("storeBytes")} B'
          f'{"; cadence certifies " + str(cert["n"]) if cert else ""}; wall {s.get("totalSeconds")} s; load {la0}->{la1}; '
          f'bar write p99 <= {bar} ms, reopen <= {reopen_bar} ms')
print(('births FAIL: ' + '; '.join(fails) + ' | ' if fails else 'births PASS: ') + detail, file=sys.stderr)
sys.exit(1 if fails else 0)
PY
  rc=$?
  if [ "$q0" != 0 ] || [ "$q1" != 0 ] && [ -z "${JOURNEY_PLANT_BIRTHS:-}" ]; then
    echo "births UNCONFIGURED: bar not judged: loadavg $la0->$la1 (quiet: no other unit >= $qt cores; $(tail -1 "$OUT/quiet-start.out" "$OUT/quiet-end.out" 2>/dev/null | grep -m1 'box not quiet' || echo busy)) | verdict it would have had: rc $rc; $(tail -1 "$OUT/births.err" 2>/dev/null | cut -c1-300)" >&2
    sed -i 's/\tPASS\t/\tUNJUDGED\t/; s/\tFAIL\t/\tUNJUDGED\t/' "$OUT/subrows.tsv" 2>/dev/null
    return 98
  fi
  return $rc
}
