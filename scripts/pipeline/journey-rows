# The fixed performance workload (scripts/perf/workload.sh, docs/PERF-WORKLOAD.md) at its smallest
# parameters on a fresh native Store: genesis, births, updates, current and past-state reads, a
# checkpoint certify past height 64, a granted call and an inbox send, a cold reopen. PASS only when
# every phase completed AND the whole run took < 180 s. One sub-row per phase (its wall); the table is
# OUT/table.txt and the per-operation figures OUT/results.tsv. It measures wall time, so it requires a
# quiet box: a busy one is UNCONFIGURED (98) with the busy job named (scripts/perf/box.py quiet), never
# a red or green verdict taken under someone else's load. Plant: JOURNEY_PLANT_PERF=budget-1s
# judges the same run against a 1 s bound, so the row must go red naming the bound.
# world: genesis: perf-genesis measures the fresh genesis
row_perf() {
  local d=$SRC/scripts/perf/workload.sh budget=180 rc
  [ -f "$d" ] || return 99
  case "${JOURNEY_PLANT_PERF:-}" in
    '') ;;
    budget-1s) budget=1 ;;
    *) echo "unknown JOURNEY_PLANT_PERF ${JOURNEY_PLANT_PERF} (known: budget-1s)" >&2; return 2 ;;
  esac
  local la0 la1; la0=$(cut -d' ' -f1 /proc/loadavg)
  # always measured (instructions, p50/p99 in the detail); the wall bound is judged only when quiet
  PERF_UNDER_LOAD=1 PERF_BUDGET_S=$budget bash "$d" "$BIN" "$RUN/p" "${PERF_ROW_N:-20}" "${PERF_ROW_M:-16}" "${PERF_ROW_K:-8}" \
    >"$OUT/perf.out" 2>"$OUT/perf.err"
  rc=$?
  la1=$(cut -d' ' -f1 /proc/loadavg)
  [ "$rc" = 3 ] && { tail -1 "$OUT/perf.err" >&2; return 98; }
  local f
  for f in results.tsv table.txt summary.json settings.json quiet.json workload.log; do cp "$RUN/p/$f" "$OUT/" 2>/dev/null; done
  # one sub-row per phase: PASS when the phase completed, its wall from the table
  if [ -f "$OUT/summary.json" ] && [ -f "$OUT/results.tsv" ]; then
    awk -F'\t' '$2 == "TOTAL" {print $1 "\t" $7}' "$OUT/results.tsv" | while IFS=$'\t' read -r ph wall; do
      if jq -e --arg p "$ph" '.phasesCompleted | index($p)' "$OUT/summary.json" >/dev/null; then st=PASS; else st=FAIL; fi
      printf '%s\t%s\t%s\t%s\n' "perf-$ph" "$st" "$wall" \
        "$(awk -F'\t' -v p="$ph" '$1 == p && $2 != "TOTAL" {printf "%s%s n=%s p50=%sms max=%sms", (s++?"; ":""), $2, $3, $4, $6}' "$OUT/results.tsv")"
    done >"$OUT/subrows.tsv"
  fi
  if [ -z "${JOURNEY_PLANT_PERF:-}" ] && jq -e '.underLoad == true' "$OUT/summary.json" >/dev/null 2>&1; then
    echo "perf UNCONFIGURED: bar not judged: loadavg $la0->$la1 ($(grep -m1 'box not quiet' "$RUN/p/quiet.out" 2>/dev/null || echo 'box not quiet')) | verdict it would have had: rc $rc; $(tail -1 "$OUT/perf.err" | cut -c1-300)" >&2
    return 98
  fi
  tail -1 "$OUT/perf.err" >&2
  return $rc
}

