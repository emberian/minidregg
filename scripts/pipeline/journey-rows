# HOST-UPGRADE exercises the running tip, independent of APP ADOPT/MIGRATE.
# The previous main reopen is 98 until a READY same-epoch main set is available.
# world: genesis: the subject is the Host upgrade, so the world is born by the PREVIOUS candidate's binaries
row_hostupgrade() (
  local d=$SRC/native/resource-client/journey.d/jhostupgrade.sh
  local artifacts=${ARTIFACT_ROOT:-/srv/artifacts} previous=
  local e=${HOSTUPGRADE_EF_SET:-$artifacts/e0a8ba21a39d92b470cc331fd16ea0408f608b1f}   # the pinned old-epoch set, under this box's ARTIFACT_ROOT
  local candidate pair n n1 expected rc status detail t overall=0 i=0
  [ -f "$d" ] || return 99
  echo prod-hostup >"$OUT/owner"
  product_tools jq python3 sha256sum timeout realpath cmp || return $?
  hostupgrade_ready() {
    local candidate=$1 file role binary
    for file in READY manifest.json run.sh genesis.sh genesis-params.example.json; do
      [ -f "$candidate/$file" ] || return 1
    done
    for role in host mini store verifier; do
      binary=$(jq -er --arg r "$role" '.[$r]' "$candidate/manifest.json") || return 1
      [ -x "$binary" ] || return 1
    done
  }
  for candidate in "$e" "$SET"; do
    hostupgrade_ready "$candidate" || { echo "missing hostupgrade candidate input: $candidate" >&2; return 98; }
  done
  # Ask the candidate's Lean code for its epoch; no config or Store is needed.
  hostupgrade_epoch() {
    local candidate=$1 tag=$2 binary rc
    binary=$(jq -er '.host' "$candidate/manifest.json") || return 1
    if timeout 30 "$binary" store-epoch >"$OUT/epoch-$tag.txt" 2>"$OUT/epoch-$tag.err"; then
      [ -s "$OUT/epoch-$tag.txt" ] || return 1
      return 0
    else rc=$?; fi
    # Historical Hosts print usage for this unknown verb. They cannot establish
    # compatibility and must never qualify as a same-epoch predecessor.
    if [ "$rc" = 1 ] && [ ! -s "$OUT/epoch-$tag.txt" ] && \
      grep -q 'minidregg-host CONFIG.json' "$OUT/epoch-$tag.err"; then return 98; fi
    return 1
  }
  if hostupgrade_epoch "$SET" tip; then :; else
    rc=$?; echo "cannot query tip Store epoch: $SET (exit $rc)" >&2; return "$rc"
  fi
  # TIPS records '<sha> <main|green|next [+labels]> <tree>'. Search main history
  # newest first, before this tip when listed. A distinct main symlink is also
  # an input unless TIPS identifies it as newer than this tip.
  python3 - "$artifacts" "$SET" >"$OUT/previous-main-candidates.txt" <<'PY_PREVIOUS' || { echo "cannot read previous main artifact index" >&2; return 1; }
import pathlib, re, sys
root, tip = map(pathlib.Path, sys.argv[1:])
tip = tip.resolve()
tips = root / 'TIPS'
rows = [line.split() for line in tips.read_text().splitlines()] if tips.is_file() else []
rows = [row for row in rows if len(row) >= 3 and re.fullmatch('[0-9a-f]{40}', row[0])]
cut = next((i for i, row in enumerate(rows) if row[0] == tip.name), len(rows))
candidates = [root / row[0] for row in reversed(rows[:cut]) if 'main' in row[1].split('+')]
main = root / 'main'
if main.is_dir():
    positions = [i for i, row in enumerate(rows) if row[0] == main.resolve().name]
    if cut == len(rows) or not positions or min(positions) < cut:
        candidates.insert(0, main)
seen = {tip}
for candidate in candidates:
    candidate = candidate.resolve()
    if candidate not in seen:
        seen.add(candidate)
        print(candidate)
PY_PREVIOUS
  while IFS= read -r candidate; do
    hostupgrade_ready "$candidate" || continue
    i=$((i+1))
    printf '%s\n' "$candidate" >"$OUT/epoch-previous-$i.candidate"
    if hostupgrade_epoch "$candidate" "previous-$i"; then :; else
      rc=$?
      if [ "$rc" = 98 ]; then continue; fi
      echo "cannot query previous main Store epoch: $candidate" >&2; return 1
    fi
    if cmp -s "$OUT/epoch-tip.txt" "$OUT/epoch-previous-$i.txt"; then previous=$candidate; break; fi
  done <"$OUT/previous-main-candidates.txt"
  : >"$OUT/subrows.tsv"
  for pair in EF REOPEN PREVIOUS; do
    case "$pair" in
      EF) n=$e; n1=$SET; expected=refuse ;;
      REOPEN) n=$SET; n1=$SET; expected=reopen ;;
      PREVIOUS)
        if [ -z "$previous" ]; then
          printf 'HOST-UPGRADE-PREVIOUS\tUNCONFIGURED\t0\tno previous READY main set with the tip Store epoch\n' >>"$OUT/subrows.tsv"
          [ "$overall" != 0 ] || overall=98
          continue
        fi
        n=$previous; n1=$SET; expected=reopen ;;
    esac
    t=$(date +%s)
    if bash "$d" "$n" "$n1" "$OUT/$pair" "$expected" >"$OUT/$pair.out" 2>"$OUT/$pair.err"; then rc=0; else rc=$?; fi
    case "$rc" in 0) status=PASS ;; 98) status=UNCONFIGURED ;; *) status=FAIL ;; esac
    if [ "$rc" = 98 ]; then [ "$overall" != 0 ] || overall=98
    elif [ "$rc" != 0 ]; then overall=1; fi
    detail=$(awk 'NF {last=$0} END {print last}' "$OUT/$pair.err" | tr '\t\n' '  ')
    if [ -s "$OUT/$pair/verdict.txt" ]; then detail=$(cat "$OUT/$pair/verdict.txt"); fi
    printf 'HOST-UPGRADE-%s\t%s\t%s\t%s\n' "$pair" "$status" "$(( $(date +%s)-t ))" "$detail" >>"$OUT/subrows.tsv"
  done
  echo "hostupgrade: $(cut -f1,2 "$OUT/subrows.tsv" | tr '\n' ';')" >&2
  return "$overall"
)

