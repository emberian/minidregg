# scripts/pipeline/journey-rows -- THE journey set the continuous runner runs on every new artifact
# set (PIPELINE regime item 4). Sourced by scripts/pipeline/journey-runner from the TIP's own tree
# (so a lane that adds a journey adds its row here in the same commit), falling back to the
# runner's copy for a tip that predates this file.
#
# A row is a function row_<NAME> listed in JOURNEY_ROWS. It runs in a fresh scratch directory and
# sees: SRC (the tip's tree), SET (the READY artifact set), BIN (= SET/bin), MANIFEST (the set's
# journey-format manifest), RUN (a fresh SHORT scratch dir, deleted after the row: sockets fit
# sun_path), OUT (kept: the row's evidence), LEANENV (1 when SRC has the tip's built oleans).
# Exit 0 PASS; 99 ABSENT (the driver is not in this tree: reported, not red); 98 UNCONFIGURED (an
# input the runner lacks, e.g. no lean env: reported, not red); anything else FAIL. A row may write
# OUT/subrows.tsv (ID<TAB>STATUS<TAB>WALL_S<TAB>DETAIL) to report one table row per step; the
# last stderr line is the row's detail. Rows generate their own test keys inside RUN; no secret
# ever reaches the box. OWNER hints: OUT/owner (a lane name) when the row can tell.
JOURNEY_ROWS=(journey objective rooms activity seats call send objectrecord welcomecontinuity sshe2e)

# J0-J8 + the rotation rows (JROT, JROTL, and JRLANE and any *SEAT* step when the tip's journey.sh
# has them), one fresh Store, through native/resource-client/journey.sh.
row_journey() {
  local js=$SRC/native/resource-client/journey.sh steps extra
  [ -f "$js" ] || return 99
  extra=$(sed -n 's/^STEPS=(\(.*\))$/\1/p' "$js" | tr ' ' '\n' | grep -E '^(JRLANE|.*SEAT.*)$' | paste -sd' ')
  steps="J0 J1 J2 J3 J4 J5 J6 J7 J8 JROT JROTL${extra:+ $extra}"
  JOURNEY_STEPS="$steps" JOURNEY_GROWTH_LEVELS=10 bash "$js" "$MANIFEST" "$RUN/j" >"$OUT/journey.out" 2>"$OUT/journey.err"
  local rc=$?
  [ -s "$RUN/j/journey-result.json" ] || { tail -1 "$OUT/journey.err" >&2; return 1; }
  cp "$RUN/j/journey-result.json" "$OUT/"
  jq -r --arg want " $steps " '.steps[] | . as $s | select($want | contains(" " + $s.id + " ")) |
    [.id, .status, (.wallSeconds|tostring), (.detail // "" | gsub("[\t\n]"; " "))] | @tsv' \
    "$RUN/j/journey-result.json" >"$OUT/subrows.tsv"
  # keep each red step's own logs (the world itself goes with RUN)
  jq -r '.steps[] | select(.status != "PASS") | .id' "$RUN/j/journey-result.json" | while read -r id; do
    [ -d "$RUN/j/steps/$id" ] && cp -r "$RUN/j/steps/$id" "$OUT/step-$id" 2>/dev/null
  done
  echo "frontier $(jq -r .frontier "$RUN/j/journey-result.json")" >&2
  return $rc
}

# The native Objective acceptance (Accepted receipt + every refusal) on its own two scratch worlds.
row_objective() {
  local d=$SRC/native/resource-client/objective-native-acceptance.py
  [ -f "$d" ] || return 99
  [ "$LEANENV" = 1 ] || { echo "no lean env for this tip (its mutations run lake env lean)" >&2; return 98; }
  (cd "$SRC" && python3 "$d" all --bin "$BIN" --root "$RUN/o") >"$OUT/objective.out" 2>"$OUT/objective.err"
  local rc=$?
  cp "$RUN/o/results/summary.json" "$OUT/" 2>/dev/null
  tail -1 "$OUT/objective.out" >&2
  return $rc
}

# Private rooms end to end on a real Host (J0..J5 + JPRIV1 against the expected row table).
row_rooms() {
  local d=$SRC/native/resource-client/rooms-e2e.sh
  [ -f "$d" ] || return 99
  command -v bc >/dev/null 2>&1 || { echo "no bc on this box (rooms-e2e.sh requires it)" >&2; return 98; }
  MINI_HOST_BIN=$BIN/minidregg-host MINI_BIN=$BIN/mini MINI_STORE_BIN=$BIN/minidregg-link-sqlite-store \
    MINI_VERIFIER_BIN=$BIN/minidregg-credential-signature-verifier \
    bash "$d" "$RUN/r" >"$OUT/rooms.out" 2>"$OUT/rooms.err"
  local rc=$?
  # the verdict: the steps that did not pass, then the expected-row count
  { grep -E '^rooms-e2e: [A-Z0-9]+ +(FAIL|SKIPPED|UNBUILT)' "$OUT/rooms.out" | sed 's/^rooms-e2e: //' | paste -sd';'
    grep -E '^rooms-e2e: [0-9]+ rows' "$OUT/rooms.out" | sed 's/^rooms-e2e: //'; } | paste -sd' ' >&2
  return $rc
}

# The activity acceptance (activity-native's driver) once it is in the tree.
row_activity() {
  local d
  d=$(ls "$SRC"/native/resource-client/*activity*accept* "$SRC"/native/resource-client/*activity*e2e* 2>/dev/null | head -1)
  [ -n "$d" ] || return 99
  case "$d" in
    # objective-activity-native-acceptance.py takes --bin and --root only (no `all` verb, unlike
    # objective-native-acceptance.py); its results.json is the row's evidence
    *.py) (cd "$SRC" && python3 "$d" --bin "$BIN" --root "$RUN/a") ;;
    *)    (cd "$SRC" && MINI_HOST_BIN=$BIN/minidregg-host MINI_BIN=$BIN/mini bash "$d" "$MANIFEST" "$RUN/a") ;;
  esac >"$OUT/activity.out" 2>"$OUT/activity.err"
  local rc=$?
  cp "$RUN/a/results.json" "$OUT/" 2>/dev/null
  echo "$(basename "$d"): $(tail -1 "$OUT/activity.out")" >&2
  return $rc
}

# Seats: a stand-alone seats driver when one exists (seat steps of journey.sh run in row_journey).
row_seats() {
  local d
  d=$(ls "$SRC"/native/resource-client/*seat*journey* "$SRC"/native/resource-client/*seat*accept* \
         "$SRC"/native/resource-client/*seat*e2e* 2>/dev/null | head -1)
  [ -n "$d" ] || return 99
  case "$d" in
    *.py) (cd "$SRC" && python3 "$d" all --bin "$BIN" --root "$RUN/s") ;;
    *)    (cd "$SRC" && bash "$d" "$MANIFEST" "$RUN/s") ;;
  esac >"$OUT/seats.out" 2>"$OUT/seats.err"
  local rc=$?
  echo "$(basename "$d"): $(tail -1 "$OUT/seats.out")" >&2
  return $rc
}

# Synchronous cross-object `call` (OB7, Kernel/ObjectiveCall): C1-C8 on a fresh native world (51 checks).
# OUT/subrows.tsv: one line per group (C1-leaf .. C8-shape). The driver has self-test plants (honest-thief,
# vault-permit-all, gate-open); JOURNEY_PLANT_CALL=NAME[,NAME] runs the row with that fault put in the
# world: the row must go RED (the driver exits 1 with "PLANT-RESULT red <groups>"), a planted fault that
# stays green is the driver exiting 3 ("PLANT-RESULT blind"), also red. Unset in normal runs.
row_call() {
  local d=$SRC/native/resource-client/objective-call-native-journey.py
  [ -f "$d" ] || return 99
  (cd "$SRC" && python3 "$d" --bin "$BIN" --root "$RUN/c" ${JOURNEY_PLANT_CALL:+--plant "$JOURNEY_PLANT_CALL"}) >"$OUT/call.out" 2>"$OUT/call.err"
  local rc=$?
  cp "$RUN/c/results.json" "$OUT/" 2>/dev/null
  cp "$RUN/c/groups.tsv" "$OUT/subrows.tsv" 2>/dev/null
  cp -r "$RUN/c/transcript" "$OUT/" 2>/dev/null
  tail -1 "$OUT/call.out" >&2
  return $rc
}

# Asynchronous `send` with inboxes (OB8, Kernel/Inbox + ObjectiveSend): S1-S7 on a fresh native world
# (66 checks). Plants (vault-open, dir-empty, roomy-postage) via JOURNEY_PLANT_SEND, as row_call.
row_send() {
  local d=$SRC/native/resource-client/objective-send-native-journey.py
  [ -f "$d" ] || return 99
  (cd "$SRC" && python3 "$d" --bin "$BIN" --root "$RUN/s" ${JOURNEY_PLANT_SEND:+--plant "$JOURNEY_PLANT_SEND"}) >"$OUT/send.out" 2>"$OUT/send.err"
  local rc=$?
  cp "$RUN/s/results.json" "$OUT/" 2>/dev/null
  cp "$RUN/s/groups.tsv" "$OUT/subrows.tsv" 2>/dev/null
  cp -r "$RUN/s/transcript" "$OUT/" 2>/dev/null
  tail -1 "$OUT/send.out" >&2
  return $rc
}

# The object record on the native activity route: no record, no object; the object law judges every
# declared-state write (direct write, birth, delivery); a delivery is judged as its birth subject. The
# route's own acceptance (row `activity`) installs every object under a permit-all law; this row is the law
# half, on a fresh scratch world. ABSENT on a tip whose `mini` has no `activity` command (the route is
# not in that tip), never red. OUT/subrows.tsv: one line per journey row (OR1..OR7).
row_objectrecord() {
  local d=$SRC/native/resource-client/objectrecord-native-journey.py
  [ -f "$d" ] || return 99
  if "$BIN/mini" activity 2>&1 | grep -q "unknown command activity"; then
    echo "this tip has no native activity route (mini activity)" >&2; return 99
  fi
  (cd "$SRC" && python3 "$d" --bin "$BIN" --root "$RUN/or") >"$OUT/objectrecord.out" 2>"$OUT/objectrecord.err"
  local rc=$?
  cp "$RUN/or/results.json" "$OUT/" 2>/dev/null
  cp "$RUN/or/groups.tsv" "$OUT/subrows.tsv" 2>/dev/null
  cp -r "$RUN/or/transcript" "$OUT/" 2>/dev/null   # kept: the exact output of every command of the world
  tail -1 "$OUT/objectrecord.out" >&2
  return $rc
}

# Key-only welcome continuity: a participant joins from the sponsor's welcome, the receipt is authenticated
# by read-only lookup and the local Lean verifier, refused welcomes (forged, wrong possession, wrong command,
# lost custody) leave no workspace. One sub-row per step of the driver (rows.tsv).
row_welcomecontinuity() {
  local d=$SRC/native/resource-client/welcome-continuity-journey.sh
  [ -f "$d" ] || return 99
  [ -x "$BIN/minidregg-client-consent" ] || { echo "the set has no signing-consent provider (minidregg-client-consent)" >&2; return 98; }
  bash "$d" "$BIN/minidregg-host" "$BIN/mini" "$BIN/minidregg-link-sqlite-store" \
    "$BIN/minidregg-credential-signature-verifier" "$RUN/wc" >"$OUT/welcome.out" 2>"$OUT/welcome.err"
  local rc=$?
  awk -F'\t' 'NR>1 {st=($2 ~ /^PASS/)?"PASS":"FAIL"; printf "%s\t%s\t0\t%s\n", $1, st, $2}' "$RUN/wc/rows.tsv" >"$OUT/subrows.tsv" 2>/dev/null
  cp -r "$RUN/wc/logs" "$OUT/logs" 2>/dev/null   # every step's stdout, stderr and opcode log; keys are not in it
  tail -1 "$OUT/welcome.err" >&2
  return $rc
}

# The ssh:DEST operator route end to end (native/mini-sdk/tests/ssh-e2e.sh): the SDK's ssh client, a real
# unprivileged sshd on loopback, the forced `mini socket-proxy`, a real Host; a planted host key, an unknown
# host key and an unauthorised key are refused by name. Builds the SDK test binary on first use into a
# shared target dir (CARGO_TARGET_DIR), so the first tip on a box is slow and the rest are warm.
row_sshe2e() {
  local d=$SRC/native/mini-sdk/tests/ssh-e2e.sh
  [ -f "$d" ] || return 99
  command -v sshd >/dev/null 2>&1 || [ -x /usr/sbin/sshd ] || { echo "no sshd on this box" >&2; return 98; }
  [ -f "$SET/run.sh" ] || { echo "the set has no run.sh (candidate layout)" >&2; return 98; }
  mkdir -p "$HOME/.cache/journey-cargo-target"
  CARGO_TARGET_DIR=$HOME/.cache/journey-cargo-target bash "$d" "$SET" "$RUN/ssh" >"$OUT/ssh-e2e.out" 2>"$OUT/ssh-e2e.err"
  local rc=$?
  cp -r "$RUN/ssh/log" "$OUT/log" 2>/dev/null
  grep -E '^test |^test result' "$OUT/log/ssh-e2e.log" 2>/dev/null | cut -c1-160 | sed 's/ \.\.\. .*$/ .../' >"$OUT/tests.txt"
  tail -1 "$OUT/ssh-e2e.err" >&2
  return $rc
}
