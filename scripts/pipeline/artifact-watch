#!/usr/bin/env bash
# scripts/pipeline/artifact-watch -- the gate box's publisher loop (run it in tmux).
#
#   scripts/pipeline/artifact-watch [--once]
#
# The merge keeper appends one line per gated tip to $ARTIFACT_ROOT/TIPS:
#   <40-hex sha> <main|green|next> <path of the gated tree when written> [notes...]
# Every PIPELINE_WATCH_S (60) seconds this loop publishes the NEWEST unpublished line of each
# label (an older line of the same label superseded while queued is skipped, never built), with
# scripts/pipeline/publish-artifacts. It also follows GitHub's refs (main, tag green, branch next)
# and RELABELS a READY set the ref points at; a ref alone never triggers a build (VERIFY-ONCE: the
# keeper's gate decides what is a tip). A failed publication is retried on the next pass, resuming
# from its failed step (publish-artifacts keeps its work directory); after PIPELINE_PUBLISH_RETRIES
# (3) attempts it leaves $ARTIFACT_ROOT/.work/TIP.failed (the log), appends a line to
# $ARTIFACT_ROOT/ALERTS on the publishing box (its fetch-artifacts and `slots` print it), and is not retried until
# that file (and TIP.attempts) is removed. A run that finds the tip locked (exit 75) is not an attempt.
set -uo pipefail
PIPELINE_PROG=artifact-watch
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib.sh"
once=0; [ "${1:-}" = --once ] && once=1
mkdir -p "$ARTIFACT_ROOT/.work"; touch "$ARTIFACT_ROOT/TIPS"
while :; do
  # newest line per label, in file order
  # newest line per label (a line may carry several: main+green), then one entry per sha
  awk 'NF>=3 && $1 ~ /^[0-9a-f]{40}$/ { n=split($2, ls, "+"); for (i=1;i<=n;i++) { last[ls[i]]=$1; path[$1]=$3 } }
       END { for (l in last) lab[last[l]] = (lab[last[l]] == "" ? l : lab[last[l]] "+" l);
             for (s in lab) print s, lab[s], path[s] }' "$ARTIFACT_ROOT/TIPS" |
  sort -k2,2r |   # next first: the journey box wants next first
  while read -r sha label path; do
    if [ -f "$ARTIFACT_ROOT/$sha/READY" ]; then
      for l in ${label//+/ }; do [ "$(readlink "$ARTIFACT_ROOT/$l" 2>/dev/null)" = "$sha" ] || { pipeline_label "$l" "$sha"; "$here/mirror-artifacts" "$sha" "$l" >/dev/null 2>&1; }; done
      continue
    fi
    [ -f "$ARTIFACT_ROOT/.work/$sha.failed" ] && continue
    pipeline_log "publishing $sha ($label) hint $path"
    rc=0; "$here/publish-artifacts" "$sha" "$label" "$path" >>"$ARTIFACT_ROOT/.work/$sha.out" 2>&1 || rc=$?
    if [ "$rc" = 75 ]; then pipeline_log "$sha is being published by another run"; continue; fi   # in progress, not an attempt
    if [ "$rc" != 0 ]; then
      n=$(( $(cat "$ARTIFACT_ROOT/.work/$sha.attempts" 2>/dev/null || echo 0) + 1 )); echo $n >"$ARTIFACT_ROOT/.work/$sha.attempts"
      if [ "$n" -ge "${PIPELINE_PUBLISH_RETRIES:-3}" ]; then
        mv "$ARTIFACT_ROOT/.work/$sha.out" "$ARTIFACT_ROOT/.work/$sha.failed"
        pipeline_log "FAILED $sha ($n attempts, each resumed from its failed step): $ARTIFACT_ROOT/.work/$sha.failed"
        # Said where it is read: ALERTS (fetch-artifacts prints the lines naming what it was asked
        # for; `slots` prints them all), one line per failure with its last error.
        printf '%s PUBLISH FAILED %s (%s) after %s attempts: %s [log %s]\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" "$label" "$n" \
          "$(grep -E 'FAIL|RED|error' "$ARTIFACT_ROOT/.work/$sha.failed" | tail -1 | cut -c1-240)" "$ARTIFACT_ROOT/.work/$sha.failed" >>"$ARTIFACT_ROOT/ALERTS"
      else pipeline_log "attempt $n of $sha failed; the next pass resumes from the failed step"; fi
      tail -5 "$ARTIFACT_ROOT/.work/$sha.out" "$ARTIFACT_ROOT/.work/$sha.failed" 2>/dev/null
    else tail -3 "$ARTIFACT_ROOT/.work/$sha.out"; fi
  done
  # relabel from GitHub refs (never build)
  git ls-remote "$PIPELINE_REPO_URL" refs/heads/main refs/heads/next refs/tags/green 2>/dev/null |
  while read -r sha ref; do
    label=${ref##*/}
    if [ -f "$ARTIFACT_ROOT/$sha/READY" ] && [ "$(readlink "$ARTIFACT_ROOT/$label" 2>/dev/null)" != "$sha" ]; then
      pipeline_label "$label" "$sha" && pipeline_log "relabelled $label -> $sha (GitHub $ref)"
      "$here/mirror-artifacts" "$sha" "$label" >/dev/null 2>&1 || pipeline_log "label mirror failed"
    fi
  done
  [ "$once" = 1 ] && break
  sleep "${PIPELINE_WATCH_S:-60}"
done
