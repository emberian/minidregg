#!/usr/bin/env bash
# scripts/pipeline/box-peer-gate -- the forced command of a peer build box's key (setup-box-peer).
#
# A sibling box may READ this box's /srv, and push lane branches to its shared remote, nothing else:
#   git fetch PEER:/srv/lanes/<lane>/src <ref>     git-upload-pack of a repository under /srv
#   rsync -a PEER:/lanes/<lane>/logs/ DEST/        rrsync -ro /srv (paths are relative to /srv)
#   git push PEER:/srv/git/minidregg.git HEAD:lane/<name>   git-receive-pack, /srv/git/*.git only
#   ssh PEER slots --free / ssh PEER peer-build LANE SHA T...   build-anywhere: a free slot over there
# No shell, no other writes, no forwarding (the key is `restrict`ed); everything else is refused.
set -uo pipefail
cmd=${SSH_ORIGINAL_COMMAND:-}
case "$cmd" in
  "git-upload-pack "*|"git upload-pack "*)
    p=${cmd#git-upload-pack }; p=${p#git upload-pack }; p=${p#\'}; p=${p%\'}
    r=$(realpath -e -- "$p" 2>/dev/null) || { echo "box-peer-gate: no such repository: $p" >&2; exit 1; }
    case "$r/" in /srv/*) exec git-upload-pack -- "$r" ;; esac
    echo "box-peer-gate: $p is outside /srv" >&2; exit 1 ;;
  "git-receive-pack "*|"git receive-pack "*)
    # pushes only into the burst's shared remote(s) (its hook admits lane/<name> branches only)
    p=${cmd#git-receive-pack }; p=${p#git receive-pack }; p=${p#\'}; p=${p%\'}
    r=$(realpath -e -- "$p" 2>/dev/null) || { echo "box-peer-gate: no such repository: $p" >&2; exit 1; }
    case "$r" in /srv/git/*.git) exec git-receive-pack -- "$r" ;; esac
    echo "box-peer-gate: pushes go to /srv/git/*.git only" >&2; exit 1 ;;
  "rsync --server --sender "*) exec rrsync -ro /srv ;;
  # build-anywhere: a sibling with no free slot asks for ours (slots --free) and builds its pushed lane here
  slots|"slots --free"|"slots --json") exec "$(dirname "$0")/slots" ${cmd#slots} ;;
  "peer-build "*)
    [[ $cmd =~ ^peer-build( [A-Za-z0-9._+:-]+){3,}$ ]] || { echo "box-peer-gate: malformed peer-build" >&2; exit 1; }
    set -- $cmd; shift; exec "$(dirname "$0")/peer-build" "$@" ;;
esac
echo "box-peer-gate: refused (only git fetch and read-only rsync under /srv): ${cmd:0:120}" >&2
exit 1
