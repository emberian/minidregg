#!/usr/bin/env bash
# scripts/pipeline/lane-tree -- shared, cheap lane trees on a build box: a small pool of warm trees.
#
#   lane-tree acquire LANE [REF]   lease a pooled tree for LANE, check REF out in it (default origin/main),
#                                  print its path. Re-acquiring a LANE that holds a tree returns the same tree.
#   lane-tree release LANE         save the tree's uncommitted diff (if any) and free it
#   lane-tree renew LANE|TREE      extend the lease (lane-check calls this for the tree it checks)
#   lane-tree status               every tree: holder, lease age, HEAD, dirty or not
#   lane-tree gc                   free every lease older than LANE_POOL_TTL_H hours (default 12), diff saved
#   lane-tree warm LANE|TREE [SRC]   make the tree's build outputs as warm as SRC's (default $LANE_POOL_WARM),
#                                  by hard links (scripts/pipeline/warm-link); acquire does this itself
#   lane-tree init SEED_TREE N     (once per box) pool.env, the shared packages, the pool's repo and N trees,
#                                  each warm from SEED_TREE's .lake/build by warm-link
#
# The box's pool is described by one file, pool.env, found at $LANE_POOL_ENV, else /build/pool/pool.env,
# else /tank/dregg-build/pool/pool.env, else $HOME/pool/pool.env (hbox's NVMe pool; the Mac's). `init`
# writes it from the environment when none exists. It sets:
#   LANE_POOL_ROOT      the pool's directory: trees t1..tN, leases/, saved/, pool.lock
#   LANE_POOL_REPO      the pool's own bare repo the trees are worktrees of (init clones it; origin GitHub)
#   LANE_POOL_PACKAGES  the box's ONE shared .lake/packages (read-only, keyed by lake-manifest.json); every
#                       tree's .lake/packages is a symlink to it
#   LAKE_CACHE_DIR      the box's ONE Lake artifact cache; LAKE_ARTIFACT_CACHE=true for every pooled build
#   LANE_POOL_WARM      optional: a built tree kept current at main (hbox: the integration tree); acquire
#                       links its newer outputs into the tree it hands out, so a lane starts warm at main
#
# Sharing over isolation (ember, 2026-10-28: "we'd rather risk accidental interference, which is easy to
# converge"): trees are reused lane after lane and every build shares the box's artifact cache, so a lane
# compiles only modules no tree on the box has compiled from the same inputs. What still holds:
#   - a tree has ONE holder at a time (the lease); a lane edits only the tree it holds;
#   - the shared packages are read-only: a manifest or toolchain change needs a new packages directory
#     (`lane-tree init`), never an edit in place;
#   - never sync sources into a tree while a build runs in it (a build keys its cache entries by the
#     inputs it hashed at start: tonight's 92 poisoned cache entries came from exactly that);
#   - lake never runs as root; lane-check is never wrapped in closure-lock (it takes the lock itself).
set -euo pipefail
PIPELINE_PROG=lane-tree
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
die() { printf 'lane-tree: %s\n' "$*" >&2; exit 2; }
[ "$(id -u)" != 0 ] || die "refusing to run as root (lake must never run as root)"
# swarm-build's systemd --user scope needs the user bus (see scripts/pipeline/lib.sh): set it, or refuse.
[ -n "${XDG_RUNTIME_DIR:-}" ] || { [ -d "/run/user/$(id -u)" ] && export XDG_RUNTIME_DIR=/run/user/$(id -u); }
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || { [ -S "${XDG_RUNTIME_DIR:-/x}/bus" ] && export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus; }
if command -v swarm-build >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1 &&
   ! systemctl --user show-environment >/dev/null 2>&1; then
  die "swarm-build cannot reach the systemd user bus (XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}): a build here would exit 1 and compile nothing; log in as $(id -un) or enable lingering"
fi
pool_env=
for f in "${LANE_POOL_ENV:-}" /build/pool/pool.env /tank/dregg-build/pool/pool.env "$HOME/pool/pool.env"; do
  [ -n "$f" ] && [ -f "$f" ] && { pool_env=$f; . "$f"; break; }
done
if [ -z "$pool_env" ] && [ "${1:-}" = init ]; then
  : "${LANE_POOL_ROOT:?init without a pool.env: set LANE_POOL_ROOT LANE_POOL_REPO LANE_POOL_PACKAGES LAKE_CACHE_DIR}"
  : "${LANE_POOL_REPO:?}" "${LANE_POOL_PACKAGES:?}" "${LAKE_CACHE_DIR:?}"
  mkdir -p "$LANE_POOL_ROOT"
  { for v in LANE_POOL_ROOT LANE_POOL_REPO LANE_POOL_PACKAGES LAKE_CACHE_DIR LANE_POOL_WARM; do
      [ -n "${!v:-}" ] && printf 'export %s=%q\n' "$v" "${!v}"; done
    echo 'export LAKE_ARTIFACT_CACHE=true'; } > "$LANE_POOL_ROOT/pool.env"
  pool_env=$LANE_POOL_ROOT/pool.env
  echo "lane-tree: wrote $pool_env"
fi
: "${LANE_POOL_ROOT:?no pool.env on this box (lane-tree init creates one)}"
TTL_H=${LANE_POOL_TTL_H:-12}
leases=$LANE_POOL_ROOT/leases; saved=$LANE_POOL_ROOT/saved
mkdir -p "$leases" "$saved"
exec 8>"$LANE_POOL_ROOT/pool.lock"
# flock(1) where it exists; elsewhere (macOS) the same flock(2) on fd 8 from python: the lock belongs to the
# open file description this shell holds, so it outlives the helper process.
if command -v flock >/dev/null 2>&1; then lock() { flock 8; }
else lock() { python3 -c 'import fcntl; fcntl.flock(8, fcntl.LOCK_EX)' 8>&8; }; fi
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
clone_dir() {   # SRC DST: a real copy, by reflink/clonefile where the filesystem has it
  cp -a --reflink=auto "$1" "$2" 2>/dev/null || cp -Rpc "$1" "$2" 2>/dev/null || cp -Rp "$1" "$2"; }
warm() {        # TREE SRC_TREE: link SRC's newer build outputs into TREE (never while a build runs in TREE)
  [ -n "$2" ] && [ -d "$2/.lake/build" ] || return 0
  python3 "$here/warm-link" "$2/.lake/build" "$1/.lake/build" >&2; }
now() { date +%s; }
trees() { ls -d "$LANE_POOL_ROOT"/t[0-9]* 2>/dev/null | sort -V || true; }
holder() { [ -f "$leases/$(basename "$1")" ] && cut -f1 "$leases/$(basename "$1")" || true; }
lease_age_h() { local f=$leases/$(basename "$1"); [ -f "$f" ] && echo $(( ($(now) - $(cut -f2 "$f")) / 3600 )) || echo -; }
held_by() { local t; for t in $(trees); do [ "$(holder "$t")" = "$1" ] && { echo "$t"; return 0; }; done; return 0; }
save_diff() {   # TREE REASON: keep any uncommitted work before a tree changes hands
  local t=$1 why=$2 d
  d=$(git -C "$t" status --porcelain --untracked-files=normal 2>/dev/null | grep -v '^?? \.lake' || true)
  [ -z "$d" ] && return 0
  local out=$saved/$(basename "$t")-$(holder "$t")-$(date -u +%Y%m%dT%H%M%SZ).patch
  { echo "# $why; HEAD $(git -C "$t" rev-parse HEAD)"; git -C "$t" diff HEAD; git -C "$t" ls-files --others --exclude-standard | sed 's/^/# untracked: /'; } > "$out"
  printf 'lane-tree: saved uncommitted work of %s to %s\n' "$t" "$out" >&2
}
case ${1:-} in
  acquire)
    lane=${2:?LANE}; ref=${3:-origin/main}
    case $lane in *[!A-Za-z0-9._-]*) die "lane name '$lane'";; esac
    lock
    t=$(held_by "$lane")
    if [ -z "$t" ]; then
      [ -n "$(trees)" ] || die "the pool at $LANE_POOL_ROOT has no trees (lane-tree init SEED N)"
      # a free tree, else the oldest expired lease; the least recently used first
      for c in $(ls -tr -d $(trees)); do
        h=$(holder "$c"); a=$(lease_age_h "$c")
        if [ -z "$h" ] || { [ "$a" != - ] && [ "$a" -ge "$TTL_H" ]; }; then t=$c; break; fi
      done
      [ -n "$t" ] || die "no free tree: $("$0" status 2>/dev/null | tr '\n' ';') (wait, or gc expired leases)"
      [ -z "$(holder "$t")" ] || save_diff "$t" "lease of $(holder "$t") expired; taken by $lane"
    fi
    printf '%s\t%s\t%s\n' "$lane" "$(now)" "$ref" > "$leases/$(basename "$t")"
    git -C "$LANE_POOL_REPO" fetch -q origin 2>/dev/null || printf 'lane-tree: fetch failed; checking out what the repo has\n' >&2
    if [ "$(git -C "$t" rev-parse HEAD)" != "$(git -C "$t" rev-parse "$ref" 2>/dev/null || echo none)" ]; then
      save_diff "$t" "before checking out $ref for $lane"
      git -C "$t" checkout -q -f --detach "$ref" || die "cannot check out $ref"
      git -C "$t" clean -q -fd -e .lake
    fi
    warm "$t" "${LANE_POOL_WARM:-}"
    touch "$t"
    echo "$t" ;;
  warm)
    x=${2:?LANE or TREE}; from=${3:-${LANE_POOL_WARM:-}}
    [ -n "$from" ] || die "warm: no SRC and no LANE_POOL_WARM"
    if [ -d "$x" ]; then t=$(cd "$x" && pwd -P); else t=$(held_by "$x"); [ -n "$t" ] || die "$x holds no tree"; fi
    warm "$t" "$from" ;;
  release)
    lane=${2:?LANE}; lock
    t=$(held_by "$lane"); [ -n "$t" ] || die "$lane holds no tree"
    save_diff "$t" "released by $lane"
    rm -f "$leases/$(basename "$t")"; echo "released $t" ;;
  renew)
    lane=${2:?LANE or TREE}; lock
    if [ -d "$lane" ]; then t=$(cd "$lane" && pwd -P); [ -f "$leases/$(basename "$t")" ] || exit 0
    else t=$(held_by "$lane"); [ -n "$t" ] || exit 0; fi
    awk -v n="$(now)" 'BEGIN{FS=OFS="\t"} {$2=n; print}' "$leases/$(basename "$t")" > "$leases/.r" && mv "$leases/.r" "$leases/$(basename "$t")" ;;
  status)
    for t in $(trees); do
      d=$(git -C "$t" status --porcelain --untracked-files=no 2>/dev/null | wc -l)
      printf '%s\t%s\tlease %sh\t%s\tdirty %s\n' "$(basename "$t")" "$(holder "$t" | sed 's/^$/(free)/')" \
        "$(lease_age_h "$t")" "$(git -C "$t" log -1 --format='%h %s' | cut -c1-60)" "$d"
    done ;;
  gc)
    lock
    for t in $(trees); do
      h=$(holder "$t"); a=$(lease_age_h "$t")
      if [ -n "$h" ] && [ "$a" -ge "$TTL_H" ]; then save_diff "$t" "lease of $h expired (${a}h)"; rm -f "$leases/$(basename "$t")"; echo "freed $(basename "$t") ($h, ${a}h)"; fi
    done ;;
  init)
    seed=${2:?SEED_TREE}; n=${3:?N}
    : "${LANE_POOL_REPO:?}" "${LANE_POOL_PACKAGES:?}" "${LAKE_CACHE_DIR:?}"
    [ -d "$seed/.lake/packages" ] && [ -d "$seed/.lake/build" ] || die "$seed is not a built tree"
    lock
    if [ ! -d "$LANE_POOL_PACKAGES" ]; then
      key=$(cat "$seed/lake-manifest.json" "$seed/lean-toolchain" | sha256 | cut -c1-12)
      case $LANE_POOL_PACKAGES in *"$key"*) ;; *) die "LANE_POOL_PACKAGES must name the manifest key $key";; esac
      s=$(now); mkdir -p "$LANE_POOL_PACKAGES.tmp"
      for p in "$seed/.lake/packages"/*; do   # a symlinked package (the Mac's shared checkouts) by its target
        clone_dir "$(CDPATH='' cd -- "$p" && pwd -P)" "$LANE_POOL_PACKAGES.tmp/$(basename -- "$p")"; done
      chmod -R a-w "$LANE_POOL_PACKAGES.tmp"; mv "$LANE_POOL_PACKAGES.tmp" "$LANE_POOL_PACKAGES"
      echo "shared packages: $(du -sh "$LANE_POOL_PACKAGES" | cut -f1) in $(( $(now) - s )) s"
    fi
    mkdir -p "$LAKE_CACHE_DIR"
    if [ ! -d "$LANE_POOL_REPO" ]; then
      # the pool's own bare repo, owned by the lanes user (a shared clone's object store can hold
      # root-owned directories, and then no fetch succeeds); objects are borrowed from the seed's repo
      ref=$(CDPATH='' cd -- "$seed" && CDPATH='' cd -- "$(git rev-parse --git-common-dir)" && pwd -P)
      git clone -q --bare --reference "$ref" "${LANE_POOL_ORIGIN:-https://github.com/emberian/minidregg.git}" "$LANE_POOL_REPO"
      git -C "$LANE_POOL_REPO" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
      git -C "$LANE_POOL_REPO" fetch -q origin
    fi
    i=$(trees | wc -l)
    while [ "$i" -lt "$n" ]; do
      i=$((i + 1)); t=$LANE_POOL_ROOT/t$i; s=$(now)
      git -C "$LANE_POOL_REPO" worktree add -q --detach "$t" origin/main
      mkdir -p "$t/.lake"; ln -sfn "$LANE_POOL_PACKAGES" "$t/.lake/packages"
      warm "$t" "$seed"
      echo "t$i: $(( $(now) - s )) s, $(du -sh "$t" | cut -f1)"
    done ;;
  *) sed -n 2,12p "$0" >&2; exit 2 ;;
esac
