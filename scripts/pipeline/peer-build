#!/usr/bin/env bash
# scripts/pipeline/peer-build LANE SHA TARGET... -- build a sibling box's lane HERE, in a free lane slot.
#
# The remote half of build-anywhere, reached ONLY through box-peer-gate (the peer key's forced
# command). The requester pushed its lane's HEAD to the burst's shared remote as lane/<LANE>; this
# box fetches SHA from there into its OWN copy of the lane, $PIPELINE_LANES/peer-<LANE>/src (made by
# mk-lane from this box's warm base when absent; never a lane an agent works in here), checks it
# out and runs `slot.sh swarm-build lake build TARGET...`. stdout+stderr is the build log, the exit
# code the build's. Products stay here: the requester gets the verdict and the log.
set -uo pipefail
PIPELINE_PROG=peer-build
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib.sh"
lane=${1:-} sha=${2:-}; shift 2 2>/dev/null || pipeline_die "usage: peer-build LANE SHA TARGET..."
[[ $lane =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || pipeline_die "bad lane name"
[[ $sha =~ ^[0-9a-f]{40}$ ]] || pipeline_die "SHA must be 40 hex"
[ $# -ge 1 ] || pipeline_die "no targets"
for t in "$@"; do [[ $t =~ ^[A-Za-z0-9._+:-]+$ ]] || pipeline_die "bad target $t"; done
LANES=${PIPELINE_LANES:-/srv/lanes}
shared=${PIPELINE_GIT:-/srv/git/minidregg.git}
[ -d "$shared" ] || shared=${PIPELINE_SHARED_REMOTE:-${PIPELINE_PEER:?no shared remote here and no PIPELINE_PEER}:/srv/git/minidregg.git}
d=$LANES/peer-$lane/src
if [ ! -d "$d" ]; then
  pipeline_log "making peer-$lane from this box's warm base"
  "$here/mk-lane.sh" "peer-$lane" >&2 || pipeline_die "mk-lane peer-$lane failed"
fi
cd "$d" || exit 1
[ -z "$(git status --porcelain --untracked-files=no)" ] || pipeline_die "$d has uncommitted tracked edits; refusing"
git fetch -q "$shared" "refs/heads/lane/$lane" || pipeline_die "cannot fetch lane/$lane from $shared"
git cat-file -e "$sha^{commit}" 2>/dev/null || pipeline_die "$sha is not in lane/$lane on $shared (push first)"
git checkout -q -B main "$sha"
pipeline_log "$(hostname): peer-$lane at $sha; lake build $*; slots free: $("$here/slots" --free 2>/dev/null | paste -sd' ' || echo none-waiting)"
export SWARM_BUILD_TAG="peer-$lane" SWARM_MEM_MAX=${SWARM_MEM_MAX:-24G}
exec "$here/slot.sh" swarm-build lake build "$@" 2>&1
