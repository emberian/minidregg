+    def start_b_service(self, mini_b, ready):
+        """Pin B's live fn inputs outside the request frame and keep one Mini session."""
+        L = self.out
+        config = json.loads(Path(mini_b).read_text())
+        config["fnPoll"] = {
+            "originConfigPath": str(Path(self.args.origin_pin).resolve()),
+            "fnPinPath": str(L / "r-fn-pin.json"),
+            "scopePath": str(L / "b-scope-pin.json"),
+            "policyPath": str(Path(self.args.mini_b_policy or self.args.policy).resolve()),
+            "controlPath": ready["b_control"]}
+        service_config = L / "mini-b-service-config.json"
+        service_config.write_text(json.dumps(config, sort_keys=True, indent=2) + "\n")
+        socket_dir = L / "mini-b-service"
+        socket_dir.mkdir(mode=0o700)
+        socket = socket_dir / "host.sock"
+        with (L / "mini-b-service.log").open("wb") as log:
+            self.b_service = subprocess.Popen(
+                [self.mini_client, "serve", "--host", self.mini_bin,
+                 "--config", service_config, "--socket", socket],
+                stdout=log, stderr=subprocess.STDOUT, cwd=L, env=self.benv)
+        for _ in range(600):
+            if socket.exists():
+                break
+            if self.b_service.poll() is not None:
+                raise Stop("Mini B session exited before socket readiness")
+            time.sleep(0.1)
+        else:
+            raise Stop("Mini B session socket did not become ready")
+        self.mini("mini-b-service-ready", ["/bin/test", "-S", socket])
+        return service_config, socket
 
