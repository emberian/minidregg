+    def start_a_service(self, mini_a, ready):
+        """Pin A's R origin and live Q consumer outside the typed request."""
+        L = self.out
+        config = json.loads(Path(mini_a).read_text())
+        config["fnReplyPoll"] = {
+            "originConfigPath": str(Path(self.args.origin_pin).resolve()),
+            "rPinPath": str(L / "r-fn-pin.json"),
+            "rClaimPath": str(Path(self.args.r_claim).resolve()),
+            "rCarrierPath": str(L / "r-at-a.eml"),
+            "qPinPath": str(L / "q-fn-pin.json"),
+            "scopePath": str(L / "a-scope-pin.json"),
+            "qClaimPath": str(L / "q-claim.json"),
+            "policyPath": str(Path(self.args.mini_a_policy or self.args.policy).resolve()),
+            "controlPath": ready["a_control"]}
+        service_config = L / "mini-a-service-config.json"
+        service_config.write_text(json.dumps(config, sort_keys=True, indent=2) + "\n")
+        socket_dir = L / "mini-a-service"
+        socket_dir.mkdir(mode=0o700)
+        socket = socket_dir / "host.sock"
+        with (L / "mini-a-service.log").open("wb") as log:
+            self.a_service = subprocess.Popen(
+                [self.mini_client, "serve", "--host", self.mini_bin,
+                 "--config", service_config, "--socket", socket],
+                stdout=log, stderr=subprocess.STDOUT, cwd=L, env=self.benv)
+        for _ in range(600):
+            if socket.exists():
+                break
+            if self.a_service.poll() is not None:
+                raise Stop("Mini A session exited before socket readiness")
+            time.sleep(0.1)
+        else:
+            raise Stop("Mini A session socket did not become ready")
+        self.mini("mini-a-service-ready", ["/bin/test", "-S", socket])
