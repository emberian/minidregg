+    def fn_native(self, label, *args, check=None):
+        """Run an exact native fn command in this run's isolated hbox Store."""
+        image = self.args.image_dir.rstrip("/") + "/fn-host"
+        command = "FN_OPENSSL_PREFIX=" + shlex.quote(self.args.openssl_prefix) + " " + \
+            " ".join(shlex.quote(str(part)) for part in (image, "--fn", *args))
+        return self.mini(label, ["ssh", self.host, command], check=check)
+
+    def fn_status(self, label, control):
+        self.fn_native(label, "consumer", "status", control, CONSUMER)
+        text = (self.logs / "{:02d}-{}.log".format(self.n, label)).read_text()
+        found = re.search(r"consumer status accepted committed-ack=(\d+) "
+                          r"committed-journal-frontier=(\d+) journal-event-distance=(\d+)", text)
+        if not found:
+            raise Stop(label + " returned no native consumer status")
+        return tuple(int(value) for value in found.groups())
+
+    def b_skip_pages_before_r(self, mini_b, ready):
+        """Native neutral events and durable skips through a short fn scan page."""
+        L = self.out
+        b_root = ready["b_root"]
+        registered = b_root + "/registered.fncu"
+        self.fn_native("b-initial-inspect", "consumer-inspect", registered)
+        inspected = (self.logs / "{:02d}-b-initial-inspect.log".format(self.n)).read_text()
+        fields = dict(re.findall(r"([a-z-]+)=([^\s]+)", inspected.split("fn-consumer-inspect-v1", 1)[1]))
+        if fields.get("position") != "0":
+            raise Stop("B initial fn cursor did not begin at position zero")
+        scope = {"history": fields["history"], "incarnation": fields["incarnation"],
+                 "consumer": fields["consumer"], "principal": fields["principal"],
+                 "query": fields["query"], "queryVersion": int(fields["query-version"]),
+                 "viewVersion": int(fields["view-version"]),
+                 "registrationEpoch": int(fields["registration-epoch"])}
+        (L / "b-scope-pin.json").write_text(json.dumps(scope, sort_keys=True) + "\n")
+        r_keys = self.fetch_keys(ready["r"], "r-early")
+        (L / "r-fn-pin.json").write_text(json.dumps(self.pin(self.bridge, r_keys), sort_keys=True) + "\n")
+        for index in range(17):
+            self.fn_native("b-neutral-{:02d}".format(index), "consumer", "register",
+                           ready["b_control"], "mini-neutral-{:02d}".format(index),
+                           GROUP, b_root + "/neutral-{:02d}.fncu".format(index))
+        config, socket = self.start_b_service(mini_b, ready)
+        initial_ack, frontier, _ = self.fn_status("b-before-skip-status", ready["b_control"])
+        if initial_ack != 0 or frontier < 17:
+            raise Stop("B neutral registration did not create bounded scan backlog")
+        first = True
+        for index in range(8):
+            poll_dir = L / "b-skip-poll-{:02d}".format(index)
+            self.mini("b-skip-poll-{:02d}".format(index),
+                      [self.mini_client, "consumer-poll", "--host", self.mini_bin,
+                       "--config", config, "--socket", socket, "--dir", poll_dir])
+            answer = self.json("b-skip-poll-{:02d}/decision.json".format(index))
+            if answer.get("status") == "idle":
+                if first:
+                    raise Stop("B neutral backlog yielded idle before any skip")
+                if (answer.get("decision", {}).get("type") != "fn-empty-page-idle-v1" or
+                    int(answer["decision"]["position"]) != initial_ack or
+                    initial_ack != frontier):
+                    raise Stop("B idle answer differs from acknowledged frontier")
+                break
+            decision = answer.get("decision", {})
+            from_position = int(decision.get("fromPosition", "-1"))
+            to_position = int(decision.get("toPosition", "-1"))
+            if (answer.get("status") != "skip-decision" or
+                decision.get("type") != "fn-empty-page-progress-decision-v1" or
+                decision.get("decision") != "proposed-fresh" or
+                from_position != initial_ack or
+                not (initial_ack < to_position <= initial_ack + 16 and to_position <= frontier) or
+                not (poll_dir / "intent.bin").is_file()):
+                raise Stop("B empty page did not propose a fresh Mini skip")
+            submit_dir = L / "b-skip-submit-{:02d}".format(index)
+            self.mini("b-skip-submit-{:02d}".format(index),
+                      [self.mini_client, "submit", "--host", self.mini_bin,
+                       "--config", config, "--socket", socket,
+                       "--intent", poll_dir / "intent.bin", "--intent-kind", "binary",
+                       "--key", self.args.mini_b_custody_key or self.args.mini_custody_key,
+                       "--dir", submit_dir],
+                      check=lambda: (self.json("b-skip-submit-{:02d}/outcome.json".format(index)).get("type") == "confirmed"
+                                     and self.json("b-skip-submit-{:02d}/outcome.json".format(index)).get("confirmation") == "installed"))
+            transaction = self.json("b-skip-submit-{:02d}/outcome.json".format(index))["transactionId"]
+            if first:
+                self.b_service.terminate()
+                self.b_service.wait(timeout=10)
+                self.b_service = None
+                socket.unlink(missing_ok=True)
+                config, socket = self.start_b_service(mini_b, ready)
+                repeat_dir = L / "b-skip-repeat"
+                self.mini("b-skip-repeat", [self.mini_client, "consumer-poll",
+                          "--host", self.mini_bin, "--config", config,
+                          "--socket", socket, "--dir", repeat_dir],
+                          check=lambda: (self.json("b-skip-repeat/decision.json").get("status") == "skip-decision"
+                                         and self.json("b-skip-repeat/decision.json").get("decision", {}).get("type") == "fn-empty-page-progress-decision-v1"
+                                         and self.json("b-skip-repeat/decision.json").get("decision", {}).get("decision") == "repeated"
+                                         and int(self.json("b-skip-repeat/decision.json")["decision"]["fromPosition"]) == from_position
+                                         and int(self.json("b-skip-repeat/decision.json")["decision"]["toPosition"]) == to_position
+                                         and not (repeat_dir / "intent.bin").exists()))
+                first = False
+            ack_dir = L / "b-skip-ack-{:02d}".format(index)
+            self.mini("b-skip-ack-{:02d}".format(index),
+                      [self.mini_client, "consumer-ack", "--host", self.mini_bin,
+                       "--config", config, "--socket", socket,
+                       "--mini-transaction", transaction, "--dir", ack_dir],
+                      check=lambda: (self.json("b-skip-ack-{:02d}/ack.json".format(index)).get("kind") == "empty-page-skip"
+                                     and self.json("b-skip-ack-{:02d}/ack.json".format(index)).get("fnAck") == "durable-accepted"))
+            ack, frontier, _ = self.fn_status("b-after-skip-status-{:02d}".format(index),
+                                             ready["b_control"])
+            if ack != to_position or ack > frontier:
+                raise Stop("B fn ACK differs from the accepted Mini skip cursor")
+            initial_ack = ack
+            # fn's ACK is itself a Store event. A subsequent poll may observe
+            # that event, so demanding idle would chase our own ACK forever.
+            # The native consumer ends this wake after a short scan page.
+            if to_position - from_position < 16:
+                break
+        else:
+            raise Stop("B neutral backlog did not reach a short fn page within eight scans")
 
