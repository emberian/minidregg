#!/usr/bin/env bash
# Fixture model of the volume helper (native/spk-host/src/broker_volume_dir.rs), for
# `fixture-os` journeys only (copied into $MINI_FIXTURE_OS; the broker clears the
# environment, so the model root is this file's directory). The volume is a plain
# directory; the project quota is modeled: the directory is registered in
# $MINI_FIXTURE_OS/mounts/<name> with its size and project id, which
# src/fixture_os.rs answers as a bounded project directory. The registration and
# witness bytes are the real helper's, field for field.
set -euo pipefail
usage() { echo 'usage: volume-helper-model --root GRAINS_ROOT create STORE RESOURCE APP_UID SIZE_MIB VOLUME_HEX | attest STORE RESOURCE' >&2; exit 2; }
fos=$(cd -- "$(dirname -- "$0")" && pwd)
(( $# >= 5 )) && [[ $1 == --root ]] || usage
root=$2
shift 2
action=$1 store=$2 resource=$3
case $action in
  create) (( $# == 6 )) || usage ;;
  attest) (( $# == 3 )) || usage ;;
  *) usage ;;
esac
[[ $store =~ ^[0-9a-f]{16}$ && $resource =~ ^[1-9][0-9]{0,17}$ ]] || usage
name=$store-$resource
target=$root/vars/$name
config=$root/volumes/$name.conf
umask 077
mkdir -p -m 700 "$root/volumes"
mkdir -p -m 711 "$root/vars"
mkdir -p -m 755 "$root/attest"
mkdir -p -m 700 "$fos/mounts"
mapfile -t identity_lines < "$fos/host-identity"
deployment_id=${identity_lines[0]#deployment_id=}
host_id=${identity_lines[1]#host_id=}
if [[ $action == create ]]; then
  app_uid=$4 size_mib=$5 volume_id=$6
  [[ $app_uid =~ ^[1-9][0-9]{0,9}$ && $size_mib =~ ^[1-9][0-9]{0,5}$ && $volume_id =~ ^[0-9a-f]{64}$ ]] || usage
  (( size_mib >= 64 && size_mib <= 16384 )) || usage
  [[ ! -e $config && ! -e $target ]] || { echo 'volume already exists' >&2; exit 1; }
  bytes=$(( size_mib * 1024 * 1024 ))
  project=$(( 1000000000 + 0x$(printf '%s' "$name" | sha256sum | cut -c1-7) ))
  mkdir -m 700 -- "$target"
  printf 'mount=%s\nbytes=%s\nproject=%s\n' "$target" "$bytes" "$project" > "$fos/mounts/$name"
  printf 'app_uid=%s\nsize_mib=%s\ndeployment_id=%s\nhost_id=%s\nvolume_id=%s\nproject_id=%s\n' \
    "$app_uid" "$size_mib" "$deployment_id" "$host_id" "$volume_id" "$project" > "$config"
  chmod 600 -- "$config"
fi
mapfile -t config_lines < "$config"
app_uid=${config_lines[0]#app_uid=}
size_mib=${config_lines[1]#size_mib=}
volume_id=${config_lines[4]#volume_id=}
project=${config_lines[5]#project_id=}
bytes=$(( size_mib * 1024 * 1024 ))
if [[ $action == attest ]]; then
  witness=$(printf 'DREGG/SPK-VAR-CUSTODY/v1+projdir\ndeployment_id=%s\nhost_id=%s\nresource=%s\nvolume_id=%s\napp_uid=%s\nquota_bytes=%s\nproject_id=%s\nfs_type=ext4\ndirectory_inode=%s\ndirectory=%s' \
    "$deployment_id" "$host_id" "$resource" "$volume_id" "$app_uid" "$bytes" "$project" "$(stat -c '%i' -- "$target")" "$target")
  tmp=$(mktemp "$root/attest/.witness.XXXXXXXX")
  printf '%s\n' "$witness" > "$tmp"
  chmod 644 -- "$tmp"
  mv -fT -- "$tmp" "$root/attest/$name.witness"
fi
echo "verified store=$store resource=$resource uid=$app_uid size_mib=$size_mib mount=$target"
