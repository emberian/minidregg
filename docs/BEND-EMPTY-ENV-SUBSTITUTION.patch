+-- The logical definition remains precisely the original environment
+-- substitution. Native execution avoids traversing t for the empty environment.
+def Term.subEnv (e : Env) (t : Term) : Term := Term.sub (Env.sub e) t
+
+def Term.subEnvFast (e : Env) (t : Term) : Term :=
+  match e with
+  | [] => t
+  | _ :: _ => Term.sub (Env.sub e) t
+
+@[csimp] theorem subEnv_fast : @Term.subEnv = @Term.subEnvFast := by
+  have up : Subst.up Var = Var := by
+    funext i
+    cases i <;> rfl
+  have identity (t : Term) : Term.sub Var t = t := by
+    induction t <;> simp [Term.sub, up, *]
+  funext e t
+  cases e with
+  | nil => exact identity t
+  | cons x xs => rfl
+
