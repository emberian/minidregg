edition ObjectiveBend 1
# CollectiveAdoption: ballot, absolute-YES quorum, and preparation of an
# installation proposal over kernel-authenticated samples.
#
# No signatures or grants are fabricated here; a ballot result cannot grant
# authority to install and cannot change what it endorsed.
import ./CatalogReview.obend as Review

sum Subjects:
  empty: {}
  more: {head: String, tail: Subjects}

record Vote:
  subject: String
  yes: Bool

sum Votes:
  empty: {}
  more: {head: Vote, tail: Votes}

record Proposal:
  round: String
  base: Review.Candidate
  candidate: Review.Candidate
  basePrototype: String
  candidatePrototype: String
  baseKindRoot: String
  instanceRoot: String
  migration: String
  policy: String
  electorate: Subjects
  quorum: Nat

record Ballots:
  proposal: Proposal
  votes: Votes
  closed: Bool

record Cast:
  expected: Ballots
  successor: Ballots
  yesCount: Nat
  totalCount: Nat

sum CastResult:
  refused: Ballots
  accepted: Cast

record Resolved:
  expected: Ballots
  successor: Ballots
  decision: Review.Decision

sum Resolution:
  unresolved: Ballots
  resolved: Resolved

record Install:
  adoption: Review.Adoption
  binding: Proposal

sum Installation:
  refused: {}
  install: Install

# ---- the quorum rule: a spec, combined by `and` --------------------------------

record Rule:
  carries(quorum: Nat, yes: Nat) -> Bool
  attainable(quorum: Nat, seats: Nat) -> Bool

spec PositiveQuorum for Rule:
  combine and carries(quorum: Nat, yes: Nat) -> Bool:
    0n < quorum
  combine and attainable(quorum: Nat, seats: Nat) -> Bool:
    0n < quorum

spec AbsoluteQuorum extends PositiveQuorum for Rule:
  combine and carries(quorum: Nat, yes: Nat) -> Bool:
    quorum <= yes
  combine and attainable(quorum: Nat, seats: Nat) -> Bool:
    quorum <= seats

def blankRule() -> Rule:
  {carries: fn(quorum: Nat, yes: Nat) -> Bool: false, attainable: fn(quorum: Nat, seats: Nat) -> Bool: false}

def rule() -> Rule:
  fix(AbsoluteQuorum, blankRule())

# ---- ballot arithmetic --------------------------------------------------------

def member(subject: String, electorate: Subjects) -> Bool:
  match electorate:
    case empty(_): false
    case more(m): subject == m.head || member(subject, m.tail)

def used(subject: String, votes: Votes) -> Bool:
  match votes:
    case empty(_): false
    case more(m): subject == m.head.subject || used(subject, m.tail)

def yesCount(votes: Votes) -> Nat:
  match votes:
    case empty(_): 0n
    case more(m): if m.head.yes then 1n + yesCount(m.tail) else yesCount(m.tail)

def totalCount(votes: Votes) -> Nat:
  match votes:
    case empty(_): 0n
    case more(m): 1n + totalCount(m.tail)

def electorateCount(electorate: Subjects) -> Nat:
  match electorate:
    case empty(_): 0n
    case more(m): 1n + electorateCount(m.tail)

def not(b: Bool) -> Bool:
  if b then false else true

def uniqueElectorate(electorate: Subjects) -> Bool:
  match electorate:
    case empty(_): true
    case more(m): not(member(m.head, m.tail)) && uniqueElectorate(m.tail)

def validVotes(votes: Votes, electorate: Subjects) -> Bool:
  match votes:
    case empty(_): true
    case more(m): member(m.head.subject, electorate) && not(used(m.head.subject, m.tail)) && validVotes(m.tail, electorate)

def valid(state: Ballots) -> Bool:
  uniqueElectorate(state.proposal.electorate) && rule().attainable(state.proposal.quorum, electorateCount(state.proposal.electorate)) && validVotes(state.votes, state.proposal.electorate)

def castAllowed(state: Ballots, actor: String, round: String) -> Bool:
  valid(state) && round == state.proposal.round && not(state.closed) && member(actor, state.proposal.electorate) && not(used(actor, state.votes))

def acceptCast(state: Ballots, nextVotes: Votes) -> CastResult:
  CastResult.accepted({expected: state, successor: {proposal: state.proposal, votes: nextVotes, closed: false}, yesCount: yesCount(nextVotes), totalCount: totalCount(nextVotes)})

def cast(state: Ballots, actor: String, round: String, yes: Bool) -> CastResult:
  if castAllowed(state, actor, round) then acceptCast(state, Votes.more({head: {subject: actor, yes: yes}, tail: state.votes})) else CastResult.refused(state)

def resolveAllowed(state: Ballots) -> Bool:
  valid(state) && not(state.closed) && rule().carries(state.proposal.quorum, yesCount(state.votes))

def resolve(state: Ballots) -> Resolution:
  if resolveAllowed(state) then Resolution.resolved({expected: state, successor: {proposal: state.proposal, votes: state.votes, closed: true}, decision: {candidate: state.proposal.candidate, policy: state.proposal.policy, endorsed: true}}) else Resolution.unresolved(state)

def endorsed(state: Ballots) -> Bool:
  valid(state) && state.closed && rule().carries(state.proposal.quorum, yesCount(state.votes))

def installAllowed(state: Ballots, current: Review.Candidate, currentPrototype: String, currentKindRoot: String, currentInstanceRoot: String, migration: String, review: Review.Recommendation) -> Bool:
  Review.candidateEq(state.proposal.base, current) && state.proposal.basePrototype == currentPrototype && state.proposal.baseKindRoot == currentKindRoot && state.proposal.instanceRoot == currentInstanceRoot && state.proposal.migration == migration && Review.eligible(state.proposal.candidate, state.proposal.policy, review, {candidate: state.proposal.candidate, policy: state.proposal.policy, endorsed: endorsed(state)})

def prepareInstall(state: Ballots, current: Review.Candidate, currentPrototype: String, currentKindRoot: String, currentInstanceRoot: String, migration: String, review: Review.Recommendation) -> Installation:
  if installAllowed(state, current, currentPrototype, currentKindRoot, currentInstanceRoot, migration, review) then Installation.install({adoption: Review.Adoption.propose({expected: current, selected: state.proposal.candidate, policy: state.proposal.policy}), binding: state.proposal}) else Installation.refused()
