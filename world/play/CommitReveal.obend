edition ObjectiveBend 1
# CommitReveal: two-party commit/reveal game on Kernel/ObjectiveActivity with timeout forfeiture.
law moves_monotone: request.turn in [1, 4] or monotone(moves)

record Table:
  a: Nat
  b: Nat
  stake: Nat
  window: Nat
record Waiting:
  table: Table
  due: Nat
record AfterA:
  table: Table
  due: Nat
  sealA: Nat
record Sealed:
  table: Table
  due: Nat
  sealA: Nat
  sealB: Nat
record OneOpen:
  table: Table
  due: Nat
  sealA: Nat
  sealB: Nat
  moveA: Nat
record Verdict:
  outcome: String
  toA: Nat
  toB: Nat
sum Game:
  commitA: Waiting
  commitB: AfterA
  revealA: Sealed
  revealB: OneOpen
  settled: Verdict
record Commit:
  who: Nat
  seal: Nat
  now: Nat
record Reveal:
  who: Nat
  move: Nat
  salt: Nat
  now: Nat
record Tick:
  now: Nat
sum Event:
  commit: Commit
  reveal: Reveal
  timeout: Tick
sum Transition:
  refused: Game
  moved: Game
  ended: Verdict

def validMove(m: Nat) -> Bool:
  m < 3n

def beats(x: Nat, y: Nat) -> Bool:
  (x == 1n && y == 0n) || (x == 2n && y == 1n) || (x == 0n && y == 2n)

def seal(move: Nat, salt: Nat) -> Nat:
  salt * 3n + move

def pot(t: Table) -> Nat:
  t.stake * 2n

def tableOf(g: Game) -> Table:
  match g:
    case commitA(w): w.table
    case commitB(h): h.table
    case revealA(s): s.table
    case revealB(o): o.table
    case settled(_): {a: 0n, b: 0n, stake: 0n, window: 0n}

def phaseOf(g: Game) -> String:
  match g:
    case commitA(_): "commitA"
    case commitB(_): "commitB"
    case revealA(_): "revealA"
    case revealB(_): "revealB"
    case settled(v): v.outcome

def isSettled(g: Game) -> Bool:
  match g:
    case commitA(_): false
    case commitB(_): false
    case revealA(_): false
    case revealB(_): false
    case settled(_): true

def dueOf(g: Game) -> Nat:
  match g:
    case commitA(w): w.due
    case commitB(h): h.due
    case revealA(s): s.due
    case revealB(o): o.due
    case settled(_): 0n

def start(a: Nat, b: Nat, stake: Nat, window: Nat, now: Nat) -> Game:
  Game.commitA({table: {a: a, b: b, stake: stake, window: window}, due: now + window})

def voided(t: Table) -> Transition:
  Transition.ended({outcome: "voided", toA: t.stake, toB: t.stake})

def forfeitsA(t: Table) -> Transition:
  Transition.ended({outcome: "aForfeits", toA: 0n, toB: pot(t)})

def forfeitsB(t: Table) -> Transition:
  Transition.ended({outcome: "bForfeits", toA: pot(t), toB: 0n})

def decide(t: Table, moveA: Nat, moveB: Nat) -> Transition:
  if beats(moveA, moveB) then Transition.ended({outcome: "aWins", toA: pot(t), toB: 0n}) else if beats(moveB, moveA) then Transition.ended({outcome: "bWins", toA: 0n, toB: pot(t)}) else Transition.ended({outcome: "draw", toA: t.stake, toB: t.stake})

def commitOn(g: Game, c: Commit) -> Transition:
  match g:
    case commitA(w): if c.who == w.table.a && c.now <= w.due then Transition.moved(Game.commitB({table: w.table, due: c.now + w.table.window, sealA: c.seal})) else Transition.refused(g)
    case commitB(h): if c.who == h.table.b && c.now <= h.due then Transition.moved(Game.revealA({table: h.table, due: c.now + h.table.window, sealA: h.sealA, sealB: c.seal})) else Transition.refused(g)
    case revealA(_): Transition.refused(g)
    case revealB(_): Transition.refused(g)
    case settled(_): Transition.refused(g)

def revealOn(g: Game, r: Reveal) -> Transition:
  match g:
    case revealA(s): if r.who == s.table.a && r.now <= s.due && validMove(r.move) && seal(r.move, r.salt) == s.sealA then Transition.moved(Game.revealB({table: s.table, due: r.now + s.table.window, sealA: s.sealA, sealB: s.sealB, moveA: r.move})) else Transition.refused(g)
    case revealB(o): if r.who == o.table.b && r.now <= o.due && validMove(r.move) && seal(r.move, r.salt) == o.sealB then decide(o.table, o.moveA, r.move) else Transition.refused(g)
    case commitA(_): Transition.refused(g)
    case commitB(_): Transition.refused(g)
    case settled(_): Transition.refused(g)

def timeoutOn(g: Game, k: Tick) -> Transition:
  match g:
    case commitA(w): if w.due < k.now then voided(w.table) else Transition.refused(g)
    case commitB(h): if h.due < k.now then voided(h.table) else Transition.refused(g)
    case revealA(s): if s.due < k.now then forfeitsA(s.table) else Transition.refused(g)
    case revealB(o): if o.due < k.now then forfeitsB(o.table) else Transition.refused(g)
    case settled(_): Transition.refused(g)

def react(g: Game, e: Event) -> Transition:
  match e:
    case commit(c): commitOn(g, c)
    case reveal(r): revealOn(g, r)
    case timeout(k): timeoutOn(g, k)

def stateOf(t: Transition) -> Game:
  match t:
    case refused(g): g
    case moved(g): g
    case ended(v): Game.settled(v)

def wasRefused(t: Transition) -> Bool:
  match t:
    case refused(_): true
    case moved(_): false
    case ended(_): false

record Opening:
  a: Nat
  b: Nat
  stake: Nat
  window: Nat
  now: Nat
  keeper: Nat
  fresh: Bool
record Ledger:
  moves: Nat
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
record Write:
  moves: EditNat
record Ask:
  decider: Nat
record At:
  at: Nat
sum Source:
  reply: Ask
  height: At
record Await:
  write: Write
  on: Source
  patience: Nat
record Pay:
  to: Nat
  amount: Nat
  write: Write
sum Plan:
  await: Await
  transfer: Pay
sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}
record View:
  version: Nat
  state: Ledger
record Step:
  outcome: Outcome
  view: View
sum Response:
  resumed: Step

def keepLedger() -> Write:
  {moves: EditNat.keep()}

def ask(o: Opening, w: Write) -> Plan:
  Plan.await({write: w, on: Source.reply({decider: o.keeper}), patience: 64n})

def pay(to: Nat, amount: Nat) -> Plan:
  Plan.transfer({to: to, amount: amount, write: {moves: EditNat.add(1n)}})

def serve(o: Opening, g: Game, w: Write) -> Activity<Plan, Response, String>:
  match perform(ask(o, w)):
    case resumed(r):
      match r.outcome:
        case reply(e): step(o, g, react(g, e))
        case settled(_): serve(o, g, keepLedger())
        case refused(_): serve(o, g, keepLedger())
        case unknown(_): serve(o, g, keepLedger())
        case timedOut(_): serve(o, g, keepLedger())
        case broken(_): serve(o, g, keepLedger())
        case upgraded(_): serve(o, g, keepLedger())

def step(o: Opening, g: Game, t: Transition) -> Activity<Plan, Response, String>:
  match t:
    case refused(unchanged): serve(o, unchanged, keepLedger())
    case moved(next): serve(o, next, keepLedger())
    case ended(v): if v.toA == 0n then payB(o, g, v) else payA(o, g, v)

def payA(o: Opening, g: Game, v: Verdict) -> Activity<Plan, Response, String>:
  match perform(pay(tableOf(g).a, v.toA)):
    case resumed(r):
      match r.outcome:
        case settled(_): payB(o, g, v)
        case refused(_): serve(o, g, keepLedger())
        case reply(_): serve(o, g, keepLedger())
        case unknown(_): serve(o, g, keepLedger())
        case timedOut(_): serve(o, g, keepLedger())
        case broken(_): serve(o, g, keepLedger())
        case upgraded(_): serve(o, g, keepLedger())

def payB(o: Opening, g: Game, v: Verdict) -> Activity<Plan, Response, String>:
  if v.toB == 0n then v.outcome else sendB(o, g, v)

def sendB(o: Opening, g: Game, v: Verdict) -> Activity<Plan, Response, String>:
  match perform(pay(tableOf(g).b, v.toB)):
    case resumed(r):
      match r.outcome:
        case settled(_): v.outcome
        case refused(_): retryB(o, g, v)
        case reply(_): retryB(o, g, v)
        case unknown(_): retryB(o, g, v)
        case timedOut(_): retryB(o, g, v)
        case broken(_): retryB(o, g, v)
        case upgraded(_): retryB(o, g, v)

def retryB(o: Opening, g: Game, v: Verdict) -> Activity<Plan, Response, String>:
  match perform(ask(o, keepLedger())):
    case resumed(_): payB(o, g, v)

def play(o: Opening) -> Activity<Plan, Response, String>:
  serve(o, start(o.a, o.b, o.stake, o.window, o.now), if o.fresh then {moves: EditNat.set(0n)} else keepLedger())
