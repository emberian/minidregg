edition ObjectiveBend 1
# BountyEscrow: native seat-store bounty contract (Kernel/Seat, Kernel/SeatStore).
# Reads open seats (escrow, claim, work, approve, reject, cancel) and emits seat plans
# (`mint`, `reallocate`, `exit`) judged by the kernel's offer-safety and conservation laws.

record Amount:
  asset: Nat
  amount: Nat
sum Amounts:
  nil: {}
  cons: {head: Amount, tail: Amounts}
record Term:
  name: String
  value: Nat
sum Terms:
  nil: {}
  cons: {head: Term, tail: Terms}
sum Exit:
  onDemand: {}
  afterDeadline: Nat
sum Shown:
  hidden: {}
  none: {}
  shown: Nat
record Disclosed:
  offerer: Shown
  payee: Shown
  holder: Shown
record SeatView:
  seat: Nat
  role: String
  terms: Terms
  give: Amounts
  want: Amounts
  exit: Exit
  opened: Nat
  allocation: Amounts
  disclosed: Disclosed
sum Seats:
  nil: {}
  cons: {head: SeatView, tail: Seats}
record Move:
  source: Nat
  destination: Nat
  asset: Nat
  amount: Nat
sum Moves:
  nil: {}
  cons: {head: Move, tail: Moves}
record PostIn:
  holder: Nat
  review: Nat
record ClaimIn:
  holder: Nat
sum Input:
  post: PostIn
  claim: ClaimIn
  advance: {}
  pad: ClaimIn
record Call:
  input: Input
  height: Nat
  invoker: Shown
  seats: Seats
record Mint:
  role: String
  terms: Terms
  holder: Nat
record ExitSeat:
  seat: Nat
record Reallocate:
  moves: Moves
sum Action:
  reallocate: Reallocate
  mint: Mint
  exit: ExitSeat
  terminate: {}
sum Plan:
  nil: {}
  cons: {head: Action, tail: Plan}
sum Maybe:
  absent: {}
  present: SeatView

def held(asset: Nat, amounts: Amounts) -> Nat:
  match amounts:
    case nil(_): 0n
    case cons(c): if c.head.asset == asset then c.head.amount else held(asset, c.tail)

def term(name: String, terms: Terms) -> Nat:
  match terms:
    case nil(_): 0n
    case cons(c): if c.head.name == name then c.head.value else term(name, c.tail)

def isNil(amounts: Amounts) -> Bool:
  match amounts:
    case nil(_): true
    case cons(_): false

def isOne(amounts: Amounts) -> Bool:
  match amounts:
    case nil(_): false
    case cons(c): isNil(c.tail)

def headAsset(amounts: Amounts) -> Nat:
  match amounts:
    case nil(_): 0n
    case cons(c): c.head.asset

def headAmount(amounts: Amounts) -> Nat:
  match amounts:
    case nil(_): 0n
    case cons(c): c.head.amount

def isOneOf(amounts: Amounts, asset: Nat, amount: Nat) -> Bool:
  isOne(amounts) && headAsset(amounts) == asset && headAmount(amounts) == amount

def hasDue(rule: Exit) -> Bool:
  match rule:
    case onDemand(_): false
    case afterDeadline(_): true

def dueOf(rule: Exit) -> Nat:
  match rule:
    case onDemand(_): 0n
    case afterDeadline(h): h

def isEmpty(seats: Seats) -> Bool:
  match seats:
    case nil(_): true
    case cons(_): false

def firstRole(role: String, seats: Seats) -> Maybe:
  match seats:
    case nil(_): Maybe.absent()
    case cons(c): if c.head.role == role then Maybe.present(c.head) else firstRole(role, c.tail)

def winner(seats: Seats, best: Maybe) -> Maybe:
  match seats:
    case nil(_): best
    case cons(c): winner(c.tail, better(c.head, best))

def better(seat: SeatView, best: Maybe) -> Maybe:
  if seat.role == "claim" then beats(seat, best) else best

def beats(seat: SeatView, best: Maybe) -> Maybe:
  match best:
    case absent(_): Maybe.present(seat)
    case present(b): if seat.opened < b.opened then Maybe.present(seat) else best

def workOf(pair: Nat, seats: Seats) -> Maybe:
  match seats:
    case nil(_): Maybe.absent()
    case cons(c): if c.head.role == "work" && term("pair", c.head.terms) == pair then Maybe.present(c.head) else workOf(pair, c.tail)

def exitOne(seat: Nat, rest: Plan) -> Plan:
  Plan.cons({head: Action.exit({seat: seat}), tail: rest})

def exitAll(seats: Seats) -> Plan:
  match seats:
    case nil(_): Plan.nil()
    case cons(c): exitOne(c.head.seat, exitAll(c.tail))

def wholeMove(source: SeatView, destination: SeatView, asset: Nat) -> Move:
  {source: source.seat, destination: destination.seat, asset: asset, amount: held(asset, source.allocation)}

def reallocation(moves: Moves) -> Plan:
  Plan.cons({head: Action.reallocate({moves: moves}), tail: Plan.nil()})

def exchange(first: Move, second: Move) -> Plan:
  reallocation(Moves.cons({head: first, tail: Moves.cons({head: second, tail: Moves.nil()})}))

def andThen(first: Plan, rest: Plan) -> Plan:
  match first:
    case nil(_): rest
    case cons(c): Plan.cons({head: c.head, tail: andThen(c.tail, rest)})

def mintOne(role: String, terms: Terms, holder: Nat, rest: Plan) -> Plan:
  Plan.cons({head: Action.mint({role: role, terms: terms, holder: holder}), tail: rest})

def pairTerms(pair: Nat) -> Terms:
  Terms.cons({head: {name: "pair", value: pair}, tail: Terms.nil()})

def reviewTerms(review: Nat) -> Terms:
  Terms.cons({head: {name: "review", value: review}, tail: Terms.nil()})

def escrowReady(e: SeatView, height: Nat) -> Bool:
  hasDue(e.exit) && height < dueOf(e.exit) && isOneOf(e.want, headAsset(e.want), 1n) && isOne(e.give) && held(headAsset(e.give), e.allocation) == headAmount(e.give)

def workReady(e: SeatView, w: SeatView) -> Bool:
  isNil(w.want) && isOneOf(w.give, headAsset(e.want), 1n) && held(headAsset(e.want), w.allocation) == 1n

def claimReady(e: SeatView, c: SeatView, height: Nat) -> Bool:
  isNil(c.give) && isOneOf(c.want, headAsset(e.give), held(headAsset(e.give), e.allocation)) && hasDue(c.exit) && height + term("review", e.terms) + 1n <= dueOf(c.exit)

def postPlan(p: PostIn, seats: Seats) -> Plan:
  if isEmpty(seats) then mintOne("escrow", reviewTerms(p.review), p.holder, mintOne("approve", Terms.nil(), p.holder, mintOne("reject", Terms.nil(), p.holder, mintOne("cancel", Terms.nil(), p.holder, Plan.nil())))) else Plan.nil()

def claimPlan(c: ClaimIn, height: Nat, seats: Seats) -> Plan:
  match firstRole("escrow", seats):
    case absent(_): Plan.nil()
    case present(e): if escrowReady(e, height) then mintOne("claim", pairTerms(height), c.holder, mintOne("work", pairTerms(height), c.holder, Plan.nil())) else Plan.nil()

def advancePlan(height: Nat, seats: Seats) -> Plan:
  match firstRole("escrow", seats):
    case absent(_): Plan.nil()
    case present(e): advanceEscrow(height, seats, e)

def advanceEscrow(height: Nat, seats: Seats, e: SeatView) -> Plan:
  match winner(seats, Maybe.absent()):
    case absent(_): cancelPlan(seats)
    case present(c): advanceClaim(height, seats, e, c)

def cancelPlan(seats: Seats) -> Plan:
  match firstRole("cancel", seats):
    case absent(_): Plan.nil()
    case present(_): exitAll(seats)

def advanceClaim(height: Nat, seats: Seats, e: SeatView, c: SeatView) -> Plan:
  if 0n < held(headAsset(e.give), c.allocation) then decide(height, seats, e, c) else submit(height, seats, e, c)

def decide(height: Nat, seats: Seats, e: SeatView, c: SeatView) -> Plan:
  match firstRole("approve", seats):
    case present(_): exitAll(seats)
    case absent(_): rejection(height, seats, e, c)

def rejection(height: Nat, seats: Seats, e: SeatView, c: SeatView) -> Plan:
  match firstRole("reject", seats):
    case absent(_): Plan.nil()
    case present(x): if hasDue(c.exit) && height < dueOf(c.exit) then reopen(seats, e, c, x) else Plan.nil()

def reopen(seats: Seats, e: SeatView, c: SeatView, x: SeatView) -> Plan:
  match workOf(term("pair", c.terms), seats):
    case absent(_): Plan.nil()
    case present(w): andThen(exchange(wholeMove(c, e, headAsset(e.give)), wholeMove(e, w, headAsset(e.want))), exitOne(c.seat, exitOne(x.seat, exitOne(w.seat, Plan.nil()))))

def submit(height: Nat, seats: Seats, e: SeatView, c: SeatView) -> Plan:
  match workOf(term("pair", c.terms), seats):
    case absent(_): Plan.nil()
    case present(w): if escrowReady(e, height) && claimReady(e, c, height) && workReady(e, w) then swapIn(e, c, w) else Plan.nil()

def swapIn(e: SeatView, c: SeatView, w: SeatView) -> Plan:
  exchange(wholeMove(e, c, headAsset(e.give)), wholeMove(w, e, headAsset(e.want)))

def bounty(call: Call) -> Plan:
  match call.input:
    case post(p): postPlan(p, call.seats)
    case claim(c): claimPlan(c, call.height, call.seats)
    case advance(_): advancePlan(call.height, call.seats)
    case pad(c): mintOne("pad", Terms.nil(), c.holder, Plan.nil())
