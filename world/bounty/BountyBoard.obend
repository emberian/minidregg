edition ObjectiveBend 1
# BountyBoard: escrowed bounty lifecycle on Kernel/ObjectiveActivity.
# The reward is escrowed in the activity's purse at birth and leaves at most once (`single_payout`).
law moves_monotone: request.turn in [1, 4] or monotone(moves)
law single_payout: new.moves <= 1

record Posted:
  poster: Nat
  title: String
  reward: Nat
  deadline: Nat
  review: Nat
record Taken:
  posted: Posted
  claimant: Nat
record Delivered:
  taken: Taken
  work: String
  submittedAt: Nat
sum State:
  open: Posted
  claimed: Taken
  submitted: Delivered
  paid: Delivered
  refunded: Posted
record Payout:
  to: Nat
  amount: Nat
record Claim:
  claimant: Nat
  now: Nat
record Submit:
  claimant: Nat
  work: String
  now: Nat
record Act:
  actor: Nat
  now: Nat
record Tick:
  now: Nat
sum Event:
  claim: Claim
  submit: Submit
  approve: Act
  reject: Act
  cancel: Act
  expire: Tick
record Move:
  next: State
  payout: Payout
sum Transition:
  refused: State
  moved: State
  disbursed: Move

def postedOf(s: State) -> Posted:
  match s:
    case open(p): p
    case claimed(t): t.posted
    case submitted(d): d.taken.posted
    case paid(d): d.taken.posted
    case refunded(p): p

def phaseOf(s: State) -> String:
  match s:
    case open(_): "open"
    case claimed(_): "claimed"
    case submitted(_): "submitted"
    case paid(_): "paid"
    case refunded(_): "refunded"

def isTerminal(s: State) -> Bool:
  match s:
    case open(_): false
    case claimed(_): false
    case submitted(_): false
    case paid(_): true
    case refunded(_): true

def live(p: Posted, now: Nat) -> Bool:
  now < p.deadline

def reviewEnds(d: Delivered) -> Nat:
  d.submittedAt + d.taken.posted.review

def post(poster: Nat, title: String, reward: Nat, deadline: Nat, review: Nat) -> State:
  State.open({poster: poster, title: title, reward: reward, deadline: deadline, review: review})

def payClaimant(d: Delivered) -> Transition:
  Transition.disbursed({next: State.paid(d), payout: {to: d.taken.claimant, amount: d.taken.posted.reward}})

def refundPoster(p: Posted) -> Transition:
  Transition.disbursed({next: State.refunded(p), payout: {to: p.poster, amount: p.reward}})

def claimOn(s: State, c: Claim) -> Transition:
  match s:
    case open(p): if live(p, c.now) && c.claimant != p.poster then Transition.moved(State.claimed({posted: p, claimant: c.claimant})) else Transition.refused(s)
    case claimed(_): Transition.refused(s)
    case submitted(_): Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def submitOn(s: State, m: Submit) -> Transition:
  match s:
    case claimed(t): if live(t.posted, m.now) && m.claimant == t.claimant then Transition.moved(State.submitted({taken: t, work: m.work, submittedAt: m.now})) else Transition.refused(s)
    case open(_): Transition.refused(s)
    case submitted(_): Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def approveOn(s: State, a: Act) -> Transition:
  match s:
    case submitted(d): if a.actor == d.taken.posted.poster && a.now <= reviewEnds(d) then payClaimant(d) else Transition.refused(s)
    case open(_): Transition.refused(s)
    case claimed(_): Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def rejectOn(s: State, a: Act) -> Transition:
  match s:
    case submitted(d): if a.actor == d.taken.posted.poster && a.now <= reviewEnds(d) && live(d.taken.posted, a.now) then Transition.moved(State.open(d.taken.posted)) else Transition.refused(s)
    case open(_): Transition.refused(s)
    case claimed(_): Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def cancelOn(s: State, a: Act) -> Transition:
  match s:
    case open(p): if a.actor == p.poster then refundPoster(p) else Transition.refused(s)
    case claimed(_): Transition.refused(s)
    case submitted(_): Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def expireOn(s: State, k: Tick) -> Transition:
  match s:
    case open(p): if live(p, k.now) then Transition.refused(s) else refundPoster(p)
    case claimed(t): if live(t.posted, k.now) then Transition.refused(s) else refundPoster(t.posted)
    case submitted(d): if reviewEnds(d) < k.now then payClaimant(d) else Transition.refused(s)
    case paid(_): Transition.refused(s)
    case refunded(_): Transition.refused(s)

def react(s: State, e: Event) -> Transition:
  match e:
    case claim(c): claimOn(s, c)
    case submit(m): submitOn(s, m)
    case approve(a): approveOn(s, a)
    case reject(a): rejectOn(s, a)
    case cancel(a): cancelOn(s, a)
    case expire(k): expireOn(s, k)

def stateOf(t: Transition) -> State:
  match t:
    case refused(s): s
    case moved(s): s
    case disbursed(m): m.next

def wasRefused(t: Transition) -> Bool:
  match t:
    case refused(_): true
    case moved(_): false
    case disbursed(_): false

record Opening:
  posted: Posted
  keeper: Nat
  fresh: Bool
record Ledger:
  moves: Nat
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
record Write:
  moves: EditNat
record Ask:
  decider: Nat
record At:
  at: Nat
sum Source:
  reply: Ask
  height: At
record Await:
  write: Write
  on: Source
  patience: Nat
record Pay:
  to: Nat
  amount: Nat
  write: Write
sum Plan:
  await: Await
  transfer: Pay
sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}
record View:
  version: Nat
  state: Ledger
record Step:
  outcome: Outcome
  view: View
sum Response:
  resumed: Step

def keepLedger() -> Write:
  {moves: EditNat.keep()}

def firstWrite(o: Opening) -> Write:
  if o.fresh then {moves: EditNat.set(0n)} else keepLedger()

def serve(o: Opening, s: State, w: Write) -> Activity<Plan, Response, String>:
  match perform(Plan.await({write: w, on: Source.reply({decider: o.keeper}), patience: 64n})):
    case resumed(r):
      match r.outcome:
        case reply(e): step(o, s, react(s, e))
        case settled(_): serve(o, s, keepLedger())
        case refused(_): serve(o, s, keepLedger())
        case unknown(_): serve(o, s, keepLedger())
        case timedOut(_): serve(o, s, keepLedger())
        case broken(_): serve(o, s, keepLedger())
        case upgraded(_): serve(o, s, keepLedger())

def step(o: Opening, s: State, t: Transition) -> Activity<Plan, Response, String>:
  match t:
    case refused(unchanged): serve(o, unchanged, keepLedger())
    case moved(next): serve(o, next, keepLedger())
    case disbursed(m): disburse(o, s, m)

def disburse(o: Opening, s: State, m: Move) -> Activity<Plan, Response, String>:
  match perform(Plan.transfer({to: m.payout.to, amount: m.payout.amount, write: {moves: EditNat.add(1n)}})):
    case resumed(r):
      match r.outcome:
        case settled(_): phaseOf(m.next)
        case refused(_): serve(o, s, keepLedger())
        case reply(_): serve(o, s, keepLedger())
        case unknown(_): serve(o, s, keepLedger())
        case timedOut(_): serve(o, s, keepLedger())
        case broken(_): serve(o, s, keepLedger())
        case upgraded(_): serve(o, s, keepLedger())

def bounty(o: Opening) -> Activity<Plan, Response, String>:
  serve(o, State.open(o.posted), firstWrite(o))
