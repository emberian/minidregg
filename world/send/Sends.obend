edition ObjectiveBend 1
# Asynchronous sends between objects (Kernel/ObjectiveCall `send`, Kernel/ObjectiveSend).
# A method may yield `send {to, method, args}`: `to` is an object's inbox
# (`To.object(n)`) or the reply of an earlier send not yet delivered
# (`To.slot(n)`, pipelined: queued on that reply slot and forwarded when it is
# decided). A send is answered in the same turn with `queued {slot}`, the
# message's id, which is also its reply slot's name. The message is delivered
# later, by anyone, in its own turn (`deliverMessage`): the target's method runs
# with `request/caller` the sender and no subject.
record State:
  total: Nat
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
record Write:
  total: EditNat
record View:
  version: Nat
  state: State
record Return:
  result: Nat
  write: Write
record Got:
  result: Nat
sum Returned:
  returned: Got
record CallN:
  target: Nat
  method: String
  args: Nat
sum PlanN:
  call: CallN
sum To:
  object: Nat
  slot: Nat
record SendN:
  to: To
  method: String
  args: Nat
sum PlanS:
  send: SendN
record Slot:
  slot: Nat
sum Queued:
  queued: Slot
sum PlanC:
  cancel: Slot
sum PlanT:
  stop: Slot
sum Acked:
  acked: Slot
record Post:
  target: Nat
  amount: Nat
record Pipe:
  via: Nat
  amount: Nat
sum Ref:
  ref: Nat
  none: {}
record Found:
  result: Ref
  write: Write
record Relay:
  target: Nat
  method: String
  amount: Nat
record SendA:
  to: To
  method: String
  args: Nat
  allowance: Nat
sum PlanA:
  send: SendA
record RelayA:
  target: Nat
  method: String
  amount: Nat
  allowance: Nat
record Hop:
  target: Nat
  price: Nat
  allowance: Nat
record SendH:
  to: To
  method: String
  args: Hop
  allowance: Nat
sum PlanH:
  send: SendH
# A leaf: adds `amount` and returns the new total.
def deposit(view: View, amount: Nat) -> Activity<PlanN, Returned, Return>:
  {result: view.state.total + amount, write: {total: EditNat.add(amount)}}
# Sends `deposit(amount)` to `target`; returns the message id (its reply slot).
def post(view: View, p: Post) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(p.target), method: "deposit", args: p.amount})):
    case queued(q): {result: q.slot, write: {total: EditNat.add(1n)}}
# Three sends to one target in one turn; returns the last message id.
def post3(view: View, p: Post) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(p.target), method: "deposit", args: p.amount})):
    case queued(a):
      match perform(PlanS.send({to: To.object(p.target), method: "deposit", args: p.amount})):
        case queued(b):
          match perform(PlanS.send({to: To.object(p.target), method: "deposit", args: p.amount})):
            case queued(c): {result: c.slot, write: {total: EditNat.add(3n)}}
# Pipelining: asks `via` to look up an object, and sends `deposit(amount)` to the
# REPLY of that lookup before it is delivered. Returns the lookup's message id.
def pipe(view: View, p: Pipe) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(p.via), method: "lookup", args: 0n})):
    case queued(first):
      match perform(PlanS.send({to: To.slot(first.slot), method: "deposit", args: p.amount})):
        case queued(second): {result: first.slot, write: {total: EditNat.keep()}}
# A directory: replies with a reference to the object its state names (total),
# or no reference when it names none (0).
def lookup(view: View, unused: Nat) -> Activity<PlanN, Returned, Found>:
  if view.state.total == 0n then {result: Ref.none({}), write: {total: EditNat.keep()}} else {result: Ref.ref(view.state.total), write: {total: EditNat.keep()}}
# Sends `deposit(amount)` to the reply slot `target` (a pipelined send to a slot by name).
def chase(view: View, p: Post) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.slot(p.target), method: "deposit", args: p.amount})):
    case queued(q): {result: q.slot, write: {total: EditNat.keep()}}
# Row F, the interface check: a method whose Plan admits `send` cannot be delivered (a
# delivered message has no paying account for onward sends), so a send naming it is
# refused `notDeliverable` AT THE SEND, before any postage is escrowed.
def bounce(view: View, n: Nat) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
    case queued(q): {result: q.slot, write: {total: EditNat.keep()}}
# Sends `method(amount)` to `target`: any method name, Nat arguments.
def relay(view: View, r: Relay) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(r.target), method: r.method, args: r.amount})):
    case queued(q): {result: q.slot, write: {total: EditNat.keep()}}
# Pipelined: asks `target` to look up an object and sends `method(amount)` to the REPLY;
# whether that method is deliverable is decided when the reply resolves (refunded if not).
def relayVia(view: View, r: Relay) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(r.target), method: "lookup", args: 0n})):
    case queued(first):
      match perform(PlanS.send({to: To.slot(first.slot), method: r.method, args: r.amount})):
        case queued(second): {result: first.slot, write: {total: EditNat.keep()}}
# Row F, the sender's two controls over a message it sent (by its id = its reply slot):
# `cancel` withdraws it while it is still queued (refunding it and the sends pipelined on
# its slot; its slot decided `cancelled`), and is a no-op once it was delivered; `stop`
# only stops waiting (the pipelined sends are refunded, the message is still delivered,
# and its delivery retires the slot; a decided slot is retired at once). Both are
# answered `acked` at the yield and take effect when the turn commits.
def cancelOf(view: View, n: Nat) -> Activity<PlanC, Acked, Return>:
  match perform(PlanC.cancel({slot: n})):
    case acked(a): {result: a.slot, write: {total: EditNat.keep()}}
def stopOf(view: View, n: Nat) -> Activity<PlanT, Acked, Return>:
  match perform(PlanT.stop({slot: n})):
    case acked(a): {result: a.slot, write: {total: EditNat.keep()}}
# Row F, the prepaid continuation allowance: a send may carry an `allowance`, escrowed with
# its postage; only then may its delivered method send onward, out of that allowance alone
# (at most 4 onward sends, at most 3 hops deep), the rest returning to the payer.
def relayA(view: View, r: RelayA) -> Activity<PlanA, Queued, Return>:
  match perform(PlanA.send({to: To.object(r.target), method: r.method, args: r.amount, allowance: r.allowance})):
    case queued(q): {result: q.slot, write: {total: EditNat.keep()}}
# Two onward sends: `deposit(n)` to object n, twice.
def bounce2(view: View, n: Nat) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
    case queued(a):
      match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
        case queued(b): {result: b.slot, write: {total: EditNat.keep()}}
# Four onward sends (the fan-out bound).
def bounce4(view: View, n: Nat) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
    case queued(a):
      match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
        case queued(b):
          match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
            case queued(c):
              match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
                case queued(d): {result: d.slot, write: {total: EditNat.keep()}}
# Five onward sends: one over the fan-out bound.
def bounce5(view: View, n: Nat) -> Activity<PlanS, Queued, Return>:
  match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
    case queued(a):
      match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
        case queued(b):
          match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
            case queued(c):
              match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
                case queued(d):
                  match perform(PlanS.send({to: To.object(n), method: "deposit", args: n})):
                    case queued(e): {result: e.slot, write: {total: EditNat.keep()}}
# A continuation chain: sends `hop` to `target` carrying all but one `price` of its own
# allowance (its escrow is then exactly that allowance), counting itself.
def hop(view: View, h: Hop) -> Activity<PlanH, Queued, Return>:
  match perform(PlanH.send({to: To.object(h.target), method: "hop", args: {target: h.target, price: h.price, allowance: h.allowance - h.price}, allowance: h.allowance - h.price})):
    case queued(q): {result: q.slot, write: {total: EditNat.add(1n)}}
