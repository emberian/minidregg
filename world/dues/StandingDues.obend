edition ObjectiveBend 1
# StandingDues: standing dues and prepaid lease on Kernel/ObjectiveActivity.
# Period `k` is paid once, in order, from the activity's purse to the room.
law paid_monotone: request.turn in [1, 4] or monotone(paid)

record Terms:
  payer: Nat
  room: Nat
  amount: Nat
  period: Nat
  start: Nat
  periods: Nat
  window: Nat
  lease: Bool
sum Phase:
  running: {}
  complete: {}
  cancelled: {}
  lapsed: {}
  settled: {}
  void: {}
record Account:
  terms: Terms
  k: Nat
  paid: Nat
  prepaid: Nat
  deposited: Nat
  refunded: Nat
  phase: Phase
record Transfer:
  fromAccount: Nat
  toAccount: Nat
  amount: Nat
record Discharge:
  period: Nat
  now: Nat
record Cancel:
  actor: Nat
  now: Nat
record TopUp:
  actor: Nat
  amount: Nat
record Tick:
  now: Nat
sum Event:
  discharge: Discharge
  cancel: Cancel
  topUp: TopUp
  lapse: Tick
  settle: Tick
record Moved:
  account: Account
  transfer: Transfer
sum Transition:
  refused: Account
  quiet: Account
  moved: Moved

def isRunning(p: Phase) -> Bool:
  match p:
    case running(_): true
    case complete(_): false
    case cancelled(_): false
    case lapsed(_): false
    case settled(_): false
    case void(_): false

def isLapsed(p: Phase) -> Bool:
  match p:
    case running(_): false
    case complete(_): false
    case cancelled(_): false
    case lapsed(_): true
    case settled(_): false
    case void(_): false

def phaseName(a: Account) -> String:
  match a.phase:
    case running(_): "running"
    case complete(_): "complete"
    case cancelled(_): "cancelled"
    case lapsed(_): "lapsed"
    case settled(_): "settled"
    case void(_): "void"

def validTerms(t: Terms) -> Bool:
  t.payer != t.room && 0n < t.amount && 0n < t.period && 0n < t.periods && t.window < t.period

def dueAt(t: Terms, k: Nat) -> Nat:
  t.start + k * t.period

def open(t: Terms, deposit: Nat) -> Account:
  if validTerms(t) then {terms: t, k: 0n, paid: 0n, prepaid: if t.lease then deposit else 0n, deposited: if t.lease then deposit else 0n, refunded: 0n, phase: Phase.running()} else {terms: t, k: 0n, paid: 0n, prepaid: 0n, deposited: 0n, refunded: 0n, phase: Phase.void()}

def dueCount(t: Terms, now: Nat, k: Nat) -> Nat:
  if k < t.periods && dueAt(t, k) <= now then 1n + dueCount(t, now, k + 1n) else 0n

def behindBy(a: Account, now: Nat) -> Nat:
  if isRunning(a.phase) then dueCount(a.terms, now, a.k) else 0n

def nextPhase(t: Terms, nextK: Nat) -> Phase:
  if nextK == t.periods then Phase.complete() else Phase.running()

def dischargeMove(a: Account, t: Terms, nextK: Nat) -> Transition:
  Transition.moved({account: {terms: t, k: nextK, paid: a.paid + t.amount, prepaid: if t.lease then a.prepaid - t.amount else 0n, deposited: a.deposited, refunded: a.refunded, phase: nextPhase(t, nextK)}, transfer: {fromAccount: t.payer, toAccount: t.room, amount: t.amount}})

def discharge(a: Account, period: Nat, now: Nat) -> Transition:
  let t = a.terms
  if isRunning(a.phase) && period == a.k && a.k < t.periods && dueAt(t, a.k) <= now && (t.lease == false || t.amount <= a.prepaid) then dischargeMove(a, t, a.k + 1n) else Transition.refused(a)

def cancel(a: Account, c: Cancel) -> Transition:
  let t = a.terms
  let boundary = dueAt(t, a.k)
  if isRunning(a.phase) && c.actor == t.payer && a.k < t.periods && boundary <= c.now && c.now < boundary + t.window then Transition.quiet({terms: t, k: a.k, paid: a.paid, prepaid: a.prepaid, deposited: a.deposited, refunded: a.refunded, phase: Phase.cancelled()}) else Transition.refused(a)

def topUp(a: Account, u: TopUp) -> Transition:
  let t = a.terms
  if isRunning(a.phase) && t.lease && u.actor == t.payer && 0n < u.amount then Transition.quiet({terms: t, k: a.k, paid: a.paid, prepaid: a.prepaid + u.amount, deposited: a.deposited + u.amount, refunded: a.refunded, phase: a.phase}) else Transition.refused(a)

def lapse(a: Account, now: Nat) -> Transition:
  let t = a.terms
  if isRunning(a.phase) && t.lease && a.k < t.periods && dueAt(t, a.k) <= now && a.prepaid < t.amount then Transition.quiet({terms: t, k: a.k, paid: a.paid, prepaid: a.prepaid, deposited: a.deposited, refunded: a.refunded, phase: Phase.lapsed()}) else Transition.refused(a)

def settle(a: Account) -> Transition:
  if isLapsed(a.phase) then Transition.moved({account: {terms: a.terms, k: a.k, paid: a.paid, prepaid: 0n, deposited: a.deposited, refunded: a.prepaid, phase: Phase.settled()}, transfer: {fromAccount: a.terms.room, toAccount: a.terms.payer, amount: a.prepaid}}) else Transition.refused(a)

def react(a: Account, e: Event) -> Transition:
  match e:
    case discharge(d): discharge(a, d.period, d.now)
    case cancel(c): cancel(a, c)
    case topUp(u): topUp(a, u)
    case lapse(l): lapse(a, l.now)
    case settle(_): settle(a)

def accountOf(tr: Transition) -> Account:
  match tr:
    case refused(a): a
    case quiet(a): a
    case moved(m): m.account

def wasRefused(tr: Transition) -> Bool:
  match tr:
    case refused(_): true
    case quiet(_): false
    case moved(_): false

record Receipt:
  phase: String
  k: Nat
  paid: Nat
  refunded: Nat

def receiptOf(a: Account) -> Receipt:
  {phase: phaseName(a), k: a.k, paid: a.paid, refunded: a.refunded}

record Opening:
  terms: Terms
  deposit: Nat
  keeper: Nat
  fresh: Bool
record Ledger:
  paid: Nat
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
record Write:
  paid: EditNat
record Ask:
  decider: Nat
record At:
  at: Nat
sum Source:
  reply: Ask
  height: At
record Await:
  write: Write
  on: Source
  patience: Nat
record Pay:
  to: Nat
  amount: Nat
  write: Write
sum Plan:
  await: Await
  transfer: Pay
sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}
record View:
  version: Nat
  state: Ledger
record Step:
  outcome: Outcome
  view: View
sum Response:
  resumed: Step

def keepLedger() -> Write:
  {paid: EditNat.keep()}

def firstWrite(o: Opening) -> Write:
  if o.fresh then {paid: EditNat.set(0n)} else keepLedger()

def serve(o: Opening, a: Account, w: Write) -> Activity<Plan, Response, Receipt>:
  if isRunning(a.phase) || isLapsed(a.phase) then await(o, a, w) else receiptOf(a)

def await(o: Opening, a: Account, w: Write) -> Activity<Plan, Response, Receipt>:
  match perform(Plan.await({write: w, on: Source.reply({decider: o.keeper}), patience: 64n})):
    case resumed(r):
      match r.outcome:
        case reply(e): step(o, a, react(a, e))
        case settled(_): serve(o, a, keepLedger())
        case refused(_): serve(o, a, keepLedger())
        case unknown(_): serve(o, a, keepLedger())
        case timedOut(_): serve(o, a, keepLedger())
        case broken(_): serve(o, a, keepLedger())
        case upgraded(_): serve(o, a, keepLedger())

def step(o: Opening, before: Account, tr: Transition) -> Activity<Plan, Response, Receipt>:
  match tr:
    case refused(unchanged): serve(o, unchanged, keepLedger())
    case quiet(next): serve(o, next, keepLedger())
    case moved(m): disburse(o, before, m)

def disburse(o: Opening, before: Account, m: Moved) -> Activity<Plan, Response, Receipt>:
  let delta = if m.transfer.toAccount == before.terms.room then EditNat.add(m.transfer.amount) else EditNat.keep()
  match perform(Plan.transfer({to: m.transfer.toAccount, amount: m.transfer.amount, write: {paid: delta}})):
    case resumed(r):
      match r.outcome:
        case settled(_): serve(o, m.account, keepLedger())
        case refused(_): serve(o, before, keepLedger())
        case reply(_): serve(o, before, keepLedger())
        case unknown(_): serve(o, before, keepLedger())
        case timedOut(_): serve(o, before, keepLedger())
        case broken(_): serve(o, before, keepLedger())
        case upgraded(_): serve(o, before, keepLedger())

def dues(o: Opening) -> Activity<Plan, Response, Receipt>:
  serve(o, open(o.terms, o.deposit), firstWrite(o))
