edition ObjectiveBend 1
# SharedConsequences: shared-consequence station methods over admitted actor/property/resource inputs.
# Uses native Core4 O(1) `<, <=, -, !=` comparisons; scenario fixtures live in StationScenarios.obend.

record SourceVersion:
  artifact: String
  definition: String
  revision: Nat
record Ref:
  target: Nat
  root: String
sum Owner:
  ground: {}
  held: Nat
record Player:
  ref: Ref
  subject: Nat
  scene: Nat
  turn: Nat
record Property:
  ref: Ref
  scene: Nat
  owner: Owner
  generation: Nat
record Supply:
  ref: Ref
  remaining: Nat
  generation: Nat
record Edge:
  src: Nat
  dst: Nat
  cost: Nat
sum Edges:
  empty: {}
  more: {head: Edge, tail: Edges}
record Rules:
  source: SourceVersion
  ref: Ref
  edges: Edges
record Write:
  field: Nat
  before: Nat
  after: Nat
sum Writes:
  empty: {}
  more: {head: Write, tail: Writes}
sum Effects:
  none: {}
  scalar: {ref: Ref, writes: Writes, rest: Effects}
sum Reads:
  none: {}
  root: {ref: Ref, rest: Reads}
record Candidate:
  source: SourceVersion
  reads: Reads
  effects: Effects
sum Result:
  refused: Nat
  proposed: Candidate

def distinct(a: Nat, b: Nat) -> Bool:
  a != b

def rolesDistinct(ruleRef: Ref, playerRef: Ref, resourceRef: Ref) -> Bool:
  ruleRef.target != playerRef.target && ruleRef.target != resourceRef.target && playerRef.target != resourceRef.target

def ownerWord(owner: Owner) -> Nat:
  match owner:
    case ground(_): 0n
    case held(subject): 1n + subject

def heldBy(owner: Owner, subject: Nat) -> Bool:
  match owner:
    case ground(_): false
    case held(holder): holder == subject

def sourceEq(a: SourceVersion, b: SourceVersion) -> Bool:
  a.artifact == b.artifact && a.definition == b.definition && a.revision == b.revision

def edgeEq(a: Edge, b: Edge) -> Bool:
  a.src == b.src && a.dst == b.dst && a.cost == b.cost

def containsEdge(edge: Edge, edges: Edges) -> Bool:
  match edges:
    case empty(_): false
    case more(m): edgeEq(edge, m.head) || containsEdge(edge, m.tail)

def one(w: Write) -> Writes:
  Writes.more({head: w, tail: Writes.empty()})

def two(w: Write, x: Write) -> Writes:
  Writes.more({head: w, tail: one(x)})

def three(w: Write, x: Write, y: Write) -> Writes:
  Writes.more({head: w, tail: two(x, y)})

def reads3(a: Ref, b: Ref, c: Ref) -> Reads:
  Reads.root({ref: a, rest: Reads.root({ref: b, rest: Reads.root({ref: c, rest: Reads.none()})})})

def effects2(a: Ref, aWrites: Writes, b: Ref, bWrites: Writes) -> Effects:
  Effects.scalar({ref: a, writes: aWrites, rest: Effects.scalar({ref: b, writes: bWrites, rest: Effects.none()})})

def takeCandidate(source: SourceVersion, ruleRef: Ref, player: Player, property: Property) -> Result:
  Result.proposed({source: source, reads: reads3(ruleRef, player.ref, property.ref), effects: effects2(player.ref, one({field: 1n, before: player.turn, after: 1n + player.turn}), property.ref, two({field: 1n, before: 0n, after: 1n + player.subject}, {field: 2n, before: property.generation, after: 1n + property.generation}))})

def takeOnOwner(rules: Rules, player: Player, property: Property) -> Result:
  match property.owner:
    case held(_): Result.refused(2n)
    case ground(_): if player.scene == property.scene then takeCandidate(rules.source, rules.ref, player, property) else Result.refused(3n)

def take(expected: SourceVersion, rules: Rules, player: Player, property: Property) -> Result:
  if sourceEq(expected, rules.source) then (if rolesDistinct(rules.ref, player.ref, property.ref) then takeOnOwner(rules, player, property) else Result.refused(6n)) else Result.refused(1n)

def dropCandidate(source: SourceVersion, ruleRef: Ref, player: Player, property: Property, holder: Nat) -> Result:
  Result.proposed({source: source, reads: reads3(ruleRef, player.ref, property.ref), effects: effects2(player.ref, one({field: 1n, before: player.turn, after: 1n + player.turn}), property.ref, three({field: 0n, before: property.scene, after: player.scene}, {field: 1n, before: 1n + holder, after: 0n}, {field: 2n, before: property.generation, after: 1n + property.generation}))})

def dropOnOwner(rules: Rules, player: Player, property: Property) -> Result:
  match property.owner:
    case ground(_): Result.refused(7n)
    case held(holder): if holder == player.subject then dropCandidate(rules.source, rules.ref, player, property, holder) else Result.refused(8n)

def drop(expected: SourceVersion, rules: Rules, player: Player, property: Property) -> Result:
  if sourceEq(expected, rules.source) then (if rolesDistinct(rules.ref, player.ref, property.ref) then dropOnOwner(rules, player, property) else Result.refused(6n)) else Result.refused(1n)

sum Spend:
  notEnough: {}
  enough: Nat

def spend(cost: Nat, available: Nat) -> Spend:
  if available < cost then Spend.notEnough() else Spend.enough(available - cost)

def spendCorrect(cost: Nat, available: Nat) -> Bool:
  match spend(cost, available):
    case notEnough(_): available < cost
    case enough(remaining): cost + remaining == available

def moveOnSpend(rules: Rules, player: Player, supply: Supply, edge: Edge) -> Result:
  match spend(edge.cost, supply.remaining):
    case notEnough(_): Result.refused(5n)
    case enough(remaining): Result.proposed({source: rules.source, reads: reads3(rules.ref, player.ref, supply.ref), effects: effects2(player.ref, two({field: 0n, before: player.scene, after: edge.dst}, {field: 1n, before: player.turn, after: 1n + player.turn}), supply.ref, two({field: 0n, before: supply.remaining, after: remaining}, {field: 1n, before: supply.generation, after: 1n + supply.generation}))})

def move(expected: SourceVersion, rules: Rules, player: Player, supply: Supply, edge: Edge) -> Result:
  if sourceEq(expected, rules.source) then (if rolesDistinct(rules.ref, player.ref, supply.ref) then (if containsEdge(edge, rules.edges) then (if player.scene == edge.src then moveOnSpend(rules, player, supply, edge) else Result.refused(3n)) else Result.refused(4n)) else Result.refused(6n)) else Result.refused(1n)

record Narrative:
  request: String
  resident: String
  source: SourceVersion
  observed: Reads
  text: String
  suggestion: Result

def gmReply(request: String, resident: String, source: SourceVersion, observed: Reads, text: String, suggestion: Result) -> Narrative:
  {request: request, resident: resident, source: source, observed: observed, text: text, suggestion: suggestion}
