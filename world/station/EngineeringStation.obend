edition ObjectiveBend 1
# EngineeringStation: authored scene graph and rule bindings over SharedConsequences.
import ./SharedConsequences.obend as Lib

def version(rev: Nat) -> Lib.SourceVersion:
  {artifact: "station/engineering", definition: "rules", revision: rev}

def edges() -> Lib.Edges:
  Lib.Edges.more({head: {src: 1n, dst: 2n, cost: 2n}, tail: Lib.Edges.more({head: {src: 2n, dst: 1n, cost: 2n}, tail: Lib.Edges.more({head: {src: 2n, dst: 3n, cost: 1n}, tail: Lib.Edges.empty()})})})

def rules(ruleRef: Lib.Ref, rev: Nat) -> Lib.Rules:
  {source: version(rev), ref: ruleRef, edges: edges()}

def takeItem(expected: Lib.SourceVersion, ruleRef: Lib.Ref, rev: Nat, player: Lib.Player, property: Lib.Property) -> Lib.Result:
  Lib.take(expected, rules(ruleRef, rev), player, property)

def dropItem(expected: Lib.SourceVersion, ruleRef: Lib.Ref, rev: Nat, player: Lib.Player, property: Lib.Property) -> Lib.Result:
  Lib.drop(expected, rules(ruleRef, rev), player, property)

def moveScene(expected: Lib.SourceVersion, ruleRef: Lib.Ref, rev: Nat, player: Lib.Player, supply: Lib.Supply, edge: Lib.Edge) -> Lib.Result:
  Lib.move(expected, rules(ruleRef, rev), player, supply, edge)
