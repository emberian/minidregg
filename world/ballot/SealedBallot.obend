edition ObjectiveBend 1
# SealedBallot: commit-reveal room ballot on Kernel/ObjectiveActivity with participant-signed
# turns and kernel-enforced `monotone` tally and `hashEq` (cSHAKE256 DREGG.PRED.HASHEQ/v2) laws.
law tally_monotone: request.turn in [1, 4] or (monotone(yes) and monotone(no) and monotone(abstain) and monotone(published))
law commit_binding: new.commit == 0 or hashEq([vote], salt, commit)

def not(b: Bool) -> Bool:
  if b then false else true

sum Voters:
  empty: {}
  more: {head: Nat, tail: Voters}
record SealedVote:
  voter: Nat
  digest: Nat
sum Commits:
  empty: {}
  more: {head: SealedVote, tail: Commits}
record Opening:
  voter: Nat
  vote: Nat
  salt: Nat
  digest: Nat
sum Openings:
  empty: {}
  more: {head: Opening, tail: Openings}
record Terms:
  electorate: Voters
  quorum: Nat
  commitEnd: Nat
  revealEnd: Nat
record Poll:
  terms: Terms
  valid: Bool
  commits: Commits
  openings: Openings
  closed: Bool
record Cast:
  voter: Nat
  digest: Nat
  now: Nat
record Reveal:
  voter: Nat
  vote: Nat
  salt: Nat
  digest: Nat
  now: Nat
record Tick:
  now: Nat
sum Event:
  commit: Cast
  reveal: Reveal
  tally: Tick
sum Transition:
  refused: Poll
  moved: Poll

def member(v: Nat, xs: Voters) -> Bool:
  match xs:
    case empty(_): false
    case more(m): v == m.head || member(v, m.tail)

def size(xs: Voters) -> Nat:
  match xs:
    case empty(_): 0n
    case more(m): 1n + size(m.tail)

def distinct(xs: Voters) -> Bool:
  match xs:
    case empty(_): true
    case more(m): not(member(m.head, m.tail)) && distinct(m.tail)

def nonZeroVoters(xs: Voters) -> Bool:
  match xs:
    case empty(_): true
    case more(m): 0n < m.head && nonZeroVoters(m.tail)

def committed(v: Nat, cs: Commits) -> Bool:
  match cs:
    case empty(_): false
    case more(m): v == m.head.voter || committed(v, m.tail)

def digestOf(v: Nat, cs: Commits) -> Nat:
  match cs:
    case empty(_): 0n
    case more(m): if v == m.head.voter then m.head.digest else digestOf(v, m.tail)

def commitCount(cs: Commits) -> Nat:
  match cs:
    case empty(_): 0n
    case more(m): 1n + commitCount(m.tail)

def opened(v: Nat, os: Openings) -> Bool:
  match os:
    case empty(_): false
    case more(m): v == m.head.voter || opened(v, m.tail)

def openCount(os: Openings) -> Nat:
  match os:
    case empty(_): 0n
    case more(m): 1n + openCount(m.tail)

def yesCount(os: Openings) -> Nat:
  match os:
    case empty(_): 0n
    case more(m): if m.head.vote == 1n then 1n + yesCount(m.tail) else yesCount(m.tail)

def noCount(os: Openings) -> Nat:
  match os:
    case empty(_): 0n
    case more(m): if m.head.vote == 0n then 1n + noCount(m.tail) else noCount(m.tail)

def validTerms(t: Terms) -> Bool:
  distinct(t.electorate) && nonZeroVoters(t.electorate) && 0n < t.quorum && t.quorum <= size(t.electorate) && t.commitEnd < t.revealEnd

def open(t: Terms) -> Poll:
  {terms: t, valid: validTerms(t), commits: Commits.empty(), openings: Openings.empty(), closed: false}

def live(p: Poll) -> Bool:
  p.valid && not(p.closed)

def commitOn(p: Poll, c: Cast) -> Transition:
  if live(p) && c.now < p.terms.commitEnd && member(c.voter, p.terms.electorate) && not(committed(c.voter, p.commits)) && 0n < c.digest then Transition.moved({terms: p.terms, valid: p.valid, commits: Commits.more({head: {voter: c.voter, digest: c.digest}, tail: p.commits}), openings: p.openings, closed: false}) else Transition.refused(p)

def revealOn(p: Poll, r: Reveal) -> Transition:
  if live(p) && p.terms.commitEnd <= r.now && r.now < p.terms.revealEnd && committed(r.voter, p.commits) && not(opened(r.voter, p.openings)) && r.vote < 2n && 0n < r.salt && r.digest == digestOf(r.voter, p.commits) then Transition.moved({terms: p.terms, valid: p.valid, commits: p.commits, openings: Openings.more({head: {voter: r.voter, vote: r.vote, salt: r.salt, digest: r.digest}, tail: p.openings}), closed: false}) else Transition.refused(p)

def tallyOn(p: Poll, k: Tick) -> Transition:
  if live(p) && p.terms.revealEnd <= k.now then Transition.moved({terms: p.terms, valid: p.valid, commits: p.commits, openings: p.openings, closed: true}) else Transition.refused(p)

def react(p: Poll, e: Event) -> Transition:
  match e:
    case commit(c): commitOn(p, c)
    case reveal(r): revealOn(p, r)
    case tally(k): tallyOn(p, k)

def pollOf(t: Transition) -> Poll:
  match t:
    case refused(p): p
    case moved(p): p

def wasRefused(t: Transition) -> Bool:
  match t:
    case refused(_): true
    case moved(_): false

record Result:
  regime: String
  yes: Nat
  no: Nat
  abstain: Nat
  passed: Bool

def resultOf(p: Poll) -> Result:
  {regime: "ballot", yes: yesCount(p.openings), no: noCount(p.openings), abstain: commitCount(p.commits) - openCount(p.openings), passed: p.valid && p.terms.quorum <= yesCount(p.openings)}

def nextVoter(xs: Voters, cs: Commits, os: Openings) -> Nat:
  match xs:
    case empty(_): 1n
    case more(m): if not(committed(m.head, cs)) || not(opened(m.head, os)) then m.head else nextVoter(m.tail, cs, os)

def deciderFor(p: Poll, keeper: Nat) -> Nat:
  if 0n < keeper then keeper else nextVoter(p.terms.electorate, p.commits, p.openings)

record Published:
  yes: Nat
  no: Nat
  abstain: Nat
  vote: Nat
  salt: Nat
  commit: Nat
  passed: Bool
  published: Bool
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
sum EditBool:
  keep: {}
  set: Bool
record Write:
  yes: EditNat
  no: EditNat
  abstain: EditNat
  vote: EditNat
  salt: EditNat
  commit: EditNat
  passed: EditBool
  published: EditBool
record Ask:
  decider: Nat
record At:
  at: Nat
sum Source:
  reply: Ask
  height: At
record Await:
  write: Write
  on: Source
  patience: Nat
record CommitPlan:
  write: Write
sum Plan:
  await: Await
  commit: CommitPlan
sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}
record View:
  version: Nat
  state: Published
record Step:
  outcome: Outcome
  view: View
sum Response:
  resumed: Step

def keepAll() -> Write:
  {yes: EditNat.keep(), no: EditNat.keep(), abstain: EditNat.keep(), vote: EditNat.keep(), salt: EditNat.keep(), commit: EditNat.keep(), passed: EditBool.keep(), published: EditBool.keep()}

def created() -> Write:
  {yes: EditNat.set(0n), no: EditNat.set(0n), abstain: EditNat.set(0n), vote: EditNat.set(0n), salt: EditNat.set(0n), commit: EditNat.set(0n), passed: EditBool.set(false), published: EditBool.set(false)}

def publication(r: Result) -> Write:
  {yes: EditNat.set(r.yes), no: EditNat.set(r.no), abstain: EditNat.set(r.abstain), vote: EditNat.set(0n), salt: EditNat.set(0n), commit: EditNat.set(0n), passed: EditBool.set(r.passed), published: EditBool.set(true)}

def serve(keeper: Nat, p: Poll, w: Write) -> Activity<Plan, Response, Result>:
  if live(p) then await(keeper, p, w) else resultOf(p)

def await(keeper: Nat, p: Poll, w: Write) -> Activity<Plan, Response, Result>:
  match perform(Plan.await({write: w, on: Source.reply({decider: deciderFor(p, keeper)}), patience: 64n})):
    case resumed(r):
      match r.outcome:
        case reply(e): step(keeper, p, react(p, e))
        case settled(_): serve(keeper, p, keepAll())
        case refused(_): serve(keeper, p, keepAll())
        case unknown(_): serve(keeper, p, keepAll())
        case timedOut(_): serve(keeper, p, keepAll())
        case broken(_): serve(keeper, p, keepAll())
        case upgraded(_): serve(keeper, p, keepAll())

def step(keeper: Nat, p: Poll, t: Transition) -> Activity<Plan, Response, Result>:
  match t:
    case refused(unchanged): serve(keeper, unchanged, keepAll())
    case moved(next): if next.closed then publish(keeper, p, next) else serve(keeper, next, keepAll())

def publish(keeper: Nat, before: Poll, closed: Poll) -> Activity<Plan, Response, Result>:
  match perform(Plan.commit({write: publication(resultOf(closed))})):
    case resumed(r):
      match r.outcome:
        case settled(_): resultOf(closed)
        case refused(_): serve(keeper, before, keepAll())
        case reply(_): serve(keeper, before, keepAll())
        case unknown(_): serve(keeper, before, keepAll())
        case timedOut(_): serve(keeper, before, keepAll())
        case broken(_): serve(keeper, before, keepAll())
        case upgraded(_): serve(keeper, before, keepAll())

record Spec:
  first: Nat
  count: Nat
  quorum: Nat
  commitEnd: Nat
  revealEnd: Nat
  keeper: Nat
  fresh: Bool

def range(first: Nat, count: Nat) -> Voters:
  match count:
    case 0n: Voters.empty()
    case 1n+rest: Voters.more({head: first, tail: range(first + 1n, rest)})

def ballot(s: Spec) -> Activity<Plan, Response, Result>:
  serve(s.keeper, open({electorate: range(s.first, s.count), quorum: s.quorum, commitEnd: s.commitEnd, revealEnd: s.revealEnd}), if s.fresh then created() else keepAll())
