edition ObjectiveBend 1
# OrderedCapacity: contributed capacity, allocated by frozen request order.
# Authenticated samples supply exact canonical subject/resource/root bytes.

record Capacity:
  target: Nat
  token: String
  root: String

sum Stock:
  empty: {}
  item: {capacity: Capacity, rest: Stock}

sum Requests:
  none: {}
  request: {subject: String, units: Nat, rest: Requests}

sum Grants:
  none: {}
  grant: {subject: String, stock: Stock, rest: Grants}

def join(xs: Stock, ys: Stock) -> Stock:
  match xs:
    case empty(_): ys
    case item(i): Stock.item({capacity: i.capacity, rest: join(i.rest, ys)})

def prefixStep(p: Nat, xs: Stock) -> Stock:
  match xs:
    case empty(_): Stock.empty()
    case item(i): Stock.item({capacity: i.capacity, rest: prefix(p, i.rest)})

def prefix(n: Nat, xs: Stock) -> Stock:
  match n:
    case 0n: Stock.empty()
    case 1n+p: prefixStep(p, xs)

def suffixStep(p: Nat, xs: Stock) -> Stock:
  match xs:
    case empty(_): Stock.empty()
    case item(i): suffix(p, i.rest)

def suffix(n: Nat, xs: Stock) -> Stock:
  match n:
    case 0n: xs
    case 1n+p: suffixStep(p, xs)

def allocate(requests: Requests, stock: Stock) -> Grants:
  match requests:
    case none(_): Grants.none()
    case request(r): Grants.grant({subject: r.subject, stock: prefix(r.units, stock), rest: allocate(r.rest, suffix(r.units, stock))})

def remaining(requests: Requests, stock: Stock) -> Stock:
  match requests:
    case none(_): stock
    case request(r): remaining(r.rest, suffix(r.units, stock))

def assigned(grants: Grants) -> Stock:
  match grants:
    case none(_): Stock.empty()
    case grant(g): join(g.stock, assigned(g.rest))
