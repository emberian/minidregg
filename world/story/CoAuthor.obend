edition ObjectiveBend 1
# CoAuthor: collaborative crowd-authored story on Kernel/ObjectiveActivity.
# In each round any author may propose a passage (one each) and edit their own
# proposal while open; electors vote once per round; after the window closes,
# sealing appends the winning proposal as an immutable chapter (`monotone(chapters)`).
law chapters_monotone: request.turn in [1, 4] or monotone(chapters)

record Electorate:
  first: Nat
  count: Nat
record Meta:
  title: String
  window: Nat
  total: Nat
  electorate: Electorate
record Proposal:
  id: Nat
  author: Nat
  text: String
sum Proposals:
  empty: {}
  more: {head: Proposal, tail: Proposals}
record Ballot:
  voter: Nat
  pick: Nat
sum Ballots:
  empty: {}
  more: {head: Ballot, tail: Ballots}
record Chapter:
  number: Nat
  id: Nat
  author: Nat
  text: String
  votes: Nat
sum Chapters:
  empty: {}
  more: {head: Chapter, tail: Chapters}
record Round:
  closes: Nat
  proposals: Proposals
  ballots: Ballots
record Story:
  meta: Meta
  chapters: Chapters
  round: Round
  nextId: Nat
  done: Bool
record Propose:
  author: Nat
  text: String
  now: Nat
record Edit:
  author: Nat
  id: Nat
  text: String
  now: Nat
record Vote:
  voter: Nat
  pick: Nat
  now: Nat
record Tick:
  now: Nat
sum Event:
  propose: Propose
  edit: Edit
  vote: Vote
  seal: Tick
record Refusal:
  reason: String
  story: Story
record Appended:
  story: Story
  chapter: Chapter
sum Transition:
  refused: Refusal
  moved: Story
  appended: Appended
sum Lookup:
  missing: {}
  found: Proposal
record Pick:
  proposal: Proposal
  votes: Nat
sum Winner:
  none: {}
  some: Pick

def not(b: Bool) -> Bool:
  if b then false else true

def isElector(v: Nat, e: Electorate) -> Bool:
  e.first <= v && v < e.first + e.count

def find(id: Nat, ps: Proposals) -> Lookup:
  match ps:
    case empty(_): Lookup.missing()
    case more(m): if m.head.id == id then Lookup.found(m.head) else find(id, m.tail)

def authored(author: Nat, ps: Proposals) -> Bool:
  match ps:
    case empty(_): false
    case more(m): m.head.author == author || authored(author, m.tail)

def append(ps: Proposals, p: Proposal) -> Proposals:
  match ps:
    case empty(_): Proposals.more({head: p, tail: Proposals.empty()})
    case more(m): Proposals.more({head: m.head, tail: append(m.tail, p)})

def retext(ps: Proposals, id: Nat, text: String) -> Proposals:
  match ps:
    case empty(_): ps
    case more(m): Proposals.more({head: if m.head.id == id then {id: id, author: m.head.author, text: text} else m.head, tail: retext(m.tail, id, text)})

def voted(voter: Nat, bs: Ballots) -> Bool:
  match bs:
    case empty(_): false
    case more(m): m.head.voter == voter || voted(voter, m.tail)

def votesFor(id: Nat, bs: Ballots) -> Nat:
  match bs:
    case empty(_): 0n
    case more(m): if m.head.pick == id then 1n + votesFor(id, m.tail) else votesFor(id, m.tail)

def sealedId(id: Nat, cs: Chapters) -> Bool:
  match cs:
    case empty(_): false
    case more(m): m.head.id == id || sealedId(id, m.tail)

def chapterCount(cs: Chapters) -> Nat:
  match cs:
    case empty(_): 0n
    case more(m): 1n + chapterCount(m.tail)

def appendChapter(cs: Chapters, c: Chapter) -> Chapters:
  match cs:
    case empty(_): Chapters.more({head: c, tail: Chapters.empty()})
    case more(m): Chapters.more({head: m.head, tail: appendChapter(m.tail, c)})

def lead(ps: Proposals, bs: Ballots, cur: Pick) -> Pick:
  match ps:
    case empty(_): cur
    case more(m): leadWith(m.head, votesFor(m.head.id, bs), m.tail, bs, cur)

def leadWith(p: Proposal, n: Nat, rest: Proposals, bs: Ballots, cur: Pick) -> Pick:
  if cur.votes < n then lead(rest, bs, {proposal: p, votes: n}) else lead(rest, bs, cur)

def winner(ps: Proposals, bs: Ballots) -> Winner:
  match ps:
    case empty(_): Winner.none()
    case more(m): Winner.some(lead(m.tail, bs, {proposal: m.head, votes: votesFor(m.head.id, bs)}))

def refuse(s: Story, reason: String) -> Transition:
  Transition.refused({reason: reason, story: s})

def open(s: Story, now: Nat) -> Bool:
  now <= s.round.closes

def withRound(s: Story, r: Round) -> Story:
  {meta: s.meta, chapters: s.chapters, round: r, nextId: s.nextId, done: s.done}

def start(title: String, window: Nat, total: Nat, electorate: Electorate, now: Nat) -> Story:
  {meta: {title: title, window: window, total: total, electorate: electorate}, chapters: Chapters.empty(), round: {closes: now + window, proposals: Proposals.empty(), ballots: Ballots.empty()}, nextId: 1n, done: false}

def proposeOn(s: Story, e: Propose) -> Transition:
  if s.done then refuse(s, "complete") else if not(open(s, e.now)) then refuse(s, "late") else if authored(e.author, s.round.proposals) then refuse(s, "alreadyProposed") else Transition.moved({meta: s.meta, chapters: s.chapters, round: {closes: s.round.closes, proposals: append(s.round.proposals, {id: s.nextId, author: e.author, text: e.text}), ballots: s.round.ballots}, nextId: s.nextId + 1n, done: s.done})

def editOn(s: Story, e: Edit) -> Transition:
  if s.done then refuse(s, "complete") else if sealedId(e.id, s.chapters) then refuse(s, "sealed") else editProposal(s, e, find(e.id, s.round.proposals))

def editProposal(s: Story, e: Edit, found: Lookup) -> Transition:
  match found:
    case missing(_): refuse(s, "unknown")
    case found(p): if not(open(s, e.now)) then refuse(s, "late") else if p.author == e.author then Transition.moved(withRound(s, {closes: s.round.closes, proposals: retext(s.round.proposals, e.id, e.text), ballots: s.round.ballots})) else refuse(s, "notAuthor")

def voteOn(s: Story, e: Vote) -> Transition:
  if s.done then refuse(s, "complete") else if not(open(s, e.now)) then refuse(s, "late") else if not(isElector(e.voter, s.meta.electorate)) then refuse(s, "notElector") else if voted(e.voter, s.round.ballots) then refuse(s, "alreadyVoted") else voteFor(s, e, find(e.pick, s.round.proposals))

def voteFor(s: Story, e: Vote, found: Lookup) -> Transition:
  match found:
    case missing(_): refuse(s, "unknown")
    case found(_): Transition.moved(withRound(s, {closes: s.round.closes, proposals: s.round.proposals, ballots: Ballots.more({head: {voter: e.voter, pick: e.pick}, tail: s.round.ballots})}))

def sealWith(s: Story, k: Tick, w: Pick) -> Transition:
  let c = {number: chapterCount(s.chapters) + 1n, id: w.proposal.id, author: w.proposal.author, text: w.proposal.text, votes: w.votes}
  Transition.appended({story: {meta: s.meta, chapters: appendChapter(s.chapters, c), round: {closes: k.now + s.meta.window, proposals: Proposals.empty(), ballots: Ballots.empty()}, nextId: s.nextId, done: c.number == s.meta.total}, chapter: c})

def sealOn(s: Story, k: Tick) -> Transition:
  if s.done then refuse(s, "complete") else if open(s, k.now) then refuse(s, "early") else sealRound(s, k, winner(s.round.proposals, s.round.ballots))

def sealRound(s: Story, k: Tick, w: Winner) -> Transition:
  match w:
    case none(_): Transition.moved(withRound(s, {closes: k.now + s.meta.window, proposals: s.round.proposals, ballots: s.round.ballots}))
    case some(p): sealWith(s, k, p)

def react(s: Story, e: Event) -> Transition:
  match e:
    case propose(p): proposeOn(s, p)
    case edit(d): editOn(s, d)
    case vote(v): voteOn(s, v)
    case seal(k): sealOn(s, k)

def storyOf(t: Transition) -> Story:
  match t:
    case refused(r): r.story
    case moved(s): s
    case appended(a): a.story

def reasonOf(t: Transition) -> String:
  match t:
    case refused(r): r.reason
    case moved(_): "ok"
    case appended(_): "ok"

def wasRefused(t: Transition) -> Bool:
  match t:
    case refused(_): true
    case moved(_): false
    case appended(_): false

def textOf(cs: Chapters, n: Nat) -> String:
  match cs:
    case empty(_): ""
    case more(m): if m.head.number == n then m.head.text else textOf(m.tail, n)

def authorOfChapter(cs: Chapters, n: Nat) -> Nat:
  match cs:
    case empty(_): 0n
    case more(m): if m.head.number == n then m.head.author else authorOfChapter(m.tail, n)

def votesOfChapter(cs: Chapters, n: Nat) -> Nat:
  match cs:
    case empty(_): 0n
    case more(m): if m.head.number == n then m.head.votes else votesOfChapter(m.tail, n)

def proposalCount(ps: Proposals) -> Nat:
  match ps:
    case empty(_): 0n
    case more(m): 1n + proposalCount(m.tail)

record Opening:
  title: String
  window: Nat
  total: Nat
  electorate: Electorate
  now: Nat
  keeper: Nat
  fresh: Bool
record Shelf:
  chapters: Nat
  author: Nat
  text: String
sum EditNat:
  keep: {}
  set: Nat
  add: Nat
sum EditString:
  keep: {}
  set: String
record Write:
  chapters: EditNat
  author: EditNat
  text: EditString
record Ask:
  decider: Nat
record At:
  at: Nat
sum Source:
  reply: Ask
  height: At
record Await:
  write: Write
  on: Source
  patience: Nat
record Commit:
  write: Write
sum Plan:
  await: Await
  commit: Commit
sum Outcome:
  reply: Event
  settled: {}
  refused: {}
  unknown: {}
  timedOut: {}
  broken: {}
  upgraded: {}
record View:
  version: Nat
  state: Shelf
record Step:
  outcome: Outcome
  view: View
sum Response:
  resumed: Step

def keepShelf() -> Write:
  {chapters: EditNat.keep(), author: EditNat.keep(), text: EditString.keep()}

def firstWrite(o: Opening) -> Write:
  if o.fresh then {chapters: EditNat.set(0n), author: EditNat.set(0n), text: EditString.set("")} else keepShelf()

def serve(o: Opening, s: Story, w: Write) -> Activity<Plan, Response, String>:
  match perform(Plan.await({write: w, on: Source.reply({decider: o.keeper}), patience: 64n})):
    case resumed(r):
      match r.outcome:
        case reply(e): step(o, s, react(s, e))
        case settled(_): serve(o, s, keepShelf())
        case refused(_): serve(o, s, keepShelf())
        case unknown(_): serve(o, s, keepShelf())
        case timedOut(_): serve(o, s, keepShelf())
        case broken(_): serve(o, s, keepShelf())
        case upgraded(_): serve(o, s, keepShelf())

def step(o: Opening, s: Story, t: Transition) -> Activity<Plan, Response, String>:
  match t:
    case refused(r): serve(o, r.story, keepShelf())
    case moved(next): serve(o, next, keepShelf())
    case appended(a): publish(o, s, a)

def publish(o: Opening, s: Story, a: Appended) -> Activity<Plan, Response, String>:
  match perform(Plan.commit({write: {chapters: EditNat.set(a.chapter.number), author: EditNat.set(a.chapter.author), text: EditString.set(a.chapter.text)}})):
    case resumed(r):
      match r.outcome:
        case settled(_): finish(o, a.story)
        case refused(_): serve(o, s, keepShelf())
        case reply(_): serve(o, s, keepShelf())
        case unknown(_): serve(o, s, keepShelf())
        case timedOut(_): serve(o, s, keepShelf())
        case broken(_): serve(o, s, keepShelf())
        case upgraded(_): serve(o, s, keepShelf())

def finish(o: Opening, s: Story) -> Activity<Plan, Response, String>:
  if s.done then "complete" else serve(o, s, keepShelf())

def tell(o: Opening) -> Activity<Plan, Response, String>:
  serve(o, start(o.title, o.window, o.total, o.electorate, o.now), firstWrite(o))
