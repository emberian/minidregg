+/-- A response starts a distinct pure source segment. The current native gate
+must consume the pending phase and validate the exact signed outcome. This pure
+constructor transports neither external authority nor old-worker permission. -/
+def resumeCandidate (limits : Limits) (library : Library) (before : Record)
+    (outcome : Outcome) : Option (ResumedRecord limits library before outcome) :=
+  match pendingExact : before.pending with
+  | none => none
+  | some pending =>
+    if identityExact : outcome.identity = pending.identity then
+      match responseExact : BendClosureResponse.decodeResponse outcome.responseBytes with
+      | none => none
+      | some bit =>
+        match ran : BendClosureResponse.resume limits library.program pending.response
+            before.checkpoint.state bit with
+        | .error _ => none
+        | .ok resumed =>
+          let record : Record := {before with ordinal := before.ordinal + 1, segment := before.segment + 1, priorSourceSteps := before.priorSourceSteps + before.checkpoint.state.sourceSteps, checkpoint := {before.checkpoint with state := resumed.state}, pending := none, lastOutcome := some outcome, origin := some ⟨pending.response.continuation,resumed.inputPointer,bit,pending.signature⟩}
+          some ⟨pending,pendingExact,identityExact,bit,responseExact,resumed,ran,
+            record,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
+    else none
