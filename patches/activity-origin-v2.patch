+structure ResumedRecord (limits : Limits) (library : Library) (before : Record)
+    (outcome : Outcome) where
+  private mk ::
+  pending : Pending
+  pendingExact : before.pending = some pending
+  identityExact : outcome.identity = pending.identity
+  bit : Bool
+  responseExact : BendClosureResponse.decodeResponse outcome.responseBytes = some bit
+  resumed : BendClosureResponse.Resumed library.program before.checkpoint.state pending.response bit
+  ran : BendClosureResponse.resume limits library.program pending.response
+    before.checkpoint.state bit = .ok resumed
+  record : Record
+  stateExact : record.checkpoint.state = resumed.state
+  originExact : record.origin = some ⟨pending.response.continuation,
+    resumed.inputPointer,bit,pending.signature⟩
+  ordinalExact : record.ordinal = before.ordinal + 1
+  segmentExact : record.segment = before.segment + 1
+  cleared : record.pending = none
+  contextExact : record.checkpoint.contextBytes = before.checkpoint.contextBytes
+  generationExact : record.checkpoint.generation = before.checkpoint.generation
+  priorCountExact : record.priorSourceSteps = before.priorSourceSteps + before.checkpoint.state.sourceSteps
+  outcomeExact : record.lastOutcome = some outcome
