edition ObjectiveBend 1

record MissingTarget:
  missing(value: Nat) -> Nat
  result(value: Nat) -> Nat

spec Incomplete for MissingTarget:
  requires missing(value: Nat) -> Nat
  def result(value: Nat) -> Nat:
    self.missing(value)

spec Filling for MissingTarget:
  def missing(value: Nat) -> Nat:
    value + 1

def unforced() -> Specification<MissingTarget>:
  Incomplete

def completed(seed: MissingTarget) -> MissingTarget:
  fix(compose(Incomplete, Filling), seed)

def resultOfThree() -> Nat:
  completed({missing: fn(value: Nat) -> Nat: 0n, result: fn(value: Nat) -> Nat: 0n}).result(3n)
