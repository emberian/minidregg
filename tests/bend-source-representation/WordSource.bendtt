SourceWord.three : (Word (.Succ, ((.Succ, ((.Succ, ((.Zero, ()), ())), ())), ()))) =
  (.WCon, ((.False, ()), ((.WCon, ((.True, ()), ((.WCon, ((.False, ()), ((.WNil, ()), ()))), ()))), ())))

Word.Nil.arms : ∀x0 : <WNil> -> *2 =
  λ{.WNil: <()>; λ{}}

Word.Nil : *2 =
  Σx0 : <WNil> -> (Word.Nil.arms x0)

Word.Con.arms : ∀-x0 : Nat -> ∀x1 : <WCon> -> *2 =
  λ-x0 => λ{.WCon: Σx1 : Bool -> Σx2 : (Word x0) -> <()>; λ{}}

Word.Con : ∀-x0 : Nat -> *2 =
  λ-x0 => Σx1 : <WCon> -> (Word.Con.arms -x0 x1)

Word : ∀x0 : Nat -> *2 =
  λ{(,): λ{.Zero: λ{(): Word.Nil; λ{}}; λ{.Succ: λ{(,): λx0 => λ{(): (Word.Con -x0); λ{}}}; λ{}}}}

Bool.arms : ∀x0 : <False, True> -> *2 =
  λ{.False: <()>; λ{.True: <()>; λ{}}}

Bool : *2 =
  Σx0 : <False, True> -> (Bool.arms x0)

Nat.arms : ∀x0 : <Zero, Succ> -> *2 =
  λ{.Zero: <()>; λ{.Succ: Σx0 : Nat -> <()>; λ{}}}

Nat : *2 =
  Σx0 : <Zero, Succ> -> (Nat.arms x0)
