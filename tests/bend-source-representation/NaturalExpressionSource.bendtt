Nat.add : ∀x0 : Nat -> ∀x1 : Nat -> Nat =
  λ{(,): λ{.Zero: λ{(): λx0 => x0; λ{}}; λ{.Succ: λ{(,): λx0 => λ{(): λx1 => (.Succ, ((Nat.add x0 x1), ())); λ{}}}; λ{}}}}

SourceNat.doubleSum : ∀+x0 : Nat -> ∀+x1 : Nat -> Nat =
  λ+x0 => λ+x1 => (Nat.add (Nat.add x0 x1) (Nat.add x0 x1))

Nat.arms : ∀x0 : <Zero, Succ> -> *2 =
  λ{.Zero: <()>; λ{.Succ: Σx0 : Nat -> <()>; λ{}}}

Nat : *2 =
  Σx0 : <Zero, Succ> -> (Nat.arms x0)
