{
  "type": "object",
  "properties": {
    "format": {
      "const": "mini-app-interface-v1"
    },
    "name": {
      "type": "string"
    },
    "interfaceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]{52}$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "appVersion": {
      "type": "string"
    },
    "status": {
      "const": "prototype-unqualified"
    },
    "limits": {
      "type": "object",
      "properties": {
        "bodyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "replyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "snapshotDocuments": {
          "type": "integer",
          "minimum": 1
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "bodyBytes",
        "replyBytes",
        "snapshotDocuments",
        "seconds"
      ],
      "additionalProperties": false
    },
    "$defs": {
      "type": "object"
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "write": {
            "type": "boolean"
          },
          "binding": {
            "oneOf": [
              {
                "$ref": "#/$defs/HttpBinding"
              },
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "const": "ddp"
                  },
                  "kind": {
                    "enum": [
                      "method",
                      "snapshot"
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "publication": {
                    "type": "string"
                  },
                  "params": {
                    "type": "array",
                    "items": {}
                  },
                  "collections": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "result": {
                    "enum": [
                      "insert-id",
                      "json"
                    ]
                  }
                },
                "required": [
                  "protocol",
                  "kind",
                  "params"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "method"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "method",
                        "result"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "snapshot"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "publication",
                        "collections"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "protocol": {
                    "const": "conversation"
                  },
                  "wire": {
                    "enum": [
                      "json-v1",
                      "socket.io-eio3",
                      "socket.io-eio4"
                    ]
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "arg": {
                              "type": "string"
                            },
                            "encoding": {
                              "enum": [
                                "path",
                                "segment"
                              ]
                            }
                          },
                          "required": [
                            "arg",
                            "encoding"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 64
                  },
                  "query": {
                    "type": "object"
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "$ref": "#/$defs/ConversationStep"
                    }
                  },
                  "result": {}
                },
                "required": [
                  "protocol",
                  "wire",
                  "path",
                  "steps",
                  "result"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "wire": {
                          "const": "json-v1"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "steps": {
                          "items": {
                            "allOf": [
                              {
                                "not": {
                                  "required": [
                                    "emit"
                                  ]
                                }
                              },
                              {
                                "if": {
                                  "required": [
                                    "receive"
                                  ]
                                },
                                "then": {
                                  "properties": {
                                    "receive": {
                                      "not": {
                                        "required": [
                                          "event"
                                        ]
                                      }
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "required": [
                                    "receiveAll"
                                  ]
                                },
                                "then": {
                                  "properties": {
                                    "receiveAll": {
                                      "items": {
                                        "not": {
                                          "required": [
                                            "event"
                                          ]
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "steps": {
                          "items": {
                            "allOf": [
                              {
                                "not": {
                                  "required": [
                                    "send"
                                  ]
                                }
                              },
                              {
                                "if": {
                                  "required": [
                                    "receive"
                                  ]
                                },
                                "then": {
                                  "properties": {
                                    "receive": {
                                      "required": [
                                        "event"
                                      ]
                                    }
                                  }
                                }
                              },
                              {
                                "if": {
                                  "required": [
                                    "receiveAll"
                                  ]
                                },
                                "then": {
                                  "properties": {
                                    "receiveAll": {
                                      "items": {
                                        "required": [
                                          "event"
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string"
                },
                "args": {
                  "type": "object"
                },
                "exists": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "type": "string"
                      },
                      "where": {
                        "type": "object",
                        "minProperties": 1
                      }
                    },
                    "required": [
                      "collection",
                      "where"
                    ],
                    "additionalProperties": false
                  }
                },
                "assert": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      },
                      "equals": {}
                    },
                    "required": [
                      "path",
                      "equals"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "op",
                "args"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "exists"
                  ]
                },
                {
                  "required": [
                    "assert"
                  ]
                }
              ]
            }
          },
          "projection": {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string"
              },
              "where": {
                "type": "object"
              },
              "values": {
                "type": "boolean"
              }
            },
            "required": [
              "collection",
              "where"
            ],
            "additionalProperties": false
          },
          "internal": {
            "type": "boolean"
          },
          "prepare": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "op": {
                  "type": "string"
                },
                "args": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "op",
                "args"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "description",
          "input",
          "output",
          "write",
          "binding"
        ],
        "additionalProperties": false
      }
    },
    "qualification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "assert": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "await": {
            "type": "object",
            "properties": {
              "attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "intervalSeconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "retryStatuses": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 3,
                "items": {
                  "enum": [
                    502,
                    503,
                    504
                  ]
                }
              }
            },
            "required": [
              "attempts",
              "intervalSeconds",
              "retryStatuses"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "op",
          "args"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "format",
    "name",
    "interfaceVersion",
    "appId",
    "packageId",
    "appVersion",
    "status",
    "limits",
    "$defs",
    "operations",
    "qualification",
    "auth",
    "sources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CsvExpression": {
      "type": "object",
      "properties": {
        "csv": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {}
              }
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "csv"
      ],
      "additionalProperties": false
    },
    "HttpBinding": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "http"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "MKCOL",
            "MOVE",
            "PROPFIND",
            "REPORT",
            "MKCALENDAR"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "arg": {
                    "type": "string"
                  },
                  "encoding": {
                    "enum": [
                      "path",
                      "segment"
                    ]
                  }
                },
                "required": [
                  "arg",
                  "encoding"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "decode": {
          "enum": [
            "json",
            "base64",
            "status",
            "dav-multistatus",
            "text",
            "json-lines",
            "caldav-multistatus",
            "rss",
            "json-string-fragment"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "headers": {
          "type": "object"
        },
        "query": {
          "type": "object"
        },
        "json": {
          "type": "object"
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "csv"
                ]
              },
              "then": {
                "$ref": "#/$defs/CsvExpression"
              }
            }
          ]
        },
        "base64": {
          "type": "object"
        },
        "form": {
          "type": "object"
        },
        "multipart": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "filename": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              },
              "contentType": {
                "type": "string"
              },
              "text": {},
              "base64": {}
            },
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "text"
                ],
                "not": {
                  "required": [
                    "base64"
                  ]
                }
              },
              {
                "required": [
                  "base64"
                ],
                "not": {
                  "required": [
                    "text"
                  ]
                }
              }
            ]
          }
        },
        "acceptedContentTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fragment": {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "suffix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "prefix",
            "suffix"
          ],
          "additionalProperties": false
        },
        "responseHeaders": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "enum": [
              "etag",
              "last-modified",
              "content-type",
              "content-length",
              "x-sandstorm-app-data-version"
            ]
          }
        },
        "cookies": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "not": {
              "const": "__Host-mini_spk_session"
            }
          },
          "additionalProperties": {}
        },
        "emptyValue": {}
      },
      "required": [
        "protocol",
        "method",
        "path",
        "decode",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decode": {
                "const": "json-string-fragment"
              }
            },
            "required": [
              "decode"
            ]
          },
          "then": {
            "required": [
              "fragment"
            ]
          }
        }
      ]
    },
    "ConversationCheck": {
      "type": "object",
      "properties": {
        "path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "equals": {},
        "exists": {
          "const": true
        },
        "contains": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "path"
      ],
      "oneOf": [
        {
          "required": [
            "equals"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "exists"
                ]
              },
              {
                "required": [
                  "contains"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "exists"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "equals"
                ]
              },
              {
                "required": [
                  "contains"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "contains"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "equals"
                ]
              },
              {
                "required": [
                  "exists"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ConversationReceive": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ConversationCheck"
          }
        }
,
        "refuseOn": {
          "description": "Frames that are the app's own rejection of what this step awaits: one ends the step with refusal 'app-refused: <reason>' (decided).",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "where": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/ConversationCheck"
                }
              },
              "reason": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            },
            "required": [
              "where",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "where"
      ],
      "additionalProperties": false
    },
    "ConversationTerminal": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ConversationCheck"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        }
      },
      "required": [
        "where",
        "id"
      ],
      "additionalProperties": false
    },
    "ConversationStep": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "send": {}
          },
          "required": [
            "send"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "emit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "array",
              "maxItems": 128,
              "items": {}
            }
          },
          "required": [
            "emit",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "receive": {
              "$ref": "#/$defs/ConversationReceive"
            }
          },
          "required": [
            "id",
            "receive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "receiveAll": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/ConversationTerminal"
              }
            }
          },
          "required": [
            "receiveAll"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "http": {
              "$ref": "#/$defs/HttpBinding"
            }
          },
          "required": [
            "id",
            "http"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
