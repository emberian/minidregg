{
  "format": "mini-app-interface-v1",
  "name": "hummingbird",
  "interfaceVersion": 1,
  "appId": "434g078hse54h0tt189hsyp2stf7n7rap8uxwjf3dyq2zvymrx0h",
  "packageId": "c7287dfbae2796cd283a32452d2395c7",
  "appVersion": "0.4.1",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 1048576,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "operations": {
    "analytics.record": {
      "description": "Record a tracking event and return the matching dashboard hits from its live interval. Metrics reset after each interval.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "event": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "url",
          "event"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 4096
            },
            "timestamp": {
              "type": "string",
              "maxLength": 64
            },
            "ip": {
              "type": "string",
              "maxLength": 128
            }
          },
          "required": [
            "timestamp"
          ],
          "additionalProperties": true
        }
      },
      "write": true,
      "binding": {
        "protocol": "conversation",
        "wire": "socket.io-eio4",
        "path": [
          "socket.io/"
        ],
        "steps": [
          {
            "id": "beacon",
            "http": {
              "protocol": "http",
              "method": "GET",
              "path": [
                "tracking_pixel.gif"
              ],
              "query": {
                "event": {
                  "arg": "event"
                }
              },
              "headers": {
                "referer": {
                  "arg": "url"
                }
              },
              "decode": "status",
              "status": [
                200
              ]
            }
          },
          {
            "id": "hits",
            "receive": {
              "event": "hits",
              "where": [
                {
                  "path": [
                    0
                  ],
                  "contains": {
                    "url": {
                      "arg": "url"
                    }
                  }
                }
              ]
            }
          }
        ],
        "result": {
          "result": [
            "hits",
            0
          ]
        }
      }
    },
    "analytics.count": {
      "description": "Sample the next 50 ms dashboard count interval. This is not a persistent historical total.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "integer",
        "minimum": 0
      },
      "write": false,
      "binding": {
        "protocol": "conversation",
        "wire": "socket.io-eio4",
        "path": [
          "socket.io/"
        ],
        "steps": [
          {
            "id": "count",
            "receive": {
              "event": "view_totals",
              "where": [
                {
                  "path": [
                    0
                  ],
                  "exists": true
                }
              ]
            }
          }
        ],
        "result": {
          "result": [
            "count",
            0
          ]
        }
      }
    }
  },
  "qualification": [
    {
      "id": "record",
      "op": "analytics.record",
      "args": {
        "url": {
          "concat": [
            "https://grain.test/analytics/",
            {
              "context": "runId"
            }
          ]
        },
        "event": "view"
      },
      "assert": [
        {
          "contains": {
            "url": {
              "concat": [
                "https://grain.test/analytics/",
                {
                  "context": "runId"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-session"
  },
  "sources": [
    "package:c7287dfbae2796cd283a32452d2395c7/opt/app/lib/tracker.js",
    "package:c7287dfbae2796cd283a32452d2395c7/opt/app/lib/dashboard.js",
    "package:c7287dfbae2796cd283a32452d2395c7/opt/app/lib/metric.js",
    "package:c7287dfbae2796cd283a32452d2395c7/opt/app/node_modules/socket.io/package.json"
  ],
  "$defs": {}
}
