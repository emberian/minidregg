{
  "format": "mini-app-interface-v1",
  "name": "wbo",
  "interfaceVersion": 1,
  "appId": "j4jvn386t7un76qu6yyw1vwc5ke50t07e38r82kzy4qqg6qq7msh",
  "packageId": "d3b06718d12bc377db7b494679440b91",
  "appVersion": "2.18.26",
  "status": "prototype-unqualified",
  "limits": {
    "bodyBytes": 16384,
    "replyBytes": 4194304,
    "snapshotDocuments": 1000,
    "seconds": 120
  },
  "$defs": {},
  "operations": {
    "board.read": {
      "description": "Read the board's replay as a fresh socket.io connection receives it: the complete bounded list of stored mutations (WBO 2.18 joins by connecting with board and baselineSeq=0). Empty board is []. This is the live replay, not the saved file.",
      "input": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "board"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "tool": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "id",
            "tool"
          ],
          "additionalProperties": true
        }
      },
      "write": false,
      "binding": {
        "protocol": "conversation",
        "wire": "socket.io-eio4",
        "path": [
          "socket.io/"
        ],
        "query": {
          "board": {
            "arg": "board"
          },
          "baselineSeq": "0"
        },
        "steps": [
          {
            "id": "board",
            "receive": {
              "event": "broadcast",
              "where": [
                {
                  "path": [
                    0,
                    "_children"
                  ],
                  "exists": true
                }
              ]
            }
          }
        ],
        "result": {
          "result": [
            "board",
            0,
            "_children"
          ]
        }
      }
    },
    "rectangle.write": {
      "description": "Create a rectangle on this board: join, wait for the replay, send one numeric create mutation (tool 3, type 1) and wait for the server's broadcast of that exact mutation id. An acknowledged id is not saved-file evidence; read the saved board separately. Never replay an uncertain send.",
      "input": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "x": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "y": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "x2": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "y2": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "board",
          "id",
          "color",
          "size",
          "opacity",
          "x",
          "y",
          "x2",
          "y2"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "delivery": {
            "const": "acknowledged"
          },
          "id": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "delivery",
          "id"
        ],
        "additionalProperties": false
      },
      "write": true,
      "binding": {
        "protocol": "conversation",
        "wire": "socket.io-eio4",
        "path": [
          "socket.io/"
        ],
        "query": {
          "board": {
            "arg": "board"
          },
          "baselineSeq": "0"
        },
        "steps": [
          {
            "id": "board",
            "receive": {
              "event": "broadcast",
              "where": [
                {
                  "path": [
                    0,
                    "_children"
                  ],
                  "exists": true
                }
              ]
            }
          },
          {
            "emit": "broadcast",
            "args": [
              {
                "tool": 3,
                "type": 1,
                "id": {
                  "arg": "id"
                },
                "clientMutationId": {
                  "arg": "id"
                },
                "color": {
                  "arg": "color"
                },
                "size": {
                  "arg": "size"
                },
                "opacity": {
                  "arg": "opacity"
                },
                "x": {
                  "arg": "x"
                },
                "y": {
                  "arg": "y"
                },
                "x2": {
                  "arg": "x2"
                },
                "y2": {
                  "arg": "y2"
                }
              }
            ]
          },
          {
            "id": "ack",
            "receive": {
              "event": "broadcast",
              "where": [
                {
                  "path": [
                    0,
                    "mutation",
                    "id"
                  ],
                  "equals": {
                    "arg": "id"
                  }
                }
              ]
            }
          }
        ],
        "result": {
          "delivery": "acknowledged",
          "id": {
            "arg": "id"
          }
        }
      }
    },
    "board.saved.read": {
      "description": "Read the saved board as WBO's SVG export (GET /download/<board>). Saving is asynchronous: an empty or missing export refuses, and a replayed mutation is not saved-file evidence.",
      "input": {
        "type": "object",
        "properties": {
          "board": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "board"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "maxLength": 4194304
      },
      "write": false,
      "binding": {
        "protocol": "http",
        "method": "GET",
        "path": [
          "download/",
          {
            "arg": "board",
            "encoding": "segment"
          }
        ],
        "decode": "text",
        "status": [
          200
        ]
      }
    }
  },
  "qualification": [
    {
      "id": "write",
      "op": "rectangle.write",
      "args": {
        "board": {
          "context": "runId"
        },
        "id": {
          "context": "runId"
        },
        "color": "#123456",
        "size": 4,
        "opacity": 1,
        "x": 10,
        "y": 10,
        "x2": 120,
        "y2": 90
      }
    },
    {
      "id": "read",
      "op": "board.read",
      "args": {
        "board": {
          "context": "runId"
        }
      },
      "assert": [
        {
          "contains": {
            "id": {
              "context": "runId"
            }
          }
        }
      ],
      "await": {
        "attempts": 6,
        "intervalSeconds": 1,
        "retryStatuses": []
      }
    },
    {
      "id": "saved",
      "op": "board.saved.read",
      "args": {
        "board": {
          "context": "runId"
        }
      },
      "await": {
        "attempts": 6,
        "intervalSeconds": 2,
        "retryStatuses": []
      },
      "assert": [
        {
          "path": [],
          "containsText": {
            "context": "runId"
          }
        }
      ]
    }
  ],
  "auth": {
    "kind": "member-route"
  },
  "sources": [
    "https://github.com/lovasoa/whitebophir/releases/tag/v2.18.26",
    "apps/packages/wbo/qualify-writes/wbo-sio.py",
    "package:d3b06718d12bc377db7b494679440b91/opt/app/whitebophir/server/socket/replay.mjs",
    "package:d3b06718d12bc377db7b494679440b91/opt/app/whitebophir/server/socket/message_validation.mjs",
    "package:d3b06718d12bc377db7b494679440b91/opt/app/whitebophir/server/routes/board_assets.mjs"
  ]
}
